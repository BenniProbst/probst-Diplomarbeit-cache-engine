<?xml version="1.0" encoding="UTF-8"?>
<!-- ====================================================================
     experiment_golden_kern.xml
     KANONISCH AB #48. Jede Schema-Evolution zuerst HIER (STETS gepflegt).

     Fundament: Sektion 59-KERN (Mess-Schema-Steuerung) plus Sektion 62
     (Maschinen-Menge, compare-Reserve). Die Wurzel comdare_experiment
     version=2 gibt einen sauberen Schema-Schnitt gegen INC-C-v1 und die
     Alt-REV7.6-Wurzel.

     ADDITIV-DANEBEN: die alte experiment_golden.xml, die ce-Kopie und das
     Sync-Gate bleiben byte-unberuehrt (Interim-Abgabe-Kette, Interim-GO-1).
     Die Umhaengung (gegated nach dem 320er plus User-GO) ist Scheibe 6.

     #48-S5: die Element-Namen und die Reihenfolge folgen EXAKT dem Ist-
     Parser (parse_experiment_profile) und dem konsolidierten XSD
     (experiment_schema.xsd, xs:sequence). Diese Instanz validiert gegen
     experiment_schema.xsd (xmllint -schema). Achsen-Voll-Abdeckung ist die
     1:1-Lese-Referenz aus all_axes_golden.profile.xml (17 Kompositions-
     Achsen per Voll-Sweep-Default; System-Achsen-Block; Mess-Tooling-Trio;
     Writeback-Trio). all_axes_golden selbst bleibt unangetastet.
     ==================================================================== -->
<comdare_experiment version="2" id="diplomarbeit_golden_kern"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="experiment_schema.xsd">

  <metadata>
    <name>diplomarbeit_golden_kern</name>
    <mode>full</mode>
  </metadata>

  <!-- Fork 5: mode=full ist die Voll-Whitelist-Basis aus der Registry
       (ANGEBOT). Das Attribut ref benennt spaeter ein Paper-Template
       (post-v3); die Einschraenkung laeuft ueber allowed_variants je Achse. -->
  <template mode="full"/>

  <!-- Registry = ANGEBOT; die Engine-ids tragen die Wurzel-Engine-Erwartung
       (die K7-Generisierung auf beliebige Wurzeln ist post-v3). -->
  <execution_engines>
    <engine id="ee_ce"  type="CacheEngineExecutionEngineAdapter" registry="cache_engine_axis_registry.xml"/>
    <engine id="ee_prt" type="PrtArtExecutionEngineAdapter"      registry="prt_art_axis_registry.xml"/>
  </execution_engines>

  <!-- Sektion 62-C/D/E: die Maschinen-MENGE ist das CI-Fertig-Gate-Kriterium,
       KEINE Zustaendigkeits-Aufteilung. EINE XML fuer beide Maschinen
       (Symmetrie-Regel). Die Identitaet ist zweistufig: der Kern ist
       CPU-Fabrikation plus RAM-Paar; hostname_hint ist NUR ein Hinweis
       (validate prueft den Schluessel, nicht den Namen). -->
  <machines>
    <machine id="prod1" cpu_fabrication="amd_zen5_avx512" ram_pair="ddr5_2x32" hostname_hint="prod1"/>
    <machine id="prod2" cpu_fabrication="intel_avx2"      ram_pair="ddr5_2x32" hostname_hint="prod2"/>
  </machines>

  <!-- Die gemessenen Lebewesen (base_tier-ids), 1:1 aus all_axes_golden. -->
  <lebewesen>
    <tier id="prt_art"/>
    <tier id="art"/>
    <tier id="hot"/>
    <tier id="masstree"/>
    <tier id="surf"/>
    <tier id="start"/>
    <tier id="wormhole"/>
  </lebewesen>

  <!-- Sektion 59-A: phases sind optional; ein leerer Block bedeutet
       derive_default_experiment_phases() mit 3 Default-Stufen. Das Attribut
       pruefling benennt je Phase den einzusetzenden Pruefling; id_namespace
       ist der eigene id-Satz (der 3. Tier-Binary-Stempel: auch die
       Merge-Kombination bekommt einen id-Namensraum). Merges sind ADDITIV
       (Sektion 59-C): der CRC-131072-Satz bleibt unberuehrt. Der self-Marker
       laeuft ueber das phase-Attribut identity (kein Top-Level-Element). -->
  <phases>
    <phase name="Stufe1_CeOnly"           merge="Stufe1_CeOnly"           engine="ee_ce"/>
    <phase name="Stufe2_PrueflingReplace" merge="Stufe2_PrueflingReplace" engine="ee_prt"        pruefling="prt_art" id_namespace="merge_prt_v1"/>
    <phase name="Stufe3_FullJoin"         merge="Stufe3_FullJoin"         engines="ee_ce ee_prt" pruefling="prt_art" id_namespace="join_prt_v1"/>
  </phases>

  <!-- Negatives Blacklisting ist ein reines LIMIT: eine UNGENANNTE Achse
       expandiert zur VOLLEN Registry-Liste (alles messen = Default). Die
       17 kanonischen Kompositions-Achsen (in kCompositionAxisNames-Reihenfolge:
       search_algo, cache_traversal, mapping, path_compression, node_type,
       memory_layout, allocator, prefetch, concurrency, serialization,
       value_handle, index_organization, io_dispatch, migration_policy,
       filter, queuing_q1, queuing_q2) sind damit voll abgedeckt: die 2 unten
       benannten tragen einen Override, die uebrigen 15 laufen als Voll-Sweep.

       merge-Token je Achse:
         replace  = der Default wird durch den Pruefling ersetzt.
         merge    = CE plus Pruefling als Hybrid, nur Override.
         fulljoin = NUR in der Phase-3-Bindung gueltig (Stufe3_FullJoin);
                    validate erzwingt diese Bindung. Der Fork-4-Entscheid
                    trennt so den Sektion-59-A(2)-Hybrid vom A(3)-FullJoin.
       pruefling je Achse benennt, von welchem Pruefling die Achse stammt
       (engine-id / lebewesen-id / self-Marker CacheEngine). -->
  <axes_default_lookup enabled="true">
    <axis ref="search_algo"      pruefling="prt_art" merge="replace" allowed_variants="binary_search linear_search"/>
    <axis ref="path_compression" pruefling="prt_art" merge="merge"/>
    <!-- Alle uebrigen Achsen bleiben absichtlich UNGENANNT = Voll-Sweep. -->
  </axes_default_lookup>

  <!-- System-Achsen 1:1 aus all_axes_golden (Compiler-opt_level plus
       external_utils-simd). system_config ist binary_id-NEUTRAL: es
       multipliziert nur die BAU-Matrix (build_version plus opt-Suffix plus
       ext-Suffix), NIE die N=2^17-Organ-Kartesik. Ofast bleibt WEGGELASSEN
       (es bricht den IEEE-754-Determinismus und den CRC64-golden-Anker);
       avx512 ist nicht universell und bleibt draussen. -->
  <system_axes>
    <compiler>
      <opt_level>
        <option value="O2"/>
        <option value="O3"/>
      </opt_level>
    </compiler>
    <external_utils>
      <simd>
        <option value="no_extension"/>
        <option value="avx2"/>
      </simd>
    </external_utils>
  </system_axes>

  <!-- Workloads 1:1 aus all_axes_golden. -->
  <workloads>ycsb_a ycsb_b ycsb_c ycsb_d ycsb_e ycsb_f</workloads>

  <!-- Datensaetze 1:1 aus all_axes_golden (MESS-INPUTS, binary_id-NEUTRAL;
       die Akten in Code/test_data_xml/ sind die Single-Source der Provenienz,
       keine Doppelquelle). -->
  <datasets>
    <dataset id="url"             akte_ref="test_data_xml/url.test_data.xml"             loader="string_corpus"/>
    <dataset id="english_words"   akte_ref="test_data_xml/english_words.test_data.xml"   loader="string_corpus"/>
    <dataset id="sosd_books_200M" akte_ref="test_data_xml/sosd_books_200M.test_data.xml" loader="sosd_uint64"/>
  </datasets>

  <!-- Mess-Tooling-Trio 1:1 aus all_axes_golden: die drei CEB-Typen als
       SEPARATE Combos (wallclock, macro, micro). -->
  <measurement_tooling>
    <combo tools="wallclock"/>
    <combo tools="macro"/>
    <combo tools="micro"/>
  </measurement_tooling>

  <!-- exactly-one je CALL: der Modus ist ein Call-Parameter, NIE ein
       Binary-Stempel. Werte: debug, measure, release. Der vierte Wert
       compare ist die Reserve fuer Paket #47 (er liest das Mess-Replay der
       registrierten Maschinen nach dem release-Lauf); in #48 nur als
       Kommentar reserviert, KEIN Registry-Eintrag. -->
  <run_methodology>
    <method value="measure"/>
  </run_methodology>

  <measurement_framework name="ycsb"/>

  <!-- Writeback-Trio 1:1 aus all_axes_golden. -->
  <writeback_methods>
    <method value="csv"/>
    <method value="latex_table"/>
    <method value="comparison_metrics"/>
  </writeback_methods>

  <op_types>OP-1 OP-3</op_types>

  <output>
    <binary_path>golden_kern/measurements/all_permutations.bin</binary_path>
    <csv_path>golden_kern/measurements.csv</csv_path>
    <latex_path>golden_kern/golden_kern_table.tex</latex_path>
    <!-- Sektion 59-C-Slot, in #48 INERT deklariert: der Konsum (K7b/K8)
         folgt post-Abgabe. backend=local ist der Default; die minio-Variante
         traegt zusaetzlich ein endpoint-Attribut. -->
    <storage backend="local"/>
  </output>

</comdare_experiment>
