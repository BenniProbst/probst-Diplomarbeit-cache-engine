<?xml version="1.0" encoding="UTF-8"?>
<!-- DEPRECATED (#48-S5, 2026-07-22): Legacy-Fixture. BEHALTEN (Doku-nie-loeschen, INC-D), aber KEIN Ziel-Traeger.
     Neue Schema-Felder gehoeren ausschliesslich in experiment_schema.xsd (comdare_experiment v2 = Ziel-Traeger).
     Diese Datei bleibt am Ort (Test-Referenzen im messung_driver); nur dieser Kopf-Vermerk kommt hinzu. -->
<!--
  V33.D.1 (2026-05-21) - Messreihe XSD-Schema V32

  Formale Spec der messreihe_v32_*.xml Struktur.
  Code-side Validation via messung_driver/messreihe_v32_validator.hpp
  (kein xerces/libxml2 Aufwand fuer Header-only Tooling).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:element name="messreihe">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="MetadataType"/>
        <xs:element name="execution_engines" type="ExecutionEnginesType"/>
        <xs:element name="axes_default_lookup" type="AxesDefaultLookupType" minOccurs="0"/>
        <xs:element name="tupel" type="TupelType" maxOccurs="unbounded"/>
        <xs:element name="output" type="OutputType"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="32"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="MetadataType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="mode">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="defined"/>
            <xs:enumeration value="full"/>
            <xs:enumeration value="full_sampled"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ExecutionEnginesType">
    <xs:sequence>
      <xs:element name="engine" minOccurs="2" maxOccurs="2">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="type" type="xs:string" use="required"/>
          <xs:attribute name="name" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AxesDefaultLookupType">
    <xs:sequence>
      <xs:element name="axis" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="allowed_variants" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="enabled" type="xs:boolean" use="required"/>
  </xs:complexType>

  <xs:complexType name="TupelType">
    <xs:sequence>
      <xs:element name="workload">
        <xs:complexType>
          <xs:attribute name="kind" type="xs:string" use="required"/>
          <xs:attribute name="record_count" type="xs:positiveInteger" use="required"/>
          <xs:attribute name="operation_count" type="xs:positiveInteger" use="required"/>
          <xs:attribute name="seed" type="xs:unsignedLong" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- V33.D.4 NEU (Q.2): op_type Tag fuer OP-1 bis OP-6 -->
      <xs:element name="op_type" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="OP-1"/>
            <xs:enumeration value="OP-2"/>
            <xs:enumeration value="OP-3"/>
            <xs:enumeration value="OP-4"/>
            <xs:enumeration value="OP-5"/>
            <xs:enumeration value="OP-6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <!-- V33.E.3 NEU (Q.1): hardware_strategy Tag -->
      <xs:element name="hardware_strategy" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="simd" type="xs:string" minOccurs="0"/>
            <xs:element name="cache_level" type="xs:string" minOccurs="0"/>
            <xs:element name="numa" type="xs:string" minOccurs="0"/>
            <xs:element name="prefetch_distance" type="xs:string" minOccurs="0"/>
            <xs:element name="atomic_granularity" type="xs:string" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- V33.E.3 NEU (Q.1): scheduling_strategy Tag -->
      <xs:element name="scheduling_strategy" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="worker_pool" type="xs:string" minOccurs="0"/>
            <xs:element name="simd_workers" type="xs:positiveInteger" minOccurs="0"/>
            <xs:element name="heterogeneous_awareness" type="xs:string" minOccurs="0"/>
            <xs:element name="memory_interleave" type="xs:string" minOccurs="0"/>
            <xs:element name="batching" type="xs:string" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- V35.B.4 NEU: compiler_strategy Tag (Achse 15.1-15.5) -->
      <xs:element name="compiler_strategy" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="family" minOccurs="0">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="GCC"/>
                  <xs:enumeration value="Clang"/>
                  <xs:enumeration value="AppleClang"/>
                  <xs:enumeration value="MSVC"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="opt_level"   type="xs:string" minOccurs="0"/>
            <xs:element name="lto"         type="xs:string" minOccurs="0"/>
            <xs:element name="pgo"         type="xs:string" minOccurs="0"/>
            <xs:element name="target_arch" type="xs:string" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="axes" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="axis" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="baustein" type="xs:string" use="required"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="OutputType">
    <xs:sequence>
      <xs:element name="binary_path" type="xs:string"/>
      <xs:element name="csv_path" type="xs:string"/>
      <xs:element name="latex_path" type="xs:string"/>
      <xs:element name="comparison_metrics" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
