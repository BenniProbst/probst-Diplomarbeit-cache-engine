<?xml version="1.0" encoding="UTF-8"?>
<!--
  INC-C (2026-07-14) - comdare_experiment XSD-Schema (3-Phasen-Vorlage).

  Formale Spec der experiment_*.xml Struktur. Loest das Interim-Muster
  messreihe_v32_schema.xsd ab (das als Legacy-Fixture BEHALTEN wird).

  Kern-Idee: das Experiment-XML REFERENZIERT die zwei Achsen-Registries
  (cache_engine_axis_registry.xml, engine=cache_engine, 19 Achsen/90 Bausteine +
  prt_art_axis_registry.xml, engine=prt_art, 5 Slots) und traegt KEINE Bausteine
  selbst. Eine <phase> traegt NUR merge (MergeStrategy-Enum aus
  cache_engine/anatomy/pruefling_merge.hpp) + engine(s), KEIN <baustein>.

  Diese XSD ist inert bis der typisierte Parser (INC-D) sie liest. Die
  registry-/allowed_variants-/measurement-Konsistenz gegen die Registries wird
  vom Code-Parser gegen die generierten Registry-XML validiert (die XSD kann die
  Registry-Namen nicht kennen); die XSD formalisiert nur die Struktur.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:element name="comdare_experiment">
    <xs:complexType>
      <xs:sequence>
        <!-- KERN #48-S5 (2026-07-22): metadata jetzt OPTIONAL (v2). Die KERN-golden traegt die Semantik ueber
             template/axes_default_lookup; metadata/mode ist Interim-Legacy (v1). Abwesend = kein metadata. -->
        <xs:element name="metadata"             type="MetadataType" minOccurs="0"/>
        <!-- KERN-A (S4, 2026-07-20): optionales <template ref=".." mode="full|.."> (Research-Gesamtalgorithmus-
             Load). mode="full" = Voll-Whitelist-Basis + axes_default_lookup restrict/extend; ref = benanntes
             Paper-Template (SPAETERE Feature-Erweiterung). Abwesenheit = kein Template (byte-identisch). -->
        <xs:element name="template"             type="TemplateType" minOccurs="0"/>
        <xs:element name="execution_engines"    type="ExecutionEnginesType"/>
        <!-- KERN #48-S5 (Section 62-C): die Maschinen-MENGE (CI-Fertig-Gate-Kriterium; EINE XML fuer beide
             Maschinen). Identitaets-Kern = cpu_fabrication + ram_pair; hostname_hint nur Hinweis. OPTIONAL;
             Abwesenheit = keine Menge = heutiges Verhalten. Der Konsum (Fertig-Gate) gehoert dem Planer. -->
        <xs:element name="machines"             type="MachinesType" minOccurs="0"/>
        <xs:element name="lebewesen"            type="LebewesenType"/>
        <!-- KERN-A (S4 Mess-Schema, 2026-07-20): phases jetzt OPTIONAL (minOccurs=0). Abwesenheit/leer =>
             der Planer LEITET die 3 Default-Stufen ab (Stufe1_CeOnly . je Pruefling Stufe2 . Stufe3_FullJoin);
             explizite <phases> = Override (byte-identisch zum Ist). -->
        <xs:element name="phases"               type="PhasesType" minOccurs="0"/>
        <xs:element name="axes_default_lookup"  type="AxesDefaultLookupType" minOccurs="0"/>
        <xs:element name="system_axes"          type="SystemAxesType" minOccurs="0"/>
        <xs:element name="workloads"            type="xs:string"/>
        <!-- KERN #48-S5: datasets jetzt OPTIONAL (v2) - eine reine Achsen-KERN-golden braucht keine Mess-Inputs. -->
        <xs:element name="datasets"             type="DatasetsType" minOccurs="0"/>
        <!-- KERN-A: measurement_tooling = die Mess-Tooling-HAUPT-Achse (auffaechernd; vor der UNTER-Achse
             measurement_categories). OPTIONAL; Abwesenheit = Default [all] (1 Voll-Konfig, byte-stabil). -->
        <xs:element name="measurement_tooling"  type="MeasurementToolingType" minOccurs="0"/>
        <!-- KERN-A: measurement_categories jetzt OPTIONAL (minOccurs=0). Abwesenheit = alle 16 Kategorien. -->
        <xs:element name="measurement_categories" type="MeasurementCategoriesType" minOccurs="0"/>
        <!-- A9.1 (S4-Delta B9 Mess-Schema-Kern, 2026-07-20): drei PASSIVE Mess-UNTER-Achsen (Planer-delegiert,
             binary_id-NEUTRAL). Strukturell wie measurement_tooling: der Code-Parser validiert die ids gegen die
             3 constexpr-Registries (run_methodology/measurement_framework/writeback_method_registry.hpp); die XSD
             kann die Registry-Namen nicht kennen (Single-Source im Code); nur strukturell. Alle OPTIONAL;
             Abwesenheit = Default (byte-identisch).
             KERN #48-S5 (v2): run_methodology traegt fuer v2 GENAU EINE <method> (exactly-one je Call/Profil,
             Section 61-STUFEN). Das XSD kann "genau eine" strukturell nicht v2-selektiv erzwingen (der Ist-Parser
             + validate_experiment_profile sind die Autoritaet: validate meldet size>1 als Fehler); hier nur die
             Struktur. Der vierte Methoden-Wert 'compare' (Replay-Sichten-Vergleich) ist die Reserve fuer #47 -
             in #48 KEIN Registry-Eintrag, nur diese Kommentar-Reserve. -->
        <xs:element name="run_methodology"      type="RunMethodologyType" minOccurs="0"/>
        <!-- HY-D2 KOMMENTAR-RESERVE (Owner-E1, 2026-08-02): <hybrid_tier> ist der reservierte Platz der
             HYBRID-TIER-STUFE (eigene Stufe hinter der CEB; N ABI-stabile Pruef-Docks; Factory-Pattern-Proxy
             auf die plain Tier-Binaries; std::variant NUR als Traeger der Dock-Typ- und Vertrags-Varianz in
             einem wahlweise statischen oder Runtime-Dock-Array, Dock-Anzahl dynamisch). Der Platz lebt HEUTE
             ausschliesslich als diese Kommentar-Reserve, exakt nach dem COMPARE-Muster (der Modus 'compare'
             lebte erst als XSD-Kommentar-Reserve, dann als Registry-Typ; run_methodology_registry.hpp:7
             dokumentiert den Weg). KEIN Typ, KEIN Parser, KEIN Registry-Eintrag, KEIN Byte-Effekt: alle
             Bestands-XMLs bleiben unveraendert valide.
             SOLL-Form (kommt mit Paket HY-B3 als optionales Element vom Typ HybridTierType, minOccurs=0,
             GENAU HIER in der Root-Sequenz zwischen run_methodology und measurement_framework):
               hybrid_tier@enabled@genus
                 dock_array@storage=static|runtime  (storage=static setzt NUR die Compile_Time_Kapazitaet
                                                     max_docks; die Belegung bleibt in beiden Formen dynamisch)
                 eviction@strategy@ram_budget_mb
                 docks/dock@id@contract  mit  tier_binary@select=binary_id|heuristic
                 router/break_even@source@curves
             Die 'Zwischenloesung' des Owners bildet sich exakt ab: dock@contract ist die STATISCHE Seite
             (Dock-Typ je Slot steht nach Konfiguration fest), tier_binary@select die AUSTAUSCHBARE Seite
             (plain Binary je Pruefdock swappbar unter Verdraengung). contract- und strategy-Token kommen NUR
             aus constexpr-Registries im Code (Registry ist ANGEBOT, kein Runtime-Switch); die Validierung ist
             der C++-Validator validate_profile.hpp, nicht das XSD.
             Autoritaet: docs/sessions/20260802-OWNER-entscheide-hybrid-tier-stempel-regression-os-unterachsen.md:7;
             Design: ce docs/architecture/20260802-hybrid_tier_stufe_soll_design.md Abschnitt 4. -->
        <xs:element name="measurement_framework" type="MeasurementFrameworkType" minOccurs="0"/>
        <xs:element name="writeback_methods"    type="WritebackMethodsType" minOccurs="0"/>
        <xs:element name="op_types"             type="OpTypeListType"/>
        <xs:element name="output"               type="OutputType"/>
      </xs:sequence>
      <!-- KERN #48-S5: version-Attribut Pflicht, aber NICHT mehr fixed="1" - v2 = das KERN-Fundament
           (comdare_experiment v2, experiment_golden_kern.xml). v1 = Interim-Legacy (Abgabe-Kette, Scheibe 6). -->
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="id"      type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- metadata: name + mode (defined | full | full_sampled) -->
  <xs:complexType name="MetadataType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="mode">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="defined"/>
            <xs:enumeration value="full"/>
            <xs:enumeration value="full_sampled"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- KERN-A (S4, 2026-07-20): template = der Research-Gesamtalgorithmus-Load. mode="full" = starte von der VOLLEN
       Whitelist aller Achsen + je Achse restrict/extend via axes_default_lookup (der HEUTE funktionierende Pfad).
       ref = benanntes Paper-Template-Profil; die ce-/prt-Registries fuehren die Paper-Templates NOCH NICHT (post-v3)
       => ein unbekannter ref faellt tolerant auf full zurueck (der Code-Parser prueft ref NICHT hart). -->
  <xs:complexType name="TemplateType">
    <xs:attribute name="ref"  type="xs:string" use="optional"/>
    <xs:attribute name="mode" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- execution_engines: GENAU 2 (ee_ce + ee_prt), jede mit registry-Referenz -->
  <xs:complexType name="ExecutionEnginesType">
    <xs:sequence>
      <xs:element name="engine" minOccurs="2" maxOccurs="2">
        <xs:complexType>
          <xs:attribute name="id"       type="xs:string" use="required"/>
          <xs:attribute name="type"     type="xs:string" use="required"/>
          <xs:attribute name="registry" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- KERN #48-S5 (Section 62-C/D/E): machines = die Maschinen-MENGE. Der Identitaets-KERN (cpu_fabrication +
       ram_pair) ist Pflicht (validate prueft den SCHLUESSEL, nicht den Namen); hostname_hint ist ein optionaler
       Hinweis. Die XSD haelt die Struktur; die Nicht-Leere des Schluessels prueft validate_experiment_profile.

       O-8 Schritt 5 (Paket O-4b, Ledger 70.6 / RF-6): <machines> ist der DEKLARATIONS-KANAL der drei festen
       Glieder der Komplex-Haupt-System-Achse target_isa (Owner: "feste Rekombination aus RAM-Frequenz und CAS
       und CPU-Fabrikation"). Die beiden RAM-seitigen Glieder treten hier ADDITIV und OPTIONAL ein:
         ram_frequency_mhz  = Datenrate in MT/s als ganze Zahl (Einheit im Namen; z.B. 5600 fuer DDR5-5600)
         cas_latency_cl     = CAS-Latenz als reine CL-Zahl (z.B. 36); wahre Latenz ns = CL x 2000 / MT-Rate
       Das DRITTE Glied (CPU-Fabrikation) bekommt hier KEIN eigenes Attribut: es ist das O-4a-Kern-Tupel
       vendor/family/model/stepping, das compile-time in machine_identity.hpp (MachineCoreCpuId) deklariert
       und ueber den bestehenden Schluessel cpu_fabrication + ram_pair aufgeloest wird. Das Attribut
       cpu_fabrication bleibt damit unveraendert das SYMBOLISCHE Etikett des Identitaets-Schluessels
       (machine_identity.hpp Herkunfts-Block); es traegt NICHT das Tupel, sonst braeche der Schluessel.

       ABWESEND = NICHT DEKLARIERT (nicht 0 MHz / nicht CL0). Beide Attribute sind optional, damit eine
       Maschine ehrlich unvollstaendig deklariert sein darf, statt erfundene Werte zu tragen; die
       Nachdeklaration ist rein additiv. ram_pair BLEIBT (Additiv-Doktrin): es ist Teil des Schluessels und
       traegt die Bestueckung, die aus Frequenz und CAS nicht hervorgeht.

       A14/OS-U2 (Owner-Entscheid E3 vom 02.08.2026): <machines> ist zusaetzlich der ERWARTUNGS-Kanal der
       drei operating_system-UNTER-Achsen (ce measurement/operating_system_sub_axes.hpp). Sie treten hier
       ADDITIV und OPTIONAL ein:
         os_version = Distributions-/Release-Identitaet der OS-INSTANZ innerhalb ihrer Familie
                      (z.B. "debian-13", "windows-server-2022", "macos-15.5")
         kernel     = Kernel-Release der Instanz (z.B. "6.17.0-35-generic")
         build      = OS-Build-/Patch-Stand INKLUSIVE Update-Zustand (Owner E-12: "Wir mergen den Update
                      Zustand in Build"); es gibt AUSDRUECKLICH kein viertes update_status-Attribut
         os_declaration_source = Herkunfts-Notiz der drei Werte (Muster ram_frequency_source; sie reist
                      nur mit deklarierten Werten mit)
       ERWARTUNG, NICHT WERTE-QUELLE: die Werte werden je Lauf auf der Maschine ERHOBEN (Owner-KERN 27.07.,
       "HW-Werte nie statisch"); was hier steht, ist der Soll-Wert fuer den Cross-Check. ABWESEND = NICHT
       DEKLARIERT (nicht "leeres OS"). Die OS-FAMILIE (linux/windows/macos) steht NICHT hier: sie ist die
       Haupt-Achse und wird einkompiliert und gestempelt.
       ABGRENZUNG build: das ist der OS-Patch-Stand, NICHT die build_version (Ledger 70.6) und NICHT der
       build_type des Suffix-Segments "+bt=". -->
  <xs:complexType name="MachinesType">
    <xs:sequence>
      <xs:element name="machine" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id"                    type="xs:string"      use="required"/>
          <xs:attribute name="cpu_fabrication"       type="xs:string"      use="required"/>
          <xs:attribute name="ram_pair"              type="xs:string"      use="required"/>
          <xs:attribute name="hostname_hint"         type="xs:string"      use="optional"/>
          <xs:attribute name="ram_frequency_mhz"     type="xs:unsignedInt" use="optional"/>
          <xs:attribute name="cas_latency_cl"        type="xs:unsignedInt" use="optional"/>
          <xs:attribute name="os_version"            type="xs:string"      use="optional"/>
          <xs:attribute name="kernel"                type="xs:string"      use="optional"/>
          <xs:attribute name="build"                 type="xs:string"      use="optional"/>
          <xs:attribute name="os_declaration_source" type="xs:string"      use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- lebewesen: die gemessenen Tiere (base_tier-ids) -->
  <xs:complexType name="LebewesenType">
    <xs:sequence>
      <xs:element name="tier" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- phases: die Phasen. merge = MergeStrategy-Enum (Stufe1/2/3). KEIN baustein.
       KERN-A (S4, 2026-07-20): <phases> ist OPTIONAL (Element minOccurs=0 in comdare_experiment) - Abwesenheit =>
       der Planer LEITET die 3 Default-Stufen ab. Ist <phases> PRAESENT, traegt es 1..unbounded <phase> (vorher genau
       3); explizite Phasen sind der Override (byte-identisch zum Ist). -->
  <xs:complexType name="PhasesType">
    <xs:sequence>
      <xs:element name="phase" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="merge" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="Stufe1_CeOnly"/>
                <xs:enumeration value="Stufe2_PrueflingReplace"/>
                <xs:enumeration value="Stufe3_FullJoin"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <!-- Genau eine von engine (Einzel-EE) / engines (Whitespace-Liste). -->
          <xs:attribute name="engine"    type="xs:string" use="optional"/>
          <xs:attribute name="engines"   type="xs:string" use="optional"/>
          <xs:attribute name="pruefling" type="xs:string" use="optional"/>
          <!-- KERN #48-S5 (Section 59-C): id_namespace = der eigene id-Satz je Merge-Phase (3. Tier-Binary-Stempel;
               auch die Merge-Kombination bekommt einen id-Namensraum). Optional; sinnvoll nur auf einer Phase mit
               pruefling (validate warnt sonst). Konsum = K6a/#37 (Stempel-Materialisierung); hier nur Struktur. -->
          <xs:attribute name="id_namespace" type="xs:string" use="optional"/>
          <!-- KERN-A (S4): identity = optionaler CacheEngine-self-Marker ("CacheEngine"/self). Der Code-Parser
               liest es roh; die Semantik-Pruefung ("CacheEngine"/self) macht validate_profile. -->
          <xs:attribute name="identity"  type="xs:string" use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- KERN-A (S4, 2026-07-20): measurement_tooling = die Mess-Tooling-HAUPT-Achse (auffaechernd, Section 47/55).
       Je <combo tools=".."/> EINE Tooling-KONFIG (Whitespace-Liste aus {wallclock/macro/micro}). Der Code-Parser
       validiert die ids gegen kMeasurementToolingRegistry (die XSD kann die Registry-Namen nicht kennen; nur
       strukturell). Leer/abwesend = Default [all] (1 Voll-Konfig). -->
  <xs:complexType name="MeasurementToolingType">
    <xs:sequence>
      <xs:element name="combo" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="tools" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- A9.1 (S4-Delta B9 Mess-Schema-Kern, 2026-07-20): run_methodology = die Run-Methodik-UNTER-Achse
       {debug/measure/release}. Je <method value=".."/> EINE Methode. Der Code-Parser validiert die ids gegen
       kRunMethodologyRegistry (die XSD ist nur strukturell; Single-Source im Code). Leer/abwesend = Default. -->
  <xs:complexType name="RunMethodologyType">
    <xs:sequence>
      <xs:element name="method" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- A9.1: measurement_framework = die Mess-Framework-UNTER-Achse (einzeln; heute {ycsb}, honest-1). Der
       Code-Parser validiert name gegen kMeasurementFrameworkRegistry (XSD nur strukturell). Abwesend = Default. -->
  <xs:complexType name="MeasurementFrameworkType">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- A9.1: writeback_methods = die Rueckschrieb-Methoden-UNTER-Achse {csv/latex_table/comparison_metrics}
       (ehrliche Formalisierung des <output>-Trios; KEIN pdf). Je <method value=".."/> EIN Kanal. Der Code-Parser
       validiert die ids gegen kWritebackMethodRegistry (XSD nur strukturell). Leer/abwesend = Default. -->
  <xs:complexType name="WritebackMethodsType">
    <xs:sequence>
      <xs:element name="method" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- axes_default_lookup: NEGATIVES Blacklisting = reines LIMIT. Doku-Semantik: eine UNGENANNTE Achse expandiert
       zur VOLLEN Registry-Liste ("alles messen" = Default); nur die GENANNTEN Achsen tragen einen Override. axis
       ref = Registry-axis-id. allowed_variants = optionale Whitespace-Liste von Registry-baustein-name-Werten
       (Teilmenge; ABWESEND = keine Einschraenkung dieser Achse ueber die Voll-Sweep-Basis hinaus).
       KERN #48-S5 (v2): allowed_variants + enabled sind jetzt OPTIONAL (der KERN benennt nur Abweichungen). -->
  <xs:complexType name="AxesDefaultLookupType">
    <xs:sequence>
      <xs:element name="axis" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="ref"              type="xs:string" use="required"/>
          <xs:attribute name="allowed_variants" type="xs:string" use="optional"/>
          <!-- KERN-A (S4) + KERN #48-S4/S5: per-Achse Merge-Modus fuer die Pruefling-Komposition. Abwesend/leer =
               replace-Default (byte-identisch); "merge" = additiver Zusammenschluss; "fulljoin" = die EXPLIZITE,
               Phase-3-gebundene Union (Verdikt V-a). Der Code-Parser prueft {replace,merge,fulljoin} + die
               fulljoin-Phase-3-Bindung (validate_profile); die XSD ist nur strukturell. -->
          <xs:attribute name="merge"            type="xs:string" use="optional"/>
          <!-- KERN #48-S4 (Section 59-C/D): per-Achse Pruefling-Wahl (engine-id / lebewesen-id / self-Marker).
               Optional; leer = Fallback auf die Phasen-Identitaet. -->
          <xs:attribute name="pruefling"        type="xs:string" use="optional"/>
          <!-- A9b (P6, 2026-07-26): EXPLIZITE Abwahl statt Abwahl-durch-Abwesenheit. Die Registry ist ein ANGEBOT
               (§27); eine Achse wird hier ausdruecklich an- bzw. abgewaehlt, statt still zu fehlen. Das
               unterscheidet "nicht genannt" (= volle Registry-Liste, unveraendert) von "genannt und
               abgewaehlt". ABWESEND == "true", damit alle Bestands-Profile unveraendert gueltig bleiben.
               Das Attribut ist heute DEKLARATIV: der Parser LIEST es, der Resolver TRAEGT es (validate_profile,
               Ueberladung resolve_axis_refs_against_trio), aber NIEMAND wertet es aus. Grund: ein wirksames
               active="false" entfernte einen Baustein aus der Katalog-Kardinalitaet und verschoebe damit den
               golden-CRC; der auswertende Verbraucher (declared_count) gehoert in das Lane-F-Byte-Fenster.
               Kein Default-Wert in der XSD (die Datei fuehrt bewusst keine Schema-Defaults; die
               Abwesenheits-Semantik steht im Code). Lexikalisch gelten die xs:boolean-Werte true/false/1/0. -->
          <xs:attribute name="active"           type="xs:boolean" use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="enabled" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <!-- system_axes: CEB-System-Achsen — konform zur V35-Tabelle §2.1: Haupt-Achse → Unter-Achse → Optionen.
       binary_id-NEUTRAL (opt_level/simd sind system_config, stehen NIE in kCompositionAxisNames; Provenienz
       build_version/H-10-Sidecar). Haupt-Achse 'compiler' traegt die Unter-Achse 'opt_level' (EIN Container),
       deren <option>-Kinder die Stufen O0..Ofast tragen (Optionen der Unter-Achse, KEINE eigenen Achsen).
       Haupt-Achse 'external_utils' (6., Q2 Option C) traegt die Unter-Achse 'simd' (EIN Container), deren
       <option>-Kinder die Auspraegungen no_extension/avx2/avx512 tragen (symmetrisch zu compiler/opt_level).
       Alles additiv (minOccurs=0); leer = CEB-Default (O3/no_extension).
       Der Planer permutiert die Optionen SELBST (opt-g). -->
  <xs:complexType name="SystemAxesType">
    <xs:sequence>
      <xs:element name="compiler" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="opt_level" minOccurs="0">              <!-- Unter-Achse 15.2: EIN Container -->
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="option" minOccurs="0" maxOccurs="unbounded">  <!-- Optionen O0..Ofast -->
                    <xs:complexType>
                      <xs:attribute name="value" use="required">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:enumeration value="O0"/>
                            <xs:enumeration value="O1"/>
                            <xs:enumeration value="O2"/>
                            <xs:enumeration value="O3"/>
                            <xs:enumeration value="Ofast"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <!-- A4 (S2/A2-Nachzug, 2026-07-20): atomic128 = ZWEITE Unter-Achse unter compiler (INC-0-Ruling:
                 -mcx16/CMPXCHG16B ist ein Compiler-Codegen-Flag, KEIN optionales ISA-Feature). EIN Container,
                 symmetrisch zu opt_level; die <option>-Werte tragen no_cx16/cx16. binary_id-NEUTRAL, additiv. -->
            <xs:element name="atomic128" minOccurs="0">             <!-- Unter-Achse: EIN Container -->
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="option" minOccurs="0" maxOccurs="unbounded">  <!-- Optionen no_cx16/cx16 -->
                    <xs:complexType>
                      <xs:attribute name="value" use="required">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:enumeration value="no_cx16"/>
                            <xs:enumeration value="cx16"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="external_utils" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="simd" minOccurs="0">              <!-- Unter-Achse (6.x): EIN Container, symmetrisch zu opt_level -->
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="option" minOccurs="0" maxOccurs="unbounded">  <!-- Optionen no_extension/avx2/avx512 -->
                    <xs:complexType>
                      <xs:attribute name="value" use="required">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:enumeration value="no_extension"/>
                            <xs:enumeration value="avx2"/>
                            <xs:enumeration value="avx512"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- A4 (S2/A2-Nachzug, 2026-07-20): target_isa = EIGENE Haupt-System-Achse (Ziel-ISA fuer Cross-Compile,
           INC-2d; isa verliess mit INC-2d die Komposition, 18->17). KEINE Unter-Achse -> die <option>-Werte
           stehen DIREKT unter <target_isa> (kein Zwischen-Container, im Gegensatz zu compiler/opt_level).
           binary_id-NEUTRAL, additiv; leer = CEB-Default x86_64 (host==target). -->
      <!-- O-2 ENTSCHIEDEN / Lane A (c), 26.07.2026: target_isa bekommt UNTER-ACHSEN. Bisher standen unter
           <target_isa> ausschliesslich die <option>-Werte der Haupt-Achse; die vereinbarten Unter-Achsen
           (D2.6: numa_node + page, parent="target_isa") hatten GAR KEINEN XML-Kanal - das Angebot war
           unerreichbar (BLOCKER-4, mit O-2 aufgehoben).
           STRUKTUR: die Unter-Achsen folgen dem compiler/opt_level-Muster (Container + <option value=..>),
           NICHT dem target_isa-Muster (Werte direkt darunter) - denn genau diese Unterscheidung Haupt-vs-
           Unter ist hier die Aussage. Alle neuen Elemente sind minOccurs="0" und stehen HINTER <option>:
           bestehende Profile bleiben damit unveraendert valide (xs:sequence, nur Anhang).
           ADDITIV ERWEITERBAR, ABER NICHT VORWEGGEBAUT (RF-6, Ledger 70.6): die target_isa-GLIEDER
           (RAM-Frequenz / CAS / CPU-Fabrikation) werden JE MASCHINE deklariert und wirken NUR auf die
           Stempel-Identitaet. Sie sind hier BEWUSST NICHT modelliert - wenn ihr Owner-Entscheid steht,
           werden sie als weitere optionale Elemente an DIESE sequence angehaengt (Muster
           machine_signatures), ohne ein bestehendes Dokument zu brechen. Diese sequence ist deshalb
           absichtlich offen gelassen und nicht auf die zwei Unter-Achsen verengt.
           binary_id-NEUTRAL: System-Achsen tragen binary_id="never"; kein Konsument liest die neuen
           Knoten in diesem Paket (Parser fuellt nur den POD). -->
      <xs:element name="target_isa" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="option" minOccurs="0" maxOccurs="unbounded">  <!-- Optionen x86_64/aarch64 -->
              <xs:complexType>
                <xs:attribute name="value" use="required">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:enumeration value="x86_64"/>
                      <xs:enumeration value="aarch64"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <!-- Unter-Achse numa_node (D2.6; Spiegel des Organ-Members alloc_hw.numa_node). Werte-Bereich
                 BEWUSST als offener xs:string und NICHT als Enumeration: die zulaessige Menge haengt an der
                 Maschine (Node-Zahl ist nicht compile-statisch erkennbar) und wird vom Resolver gegen das
                 Registry-ANGEBOT geprueft, nicht vom Schema. Eine Enumeration hier waere eine Zusage, die
                 das Schema nicht halten kann. -->
            <xs:element name="numa_node" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="option" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="value" type="xs:string" use="required"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <!-- Unter-Achse page (D2.6; Spiegel des Organ-Members alloc_hw.page). Ebenfalls offener
                 xs:string - die Seitengroessen-Freigabe ist eine System-Capability (page_topology 4k/2m/1g),
                 ihre Durchsetzung liegt organ-seitig im AllocPageHint-NTTP. NICHT "page_type" benennen:
                 axis_01_page_type ist der Baum-Knoten-PageKind und eine ANDERE Achse (Namensfalle,
                 Bauplan D2.6 / IV-BLOCKER-5). -->
            <xs:element name="page" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="option" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="value" type="xs:string" use="required"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- datasets: Single-Source Referenzen auf die test_data-AKTEN (kein
       test_data_sets.xml-Doppelquelle). -->
  <xs:complexType name="DatasetsType">
    <xs:sequence>
      <xs:element name="dataset" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id"       type="xs:string" use="required"/>
          <xs:attribute name="akte_ref" type="xs:string" use="required"/>
          <xs:attribute name="loader"   type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- measurement_categories: Spalten-PROJEKTION. name = exakt der Enum-Name aus
       kAllMeasurementCategories (measurement_category.hpp, 16 Kategorien).
       KERN-A (S4, 2026-07-20): category minOccurs=0 (vorher 1) - ein leeres <measurement_categories/> ODER
       ein fehlendes Element = alle 16 Kategorien (statt Fehler). -->
  <xs:complexType name="MeasurementCategoriesType">
    <xs:sequence>
      <xs:element name="category" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="CLU"/>
                <xs:enumeration value="CACHE_MISS_L1"/>
                <xs:enumeration value="CACHE_MISS_L2"/>
                <xs:enumeration value="CACHE_MISS_L3"/>
                <xs:enumeration value="DTLB_MISS"/>
                <xs:enumeration value="MEMORY_FOOTPRINT"/>
                <xs:enumeration value="BRANCH_MISS"/>
                <xs:enumeration value="IPC_CPI"/>
                <xs:enumeration value="LATENCY_MEAN"/>
                <xs:enumeration value="LATENCY_P50"/>
                <xs:enumeration value="LATENCY_P95"/>
                <xs:enumeration value="LATENCY_P99"/>
                <xs:enumeration value="LATENCY_P999"/>
                <xs:enumeration value="THROUGHPUT"/>
                <xs:enumeration value="ENERGY_J"/>
                <xs:enumeration value="FILL_BUFFER_OCCUPANCY"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- op_types: Whitespace-Liste von OP-1..OP-6. -->
  <xs:simpleType name="OpTypeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OP-1"/>
      <xs:enumeration value="OP-2"/>
      <xs:enumeration value="OP-3"/>
      <xs:enumeration value="OP-4"/>
      <xs:enumeration value="OP-5"/>
      <xs:enumeration value="OP-6"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OpTypeListType">
    <xs:list itemType="OpTypeType"/>
  </xs:simpleType>

  <!-- output: Zielpfade + comparison_metrics (boolean) + storage-Slot.
       KERN #48-S5 (v2): comparison_metrics jetzt OPTIONAL (das writeback_methods-Trio ist die ehrliche v2-
       Formalisierung); storage (Section 59-C-Slot) ist INERT deklariert (Konsum K7b/K8 post-Abgabe). -->
  <xs:complexType name="OutputType">
    <xs:sequence>
      <xs:element name="binary_path"        type="xs:string"/>
      <xs:element name="csv_path"           type="xs:string"/>
      <xs:element name="latex_path"         type="xs:string"/>
      <xs:element name="comparison_metrics" type="xs:boolean" minOccurs="0"/>
      <!-- KERN #48-S4/S5: <storage backend="local|minio" endpoint=".."/>. backend-Enum-Pruefung + minio-endpoint-
           Warnung leben in validate_experiment_profile; die XSD haelt die Struktur. Abwesend = kein Storage-Slot. -->
      <xs:element name="storage" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="backend"  type="xs:string" use="required"/>
          <xs:attribute name="endpoint" type="xs:string" use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
