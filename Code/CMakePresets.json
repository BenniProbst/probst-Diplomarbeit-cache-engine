{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "COMDARE_V32_ENABLE": "ON",
        "COMDARE_BUILD_PERMUTATIONS": "ON",
        "COMDARE_PRT_ART_BUILD_PERMUTATIONS": "ON",
        "COMDARE_PERMUTATION_MODE": "on_build_on_demand",
        "COMDARE_PRT_ART_PERMUTATION_MODE": "on_build_on_demand",
        "COMDARE_PERMUTATION_PROFILE": "smoke",
        "COMDARE_PRT_ART_PERMUTATION_PROFILE": "smoke"
      }
    },
    {
      "name": "_msvc_base",
      "hidden": true,
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (Diplomarbeit Default-Entwicklung)",
      "inherits": "_msvc_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (Diplomarbeit Vollausbau)",
      "inherits": "_msvc_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-minsizerel",
      "displayName": "MSVC MinSizeRel",
      "inherits": "_msvc_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo (Profiling)",
      "inherits": "_msvc_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "_ninja_mingw_base",
      "hidden": true,
      "inherits": "_base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-mingw-debug",
      "displayName": "Ninja MinGW Debug (CLion-Default)",
      "inherits": "_ninja_mingw_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-mingw-release",
      "displayName": "Ninja MinGW Release",
      "inherits": "_ninja_mingw_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ninja-mingw-minsizerel",
      "displayName": "Ninja MinGW MinSizeRel",
      "inherits": "_ninja_mingw_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },
    {
      "name": "ninja-mingw-relwithdebinfo",
      "displayName": "Ninja MinGW RelWithDebInfo",
      "inherits": "_ninja_mingw_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release (Linux)",
      "inherits": "_base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ninja-gcc-release",
      "displayName": "Ninja GCC Release (Linux)",
      "inherits": "gcc-release",
      "generator": "Ninja"
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release (Linux)",
      "inherits": "_base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "gcc-release-measurement-on",
      "displayName": "GCC Release MEASUREMENT_ON (PL-4/L6: V32-Antrieb + W4-Gate-Tests)",
      "description": "PL-4 (L6, 2026-07-19): offizieller Preset-Einstieg fuer das Mess-Kompilat statt Hand-Flags. COMDARE_V32_DRIVER_ENABLE=ON baut test_v32_katalog_driver + test_v32_messreihe_antrieb FRISCH mit COMDARE_MEASUREMENT_ON=1 (Code/02_messung_driver/CMakeLists.txt); COMDARE_MEASUREMENT_MODE=ON pinnt den ce-Mess-Master explizit (Default ON). Golden-neutral: additives Preset, Default-Presets unveraendert.",
      "inherits": "gcc-release",
      "cacheVariables": {
        "COMDARE_V32_DRIVER_ENABLE": "ON",
        "COMDARE_MEASUREMENT_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",                "configurePreset": "msvc-debug",                "configuration": "Debug" },
    { "name": "msvc-release",              "configurePreset": "msvc-release",              "configuration": "Release" },
    { "name": "msvc-minsizerel",           "configurePreset": "msvc-minsizerel",           "configuration": "MinSizeRel" },
    { "name": "msvc-relwithdebinfo",       "configurePreset": "msvc-relwithdebinfo",       "configuration": "RelWithDebInfo" },
    { "name": "ninja-mingw-debug",         "configurePreset": "ninja-mingw-debug" },
    { "name": "ninja-mingw-release",       "configurePreset": "ninja-mingw-release" },
    { "name": "ninja-mingw-minsizerel",    "configurePreset": "ninja-mingw-minsizerel" },
    { "name": "ninja-mingw-relwithdebinfo","configurePreset": "ninja-mingw-relwithdebinfo" },
    { "name": "gcc-release",               "configurePreset": "gcc-release" },
    { "name": "ninja-gcc-release",         "configurePreset": "ninja-gcc-release" },
    { "name": "clang-release",             "configurePreset": "clang-release" },
    { "name": "gcc-release-measurement-on","configurePreset": "gcc-release-measurement-on" }
  ],
  "testPresets": [
    { "name": "msvc-debug",                "configurePreset": "msvc-debug",                "configuration": "Debug",          "output": { "outputOnFailure": true } },
    { "name": "msvc-release",              "configurePreset": "msvc-release",              "configuration": "Release",        "output": { "outputOnFailure": true } },
    { "name": "msvc-minsizerel",           "configurePreset": "msvc-minsizerel",           "configuration": "MinSizeRel",     "output": { "outputOnFailure": true } },
    { "name": "msvc-relwithdebinfo",       "configurePreset": "msvc-relwithdebinfo",       "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "ninja-mingw-debug",         "configurePreset": "ninja-mingw-debug",         "output": { "outputOnFailure": true } },
    { "name": "ninja-mingw-release",       "configurePreset": "ninja-mingw-release",       "output": { "outputOnFailure": true } },
    { "name": "gcc-release",               "configurePreset": "gcc-release",               "output": { "outputOnFailure": true } },
    { "name": "gcc-release-measurement-on","configurePreset": "gcc-release-measurement-on","output": { "outputOnFailure": true } }
  ]
}
