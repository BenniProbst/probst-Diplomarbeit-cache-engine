{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (Visual Studio 17 2022)",
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": "msvc-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja MSVC Release",
      "inherits": "_base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "COMDARE_V32_ENABLE": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja MSVC Debug",
      "inherits": "ninja-msvc-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "COMDARE_V32_ENABLE": "ON" }
    },
    {
      "name": "ninja-mingw-debug",
      "displayName": "Ninja MinGW Debug (CLion-Default)",
      "inherits": "_base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COMDARE_V32_ENABLE": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release (Linux)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ninja-gcc-release",
      "displayName": "Ninja GCC Release (Linux)",
      "inherits": "gcc-release",
      "generator": "Ninja"
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release (Linux)",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release",      "configurePreset": "msvc-release",      "configuration": "Release" },
    { "name": "msvc-debug",        "configurePreset": "msvc-debug",        "configuration": "Debug" },
    { "name": "ninja-msvc-release","configurePreset": "ninja-msvc-release" },
    { "name": "ninja-msvc-debug",  "configurePreset": "ninja-msvc-debug" },
    { "name": "ninja-mingw-debug", "configurePreset": "ninja-mingw-debug" },
    { "name": "gcc-release",       "configurePreset": "gcc-release" },
    { "name": "ninja-gcc-release", "configurePreset": "ninja-gcc-release" },
    { "name": "clang-release",     "configurePreset": "clang-release" }
  ],
  "testPresets": [
    { "name": "msvc-release",      "configurePreset": "msvc-release",      "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ninja-msvc-release","configurePreset": "ninja-msvc-release","output": { "outputOnFailure": true } },
    { "name": "ninja-mingw-debug", "configurePreset": "ninja-mingw-debug", "output": { "outputOnFailure": true } },
    { "name": "gcc-release",       "configurePreset": "gcc-release",       "output": { "outputOnFailure": true } }
  ]
}
