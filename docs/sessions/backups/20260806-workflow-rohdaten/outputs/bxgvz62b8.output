    COMDARE_CMAKE_CONFIGURE_FLAGS: "-G Ninja -DCOMDARE_V32_ENABLE=ON"
    COMDARE_CMAKE_BUILD_TARGET: "comdare_da_tools"

lint:secrets:
  extends: .lint-secrets
  tags: [baremetal]
  # #53-Haertung (21.07.): explizite Immer-rules — lint:secrets ist der EINZIGE Pflicht-Job jeder Welle
  # (Token-Risiko je Commit, auch docs-only). Befund 12012: docs-only-Welle entstand LEER-failed; diese
  # rules stellen sicher, dass die Minimal-Welle existiert und GRUEN werden kann.
  rules:
    - when: on_success
  variables:
    GIT_SUBMODULE_STRATEGY: none
lint:format:
  extends: [.lint-format, .code-rules]   # #53: docs-only-Gate (Tool-Cache aus .lint-format bleibt)
  tags: [baremetal]
  variables:
    GIT_SUBMODULE_STRATEGY: none
lint:static:
  extends: [.lint-static, .code-rules]   # #53: docs-only-Gate (Tool-Cache aus .lint-static bleibt)
  tags: [baremetal]
  variables:
    GIT_SUBMODULE_STRATEGY: none

# ── Stufe 3: Test (aus ci-templates .test) — super-eigene Unit-Suite (11 Code/tests + 4 Stufen-Fixtures) ──
# User-Direktive 06.07.: strikt grün = Tests NIE manual/auslassen → automatisch + HART (kein allow_failure;
# lokal g++-bewiesen vor Scharfschaltung). Scope = Sammel-Target comdare_da_unit_tests + ctest -L da_unit —
# bewusst NICHT Target "all": das zöge die komplette ce-Suite (888 Targets) doppelt, die ihr EIGENES
# test:unit im ce-Repo hat (dort advisory bis 58er-Fix-Strecke/264-d).
test:unit:
  extends: [.test, .code-rules, .ccache-pull]   # #53: docs-only-Gate + ccache pull-only (Konsument)
  # OP-2 (D3-Plan, 27.07.; Herleitung korrigiert nach CiCheck-Messung 13570): die Vorlage .test aus
  # den zentralen ci-templates (base-pipeline.yml) bringt needs:[] mit -- test:unit war dadurch
  # stage-frei und startete in 4/4 gemessenen Voll-Wellen VOR verify:submodules (bis 37s Vorsprung),
  # d.h. die Unit-Suite baute los, bevor die Submodul-Verifikation ueberhaupt lief. Das needs hier
  # ueberschreibt das geerbte needs:[] und garantiert die Reihenfolge (Korrektheits-Fix, kein
  # Scheduling-Fix; test:unit liegt nicht auf dem kritischen Pfad der Welle).
  # EXISTENZ-SICHER in BEIDEN Richtungen: test:unit und verify:submodules ziehen ihre rules identisch
  # aus .code-rules => beide existieren in exakt denselben Wellen, das needs haengt nie.
  needs: ["verify:submodules"]
  tags: [baremetal]
  variables:
    COMDARE_TEST_CMAKE_SOURCE_DIR: "Code"
    COMDARE_TEST_CMAKE_BUILD_DIR: "Code/build-test"
    COMDARE_TEST_CONFIGURE_FLAGS: "-DCOMDARE_DA_BUILD_TESTS=ON -DCOMDARE_V32_ENABLE=ON"
    COMDARE_TEST_BUILD_TARGET: "comdare_da_unit_tests"
    COMDARE_TEST_CTEST_ARGS: "-L da_unit"

# ── Stage orchestrate (REV13, #186 §5.4): Haupt-Pipeline zieht die 3 Modul-Pipelines synchron nach ──
# Jeder trigger startet die EIGENE Pipeline des Submodul-Projekts als downstream multi-project pipeline.
# strategy: depend = dieser Bridge-Job spiegelt den Kind-Pipeline-Status -> Super wird ROT, wenn ein Modul rot ist (= echtes Gate).
# needs: [lint:secrets] = erst nach Supers hartem Secrets-Gate triggern. Projektpfade aus .gitmodules (relative URLs -> comdare/research/<repo>).
trigger:cache-engine:
=== ci/ dir ===
ci
ci/archive
ci/anhang_forward_core.sh
ci/archive/perm-matrix-fallback.yml
