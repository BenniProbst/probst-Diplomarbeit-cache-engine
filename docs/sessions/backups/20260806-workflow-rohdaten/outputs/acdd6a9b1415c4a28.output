{"parentUuid":"39b3c30f-64d1-48f6-9490-47391b14176d","isSidechain":true,"promptId":"70a104d4-41bb-493a-9518-0961c9d23202","agentId":"acdd6a9b1415c4a28","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DK4GwrpriDPKae89GobL6q","type":"tool_result","content":"1\t#pragma once\n2\t// diagram_generator — Diplomarbeit/Code Module\n3\t// C++ Bildgenerator: erzeugt TikZ-Code (kein Python, F-EXTRA-5 konform).\n4\t//\n5\t// REV 7.6 Q3: User-Entscheidung \"TikZ-Code generieren\" — kein Python,\n6\t// A4-Awareness durch direkten LaTeX-Output, Diagramme kommen automatisch\n7\t// im LaTeX-Layout mit korrekter Seitenpositionierung.\n8\t//\n9\t// 3 Plot-Typen:\n10\t//   Bar      — Vergleich diskreter Permutationen\n11\t//   Scatter  — XY-Korrelation (z. B. allocation_size vs. latency)\n12\t//   Heatmap  — 2D-Matrix (z. B. workload × permutation)\n13\t//\n14\t// A4-Seitenformat-Constraints:\n15\t//   width  = 0.95 * \\textwidth   (etwas Rand fuer caption/numbering)\n16\t//   height = 0.40 * \\textheight  (max 40% Seitenhoehe, damit 2 Diagramme\n17\t//                                 + Text auf eine Seite passen)\n18\t\n19\t#include \"csv_to_latex.hpp\" // INC-4: c2l::WideFullRow (trägt den durchgereichten stat_<achse>_<feld>-Block)\n20\t\n21\t// M-4/B16 (2026-07-19): CE-Single-Source der Achsen-Zaehlung und -Namen (Organ-Achsen, ABI-6/INC-2d;\n22\t// die Zahl traegt kV3AxisCount -- KEIN Zaehl-Literal, A-B2/ORG-18).\n23\t// KEINE eigenen Zaehl-Literale mehr: das fruehere kSegmentCount=20 (19 Organ + framework, inkl. der nach\n24\t// INC-2c/INC-2d ausgezogenen seg_telemetry_ns/seg_isa_ns) liess has_seg_ns gegen die 17-Achsen-WIDE-CSV\n25\t// dauerhaft false werden -> seg_attribution.tex wurde NIE erzeugt.\n26\t#include \"anatomy/observable_tier.hpp\"                         // kV3AxisCount = 17 (die EINE Zaehl-Quelle)\n27\t#include \"builder/experiment_tree/axis_path_serialization.hpp\" // kCompositionAxisNames (Namen + Reihenfolge)\n28\t\n29\t#include <array>\n30\t#include <cstddef>\n31\t#include <cstdint>\n32\t#include <filesystem>\n33\t#include <span>\n34\t#include <string>\n35\t#include <string_view>\n36\t#include <utility>\n37\t#include <vector>\n38\t\n39\tnamespace comdare::da::diagram_generator {\n40\t\n41\tinline constexpr int status_ok          = 0;\n42\tinline constexpr int status_io_error    = 10;\n43\tinline constexpr int status_empty_input = 11;\n44\t\n45\t// A4-Seitenformat-Constraints\n46\tstruct PageConstraints {\n47\t    // TODO-4/#173 (2026-06-20): width_fraction von 0.95 → 0.78 gesenkt. Wurzel des Overfull-Bugs\n48\t    // (184 Boxen, 134 > 10pt): bei `scale only axis` gilt width= NUR fuer die Achsenflaeche; Titel,\n49\t    // Y-Label, Colorbar und rotierte Tick-Labels kommen ZUSAETZLICH dazu → Gesamtbox > \\textwidth.\n50\t    // 0.78 laesst Platz fuer Colorbar + Y-Label. Zusaetzlich kapselt resizebox_wrap (s.u.) das gesamte\n51\t    // tikzpicture hart auf \\textwidth (robust gegen verbleibende Zusatzbreite) — Decorator-Pattern.\n52\t    double      width_fraction    = 0.78; // * \\textwidth  (war 0.95; #173-Breiten-Fix)\n53\t    double      height_fraction   = 0.40; // * \\textheight\n54\t    bool        keep_aspect_ratio = true;\n55\t    std::string position_hint     = \"!htbp\"; // LaTeX-Float-Position\n56\t    // C1 (2026-06-01): nur den tikzpicture-Rumpf emittieren (ohne figure/centering/\n57\t    // caption-Mantel), damit das einbindende Dokument Float, Caption und Label selbst\n58\t    // steuert (z. B. spec-spezifische Anhang-Caption + referenzierbares \\label).\n59\t    bool body_only = false;\n60\t    // TODO-4/#173 (2026-06-20): kapselt das gesamte \\begin{tikzpicture}...\\end{tikzpicture} in\n61\t    // \\resizebox{\\textwidth}{!}{...} (Decorator-Pattern um den Plot-Rumpf). Erzwingt die Gesamt-\n62\t    // breite hart auf \\textwidth UNABHAENGIG von Colorbar/Title/Label-Zusatzbreite → 0 Overfull.\n63\t    // Default true (alle pgfplots-Figuren breiten-sicher). Auf false setzbar, falls ein Aufrufer\n64\t    // die Skalierung selbst steuert.\n65\t    bool resizebox_wrap = true;\n66\t};\n67\t\n68\t// ─────────────────────────────────────────────────────────────────────────────\n69\t// Bar-Chart\n70\t// ─────────────────────────────────────────────────────────────────────────────\n71\tstruct BarChartData {\n72\t    std::string              title;\n73\t    std::string              x_label;\n74\t    std::string              y_label;\n75\t    std::vector<std::string> labels; // X-Achsen-Beschriftung\n76\t    std::vector<double>      values; // Y-Werte (gleicher Index wie labels)\n77\t};\n78\t\n79\t[[nodiscard]] int write_bar_chart(std::filesystem::path const& out, BarChartData const& data,\n80\t                                  PageConstraints const& cnst = {});\n81\t\n82\t// ─────────────────────────────────────────────────────────────────────────────\n83\t// Scatter-Plot\n84\t// ─────────────────────────────────────────────────────────────────────────────\n85\tstruct ScatterData {\n86\t    std::string         title;\n87\t    std::string         x_label;\n88\t    std::string         y_label;\n89\t    std::vector<double> xs;\n90\t    std::vector<double> ys;\n91\t};\n92\t\n93\t[[nodiscard]] int write_scatter_plot(std::filesystem::path const& out, ScatterData const& data,\n94\t                                     PageConstraints const& cnst = {});\n95\t\n96\t// ─────────────────────────────────────────────────────────────────────────────\n97\t// Heatmap (2D-Matrix)\n98\t// ─────────────────────────────────────────────────────────────────────────────\n99\tstruct HeatmapData {\n100\t    std::string                      title;\n101\t    std::string                      x_label;\n102\t    std::string                      y_label;\n103\t    std::vector<std::string>         x_labels;\n104\t    std::vector<std::string>         y_labels;\n105\t    // matrix[y][x]. NaN (quiet_NaN) = Zelle OHNE Messwert (\"nicht ausgefuehrt\"), ausdruecklich NICHT 0.0\n106\t    // -- write_heatmap laesst solche Zellen ueber point meta = nan aus und schreibt als dritte Koordinate\n107\t    // nur den blanken Mesh-Traeger 0 (kein \"0.0000\"), damit die .tex keine 0-ns-Messung behauptet.\n108\t    // Details + die drei pgfplots-Proben, die diese Auslass-Strategie erzwingen: siehe write_heatmap.\n109\t    std::vector<std::vector<double>> matrix;\n110\t    // E-2b/AUSGEFUEHRT-MASKE (2026-08-06) -- executed[y][x] parallel zu matrix[y][x]. Sie traegt die\n111\t    // AUSFUEHRUNGS-Klassifikation (z_field_executed: Zaehler op_<art>_n zuerst, sonst p50>0-Heuristik) bis\n112\t    // in den Writer. Ohne sie musste write_heatmap \"gemessen\" aus dem Wert selbst raten (v>0) -- und eine\n113\t    // ECHT GEMESSENE 0 (op_<art>_n>0 bei p50==0) fiel faelschlich unter \"nicht ausgefuehrt\".\n114\t    //   executed[y][x] == true  -> die Zelle traegt einen ECHTEN Messwert. Auch die 0 ist dann ein\n115\t    //                              DARSTELLBARER Wert (Zelle mit Wert 0 und ehrlichem point meta, NICHT nan,\n116\t    //                              NICHT Auslass, NICHT Platzhalter-Grund).\n117\t    //   executed[y][x] == false -> nicht ausgefuehrt/keine Stichprobe -> Auslass ueber point meta = nan.\n118\t    // LEER (oder dimensions-abweichend) -> BESTANDSVERHALTEN: der Writer faellt auf die alte Heuristik\n119\t    // \"endlich und > 0\" zurueck. Direkt-Aufrufer ohne Ausfuehrungs-Wissen (Alt-Tests, Fremdmodule) bleiben\n120\t    // damit unveraendert; nur wer die Wahrheit KENNT (aggregate_surface_matrix), reicht sie hier durch.\n121\t    std::vector<std::vector<bool>> executed;\n122\t    // E-2a/HONEST-EMPTY (2026-08-06): Vermerk-Text, den write_heatmap ANSTELLE einer datenlosen Heatmap\n123\t    // emittiert (reiner Text, wird escape_latex-durchgereicht). Leer -> neutraler ASCII-Default. Der\n124\t    // Aufrufer (write_surface_search_algo_x_workload) fuellt ihn sprach-lokalisiert.\n125\t    std::string empty_note;\n126\t};\n127\t\n128\t// Emittiert die 2D-Heatmap (matrix plot*, view={0}{90}, viridis, log-Farbskala).\n129\t// HONEST-EMPTY (E-2a): traegt KEINE Zelle einen darstellbaren Messwert, wird KEINE entartete Heatmap\n130\t// geschrieben (pgfplots-Fatal \"too few coordinates\" bei [0.0:0.0]-Farbdomaene), sondern ein ehrlicher,\n131\t// kompilierfaehiger LaTeX-Platzhalter-Vermerk -- Rueckgabe status_ok, weil die Datei existieren MUSS\n132\t// (die 6 lc_surface_<z>.tex haengen an blankem \\input, kein \\InputIfFileExists).\n133\t// E-2b: \"darstellbar\" richtet sich nach HeatmapData::executed (falls gesetzt), NICHT nach dem Vorzeichen:\n134\t// eine ausgefuehrte 0 wird DARGESTELLT (eigene 0-Farbklasse eine Dekade unter der kleinsten gemessenen\n135\t// Dekade; besteht die Flaeche NUR aus echten Nullen, traegt die Colorbar genau diese eine 0-Klasse).\n136\t// Strukturell leere Matrix (0 Zeilen/Spalten) bleibt status_empty_input OHNE Datei (Bestandsverhalten).\n137\t[[nodiscard]] int write_heatmap(std::filesystem::path const& out, HeatmapData const& data,\n138\t                                PageConstraints const& cnst = {});\n139\t\n140\t// LaTeX-Escape (lokal, NICHT abhaengig von csv_to_latex)\n141\t[[nodiscard]] std::string escape_latex(std::string_view s);\n142\t\n143\t// ─────────────────────────────────────────────────────────────────────────────\n144\t// REV 7.6 V22.1 — Sample-CSV-Loader + workload-Gruppen-Plot\n145\t// ─────────────────────────────────────────────────────────────────────────────\n146\t//\n147\t// Liest eine V20.3-konforme measurements.csv (16 Spalten):\n148\t//   permutation_id, fingerprint, succeeded, workload_used, op_count,\n149\t//   total_cycles, cache_misses_l1..l3, dtlb_misses, coherence_invalidations,\n150\t//   energy_micro_joules, bytes_allocated, bytes_in_use_peak,\n151\t//   external_frag, internal_frag\n152\t//\n153\t// Berechnet pro Zeile throughput_ops_per_sec = op_count * 1e9 / total_cycles\n154\t// (cycles als Nanosekunden interpretiert, V21.3 Sample-Daten-Konvention).\n155\t\n156\tstruct CsvRow {\n157\t    std::string   permutation_id;\n158\t    std::string   workload_used; // YCSB_A..F (V20.1)\n159\t    std::uint64_t op_count{};\n160\t    std::uint64_t total_cycles{};\n161\t    std::uint64_t cache_misses_l1{};\n162\t    std::uint64_t bytes_in_use_peak{};\n163\t};\n164\t\n165\t[[nodiscard]] std::vector<CsvRow> load_csv_with_workload_used(std::filesystem::path const& csv_path);\n166\t\n167\t// Gruppiert nach workload_used + plottet Bar-Chart mit Throughput pro Permutation.\n168\t// Permutationen werden nach workload_used sortiert (gruppiert dargestellt).\n169\t[[nodiscard]] int write_throughput_by_workload(std::filesystem::path const& out_tikz, std::span<CsvRow const> rows,\n170\t                                               PageConstraints const& cnst = {});\n171\t\n172\t// ─────────────────────────────────────────────────────────────────────────────\n173\t// L-c (2026-06-18) — WIDE-Schema-Reader + Surface/Heatmap je Interface-Funktion\n174\t// ─────────────────────────────────────────────────────────────────────────────\n175\t//\n176\t// Das Mess-System (cache-engine run_lazy_150 / lazy_csv_header) emittiert das\n177\t// (run_lazy_150 geloescht 2026-07-11; Emitter heute Code/02_messung_driver, WIDE-Schema)\n178\t// ';'-getrennte WIDE-Schema (Spaltenzahl header-getrieben, nicht fixiert). Der Parser ist\n179\t// HEADER-GETRIEBEN (Spalten per Name aufgelöst, Reihenfolge-/Breite-agnostisch → robust gegen\n180\t// additive Schema-Erweiterungen); 1:1 portiert aus 04_csv_to_latex/csv_to_latex.cpp:158-201.\n181\t// Extrahiert werden nur die L-c-auswertungs-relevanten Felder (ns_per_op-Gesamt +\n182\t// die 5 Interface-Funktions-p50: insert/lookup/erase/scan/rmw).\n183\t\n184\tstruct WideMeasurementRow {\n185\t    std::string binary_id;              // volle statische Rekombination (17 Achsen-Belegungen)\n186\t    std::string search_algo;            // aus binary_id extrahiert (führendes \"search_algo=<wert>/\")\n187\t    std::string workload;               // Lastprofil-id (eigene Spalte \"workload\")\n188\t    double      ns_per_op        = 0.0; // Gesamt-Latenz (alle Operationen gemischt)\n189\t    double      op_insert_p50_ns = 0.0; // Interface-Funktions-Latenzen (p50, nearest-rank)\n190\t    double      op_lookup_p50_ns = 0.0;\n191\t    double      op_erase_p50_ns  = 0.0;\n192\t    double      op_scan_p50_ns   = 0.0;\n193\t    double      op_rmw_p50_ns    = 0.0;\n194\t    // P3 (2026-07-12) — die 5 Interface-Funktions-p99 (spiegeln EXAKT die 5 op_*_p50_ns; nearest-rank, ns).\n195\t    // OPTIONAL/header-getrieben aufgelöst (NICHT Pflichtspalte): fehlt EINE der 5 op_*_p99_ns-Spalten ODER ist\n196\t    // EINE Zelle leer/\"n/a\"/nicht-numerisch, bleibt has_op_p99=false (cowfix-v1 ohne p99 bricht NICHT). Das\n197\t    // WIDE-Schema trägt NUR diese Aggregat-Perzentile (p50/p99), NICHT die rohen Einzel-Op-Latenzen → die\n198\t    // Latenz-Verteilung ist ehrlich nur als p50–p99-Spanne (Range) bzw. Config-Streuung (ECDF) darstellbar.\n199\t    double op_insert_p99_ns = 0.0;\n200\t    double op_lookup_p99_ns = 0.0;\n201\t    double op_erase_p99_ns  = 0.0;\n202\t    double op_scan_p99_ns   = 0.0;\n203\t    double op_rmw_p99_ns    = 0.0;\n204\t    bool   has_op_p99       = false; // true ⇔ alle 5 op_*_p99_ns-Spalten vorhanden UND numerisch\n205\t    // E-2a/HONEST-EMPTY (2026-08-06) -- die 5 AUSFUEHRUNGS-ZAEHLER op_<art>_n (Stueckzahl der in diesem Lauf\n206\t    // tatsaechlich ausgefuehrten Operationen dieser Art). Sie sind das EINZIGE direkte Signal fuer\n207\t    // \"Operation nicht ausgefuehrt\" (op_<art>_n == 0) und trennen es von \"echt 0 ns gemessen\"; ohne sie\n208\t    // muss die Auswertung auf die p50>0-Heuristik zurueckfallen (Phantom-Falle, siehe\n209\t    // aggregate_latency_range im .cpp). Beleg fuer die Spalten-Existenz im realen WIDE-Schema:\n210\t    // measurement/20260726-164259-d03-strukt-r-erstbeleg/measurements.csv (Spalten 7/10/13/19/22).\n211\t    // OPTIONAL/header-getrieben (NICHT Pflichtspalte, NICHT in required[]): fehlt EINE der 5 Spalten ODER\n212\t    // ist EINE Zelle leer/\"n/a\"/nicht-numerisch, bleibt has_op_n=false -> BESTANDSVERHALTEN (p50>0-Heuristik).\n213\t    std::uint64_t op_insert_n = 0;\n214\t    std::uint64_t op_lookup_n = 0;\n215\t    std::uint64_t op_erase_n  = 0;\n216\t    std::uint64_t op_scan_n   = 0;\n217\t    std::uint64_t op_rmw_n    = 0;\n218\t    bool          has_op_n    = false; // true <=> alle 5 op_<art>_n-Spalten vorhanden UND numerisch\n219\t    bool   two_phase_valid  = false; // Mess-GÜLTIGKEIT (Zwei-Phasen-Cache-Warmup exakt)\n220\t    // M3v2-Tag-Spalten (Task #156, ans Schema-Ende gehängt). OPTIONAL/header-getrieben aufgelöst:\n221\t    // fehlt die Spalte (cowfix-v1-Schema), bleibt das Feld leer/0 — KEIN Parse-Fehler (n/a).\n222\t    std::string   series;                    // SOTA-Reihe (A/B/C/-); leer falls Spalte fehlt\n223\t    std::string   sweep_axis;                // gesweepte Achse (z.B. migration_policy); leer falls Spalte fehlt\n224\t    std::uint64_t working_set_n     = 0;     // Arbeitsmengen-Größe (0 = Spalte fehlt / nicht gesetzt)\n225\t    bool          has_working_set_n = false; // true ⇔ working_set_n-Spalte vorhanden und nicht-leer\n226\t    double        seg_coverage      = 0.0;   // Σseg_ns/run_total (Mess-Validität); 0 falls Spalte fehlt\n227\t    bool          has_seg_coverage  = false;\n228\t    // P4 (2026-07-12): die Stapel-Segmente der Per-Achsen-Latenz-Attribution: die kV3AxisCount\n229\t    // (ABI-6/INC-2d) Organ-Achsen (Reihenfolge = kCompositionAxisNames: search_algo..persistence_target) +\n230\t    // seg_framework_ns als LETZTES Segment (Index kSegmentCount-1). Kommensurabel mit seg_run_total_ns\n231\t    // (dem eigenen Wall-Clock des Segment-Laufs run_workload_segmented), NICHT mit total_ns (Real-Workload\n232\t    // → 3–29× daneben). Beleg: cache_engine_builder_iterator.hpp:248-257,395-401 (Σ Organ-Segmente +\n233\t    // framework = seg_run_total_ns EXAKT). OPTIONAL/header-getrieben/n-a-tolerant: fehlt EINE der\n234\t    // seg_*_ns-Spalten ODER ist EINE \"n/a\" (Nicht-Mess-DLL), bleibt has_seg_ns=false → die Zeile wird bei\n235\t    // der Attribution honest ÜBERSPRUNGEN (NICHT 0-gestapelt).\n236\t    // M-4/B16 (2026-07-19): Zaehlung aus der CE-Single-Source kV3AxisCount statt Literal — das fruehere\n237\t    // hartkodierte 20 (inkl. seg_telemetry_ns/seg_isa_ns) passte nicht mehr zur 17-Achsen-WIDE-CSV.\n238\t    static constexpr std::size_t      kSegmentCount = ::comdare::cache_engine::anatomy::kV3AxisCount + 1;\n239\t    std::array<double, kSegmentCount> seg_ns{};                  // Organ-Achsen + framework (ns)\n240\t    bool                              has_seg_ns        = false; // true ⇔ alle seg_*_ns vorhanden UND numerisch\n241\t    double                            seg_run_total_ns  = 0.0;   // äußere Wall-Clock des Segment-Laufs (100%-Ganzes)\n242\t    bool                              has_seg_run_total = false;\n243\t};\n244\t\n245\t// ─────────────────────────────────────────────────────────────────────────────\n246\t// M-4 (2026-07-19) — Segment-Spaltennamen aus der CE-Single-Source abgeleitet\n247\t// ─────────────────────────────────────────────────────────────────────────────\n248\t//\n249\t// \"seg_<achse>_ns\" wird zur UEBERSETZUNGSZEIT aus kCompositionAxisNames gepraegt (constexpr-Join per\n250\t// IIFE + index_sequence — Template-Metaprogramm ohne Laufzeit-Anteil, compile-time-Doktrin). Es gibt\n251\t// KEINE zweite Namensliste mehr: Schreiber (CE lazy_csv_header, Schleife ueber kCompositionAxisNames,\n252\t// cache_engine_builder_iterator.hpp:248-257) und Leser (parse_wide_csv) ziehen aus derselben Quelle.\n253\t\n254\tnamespace segment_columns_detail {\n255\t\n256\t// Compile-time-Speicher fuer EINEN gejointen Spaltennamen \"seg_\" + kCompositionAxisNames[I] + \"_ns\".\n257\ttemplate <std::size_t I>\n258\tstruct SegColumnName {\n259\t    static constexpr std::string_view kAxis   = ::comdare::cache_engine::builder::experiment::kCompositionAxisNames[I];\n260\t    static constexpr auto             kJoined = [] {\n261\t        constexpr std::string_view                                     prefix = \"seg_\";\n262\t        constexpr std::string_view                                     suffix = \"_ns\";\n263\t        std::array<char, prefix.size() + kAxis.size() + suffix.size()> b{};\n264\t        std::size_t                                                    p = 0;\n265\t        for (char c : prefix) b[p++] = c;\n266\t        for (char c : kAxis) b[p++] = c;\n267\t        for (char c : suffix) b[p++] = c;\n268\t        return b;\n269\t    }();\n270\t    static constexpr std::string_view value{kJoined.data(), kJoined.size()};\n271\t};\n272\t\n273\t} // namespace segment_columns_detail\n274\t\n275\t// Entkopplungs-Wache: beide CE-Quellen (POD-Zaehlung + Namensliste) muessen dieselbe Achsen-Zahl tragen —\n276\t// zieht CE eine Achse um (wie INC-2c telemetry / INC-2d isa), bricht der Bau hier LAUT statt still leer.\n277\tstatic_assert(::comdare::cache_engine::builder::experiment::kCompositionAxisNames.size() ==\n278\t                  ::comdare::cache_engine::anatomy::kV3AxisCount,\n279\t              \"CE-Drift: kCompositionAxisNames vs kV3AxisCount — Segment-Schema der Stufe 05 neu abgleichen\");\n280\t\n281\t/// Die kSegmentCount Stapel-Segment-Spaltennamen in EXAKTER Header-/Stapel-Reihenfolge: die kV3AxisCount\n282\t/// Organ-Achsen (Single-Source kCompositionAxisNames) + \"seg_framework_ns\" als letztes Segment.\n283\tinline constexpr std::array<std::string_view, WideMeasurementRow::kSegmentCount> kSegmentColumns =\n284\t    []<std::size_t... I>(std::index_sequence<I...>) {\n285\t        return std::array<std::string_view, sizeof...(I) + 1>{segment_columns_detail::SegColumnName<I>::value...,\n286\t                                                              std::string_view{\"seg_framework_ns\"}};\n287\t    }(std::make_index_sequence<::comdare::cache_engine::anatomy::kV3AxisCount>{});\n288\t\n289\t// HEADER-GETRIEBENER ';'-Parser (Spalten per Name → Index-Map). Pflichtspalten:\n290\t// binary_id, ns_per_op, workload, two_phase_valid + die 5 op_*_p50_ns.\n291\t// Rückgabe: status_ok | status_io_error | status_empty_input (Header/Parse-Fehler).\n292\t[[nodiscard]] int parse_wide_csv(std::filesystem::path const& in, std::vector<WideMeasurementRow>& out_rows);\n293\t\n294\t// Aggregiert die (search_algo × workload)-WIDE-Matrix zu einer Heatmap/Surface des\n295\t// gewählten z-Feldes (nearest-rank-Median je Zelle, NUR two_phase_valid==true). Zeilen\n296\t// (y) = distinct search_algo (sortiert), Spalten (x) = distinct workload (sortiert).\n297\t//   z_field ∈ {\"ns_per_op\", \"op_insert_p50_ns\", \"op_lookup_p50_ns\", \"op_erase_p50_ns\",\n298\t//              \"op_scan_p50_ns\", \"op_rmw_p50_ns\"}.\n299\t// Beim scan-Surface (z_field==\"op_scan_p50_ns\") werden die No-Op-Scan-Profile\n300\t// \"ycsb_e\" und \"lp_range_scan\" ausgeschlossen (für Scan invalide).\n301\t// Befüllt HeatmapData und ruft das vorhandene write_heatmap (view={0}{90}, viridis).\n302\t[[nodiscard]] int write_surface_search_algo_x_workload(std::filesystem::path const&        out,\n303\t                                                       std::span<WideMeasurementRow const> rows,\n304\t                                                       std::string const& z_field, std::string const& lang = \"en\",\n305\t                                                       PageConstraints const& cnst = {});\n306\t\n307\t// Additive echte-3D-Variante (view={45}{30}, \\addplot3[surf], z LOG-skaliert wegen\n308\t// ~14000× Workload-Spanne). Gleiche Aggregation wie write_surface_search_algo_x_workload,\n309\t// nur andere pgfplots-Projektion. Bricht write_heatmap NICHT.\n310\t// E-2b: nicht ausgefuehrte Zellen sind Loecher (z=nan + unbounded coords=jump), NIE ein Ersatzwert.\n311\t// Traegt die Flaeche eine ECHT GEMESSENE 0, faellt die z-Achse auf LINEAR zurueck -- eine log-Achse\n312\t// kann die 0 weder zeigen noch ehrlich ersetzen (Begruendung + Proben im .cpp).\n313\t[[nodiscard]] int write_surface3d_search_algo_x_workload(std::filesystem::path const&        out,\n314\t                                                         std::span<WideMeasurementRow const> rows,\n315\t                                                         std::string const& z_field, std::string const& lang = \"en\",\n316\t                                                         PageConstraints const& cnst = {});\n317\t\n318\t// ─────────────────────────────────────────────────────────────────────────────\n319\t// A2 / m3v2 (2026-06-20) — Working-Set-Sweep-Kurve (Metrik über working_set_n)\n320\t// ─────────────────────────────────────────────────────────────────────────────\n321\t// Trägt das z-Feld (nearest-rank-Median, nur two_phase_valid) über working_set_n auf, eine Kurve je\n322\t// gesweepter Achsen-Ausprägung (sweep_axis-getrieben; sonst search_algo). HEADER-GETRIEBEN/n/a-tolerant:\n323\t// fehlt die working_set_n-Spalte (cowfix-v1), liefert die Funktion status_empty_input (ehrlich leer,\n324\t// KEIN Crash). Breiten-sicher via PageConstraints (resizebox_wrap default an).\n325\t[[nodiscard]] int write_working_set_sweep_curve(std::filesystem::path const&        out,\n326\t                                                std::span<WideMeasurementRow const> rows, std::string const& z_field,\n327\t                                                std::string const& lang = \"en\", PageConstraints const& cnst = {});\n328\t\n329\t// ─────────────────────────────────────────────────────────────────────────────\n330\t// P4 (2026-07-12) — Per-Achsen-Latenz-Attribution als GESTAPELTE Balken\n331\t// ─────────────────────────────────────────────────────────────────────────────\n332\t//\n333\t// Der bisher unvisualisierte Kern-Beitrag: WELCHE der Organ-Achsen (+ Framework-Overhead) wie viel\n334\t// Latenz beiträgt. Ein Balken je search_algo; das 100%-Ganze je Balken ist seg_run_total_ns (der eigene\n335\t// Wall-Clock des Segment-Laufs), NICHT total_ns (Real-Workload → inkommensurabel). Aggregation: Mittel\n336\t// je Segment über die GÜLTIGEN Segment-Zeilen (two_phase_valid ∧ has_seg_ns ∧ seg_run_total_ns>0 ∧\n337\t// seg_coverage vorhanden). Σ der kSegmentCount Segment-Mittel == Mittel seg_run_total_ns (Coverage≈1 →\n338\t// kommensurabel).\n339\t\n340\t// Numerisch prüfbares Aggregat (deterministisch nach search_algo sortiert). means[segment][group] = Mittel ns;\n341\t// Σ_segment means[s][g] == group_totals[g] == run_total_means[g]. groups leer ⇔ keine gültige Segment-Zeile.\n342\tstruct SegmentAttribution {\n343\t    std::vector<std::string>         groups;          // search_algo, aufsteigend sortiert (Balken-x)\n344\t    std::vector<std::string>         segment_labels;  // kSegmentCount Segment-Namen (Legende, Stapel-Reihenfolge)\n345\t    std::vector<std::vector<double>> means;           // means[segment][group] = Mittel des Segments (ns)\n346\t    std::vector<double>              group_totals;    // Σ_segment means je Gruppe (== Mittel seg_run_total_ns)\n347\t    std::vector<double>              run_total_means; // Mittel seg_run_total_ns je Gruppe (Kommensurabilitäts-Beleg)\n348\t    std::vector<double>              coverage_means;  // Mittel seg_coverage je Gruppe (~1.0)\n349\t};\n350\t\n351\t// Aggregiert die (search_algo)-Gruppen zu Segment-Mitteln. Header-getrieben/n-a-tolerant: Zeilen ohne\n352\t// vollständige seg-Belegung / mit seg_run_total_ns<=0 / mit fehlender seg_coverage werden HONEST übersprungen\n353\t// (NICHT 0-gestapelt). Rückgabe mit leerem `groups`, wenn KEINE gültige Segment-Zeile existiert.\n354\t[[nodiscard]] SegmentAttribution aggregate_segment_attribution(std::span<WideMeasurementRow const> rows);\n355\t\n356\t// Emittiert den pgfplots `ybar stacked` (ein Balken je search_algo, kSegmentCount `\\addplot`-Segmente,\n357\t// Legende = Achsennamen, lineare y-Achse in ns, deterministische HSV-Kategorienfarben). Guard: keine gültige\n358\t// Segment-Zeile → status_empty_input (ehrlich leer, KEIN leerer Balken). Breiten-sicher (resizebox_wrap).\n359\t[[nodiscard]] int write_segment_attribution_stacked_bar(std::filesystem::path const&        out,\n360\t                                                        std::span<WideMeasurementRow const> rows,\n361\t                                                        std::string const&                  lang = \"en\",\n362\t                                                        PageConstraints const&              cnst = {});\n363\t\n364\t// ─────────────────────────────────────────────────────────────────────────────\n365\t// P3 (2026-07-12) — Latenz-VERTEILUNG statt Mittelwert\n366\t// ─────────────────────────────────────────────────────────────────────────────\n367\t//\n368\t// EHRLICHKEITS-GRUNDLAGE (zwingend): das WIDE-Schema trägt je Permutation NUR aggregierte Perzentile\n369\t// (op_<art>_p50_ns / op_<art>_p99_ns), NICHT die rohen Einzel-Op-Latenzen. Daher gibt es exakt ZWEI ehrliche\n370\t// Verteilungs-Darstellungen:\n371\t//   (1) Range: Punkt=p50, Whisker→p99 je (search_algo × op-Art). NUR 2 Perzentile existieren → KEIN Box-Plot\n372\t//       mit erfundenen Quartilen (das wäre Phantom).\n373\t//   (2) ECDF: die einzige ehrliche CDF-Population ist die Verteilung ÜBER die Konfigurationen (jede gültige\n374\t//       Permutation = 1 Datenpunkt ihres ns_per_op). Das ist eine \"Config-Streuung\"-ECDF (Anteil der Configs\n375\t//       mit Latenz ≤ x), NICHT eine Per-Operation-Latenz-CDF. Titel/xlabel weisen das EXPLIZIT aus.\n376\t\n377\t// Range-Aggregat: je op-Art (Zeilen) × search_algo (Spalten) der nearest-rank-Median der p50- bzw. p99-Werte\n378\t// über die GÜLTIGEN Zeilen (two_phase_valid ∧ has_op_p99 ∧ op ausgeführt (p50>0)). scan schließt die No-Op-\n379\t// Scan-Profile \"ycsb_e\"/\"lp_range_scan\" aus (wie der Surface-Pfad). present[op][algo] ⇔ ≥1 Stichprobe.\n380\t// Für wohlgeformte Daten gilt p99_median[op][algo] ≥ p50_median[op][algo] (Monotonie); p99<p50 = Datenqualität.\n381\tstruct LatencyRangeAggregate {\n382\t    std::vector<std::string>         algos;        // search_algo, aufsteigend sortiert (x-Achse)\n383\t    std::vector<std::string>         ops;          // op-Arten MIT Daten, feste Reihenfolge insert..rmw (Legende)\n384\t    std::vector<std::vector<double>> p50_median;   // [op][algo] = nearest-rank-Median der p50-Werte (Punkt, ns)\n385\t    std::vector<std::vector<double>> p99_median;   // [op][algo] = nearest-rank-Median der p99-Werte (Whisker-Top, ns)\n386\t    std::vector<std::vector<std::size_t>> counts;  // [op][algo] = Stichprobenzahl je Zelle\n387\t    std::vector<std::vector<bool>>        present; // [op][algo] = Zelle hat ≥1 gültige Stichprobe\n388\t};\n389\t\n390\t// Aggregiert die (op-Art × search_algo)-Latenz-Spanne. Header-getrieben/n-a-tolerant. Rückgabe mit leerem\n391\t// `algos`, wenn KEINE gültige Zeile existiert (keine p99 / keine ausgeführte Op).\n392\t[[nodiscard]] LatencyRangeAggregate aggregate_latency_range(std::span<WideMeasurementRow const> rows);\n393\t\n394\t// Emittiert einen pgfplots-Punkt-und-Whisker-Plot (only marks + `error bars/y dir=plus, y explicit`): je Gruppe\n395\t// (search_algo × op-Art) ein Punkt bei p50, plus-Whisker hoch bis p99. y LOG (Latenz spannt Dekaden). 1 addplot\n396\t// je op-Art (Farbe+Legende). Guard: keine gültige Zeile → status_empty_input (ehrlich leer). KEIN Box/Quartil.\n397\t// Breiten-sicher (resizebox_wrap). Titel/ylabel beschriften ehrlich \"p50–p99-Spanne\".\n398\t[[nodiscard]] int write_latency_range_bar(std::filesystem::path const& out, std::span<WideMeasurementRow const> rows,\n399\t                                          std::string const& lang = \"en\", PageConstraints const& cnst = {});\n400\t\n401\t// ECDF-Serie je search_algo: die aufsteigend sortierten ns_per_op-Werte der GÜLTIGEN Konfigurationen\n402\t// (two_phase_valid). Population = Anzahl Konfigurationen (Permutationen), NICHT Einzel-Operationen.\n403\tstruct LatencyEcdfSeries {\n404\t    std::string         algo;\n405\t    std::vector<double> sorted_ns_per_op; // aufsteigend, ein Wert je gültiger Konfiguration\n406\t};\n407\t\n408\t// Baut je search_algo eine ECDF-Serie über die ns_per_op-Werte der gültigen Konfigurationen. Leer ⇔ keine\n409\t// gültige Zeile.\n410\t[[nodiscard]] std::vector<LatencyEcdfSeries> aggregate_latency_ecdf(std::span<WideMeasurementRow const> rows);\n411\t\n412\t// Emittiert die ECDF (`const plot`-Treppe) der ns_per_op-Werte ÜBER die Konfigurationen, 1 Kurve je search_algo,\n413\t// y = Rang/N ∈ [0,1], x = ns (LOG wegen der Dekaden). Titel/xlabel weisen EXPLIZIT \"Verteilung über\n414\t// Konfigurationen\" (Config-Streuung) aus — NICHT Per-Operation. Guard: keine gültige Zeile → status_empty_input.\n415\t[[nodiscard]] int write_latency_ecdf(std::filesystem::path const& out, std::span<WideMeasurementRow const> rows,\n416\t                                     std::string const& lang = \"en\", PageConstraints const& cnst = {});\n417\t\n418\t// ─────────────────────────────────────────────────────────────────────────────\n419\t// INC-4 (2026-07-13) — Modus-2 Per-Achsen-Observer-Detail-Tabelle (stat_<achse>_<feld>)\n420\t// ─────────────────────────────────────────────────────────────────────────────\n421\t//\n422\t// Schreibt den vollen Per-Achsen-Observer-Block als longtable: je (Tier-Binary × Achse × Observer-Feld) EINE\n423\t// Zeile mit dem ECHT gemessenen uint64-Zählwert. Die Spaltennamen stat_<achse>_<feld> werden HEADER-GETRIEBEN\n424\t// aus der WIDE-CSV gelesen (c2l::WideFullRow::stat, parse_wide_csv_full) — NIE hartkodiert: die DLL-seitige\n425\t// kV3AxisSchema[17][8] ist die Single-Source und emittiert die Spaltennamen. Achse/Feld werden aus dem\n426\t// Spaltennamen mit dem Achsen-Vokabular des binary_id-Tupels (r.axes-Keys = dieselben kCompositionAxisNames-\n427\t// Namen, exakt die stat_<achse>_-Präfixe) per LÄNGSTEM-Präfix zerlegt — nötig, weil BEIDE (Achsen- und\n428\t// Feldnamen) Unterstriche tragen (naives Splitten wäre falsch).\n429\t//\n430\t// HONEST-EMPTY (exakt das write_segment_attribution_stacked_bar-Muster): existiert KEINE Zeile mit mindestens\n431\t// EINEM echt gemessenen stat_-Wert (alle Spalten \"n/a\"/leer ODER der stat_-Block fehlt) → status_empty_input\n432\t// VOR dem ofstream (KEINE Datei, KEIN erfundener 0-Wert). Innerhalb einer Zeile werden n/a-/leere Felder\n433\t// übersprungen (nie 0-erfunden). Breiten-sicher via longtable + \\scriptsize (mehrseiten-fähig; KEIN resizebox,\n434\t// da longtable nicht in eine \\resizebox darf).\n435\t[[nodiscard]] int write_axis_observer_detail_table(std::filesystem::path const&                            out,\n436\t                                                   std::span<comdare::da::csv_to_latex::WideFullRow const> rows,\n437\t                                                   std::string const&                                      lang = \"en\");\n438\t\n439\t} // namespace comdare::da::diagram_generator\n440\t"}]},"uuid":"81df4bfb-8358-4070-a650-554d353301a8","timestamp":"2026-08-06T11:35:38.998Z","sourceToolAssistantUUID":"39b3c30f-64d1-48f6-9490-47391b14176d","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/home/comdare/Projekte/Research/probst-diplomarbeit-cache-engine","sessionId":"5a19728e-f6e1-4736-a246-e3fda9ac35a1","version":"2.1.223","gitBranch":"HEAD","slug":"clever-dazzling-karp"}
