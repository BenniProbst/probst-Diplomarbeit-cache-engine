diff --git a/libs/cache_engine/anatomy/abi_adapter.hpp b/libs/cache_engine/anatomy/abi_adapter.hpp
index 021af44d..82c366c4 100644
--- a/libs/cache_engine/anatomy/abi_adapter.hpp
+++ b/libs/cache_engine/anatomy/abi_adapter.hpp
@@ -75,6 +75,7 @@
