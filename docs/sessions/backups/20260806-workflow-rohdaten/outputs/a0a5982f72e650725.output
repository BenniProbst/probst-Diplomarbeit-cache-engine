Mess-Lauf findet","         // den Plan seines Bau-Laufs nur, wenn er GEGEN DENSELBEN BAU-STAND misst. Genau das soll er.","-        std::string const plan_stamp =","-            bestandslog::slice_plan_stamp(indices, plan_slice_korn(cfg), plan_identitaet_of(view, cfg));","+        PlanAnkerBefund const mess_anker = plan_anker_befund(view, cfg, indices, plan_slice_korn(cfg));","+        if (!mess_anker.traegt()) {","+            melde_plan_ablage_ohne_anker(cfg, indices.size(), mess_anker, \"mess-weg\");","+            return result;","+        }","+        std::string const plan_stamp    = mess_anker.stamp;","         std::string const plan_rows_key = kLazyResumeRowsKey;","         auto const        faecher       = bestandslog::read_batch_plan(cfg.batch_plan_datei, plan_stamp, plan_rows_key);","         if (!faecher.has_value()) {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"cd3fb06e-9f14-4a21-ab9a-77d58133d160","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/home/comdare/Projekte/Research/probst-diplomarbeit-cache-engine","sessionId":"5a19728e-f6e1-4736-a246-e3fda9ac35a1","version":"2.1.223","gitBranch":"HEAD","slug":"clever-dazzling-karp"}
