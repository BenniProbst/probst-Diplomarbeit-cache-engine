         bl::slice_plan_stamp(eins, bl::kBuildSliceGrain, ex::plan_identitaet_of(view, cfg_bau));\n1165:            check_eq(\"(11f) der BAU-Lauf schreibt allein die Bau-Front\", datei_text(z_f),\n1200:                r_f = ex::run_lazy_static_then_dynamic(tree, sel_f, compile_stub, gen_stub, ram_stub_f, cfg_mess);\n1202:            check_eq(\"(11f) Vorbedingung: die Zelle wurde resumiert (also gemessen im Sinn der Front)\",\n1204:            check_eq(\"(11f) der MESS-Lauf setzt die Mess-Front und laesst die Bau-Front stehen\", datei_text(z_f),\n1206:            check_true(\"(11f) der Plan selbst ist unberuehrt (der Mess-Lauf plant nicht)\",\n1211:        // (11g) T2-A/F4-NB2, BEFUND 1 -- DER BAU-ZAEHLER LIEF VOR DEM PUSH-DRAIN HOCH.\n1227:            std::cout << \"\\n-- (11g) Befund 1: der Bau-Zaehler wartet auf den Push-Vollzug --\\n\";\n1247:                    // cppcheck-suppress throwInEntryPoint // FP: Negativprobe (11g) -- der Wurf IST der Testfall\n1251:                (void)ex::run_lazy_static_then_dynamic(tree, sel_g, compile_stub, gen_stub, ram_stub_g, cfg_g);\n1254:            check_true(\"(11g) der Plan selbst liegt (er beschreibt das SOLL, nicht den Vollzug)\",\n1256:            check_true(\"(11g) ALT-BEDINGUNG literal erfuellt: der Bau war fehlerfrei (fehl=0)\",\n1258:            check_true(\"(11g) ALT-STAND-BISS: TROTZDEM kein Bau-Zaehler -- die Artefakte sind nicht im Store\",\n1260:            check_true(\"(11g) und der Halt ist beziffert sichtbar (nie stumm)\",\n1262:            check_true(\"(11g) mit der EIGENEN Begruendung (Store-Transport, nicht Compiler)\",\n1276:                (void)ex::run_lazy_static_then_dynamic(tree, sel_g, compile_stub, gen_stub, ram_stub_g, cfg_g2);\n1278:            check_eq(\"(11g) Gegenprobe: alle 8 Pushes sind wirklich gelaufen\", pushes, std::size_t{8});\n1279:            check_true(\"(11g) Gegenprobe: JETZT steht der Bau-Zaehler da\", fs::exists(z_g2, ec));\n1280:            check_true(\"(11g) Gegenprobe: und er traegt die volle Fenster-Menge\",\n1285:        // (11h) T2-A/F4-NB2, BEFUND 1 (die BARRIERE selbst) -- AsyncPushPump::drain().\n1287:        // Die Zwischen-Barriere ist das Bauteil, das (11g) traegt: warten, bis alles bislang Eingereihte\n1294:            std::cout << \"\\n-- (11h) Befund 1: die Zwischen-Barriere haelt den in-flight-Push --\\n\";\n1300:                                       // cppcheck-suppress throwInEntryPoint // FP: Negativprobe (11h)\n1307:            check_eq(\"(11h) ALT-FENSTER: der Push laeuft, gebucht ist noch NICHTS\", pump.failed_count(),\n1309:            check_eq(\"(11h) und auch kein Erfolg\", pump.pushed_count(), std::size_t{0});\n1312:            check_eq(\"(11h) NACH der Barriere ist der Fehl-Push gebucht\", pump.failed_count(), std::size_t{1});\n1313:            check_eq(\"(11h) drain() schliesst den Pump NICHT -- er nimmt weiter an\", pump.pushed_count(),\n1322:            check_eq(\"(11h) der zweite Eintrag ist ebenfalls gebucht (der Pump lief weiter)\", pump.failed_count(),\n1325:            check_eq(\"(11h) nach close() bleibt die Bilanz stehen\", pump.failed_count(), std::size_t{2});\n1327:            check_eq(\"(11h) drain() nach close() haengt nicht und aendert nichts\", pump.failed_count(),\n1332:        // (11i) T2-A/F4-NB2, BEFUND 2 -- DIE MESS-FRONT WAR EINE BILANZ, KEIN PRAEFIX.\n1345:            std::cout << \"\\n-- (11i) Befund 2: die Mess-Front ist ein Praefix --\\n\";\n1359:                stamp_i = bl::slice_plan_stamp(drei, bl::kBuildSliceGrain, ex::plan_identitaet_of(view, cfg_bau_i));\n1365:            check_eq(\"(11i) Vorbedingung: der Bau-Lauf hat die Bau-Front auf 3 gesetzt\", datei_text(z_i),\n1407:                r_i = ex::run_lazy_static_then_dynamic(tree, sel_i, compile_bricht_null, gen_stub, ram_i, cfg_mess_i);\n1409:            check_eq(\"(11i) Vorbedingung: die erste Zelle ist NICHT gebaut\", r_i.build_stats.failed, std::size_t{1});\n1410:            check_eq(\"(11i) ALT-ZAHL literal: zwei Zellen HA