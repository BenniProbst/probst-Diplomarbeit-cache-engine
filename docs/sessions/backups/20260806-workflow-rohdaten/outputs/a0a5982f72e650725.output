r NICHT\", builds.size(),\n1508:                check_eq(\"(11j) und beansprucht auch kein Plan-Resume\", plan_skips, std::size_t{0});\n1533:                check_eq(\"(11j) Gegenprobe: DERSELBE Bau-Stand erbt den Zaehler (nichts wird neu gebaut)\",\n1535:                check_eq(\"(11j) Gegenprobe: und die geerbten Atome sind gebucht\", plan_skips, std::size_t{8});\n1540:        // (11k) T2-A/F4-NB2, KORN-DIVERGENZ (Vorwellen-Notiz mittag-20) -- EINE QUELLE FUER BEIDE WEGE.\n1548:            std::cout << \"\\n-- (11k) Korn-Divergenz: eine Quelle fuer Bau- und Mess-Weg --\\n\";\n1550:            check_eq(\"(11k) 0 heisst 'die Konstante' -- der produktive Lauf ist unveraendert\",\n1553:            check_eq(\"(11k) ein gesetztes Korn kommt durch\", ex::plan_slice_korn(probe), std::size_t{4});\n1565:            std::string const stamp_k = bl::slice_plan_stamp(eins_k, 4, ex::plan_identitaet_of(view, cfg_bau_k));\n1572:            check_true(\"(11k) Vorbedingung: der Plan traegt das gesetzte Korn\",\n1574:            check_eq(\"(11k) und die Bau-Front steht\", datei_text(z_k), stamp_k + \"|kompiliert=1|gemessen=0|rows=1\\n\");\n1576:            // Die Mess-Fixture (identisch zu (11f), nur mit Korn).\n1618:                    (void)ex::run_lazy_static_then_dynamic(tree, sel_k, compile_stub, gen_stub, ram_k, cfg_alt);\n1621:                check_true(\"(11k) ALT-STAND-BISS: mit dem Default-Korn findet der Mess-Lauf den Plan NICHT\",\n1623:                check_eq(\"(11k) ALT-STAND-BISS: und die Mess-Front bleibt liegen\", datei_text(z_k),\n1633:                    r_k = ex::run_lazy_static_then_dynamic(tree, sel_k, compile_stub, gen_stub, ram_k, cfg_neu);\n1635:                check_eq(\"(11k) Vorbedingung: die Zelle hat resumiert\", r_k.resumed_binaries, std::size_t{1});\n1636:                check_eq(\"(11k) NEU: EIN Korn fuer beide Wege -> die Mess-Front wird fortgeschrieben\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssista