   fs::remove_all(base, ec); // Reste eines Vorlaufs -- (2) prueft ABWESENHEIT und darf nichts erben\n    fs::create_directories(base, ec);\n\n    std::cout << \"== T2-A/F4: die Plan-Ablage reist durch die run_profile-Fassade ==\\n\";\n\n    // T2-A/F4-NB3 -- DAS OPT-IN, VON DEM DIESER TEST ABHAENGT, STEHT JETZT LITERAL DA (s. Kopf).\n    // Ohne COMDARE_BESTANDSLOG=true bleibt lazy_fingerprint leer, cfg.bestand_fingerprint_fn ebenfalls,\n    // und die Plan-Ablage ist seit NB3 fail-closed INERT -- es entstuende gar kein Plan. Der Test hat\n    // diese Abhaengigkeit bis heute stillschweigend AUSGENUTZT (sein Vergleichs-Stempel war ankerlos).\n    ::setenv(\"COMDARE_BESTANDSLOG\", \"true\", 1);\n    // Und die ZWEITE Haelfte derselben Vorbedingung (T2-C, profile_run_entry.hpp:438): ist die\n    // Realversion des Tier-Treibers nicht sondierbar, faellt der Provider ebenfalls weg. Das ist eine\n    // Eigenschaft der UMGEBUNG, keine des geprueften Glieds -- deshalb steht sie hier als eigene Zeile\n    // und nicht als stille Annahme unter einem Plan-Fehlschlag.\n    check_true(\"(0) Vorbedingung: die Tier-Realversion ist erhebbar (sonst kein Fingerprint-Anker)\",\n               ::comdare::cache_engine::profile_facade::tier_realversion_ist_bekannt());\n","originalFile":null,"structuredPatch":[{"oldStart":159,"oldLines":6,"newStart":159,"newLines":20,"lines":[" "," } // namespace"," ","+// T2-A/F4-NB3: die Kopf-Zeile der Ablage OHNE den Schwanz-Schluessel -- also GENAU der Stempel, den der","+// Lauf gebildet hat. Er ist hier die EINE Quelle: von Hand liesse er sich nicht bilden, weil dieser Test","+// (bewusst: er prueft die FASSADE) keinen Zugriff auf die StaticBinaryView und damit auf keine","+// Identitaets-Funktion hat. Leer, wenn nichts oder Unerwartetes dasteht -- dann fallen die Pruefungen.","+[[nodiscard]] std::string stempel_der_ablage(fs::path const& plan, std::string const& rows_key) {","+    std::ifstream f{plan};","+    std::string   kopf;","+    if (!std::getline(f, kopf)) return {};","+    while (!kopf.empty() && kopf.back() == '\\r') kopf.pop_back();","+    std::size_t const s = kopf.find(rows_key);","+    if (s == std::string::npos) return {};","+    return kopf.substr(0, s);","+}","+"," int main() {","     std::error_code ec;","     fs::path const  base = ::comdare::test::user_tmp_dir() / \"comdare_t2a_f4_facade\";"]},{"oldStart":167,"oldLines":6,"newStart":181,"newLines":18,"lines":[" ","     std::cout << \"== T2-A/F4: die Plan-Ablage reist durch die run_profile-Fassade ==\\n\";"," ","+    // T2-A/F4-NB3 -- DAS OPT-IN, VON DEM DIESER TEST ABHAENGT, STEHT JETZT LITERAL DA (s. Kopf).","+    // Ohne COMDARE_BESTANDSLOG=true bleibt lazy_fingerprint leer, cfg.bestand_fingerprint_fn ebenfalls,","+    // und die Plan-Ablage ist seit NB3 fail-closed INERT -- es entstuende gar kein Plan. Der Test hat","+    // diese Abhaengigkeit bis heute stillschweigend AUSGENUTZT (sein Vergleichs-Stempel war ankerlos).","+    ::setenv(\"COMDARE_BESTANDSLOG\", \"true\", 1);","+    // Und die ZWEITE Haelfte derselben Vorbedingung (T2-C, profile_run_entry.hpp:438): ist die","+    // Realversion des Tier-Treibers nicht sondierbar, faellt der Provider ebenfalls weg. Das ist eine","+    // Eigenschaft der UMGEBUNG, keine des geprueften Glieds -- deshalb steht sie hier als eigene Zeile","+    // und nicht als stille Annahme unter einem Plan-Fehlschlag.","+    check_true(\"(0) Vorbedingung: die Tier-Realversion ist erhebbar (sonst kein Fingerprint-Anker)\",","+               ::comdare::cache_engine::profile_facade::tier_realversion_ist_bekannt());","+","     // -- (1) ARG GESETZT -> PLAN UND ZAEHLER LIEGEN DA.","     fs::path const plan_datei = base / \"ablage\" / \"batch_plan.txt\";","     fs::path const z_datei    = fs::path{plan_datei.string() + \".zaehler\"};"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"59c7f1de-2f8d-41df-8911-57d7043af8f3","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/ho