n    //    zurueckfallen. binary_id-neutral (die Kompositions-AKTIVIERUNG von \"merge\" ist golden-regen-/gate-gated;\n    //    hier nur die Wohlgeformtheit). Rein enum-basiert => NICHT an registry_dir gebunden. ──\n    // KERN #48-S4: eine Phase-3-Bindung liegt vor, wenn das Profil eine <phase merge=\"Stufe3_FullJoin\"> traegt.\n    // \"fulljoin\" als per-Achse-Merge-Modus ist NUR bei vorhandener Bindung gueltig (Verdikt V-a; sonst waere die\n    // Stufe-2-Hybrid-/Stufe-3-FullJoin-Trennung verletzt). Leere/abgeleitete Phasen (kein <phases>) => keine Bindung.\n    bool const has_full_join_phase = std::any_of(ep.phases.begin(), ep.phases.end(), [](cx::ExperimentPhase const& ph) {\n        return ph.merge == \"Stufe3_FullJoin\";\n    });\n    for (auto const& ax : ep.axes_default_lookup) {\n        if (ax.merge_mode.empty()) continue; // leer = replace-Default (nichts zu pruefen)\n        ++r.axis_merge_checked;\n        bool const known = std::find(std::begin(kExperimentAxisMergeModes), std::end(kExperimentAxisMergeModes),\n                                     ax.merge_mode) != std::end(kExperimentAxisMergeModes);\n        if (!known) {\n            r.ok = false;\n\n=== any XML using system_axes target_isa numa_node ===\nlibs/cache_engine/algorithm_profiles/thesis_profiles/fb_numa_page_study.profile.xml:32:       pmr::pool_options, immer USE-enabled). Der numa_node-Konsument numalloc (AA5/A09, Node-Bindung,\nlibs/cache_engine/algorithm_profiles/thesis_profiles/fb_numa_page_study.profile.xml:35:       ergaenzt; der alloc_hw-KNOPF (numa_node) bleibt schon jetzt deklariert + compile-time gated. -->\nlibs/cache_engine/algorithm_profiles/thesis_profiles/fb_numa_page_study.profile.xml:43:         numa_node {auto,0,1}: auto = kernel-Default (= bisheriges hartes -1, Baseline der\nlibs/cache_engine/algorithm_profiles/thesis_profiles/fb_numa_page_study.profile.xml:47:         Konsum: NUMAllocAllocatorBody (numa_node statt Hartcode -1) + PoolResourceAllocatorBody\nlibs/cache