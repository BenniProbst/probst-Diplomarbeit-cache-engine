tion_codegen/codegen.cmake annotiert. Die erzeugte `permutations.cmake` ist\n84\t-// byte-identisch zum Output des cmake-Backends (Beweis via tests/unit/perm_codegen_byte_identity.cmake).\n85\t+// TREUE, VOLLE ERSETZUNG: Jede Emit-/Kreuzprodukt-Zeile ist auf die korrespondierende Zeile in\n86\t+// tools/permutation_codegen/codegen.cmake annotiert. Das cpp-Backend erzeugt ALLE VIER Artefakte,\n87\t+// die codegen.cmake schreibt — byte-identisch (Beweis via tests/unit/perm_codegen_byte_identity.cmake):\n88\t+//   (1) permutations.cmake              (add_library/comdare_permutations_all)  — render_permutations_cmake\n89\t+//   (2) permutations_manifest.txt       (Runtime-Check des Experiment-Drivers)  — render_manifest\n90\t+//   (3) perm_src/perm_<id>.cpp          (per-Permutation Wrapper-Quelle)        — render_wrapper_source\n91\t+//   (4) perm_versions/perm_<id>.version (V36.E selective-rebuild-Buchhaltung)   — render_version_file\n92\t //\n93\t-// UMFANGS-GRENZE (bewusst, dokumentiert): codegen.cmake schreibt vier Artefakte —\n94\t-//   (1) permutations.cmake            (add_library/comdare_permutations_all)  <- HIER portiert\n95\t-//   (2) permutations_manifest.txt     (Runtime-Check des Experiment-Drivers)  <- HIER portiert\n96\t-//   (3) perm_src/perm_<id>.cpp        (per-Permutation Wrapper-Quelle)        <- NICHT portiert\n97\t-//   (4) perm_versions/perm_<id>.version (V36.E selective-rebuild-Buchhaltung) <- NICHT portiert\n98\t-// Die Aufgabenstellung nennt als \"Ausgang\" ausdruecklich die permutations.cmake; (1)+(2) sind die\n99\t-// beiden Registrierungs-Artefakte, deren Byte-Identitaet sinnvoll UND erreichbar ist. (3) zoege die\n100\t-// gesamte V36.E-Versions-Maschinerie (axes_versions.txt-Lookup + Minor-Bump) nach; (4) traegt in\n101\t-// codegen.cmake Zeile 508 `last_codegen=${CMAKE_CURRENT_LIST_FILE}` — ein backend-identifizierendes\n102\t-// Feld, das ein ehrliches C++-Tool nicht byte-identisch reproduzieren KANN, ohne faelschlich zu\n103\t-// behaupten, codegen.cmake habe die Datei erzeugt. Da das Default-Backend `cmake` bleibt und der\n104\t-// reale Bau (der (3)+(4) braucht) damit unberuehrt ist, ist diese Grenze risikofrei.\n105\t+// EINZIGE, EHRLICHE ABWEICHUNG: Feld `last_codegen` in (4). codegen.cmake Z.508 schreibt dort\n106\t+// ${CMAKE_CURRENT_LIST_FILE} (= Pfad zu codegen.cmake). Das cpp-Tool behauptet NICHT, codegen.cmake\n107\t+// habe die Datei erzeugt, sondern schreibt seinen EIGENEN Marker (cpp_last_codegen_marker()). Der\n108\t+// Byte-Identitaets-Test schliesst GENAU diese eine `last_codegen=`-Zeile aus; alle anderen Felder\n109\t+// sind byte-identisch. Sicherheits-Rahmen: Default-Backend bleibt `cmake`, der reale golden-320-Bau\n110\t+// ist unberuehrt; das cpp-Backend ist opt-in (COMDARE_PERMUTATION_CODEGEN_BACKEND=cpp).\n111\t+//\n112\t+// KEIN Python (Talos-OS-Direktive). Reines C++23 + CMake.\n113\t \n114\t #include <builder/permutation_codegen_tool/permutation_codegen_tool.hpp>\n115\t \n116\t #include <array>\n117\t #include <fstream>\n118\t+#include <iterator>\n119\t #include <string>\n120\t #include <string_view>\n121\t #include <utility>\n122\t@@ -29,7 +30,7 @@ namespace comdare::cache_engine::builder::permutation_codegen {\n123\t \n124\t namespace {\n125\t \n126\t-// string(TOUPPER ...) fuer die (rein ASCII-kleingeschriebenen) Allokator-Namen (codegen.cmake Zeile 254-256).\n127\t+// string(TOUPPER ...) fuer die (rein ASCII-kleingeschriebenen) Achsen-Namen (codegen.cmake Zeile 254-256).\n128\t [[nodiscard]] std::string ascii_upper(std::string_view s) {\n129\t     std::string out;\n130\t     out.reserve(s.size());\n131\t@@ -52,6 +53,299 @@ namespace {\n132\t            alloc == \"hoard\" || alloc == \"scalloc\";\n133\t }\n134\t \n135\t+// Alle Vorkommen von `from` in `s` durch `to` ersetzen (Template-Platzhalter-Substitution).\n136\t+void replace_all(std::string& s, std::string_view from, std::string_view to) {\n137\t+    if (from.empty()) return;\n138\t+    std::size_t pos = 0;\n139\t+    while ((pos = s.find(from, pos)) != std::string::npos) {\n140\t+        s.replace(pos, from.size(), to);\n141\t+        pos += to.size();\n142\t+    }\n143\t+}\n144\t+\n145\t+// Datei binaer -> string (leer bei Fehler/nicht vorhanden).\n146\t+[[nodiscard]] std::string read_file_to_string(std::filesystem::path const& p) {\n147\t+    std::ifstream in{p, std::ios::binary};\n148\t+    if (!in) return {};\n149\t+    return std::string{std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};\n150\t+}\n151\t+\n152\t+// Byte-genaues binaeres Schreiben (keine Newline-Translation) -> exakt wie CMake file(WRITE).\n153\t+[[nodiscard]] bool write_file_binary(std::filesystem::path const& p, std::string_view content, std::string* err) {\n154\t+    std::ofstream out{p, std::ios::binary | std::ios::trunc};\n155\t+    if (!out) {\n156\t+        if (err) { *err = \"cannot open output file: \" + p.string(); }\n157\t+        return false;\n158\t+    }\n159\t+    out.write(content.data(), static_cast<std::streamsize>(content.size()));\n160\t+    if (!out) {\n161\t+        if (err) { *err = \"write failed: \" + p.string(); }\n162\t+        return false;\n163\t+    }\n164\t+    return true;\n165\t+}\n166\t+\n167\t+// REGEX MATCH \"<key>([^\\n\\r]+)\" (codegen.cmake Z.150/214/218): erster Treffer, Wert bis Zeilenende;\n168\t+// leer/nicht gefunden -> `def` (das `+` im Regex verlangt >=1 Zeichen).\n169\t+[[nodiscard]] std::string match_field(std::string_view content, std::string_view key, std::string_view def) {\n170\t+    auto const pos = content.find(key);\n171\t+    if (pos == std::string_view::npos) return std::string{def};\n172\t+    std::size_t const start = pos + key.size();\n173\t+    std::size_t       end   = start;\n174\t+    while (end < content.size() && content[end] != '\\n' && content[end] != '\\r') { ++end; }\n175\t+    if (end == start) return std::string{def};\n176\t+    return std::string{content.substr(start, end - start)};\n177\t+}\n178\t+\n179\t+// Wrapper-Quell-Template (codegen.cmake Zeile 259-501, file(WRITE ${_wrapper} ...)). Reines ASCII.\n180\t+// Platzhalter @@...@@ werden in render_wrapper_source substituiert. Als raw-string -> von clang-format\n181\t+// NICHT umformatiert; die Bytes bleiben exakt.\n182\t+constexpr std::string_view kWrapperTemplate =\n183\t+    R\"PERMTPL(// Auto-generiert von tools/permutation_codegen/codegen.cmake (V36-V39 2026-05-24)\n184\t+// Permutation: @@PERM_ID@@\n185\t+// Profile=@@PROFILE@@ ISA=@@ISA@@\n186\t+// V36.E Version: @@STORED_VERSION@@  (Achsen-Sig: @@AXES_SIG@@)\n187\t+\n188\t+#define @@AXIS_MACRO_SIMD@@ 1\n189\t+#define @@AXIS_MACRO_LAYOUT@@ 1\n190\t+#define @@AXIS_MACRO_ALLOC@@ 1\n191\t+\n192\t+#include <chrono>\n193\t+#include <cstddef>\n194\t+#include <cstdint>\n195\t+#include <cstdlib>\n196\t+#include <unordered_set>\n197\t+#include <vector>\n198\t+#include <utility>\n199\t+#include <string>\n200\t+\n201\t+// V41.A5 (2026-05-24): echte Algorithmus-Implementierungen statt STL-wrapper\n202\t+#include <cache_engine/indexes/linear_probe_hashset.hpp>\n203\t+#include <cache_engine/indexes/radix_index.hpp>\n204\t+\n205\t+// V39.B + V41.A3 (2026-05-25) - SIMD-Achse echt via Intrinsics (5 Variants)\n206\t+#if defined(COMDARE_PERM_SIMD_IS_SSE4) || defined(COMDARE_PERM_SIMD_IS_AVX2) || defined(COMDARE_PERM_SIMD_IS_AVX512)\n207\t+  #if defined(__GNUC__) || defined(__clang__)\n208\t+    #include <x86intrin.h>\n209\t+  #elif defined(_MSC_VER)\n210\t+    #include <intrin.h>\n211\t+  #endif\n212\t+#elif defined(COMDARE_PERM_SIMD_IS_NEON)\n213\t+  #include <arm_neon.h>\n214\t+#endif\n215\t+\n216\t+// V40.A/B + V41.A2 (2026-05-25) - Allokator-Achse echt (7 Variants)\n217\t+#if defined(COMDARE_PERM_ALLOC_IS_MIMALLOC) && defined(COMDARE_PERM_HAVE_MIMALLOC)\n218\t+  #include <mimalloc.h>\n219\t+  #define COMDARE_ALLOC(sz)  ::mi_malloc(sz)\n220\t+  #define COMDARE_FREE(p)    ::mi_free(p)\n221\t+  #define COMDARE_ALLOC_NAME \"mimalloc\"\n222\t+#elif defined(COMDARE_PERM_ALLOC_IS_JEMA