++ b/apps/permutation_codegen_tool/main.cpp\n24\t@@ -28,13 +28,16 @@ void print_usage() {\n25\t     std::cerr << \"Usage: comdare-permutation-codegen [options]\\n\"\n26\t                  \"\\n\"\n27\t                  \"C++23-Port von tools/permutation_codegen/codegen.cmake (opt-in Backend 'cpp').\\n\"\n28\t-                 \"Erzeugt eine byte-identische permutations.cmake + permutations_manifest.txt.\\n\"\n29\t+                 \"Voller Bau-Ersatz: erzeugt byte-identisch permutations.cmake, permutations_manifest.txt,\\n\"\n30\t+                 \"perm_src/perm_<id>.cpp und perm_versions/perm_<id>.version.\\n\"\n31\t                  \"\\n\"\n32\t                  \"Options (jeweils '--key value' oder '--key=value'):\\n\"\n33\t                  \"  --target-isa ISA     Ziel-ISA (auto|scalar|sse4|avx2|avx512|neon). Default: auto\\n\"\n34\t                  \"  --profile P          Profile-Filter (smoke|medium|full). Default: smoke\\n\"\n35\t                  \"  --mode M             on_build_on_demand|on_rebuild|off_pause_build. Default: on_build_on_demand\\n\"\n36\t                  \"  --output FILE        Pfad der zu erzeugenden permutations.cmake (erforderlich)\\n\"\n37\t+                 \"  --axes-versions F    Pfad zu axes_versions.txt (V36.E Achsen-Versionen; fuer Wrapper-Sig).\\n\"\n38\t+                 \"                       Fehlt/leer => alle Achsen-Versionen 'v0' (wie fehlende Datei).\\n\"\n39\t                  \"  --help               Diese Hilfe anzeigen und beenden\\n\";\n40\t }\n41\t \n42\t@@ -84,6 +87,10 @@ int main(int argc, char** argv) {\n43\t             have_output   = true;\n44\t             continue;\n45\t         }\n46\t+        if (auto v = take_value(a, \"--axes-versions\", i, argc, argv)) {\n47\t+            inputs.axes_versions = *v;\n48\t+            continue;\n49\t+        }\n50\t         std::cerr << \"comdare-permutation-codegen: unbekanntes oder unvollstaendiges Argument: \" << a << \"\\n\\n\";\n51\t         print_usage();\n52\