t+    // statt brute-force pair-vector. Zeigt trie-Charakteristik (O(log_16 N) depth).\n392\t+    comdare::cache_engine::indexes::RadixIndex store;\n393\t+    auto t0 = std::chrono::steady_clock::now();\n394\t+    for (unsigned long i = 0; i < n_ops; ++i) {\n395\t+        store.insert(static_cast<std::uint32_t>(v39_hash::mix(i)));\n396\t+    }\n397\t+    std::uint64_t hits = 0;\n398\t+    for (unsigned long i = 0; i < n_ops; ++i) {\n399\t+        if (store.contains(static_cast<std::uint32_t>(v39_hash::mix(i)))) ++hits;\n400\t+    }\n401\t+    auto t1 = std::chrono::steady_clock::now();\n402\t+#endif\n403\t+\n404\t+    if (hits != static_cast<std::uint64_t>(n_ops)) {\n405\t+        return -2;\n406\t+    }\n407\t+    double total_us = std::chrono::duration<double, std::micro>(t1 - t0).count();\n408\t+    *out_micros_per_op = total_us / static_cast<double>(n_ops * 2);\n409\t+    return 0;\n410\t+}\n411\t+\n412\t+// V38.C - Einheitliches Entry-Symbol fuer Plugin-Loader (ausserhalb namespace).\n413\t+// V40.D: axes string enthaelt real= zur Markierung wenn vendored allocator aktiv ist\n414\t+static constexpr char kAxes_@@PERM_ID@@[] =\n415\t+    \"simd=@@SIMD@@,layout=@@LAYOUT@@,alloc=@@ALLOC@@ (real=\" COMDARE_ALLOC_NAME \")\";\n416\t+static constexpr PermDescriptor kDescriptor_@@PERM_ID@@ {\n417\t+    COMDARE_PERM_ID,\n418\t+    COMDARE_PERM_VERSION,\n419\t+    kAxes_@@PERM_ID@@,\n420\t+    &perm_@@PERM_ID@@_run\n421\t+};\n422\t+\n423\t+extern \"C\" COMDARE_PERM_EXPORT const PermDescriptor* comdare_perm_descriptor() {\n424\t+    return &kDescriptor_@@PERM_ID@@;\n425\t+}\n426\t+)PERMTPL\";\n427\t+\n428\t } // namespace\n429\t \n430\t std::optional<Profile> parse_profile(std::string_view value) noexcept {\n431\t@@ -224,6 +518,94 @@ std::string render_manifest(Inputs const& inputs, std::vector<Permutation> const\n432\t     return out;\n433\t }\n434\t \n435\t+std::string axis_version_lookup(std::string_view axes_versions_content, std::string_view axis_key) {\n436\t+    // codegen.cmake Z.149-156: REGEX MATCH \"axis_<key>=([^\\n\\r]+)\", default \"v0\".\n437\t+    std::string const needle = \"axis_\" + std::string{axis_key} + \"=\";\n438\t+    return match_field(axes_versions_content, needle, \"v0\");\n439\t+}\n440\t+\n441\t+std::string current_axes_signature(std::string_view axes_versions_content, Permutation const& perm) {\n442\t+    // codegen.cmake Z.197-207.\n443\t+    std::string const av_simd   = axis_version_lookup(axes_versions_content, \"12_simd_\" + perm.simd);\n444\t+    std::string const av_layout = axis_version_lookup(axes_versions_content, \"4_layout_\" + perm.layout);\n445\t+    std::string const av_alloc  = axis_version_lookup(axes_versions_content, \"6_alloc_\" + perm.alloc);\n446\t+    std::string       av_node   = \"v0\";\n447\t+    std::string       av_concur = \"v0\";\n448\t+    if (perm.extended) { // codegen.cmake Z.203: if(_node) — node non-empty nur bei medium/full\n449\t+        av_node   = axis_version_lookup(axes_versions_content, \"1_node_\" + perm.node);\n450\t+        av_concur = axis_version_lookup(axes_versions_content, \"8_concurrency_\" + perm.concur);\n451\t+    }\n452\t+    return \"simd=\" + av_simd + \";layout=\" + av_layout + \";alloc=\" + av_alloc + \";node=\" + av_node +\n453\t+           \";concur=\" + av_concur;\n454\t+}\n455\t+\n456\t+std::string bump_minor(std::string_view in_version) {\n457\t+    // codegen.cmake Z.159-165: MATCHES \"([0-9]+)\\.([0-9]+)\\.([0-9]+)\" -> maj.(min+1).0, sonst 0.1.0.\n458\t+    auto const is_digit = [](char c) { return c >= '0' && c <= '9'; };\n459\t+    for (std::size_t i = 0; i < in_version.size(); ++i) {\n460\t+        if (!is_digit(in_version[i])) { continue; }\n461\t+        std::size_t a = i;\n462\t+        while (a < in_version.size() && is_digit(in_version[a])) { ++a; }\n463\t+        if (a >= in_version.size() || in_version[a] != '.') { continue; }\n464\t+        std::size_t const b_start = a + 1;\n465\t+        std::size_t       b       = b_start;\n466\t+        while (b < in_version.size() && is_digit(in_version[b])) { ++b; }\n467\t+        if (b == b_start || b >= in_version.size() || in_version[b] != '.') { continue; }\n468\t+        std::size_t const c_start = b + 1;\n469\t+        std::size_t       c       = c_start;\n470\t+        while (c < in_version.size() && is_digit(in_version[c])) { ++c; }\n471\t+        if (c == c_start) { continue; }\n472\t+        std::string const maj{in_version.substr(i, a - i)};\n473\t+        long const        minor = std::stol(std::string{in_version.substr(b_start, b - b_start)});\n474\t+        return maj + \".\" + std::to_string(minor + 1) + \".0\";\n475\t+    }\n476\t+    return \"0.1.0\";\n477\t+}\n478\t+\n479\t+std::string_view cpp_last_codegen_marker() noexcept {\n480\t+    // Ehrlich: kennzeichnet das cpp-Backend, behauptet NICHT codegen.cmake. Der Byte-Identitaets-Test\n481\t+    // schliesst genau die `last_codegen=`-Zeile aus.\n482\t+    return \"comdare-permutation-codegen (cpp backend; C++23-Port von tools/permutation_codegen/codegen.cmake)\";\n483\t+}\n484\t+\n485\t+std::string render_wrapper_source(Inputs const& inputs, Permutation const& perm, std::string_view stored_version,\n486\t+                                  std::string_view current_axes_sig) {\n487\t+    // _extra_defines (codegen.cmake Z.242-247): leer bei smoke; sonst Node/Concurrency-Defines,\n488\t+    // beginnend mit \\n, ohne abschliessendes \\n.\n489\t+    std::string extra_defines;\n490\t+    if (perm.extended) {\n491\t+        extra_defines = \"\\n#define COMDARE_PERM_NODE \\\"\" + perm.node + \"\\\"\\n#define COMDARE_PERM_CONCURRENCY \\\"\" +\n492\t+                        perm.concur + \"\\\"\";\n493\t+    }\n494\t+\n495\t+    std::string out{kWrapperTemplate};\n496\t+    // Reihenfolge: die AXIS_MACRO_*-Platzhalter VOR den kurzen @@SIMD@@/@@LAYOUT@@/@@ALLOC@@ ersetzen\n497\t+    // (Substitutionswerte enthalten selbst keine @@...@@-Tokens -> ansonsten ordnungs-unabhaengig).\n498\t+    r