|| defined(__clang__)\n261\t+  #define COMDARE_PERM_EXPORT __attribute__((visibility(\"default\")))\n262\t+#else\n263\t+  #define COMDARE_PERM_EXPORT\n264\t+#endif\n265\t+\n266\t+#define COMDARE_PERM_ID \"@@PERM_ID@@\"\n267\t+#define COMDARE_PERM_VERSION \"@@STORED_VERSION@@\"\n268\t+#define COMDARE_PERM_SIMD \"@@SIMD@@\"\n269\t+#define COMDARE_PERM_LAYOUT \"@@LAYOUT@@\"\n270\t+#define COMDARE_PERM_ALLOC \"@@ALLOC@@\"@@EXTRA_DEFINES@@\n271\t+\n272\t+// V38.C - PermDescriptor: ausserhalb namespace damit extern \"C\" sauberen Symbol-Namen exportiert\n273\t+struct PermDescriptor {\n274\t+    const char* id;\n275\t+    const char* version;\n276\t+    const char* axes;\n277\t+    int (*run)(unsigned long, double*);\n278\t+};\n279\t+\n280\t+extern \"C\" COMDARE_PERM_EXPORT const char* perm_@@PERM_ID@@_id() {\n281\t+    return COMDARE_PERM_ID;\n282\t+}\n283\t+\n284\t+extern \"C\" COMDARE_PERM_EXPORT const char* perm_@@PERM_ID@@_version() {\n285\t+    return COMDARE_PERM_VERSION;\n286\t+}\n287\t+\n288\t+extern \"C\" COMDARE_PERM_EXPORT const char* perm_@@PERM_ID@@_axes() {\n289\t+    return \"simd=@@SIMD@@,layout=@@LAYOUT@@,alloc=@@ALLOC@@ (real=\" COMDARE_ALLOC_NAME \")\";\n290\t+}\n291\t+\n292\t+// V39 (2026-05-24) - Echt achsen-spezifischer Algorithmus.\n293\t+// SIMD-Achse: Hash-Berechnung variiert (scalar / sse4 mit crc32 / avx2 mit gather-loop).\n294\t+// Layout-Achse: AoS=unordered_set, SoA=2 parallele Vektoren, hybrid=pair-Vektor.\n295\t+\n296\t+// Hash-Helper pro SIMD-Variant\n297\t+namespace v39_hash {\n298\t+    constexpr std::uint64_t kPrime = 11400714819323198485ULL;\n299\t+\n300\t+#if defined(COMDARE_PERM_SIMD_IS_AVX512)\n301\t+    // AVX-512: 8 keys parallel, extract lane 0\n302\t+    static inline std::uint64_t mix(std::uint64_t k) {\n303\t+        __m512i v = _mm512_set1_epi64(static_cast<long long>(k));\n304\t+        __m512i p = _mm512_set1_epi64(static_cast<long long>(kPrime));\n305\t+        __m512i x = _mm512_xor_si512(v, p);\n306\t+        __m256i lo = _mm512_castsi512_si256(x);\n307\t+        return static_cast<std::uint64_t>(_mm256_extract_epi64(lo, 0));\n308\t+    }\n309\t+#elif defined(COMDARE_PERM_SIMD_IS_AVX2)\n310\t+    // AVX2: 4 keys parallel\n311\t+    static inline std::uint64_t mix(std::uint64_t k) {\n312\t+        __m256i v = _mm256_set1_epi64x(static_cast<long long>(k));\n313\t+        __m256i p = _mm256_set1_epi64x(static_cast<long long>(kPrime));\n314\t+        __m256i x = _mm256_xor_si256(v, p);\n315\t+        return static_cast<std::uint64_t>(_mm256_extract_epi64(x, 0));\n316\t+    }\n317\t+#elif defined(COMDARE_PERM_SIMD_IS_SSE4)\n318\t+    // SSE4.2: hardware CRC32\n319\t+    static inline std::uint64_t mix(std::uint64_t k) {\n320\t+        return _mm_crc32_u64(kPrime, k);\n321\t+    }\n322\t+#elif defined(COMDARE_PERM_SIMD_IS_NEON)\n323\t+    // ARM NEON: 2 keys parallel, vector-xor\n324\t+    static inline std::uint64_t mix(std::uint64_t k) {\n325\t+        uint64x2_t v = vdupq_n_u64(k);\n326\t+        uint64x2_t p = vdupq_n_u64(kPrime);\n327\t+        return vgetq_lane_u64(veorq_u64(v, p), 0);\n328\t+    }\n329\t+#else\n330\t+    // scalar fallback: Fibonacci-Hash\n331\t+    static inline std::uint64_t mix(std::uint64_t k) {\n332\t+        return k * kPrime;\n333\t+    }\n334\t+#endif\n335\t+}\n336\t+\n337\t+extern \"C\" COMDARE_PERM_EXPORT int perm_@@PERM_ID@@_run(unsigned long n_ops, double* out_micros_per_op) {\n338\t+    if (!out_micros_per_op || n_ops == 0) {\n339\t+        return -1;\n340\t+    }\n341\t+\n342\t+    // V40.C Allokator-Stresstest: pro op eine kleine raw-Allokation\n343\t+    // ueber den achsenspezifischen Allocator (mi_malloc/je_malloc/std::malloc).\n344\t+    // Mit reservierter pre-allocated array werden die ops sichtbar verteilt.\n345\t+    {\n346\t+        constexpr std::size_t kBufSize = 32;  // klein, viele Operationen\n347\t+        for (unsigned long i = 0; i < (n_ops / 8); ++i) {\n348\t+            void* p = COMDARE_ALLOC(kBufSize);\n349\t+            // Anti