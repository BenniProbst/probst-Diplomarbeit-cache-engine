t+    // statt brute-force pair-vector. Zeigt trie-Charakteristik (O(log_16 N) depth).\n392\t+    comdare::cache_engine::indexes::RadixIndex store;\n393\t+    auto t0 = std::chrono::steady_clock::now();\n394\t+    for (unsigned long i = 0; i < n_ops; ++i) {\n395\t+        store.insert(static_cast<std::uint32_t>(v39_hash::mix(i)));\n396\t+    }\n397\t+    std::uint64_t hits = 0;\n398\t+    for (unsigned long i = 0; i < n_ops; ++i) {\n399\t+        if (store.contains(static_cast<std::uint32_t>(v39_hash::mix(i)))) ++hits;\n400\t+    }\n401\t+    auto t1 = std::chrono::steady_clock::now();\n402\t+#endif\n403\t+\n404\t+    if (hits != static_cast<std::uint64_t>(n_ops)) {\n405\t+        return -2;\n406\t+    }\n407\t+    double total_us = std::chrono::duration<double, std::micro>(t1 - t0).count();\n408\t+    *out_micros_per_op = total_us / static_cast<double>(n_ops * 2);\n409\t+    return 0;\n410\t+}\n411\t+\n412\t+// V38.C - Einheitliches Entry-Symbol fuer Plugin-Loader (ausserhalb namespace).\n413\t+// V40.D: axes string enthaelt real= zur Markierung wenn vendored allocator aktiv ist\n414\t+static constexpr char kAxes_@@PERM_ID@@[] =\n415\t+    \"simd=@@SIMD@@,layout=@@LAYOUT@@,alloc=@@ALLOC@@ (real=\" COMDARE_ALLOC_NAME \")\";\n416\t+static constexpr PermDescriptor kDescriptor_@@PERM_ID@@ {\n417\t+    COMDARE_PERM_ID,\n418\t+    COMDARE_PERM_VERSION,\n419\t+    kAxes_@@PERM_ID@@,\n420\t+    &perm_@@PERM_ID@@_run\n421\t+};\n422\t+\n423\t+extern \"C\" COMDARE_PERM_EXPORT const PermDescriptor* comdare_perm_descriptor() {\n424\t+    return &kDescriptor_@@PERM_ID@@;\n425\t+}\n426\t+)PERMTPL\";\n427\t+\n428\t } // namespace\n429\t \n430\t std::optional<Profile> parse_profile(std::string_view value) noexcept {\n431\t@@ -224,6 +518,94 @@ std::string render_manifest(Inputs const& inputs, std::vector<Permutation> const\n432\t     return out;\n433\t }\n434\t \n435\t+std::string axis_version_lookup(std::string_view axes_versions_content, std::string_view axis_key) {\n436\t+    // 