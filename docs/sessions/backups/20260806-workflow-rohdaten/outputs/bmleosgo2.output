         }
         void do_deallocate(void* p, std::size_t bytes, std::size_t alignment) override {
             strat_->deallocate(p, bytes, alignment);
diff --git a/libs/cache_engine/axes/cacheline/node_width_config.hpp b/libs/cache_engine/axes/cacheline/node_width_config.hpp
index 64d3cb02..13ecdaec 100644
