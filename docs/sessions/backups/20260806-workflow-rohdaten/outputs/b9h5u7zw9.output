docs/sessions/20260709-BACKUP-impl-sessions-rohdaten-memories/scratchpad-rohdaten/j7764.json:1:[{"id":201207,"status":"success","stage":"chaos","name":"chaos:drift","ref":"main","tag":false,"coverage":null,"allow_failure":false,"created_at":"2026-07-04T16:45:18.325Z","started_at":"2026-07-05T05:49:43.660Z","finished_at":"2026-07-05T05:55:10.954Z","erased_at":null,"duration":327.293551,"queued_duration":3961.60002,"user":{"id":1,"username":"root","public_email":null,"name":"Administrator","state":"active","locked":false,"avatar_url":"https://secure.gravatar.com/avatar/cda9ed339d5b94a8b88b886590d2618a3812352a04a9b5f27d1df736a4cde221?s=80\u0026d=identicon","web_url":"https://gitlab.comdare.de/root","created_at":"2026-02-24T23:11:24.059Z","bio":"","location":"","linkedin":"","twitter":"","discord":"","website_url":"","github":"","job_title":"","pronouns":null,"organization":"","bot":false,"work_information":null,"followers":0,"following":0,"local_time":null},"commit":{"id":"d3cb29807b4781925daafaf6d214fbee08fe8531","short_id":"d3cb2980","created_at":"2026-07-04T18:44:49.000+02:00","parent_ids":["0e89a1a041b8adc8d1a3318e6a96e4cb0ccb842a"],"title":"#221 AUDIT-A3 K1: RC prefetch_distance als Laufzeit-Knopf am realen Store-Prefetch (ABI-4, golden-neutral)","message":"#221 AUDIT-A3 K1: RC prefetch_distance als Laufzeit-Knopf am realen Store-Prefetch (ABI-4, golden-neutral)\n\nSchliesst den write-only-RC-Defekt (applied_rc_ nie gelesen) fuer die prefetch-Achse:\n- axis_07 DistanceEstimator bekommt set_runtime_distance() (nur family==1); Default 0 = compile-time\n  estimate() -\u003e golden-320-neutral (statische Binaries unveraendert).\n- abi_adapter::tier_apply_resource_control propagiert applied_rc_.prefetch_distance -\u003e pf_organ_\n  (if constexpr requires{set_runtime_distance}; None/Hardware/Path no-op).\n- Effekt ueber den REALEN Store-Prefetch (Pfad B / tier_observe), KEIN synthetisches Pfad-A-do_batch\n  (Meta-Lehre #3 — kein Setup-Puffer).\n- test_221_rc_prefetch_distance: zwei RC-Distanzen auf DERSELBEN geladenen Binary -\u003e verschiedener realer T7.\n\nLokal MSVC verifiziert (Standalone-Smoke der realen DistanceTier-Komposition):\n  T7 last_prefetch_distance: default=4  rc=2 -\u003e2  rc=9 -\u003e9\n  PASS: RC prefetch_distance steuert realen T7 / exit=0\n\nABI-Major bleibt 4; kein POD/vtable/extern-C-Change; permutation_axes.xml/golden/registry unberuehrt.\nDie 4 uebrigen RC-Achsen (concurrency/allocator/traversal/value_handle) + KF-5-Voll-API bleiben #229-Folge.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) \u003cnoreply@anthropic.com\u003e\n","author_name":"Benjamin-Elias Probst","author_email":"benjamineliasprobst@gmail.com","authored_date":"2026-07-04T18:44:49.000+02:00","committer_name":"Benjamin-Elias Probst","committer_email":"benjamineliasprobst@gmail.com","committed_date":"2026-07-04T18:44:49.000+02:00","trailers":{},"extended_trailers":{},"web_url":"https://gitlab.comdare.de/comdare/research/comdare-cache-engine/-/commit/d3cb29807b4781925daafaf6d214fbee08fe8531"},"pipeline":{"id":7764,"iid":334,"project_id":286,"sha":"d3cb29807b4781925daafaf6d214fbee08fe8531","ref":"main","status":"failed","source":"push","created_at":"2026-07-04T16:45:17.654Z","updated_at":"2026-07-05T05:55:11.241Z","web_url":"https://gitlab.comdare.de/comdare/research/comdare-cache-engine/-/pipelines/7764"},"web_url":"https://gitlab.comdare.de/comdare/research/comdare-cache-engine/-/jobs/201207","project":{"ci_job_token_scope_enabled":false},"artifacts":[],"runner":{"id":16,"description":"prod-baremetal-prod1","ip_address":null,"active":true,"paused":false,"is_shared":true,"runner_type":"instance_type","name":null,"online":true,"created_by":{"id":1,"username":"root","public_email":null,"name":"Administrator","state":"active","locked":false,"avatar_url":"https://secure.gravatar.com/avatar/cda9ed339d5b94a8b88b886590d2618a3812352a04a9b5f27d1df736a4cde221?s=80\u0026d=identicon","web_url":"https://gitlab.comdare.de/root"},"created_at":"2026-06-2