     1	# comdare-cache-engine — GitLab CI/CD (REV 10, 2026-06-25): ci-templates-Lint + PMC-Smoke + Contract
     2	# ─────────────────────────────────────────────────────────────────────────────
     3	# REV 10 (Debug-Befunde Pipeline 6948):
     4	#  - lint:secrets GRÜN (hermetischer gitleaks-Bootstrap real bewiesen).
     5	#  - Artefakt-Object-Storage wirft nach dem Secret-Swap HTTP 500 „invalid argument" auf großen Uploads
     6	#    (das `build/`-Artefakt der cache-engine ist riesig) → build+measure zu EINEM `pmc`-Job gemergt,
     7	#    KEIN build/-Artefakt-Upload (Smoke-Beleg = ctest-Log). [Storage-Fix = Infra, Handoff geschrieben.]
     8	#  - pmc:intel bis zum prod2-Runner-Fix per Variable gegatet (Infra spielt meinen SSH-Key auf prod2).
     9	#  - contract: baut die ABI-Smoke-Tests + exakte ctest-Regex (vorher matchte 'abi' ungebaute Tests).
    10	# measure-PMC bleibt erhalten (perf_event_open, bare-metal); der mehrtägige Voll-Mess-Lauf ist separat.
    11	
    12	include:
    13	  - project: 'comdare/cluster/ci-templates'
    14	    ref: development
    15	    file: '/base-pipeline.yml'
    16	
    17	workflow:
    18	  rules:
    19	    - if: '$CI_COMMIT_TAG'
    20	      when: never
    21	    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    22	    - if: '$CI_PIPELINE_SOURCE == "web"'
    23	    - if: '$CI_PIPELINE_SOURCE == "pipeline"'
    24	    - if: '$CI_COMMIT_BRANCH'
    25	
    26	stages:
    27	  - lint
    28	  - build
    29	  - sanitize
    30	  - contract
    31	  - test           # CI-2 (#264): Voll-Suite via Sammel-Target comdare_tests (Probelauf, s. test:unit)
    32	  - chaos          # Stufe 6 (#197, EPIC #186): Mess-Drift-Detektor + Rerun-Gate (Selbstheilung)
    33	
    34	# #277/#21 (User 06.07.): ccache-Bestand auf dev-MinIO via runners.cache; projektlokales CCACHE_DIR fuer cache:-Sync.
    35	# CI-REGRESSION 04.08. (Owner-Auftrag): restore_cache 4s (27.07.) -> 150s (04.08.), weil EIN Misch-Key
    36	# vier Objektklassen (gcc-Release/asan/tsan/clang) trug, permanent am 5G-Deckel lief (Major-8-Leichen
    37	# bleiben im LRU) und JEDER Compile-Job pull-push fuhr (bis zu 2 konkurrierende cache-archiver je Key).
    38	# HEILUNG nach dem bewaehrten super-#53-Muster: (a) Klassen-Keys mit je GENAU EINEM Writer
    39	# (gcc-Release=test:unit, asan/tsan/clang=je ihr Job), Konsumenten pull-only via .ccache-pull;
    40	# (b) Key-Rotation '-a8' wirft die toten Major-7-Objekte nach dem ABI-Major-8 weg (einmalige
    41	# Cold-Kosten deklariert); (c) MAXSIZE 5G -> 3G (Zip-Transfer je Job klein halten, super-Vorbild).
    42	cache:
    43	  key: "ccache-$CI_PROJECT_NAME-a8"
    44	  paths: [".ccache"]
    45	
    46	variables:
    47	  CCACHE_DIR: "$CI_PROJECT_DIR/.ccache"
    48	  CCACHE_MAXSIZE: "3G"
    49	  # PMC-Doktrin (User 23.07.): deklarierte Vendor-Lane-Menge dieses Clusters. Jede deklarierte Lane
    50	  # MUSS ihren pmc-Job gruen bestehen (AND ueber die Deklaration); Fremd-Cluster ueberschreiben per
    51	  # Projekt-/Pipeline-Variable (z.B. "intel" auf intel-only-Clustern) -> verschiffbare Pipeline.
    52	  COMDARE_PMC_LANES: "amd intel"
    53	  GIT_SUBMODULE_STRATEGY: none
    54	  CMAKE_BUILD_PARALLEL_LEVEL: "6"          # User 2026-07-06: 2x6 Kerne bei concurrent=2 (prod1 16C; revidiert 4@8-Kern-cgroup-Aera)
    55	  COMDARE_LINT_PATHS: "libs apps tests adapters benchmark_suite benchmarks"
    56	  # contract: ABI-Contract-Smoke = test_abi_interface (std::map/ABI-Interface-Kontrakt). test_v41_anatomy_module_abi
    57	  # ist der schwerere anatomy-MODULE-Test (eigener Linux-Build) -> gehoert in den vollen Test-Stage/#179-Sweep,
    58	  # NICHT in den Contract-Smoke. (REV 11: vorher zog er den mimalloc-Kettel-Include-Bug rein, jetzt gefixt.)
    59	  COMDARE_CONTRACT_CMD: "cmake -B build-contract -G Ninja -DCOMDARE_BUILD_TESTS=ON && cmake --build build-contract --target test_abi_interface && ctest --test-dir build-contract -R '^test_abi_interface$' --output-on-failure -V"
    60	
    61	# ccache-Hygiene (super-#53-Muster): Konsumenten ziehen den gcc-Release-ccache NUR (policy: pull);
    62	# der EINE Writer des Haupt-Keys ist test:unit (Voll-Suite = maximale Objekt-Abdeckung).
    63	.ccache-pull:
    64	  cache:
    65	    key: "ccache-$CI_PROJECT_NAME-a8"
    66	    paths: [".ccache"]
    67	    policy: pull
    68	
    69	# ── Stufe 1: Lint (aus ci-templates) ──
    70	lint:secrets:
    71	  extends: .lint-secrets
    72	  tags: [baremetal]
    73	lint:format:
    74	  extends: .lint-format
    75	  tags: [baremetal]
    76	lint:static:
    77	  extends: .lint-static
    78	  tags: [baremetal]
    79	
    80	# ── Bare-Metal-PMC-Smoke (build+measure in EINEM Job; KEIN großes Artefakt) ──
    81	.bare_metal:
    82	  extends: .ccache-pull   # ccache-Hygiene 04.08.: alle bare-metal-Erben sind Konsumenten (pull-only)
    83	  before_script:
    84	    - 'echo "== Host =="; uname -a; (lscpu | grep -E "Vendor ID|Model name") || true'
    85	    - 'echo "== perf_event_paranoid =="; cat /proc/sys/kernel/perf_event_paranoid || true'
    86	    - 'echo "== Toolchain =="; cmake --version; (g++ --version || c++ --version || echo "KEIN C++-Compiler"); (ninja --version || echo "kein ninja")'
    87	
    88	# ── #273-T3 (2026-07-07): build:clang-Rollout — ce baut die Voll-Suite unter dem neuesten clang. ──
    89	# OPT-IN + advisory (COMDARE_CLANG_MATRIX=="1", wie super-T1): destabilisiert die Hauptpipeline NICHT.
    90	# clang-22.1.8 ist auf den bare-metal-Runnern vorhanden; lokal comdare_tests EXIT 0 bewiesen (07.07.).
    91	# Der gcc-15.3-Pin (T2) ist SEPARAT + gcc-15.3-gated (HO-11) und NICHT Teil dieses Jobs.
    92	build:clang:
    93	  extends: .build-clang-latest
    94	  stage: build
    95	  tags: [baremetal]
    96	  cache:   # ccache-Hygiene 04.08.: eigene Objektklasse (clang) = eigener Key, DIESER Job ist ihr Writer
    97	    key: "ccache-$CI_PROJECT_NAME-clang-a8"
    98	    paths: [".ccache"]
    99	  variables:
   100	    COMDARE_CMAKE_SOURCE_DIR: "."
   101	    COMDARE_AUDIT_BUILD_TYPE: "Release"
   102	    COMDARE_CMAKE_CONFIGURE_FLAGS: "-G Ninja -DCOMDARE_BUILD_TESTS=ON"
   103	    COMDARE_CMAKE_BUILD_TARGET: "comdare_tests"
   104	
   105	.pmc:
   106	  extends: .bare_metal
   107	  stage: build
   108	  timeout: 15m   # Härtung 2026-07-09: fail-fast statt 60min-Default. Ein hängender bare-metal-Node (prod2-configure-Hang 08.07., 3×60min verbrannt) failt so nach 15min statt eine Stunde je Pipeline zu blockieren. Normal-Lauf < 3min (configure 0.7s + smoke-Build + ctest).
   109	  needs: ["lint:secrets"]   # Codex-Review 06-27: hart auf den Secrets-Gate warten (sonst läuft Build trotz Leak)
   110	  script:
   111	    - cmake -B build -G Ninja -DCOMDARE_BUILD_TESTS=ON -DCOMDARE_ENABLE_PMC=ON
   112	    # Build-Parallelität via CMAKE_BUILD_PARALLEL_LEVEL=4 (Runner-Core-Budget, User 2026-06-25), NICHT -j nproc
   113	    # M-CE-25 (Muster-F, 2026-07-13): m3v2_pmc_smoke (Label pmc) lief in KEINEM Job — test:unit schliesst es per
   114	    # -LE pmc aus, kein dedizierter -R matchte es. Es beweist die geschlossene PMC-Naht im Lazy-WIDE-Pfad und
   115	    # gehoert damit in den PMC-Gate. Mit COMDARE_ENABLE_PMC=ON (echte Quelle, available=1) ist der Naht-Beweis
   116	    # scharf (Inversion-Fix: live-PMC = SMOKE_OK). Lokal gruen bewiesen.
   117	    - cmake --build build --target linux_perf_pmc_smoke m3v2_pmc_smoke
   118	    - ctest --test-dir build -R '^(linux_perf_pmc_smoke|m3v2_pmc_smoke)$' --output-on-failure -V
   119	  # KEINE Artefakte: das build/-Tree-Artefakt scheiterte am Object-Storage-500 (post-swap). Beleg = ctest-Log.
   120	
   121	# PMC-DOKTRIN (User 2026-07-23, 2 Stufen — Verschiffbarkeit): je Vendor-Maschine ihr eigener
   122	# PMC-Beweis (unsere Smokes = der PMC-Pfad UNSERES Programms), HART fuer jede DEKLARIERTE Lane:
   123	# COMDARE_PMC_LANES deklariert die Maschinen-Menge des Clusters (Default hier: "amd intel" =
   124	# AND, beide Pflicht ohne allow_failure — auf Comdare sind stets beide verfuegbar). Andere
   125	# Cluster verschiffen mit Projekt-/Pipeline-Override (z.B. "intel") -> nur die vorhandene Lane
   126	# wird instanziiert und muss gruen sein (XOR-Verfuegbarkeit), keine Phantom-Pflicht auf nicht
   127	# existente Vendor-Maschinen. Eine deklarierte, aber tote Maschine blockiert EHRLICH (die Lane
   128	# koennte auch nicht messen). Runner-Filter: prod1-Tags nur amd / prod2-Tags nur intel (UND-
   129	# Semantik) — nur die passende Vendor-Maschine kann ihren Job annehmen.
   130	# Probe-Beleg Reaktivierung: Pipeline 12757 pmc:intel=success + pmc:amd=success (23.07.).
   131	# [DEPRECATED-Historie 09.-23.07.: pmc:intel war rules-gated auf COMDARE_PROD2_AVAILABLE wegen
   132	#  prod2-Node-Problemen (Handover docs/sessions/20260709-*); prod2 seit 22.07. dauerhaft gesund.]
   133	pmc:amd:
   134	  extends: .pmc
   135	  tags: [baremetal, amd]
   136	  rules:
   137	    - if: '$COMDARE_PMC_LANES =~ /amd/'
   138	
   139	pmc:intel:
   140	  extends: .pmc
   141	  tags: [baremetal, intel]
   142	  rules:
   143	    - if: '$COMDARE_PMC_LANES =~ /intel/'
   144	
   145	# ── #270b (2026-07-07): 3-ISA-Teilmatrix-INSTANZIIERUNG — arm64-Smoke auf node7-rpi5-arm64 (tag arm64). ──
   146	# OPT-IN + advisory: die HARTE Scharfschaltung als CI-PFLICHT ist ausdruecklich #276 (letzte Ledger-Aufgabe).
   147	# Dieser Job destabilisiert die Hauptpipeline NICHT (rules-gated auf COMDARE_ISA_MATRIX=="true"), baut nur eine
   148	# kleine, ISA-repraesentative Teilmenge (der cpuid/isa-Probe-Test + das Conformance-Gate) und laeuft ihn — der
   149	# Beweis, dass der arm64-Toolchain-Pfad traegt. Bei node7-Freeze/Toolchain-Luecke: Runner-Endstrecke = Task #23
   150	# (K87b-Montags-Audit); dieser Job bleibt dann instanziiert-aber-ungetriggert (kein Pipeline-Schaden).
   151	build:arm64-smoke:
   152	  stage: test
   153	  tags: [arm64]
   154	  needs: []
   155	  allow_failure: true
   156	  rules:
   157	    - if: '$COMDARE_ISA_MATRIX == "true"'
   158	  script:
   159	    - 'echo "== arm64-Teilmatrix-Smoke auf $(uname -m) =="'
   160	    - 'test "$(uname -m)" = "aarch64" || { echo "FEHLER: kein aarch64-Runner (uname=$(uname -m))"; exit 1; }'
   161	    - _CC=cc; _CXX=c++; command -v g++-13 >/dev/null 2>&1 && { _CC=gcc-13; _CXX=g++-13; }
   162	    - cmake -B build-arm64 -G Ninja -DCMAKE_C_COMPILER="$_CC" -DCMAKE_CXX_COMPILER="$_CXX" -DCOMDARE_BUILD_TESTS=ON
   163	    - cmake --build build-arm64 --target test_cpuid_probe test_conformance_gate
   164	    - ctest --test-dir build-arm64 -R "^(test_cpuid_probe|test_conformance_gate)$" --output-on-failure
   165	  artifacts:
   166	    paths: []
   167	
   168	# ── Stufe 3b: Sanitize (ASan+UBSan, 10-Stufen-Prinzip P1b) — fängt Memory-/UB-Bugs ──
   169	# advisory (allow_failure) bis #179-Bereinigung, danach HART. Eigener Debug+Sanitizer-Build, kein Artefakt.
   170	# #278 (2026-07-06): HART geschaltet — Gruen-Beweise Pipelines 8190 UND 8191 (2x in Folge success).
   171	sanitize:asan-ubsan:
   172	  extends: .bare_metal
   173	  stage: sanitize
   174	  tags: [baremetal]
   175	  cache:   # ccache-Hygiene 04.08.: eigene Objektklasse (asan/ubsan-Flags) = eigener Key, DIESER Job ist ihr Writer
   176	    key: "ccache-$CI_PROJECT_NAME-asan-a8"
   177	    paths: [".ccache"]
   178	  needs: ["lint:secrets"]   # Codex-Review 06-27: hart auf den Secrets-Gate warten (sonst läuft Build trotz Leak)
   179	  script:
   180	    - cmake -B build-san -G Ninja -DCOMDARE_BUILD_TESTS=ON -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all" -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=address,undefined"
   181	    # #204/264-b: Target-Liste um die 5 schnellen, contract-gruen-bewiesenen Gates erweitert (advisory).
   182	    - cmake --build build-san --target test_abi_interface test_config_durability test_conformance_gate test_experiment_driver_v13 test_chaos_drift_gate
   183	    - 'ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=print_stacktrace=1 ctest --test-dir build-san -R "^(test_abi_interface|test_config_durability|test_conformance_gate|test_experiment_driver_v13|test_chaos_drift_gate)$" --output-on-failure -V'
   184	
   185	# ── Stufe 4: Contract (aus ci-templates; ABI-Smoke eigenständig, kein großes Artefakt) ──
   186	contract:
   187	  extends: [.contract, .ccache-pull]   # ccache-Hygiene 04.08.: Konsument des gcc-Release-Keys (pull-only)
   188	  tags: [baremetal]
   189	  needs: ["lint:secrets"]   # Codex-Review 06-27: hart auf den Secrets-Gate warten (sonst läuft Build trotz Leak)
   190	  artifacts:
   191	    paths: []     # Override: kein build/Testing/-Artefakt (Storage-500 + Pfad-Mismatch zu build-contract)
   192	
   193	# ── Stufe 4b: Contract config-durability-Gate (#195, Pipeline P0 / EPIC #186) ──
   194	# Müll-/kaputte Config-XMLs duerfen die Parser (cx::parse_document + wd::parse_load_profile) NICHT
   195	# crashen (Segfault/UB), sondern muessen sauber nullopt liefern. Eigenstaendiger Bau des GTest-
   196	# Negativtests test_config_durability (kein grosses Artefakt). Crash an einer Müll-Config = Prozess
   197	# stirbt = ctest FAILED = CI rot → das Gate faengt eine Robustheits-Regression VOR dem Mess-/Deploy-
   198	# Pfad ab. Mirror der .pmc-/contract-Konventionen (eigener Build, kein Artefakt, lint:secrets-Gate).
   199	contract:durability:
   200	  extends: .bare_metal
   201	  stage: contract
   202	  tags: [baremetal]
   203	  needs: ["lint:secrets"]   # hart auf den Secrets-Gate warten (Konvention wie .pmc/contract)
   204	  script:
   205	    # Build-Parallelitaet via globalem CMAKE_BUILD_PARALLEL_LEVEL (Runner-Core-Budget), NICHT -j nproc.
   206	    - cmake -B build-dur -G Ninja -DCOMDARE_BUILD_TESTS=ON
   207	    - cmake --build build-dur --target test_config_durability
   208	    - ctest --test-dir build-dur -R '^test_config_durability$' --output-on-failure -V
   209	  artifacts:
   210	    paths: []     # kein build/Testing/-Artefakt (Storage-500-Konvention der anderen contract-Jobs)
   211	
   212	# ── Stufe 4c: Contract Konformitaets-Gate-Regression (#223, Pipeline P0 / EPIC #186) ──
   213	# Das std::map-Konformitaets-Gate (import->GATE->messen, builder/pruef_dock/conformance_gate.hpp) MUSS
   214	# nicht-konforme Tier-Huellen FANGEN — sonst rutschten ungueltige Lebewesen als gueltige Mess-Zeilen durch
   215	# (Meta-Lehre #3). test_conformance_gate treibt eine konforme std::map-Huelle (muss bestehen) + gezielt
   216	# defekte Huellen (muessen gefangen werden) durch run_conformance_gate; faengt das Gate eine Nicht-Konformitaet
   217	# NICHT, ist der Test rot = CI rot. Reines C++/std::map (Linux-g++), kein cl/thesis_tiere-Harness -> schliesst
   218	# die Harness-CI-Verifikationsluecke fuer genau diesen Konformitaets-Contract. Mirror der .pmc-/contract-Konv.
   219	# #188-4c-0 (2026-07-02): +test_188_4c0_known_compositions_conformance — alle 11 Reference-/PaperBinding-
   220	# Compositions durch dasselbe Gate am realen Adapter (Sicherheitsnetz fuer den Spiegel-Abbau #188-4c;
   221	# seit #188-4c-i routes_through_store==true: Huellen container_-authoritativ). Exakter 2-Target-Regex (bb0-Lehre).
   222	contract:conformance:
   223	  extends: .bare_metal
   224	  stage: contract
   225	  tags: [baremetal]
   226	  needs: ["lint:secrets"]   # hart auf den Secrets-Gate warten (Konvention wie .pmc/contract/durability)
   227	  script:
   228	    # Build-Parallelitaet via globalem CMAKE_BUILD_PARALLEL_LEVEL (Runner-Core-Budget), NICHT -j nproc.
   229	    # #188-4c-0b (2026-07-02): Known-Compositions duerfen Paper-Original-Wrapper auch ohne ext-Submodule
   230	    # kompilieren. is_original-Mixins sind jetzt per COMDARE_A06/A03A/AQ1_IS_ORIGINAL_CODEGEN gegated;
   231	    # kein CI-Erzwingen von ORIGINAL_CODE_VALIDATION=ON, weil ext/ im Runner leer sein kann.
   232	    # #188-4c-ii (2026-07-02): +test_188_4cii_flat_wrapper_traversal — die 4 Flach-Wrapper store-traversierbar
   233	    # (DirectAddress-/SortedVectorTraversal); exakter 3-Target-Regex (bb0-Lehre).
   234	    - cmake -B build-conf -G Ninja -DCOMDARE_BUILD_TESTS=ON
   235	    # #216-H2 (2026-07-03): +test_216h2_stat_reset_after_load (daten-erhaltender Stat-Reset nach Load belegt) +
   236	    # test_v41_anatomy_module_abi (ABI-Major 3->4 Loader-Reject-Verifikation).
   237	    # #267 CMD-1-a (2026-07-06): +test_cmd1_a_axis_command_base — Compile-time-Command-Vertrag der Achsen
   238	    # (AxisCommand ueber 27 AxisBase-Erben, Mess-Visitor-Slot, AxisLimitations). Befund 8073/Job 213476: das
   239	    # Label 'contract' allein laesst KEINEN CI-Job den Test fahren (Jobs bauen gezielte Targets) -> explizit
   240	    # hier aufgenommen (User-Direktive: Tests nie auslassen).
   241	    # M-CE-25 (Muster-F, 2026-07-13): +test_ap15_2_get_allocator_proxy +test_ap15_3_driveable_map_contract
   242	    # +test_29_container_framework — contract-gelabelt, aber von KEINEM -R-Job gefahren (test:unit -LE contract).
   243	    # Hier in den Konformitaets-Gate aufgenommen (Container-/Allocator-Proxy-Vertraege). Lokal gruen bewiesen.
   244	    # F5.R1 (#35, 2026-07-16): +test_v41_cache_engine_facade — der API-Vermittlungs-Vertrag der Master-Framework-
   245	    # Gesamt-Fassade (get_cache_engine() ueber die EINE Tuer). Sichert die geschlossene Linker-Falle + die
   246	    # ehrliche DEFERRED-#274-Meldung als CI-Gate. Lokal 7/7 PASSED. Baut in demselben build-conf-Tree.
   247	    - cmake --build build-conf --target test_conformance_gate test_188_4c0_known_compositions_conformance test_188_4cii_flat_wrapper_traversal test_216h2_stat_reset_after_load test_v41_anatomy_module_abi test_cmd1_a_axis_command_base test_ap15_2_get_allocator_proxy test_ap15_3_driveable_map_contract test_29_container_framework test_v41_cache_engine_facade
   248	    - ctest --test-dir build-conf -R '^(test_conformance_gate|test_188_4c0_known_compositions_conformance|test_188_4cii_flat_wrapper_traversal|test_216h2_stat_reset_after_load|test_v41_anatomy_module_abi|test_cmd1_a_axis_command_base|test_ap15_2_get_allocator_proxy|test_ap15_3_driveable_map_contract|test_29_container_framework|test_v41_cache_engine_facade)$' --output-on-failure -V
   249	  artifacts:
   250	    paths: []     # kein build/Testing/-Artefakt (Storage-500-Konvention der anderen contract-Jobs)
   251	
   252	# ── Stufe 4d: Contract Pool-Adapter-Flip Compile-Gate (#188-4b-b-V, Pipeline P0 / EPIC #186) ──
   253	# Der 4b-b1b-container_-Flip (anatomy/abi_adapter.hpp) stellt fuer die 9 Weg-B-Pool-Familien (roher search_algo-
   254	# Wrapper → pool_family_==true) container_ auf ObservableComposedContainer<organ_for_search_algo_t<S>> (natives u64-
   255	# Organ, via lazy type_identity/conditional_t) um und routet insert/lookup/erase/T0-Observer/T0-Segment-Timing ueber
   256	# container_is_authoritative_. Explore+Codex-Befund: KEIN anderes CI-Target instanziiert diesen Pool-Zweig DURCH den
   257	# ABI-Adapter (test_conformance_gate = k-ary/organ==void; abi_interface/durability/chaos/pmc nutzen den Adapter nicht;
   258	# tier150 = Organ-Huelle/pool_family_==false) → der Flip war nur Codex-/static_assert-verifiziert, NIE compiliert.
   259	# test_188_4bbV instanziiert SearchAlgorithmAbiAdapter<SearchAlgorithmAnatomy<PoolFlipComposition<W>>> fuer ALLE 9
   260	# Pool-Familien und treibt jeden ueber insert/lookup/erase/size/clear + tier_observe → erzwingt die Template-
   261	# Instanziierung des Pool-Zweigs. Ein type_identity-/Routing-Compile-Fehler ODER eine Smoke-Regression = ctest FAILED
   262	# = CI rot → das Gate faengt eine Flip-Regression VOR dem 320-DLL-Mess-Lauf (#215) ab. COMDARE_MEASUREMENT_ON (CMake)
   263	# aktiviert IObservableTier + den Segment-Timing-Pfad. Mirror der contract:conformance-Konventionen (eigener Build,
   264	# kein Artefakt, lint:secrets-Gate).
   265	# #188-4a (2026-07-02): +test_188_4a_eytzinger_organ — Eytzinger als 10. organ_for-Familie (EytzingerLayoutStore,
   266	# Option b lazy rebuild): std::map-Konformitaet + Wrapper-Aequivalenz + dirty-Semantik + for_each_record-Ernte
