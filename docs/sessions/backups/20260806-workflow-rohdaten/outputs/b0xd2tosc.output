   455	
   456	# ── CI-2 (#264/264-b): Voll-Suite-PROBELAUF via Sammel-Target comdare_tests (base-pipeline .test-Template). ──
   457	# CI-6-Konvention: allow_failure bis zum ersten dokumentierten Gruen-Beweis; Hard-Gate erst nach 264-d
   458	# (-j/RAM-Politik CI-5 + #179). Ehrlicher Ist-Stand beim Anlegen (Commit 8669210d): comdare_tests baut
   459	# 788/788; ctest-Vollauf lokal 126/184 passed, 58 Laufzeit-Fails (Inventar im Ledger) -- dieser Job macht
   460	# den Stand pipeline-sichtbar, behauptet aber KEIN Gruen.
   461	# #278 (2026-07-06): HART geschaltet — Einzelfix-Serie 62->0; Gruen-Beweis LITERAL Job 214827
   462	# (Pipeline 8191, 861dce2d): "100% tests passed, 0 tests failed out of 164".
   463	test:unit:
   464	  extends: .test
   465	  tags: [baremetal]
   466	  needs: ["lint:secrets"]
   467	  variables:
   468	    COMDARE_TEST_CONFIGURE_FLAGS: "-DCOMDARE_BUILD_TESTS=ON"
   469	    COMDARE_TEST_BUILD_TARGET: "comdare_tests"
   470	    # G4a (2026-07-26): comdare_profile_run_facade ergaenzt. Die Fassade ist EXCLUDE_FROM_ALL und haengt an keinem
   471	    # Test-Target -- sie wurde in test:unit bislang GAR NICHT uebersetzt (Blindfleck-Befund: das Objektverzeichnis
   472	    # enthielt nur CXXDependInfo.json). Ein gruener Vollbau war damit keine Aussage ueber profile_run_entry.hpp;
   473	    # eine Regression dort waere erst im Voll-Bau-4 aufgefallen. Prebuild statt Test-Target, weil es eine Bibliothek
   474	    # ohne eigene Tests ist -- der 2-Pass baut sie mit, der Compiler ist hier die Wache.
   475	    COMDARE_TEST_PREBUILD_TARGET: "comdare_anatomy_codegen_cli comdare_profile_run_facade"  # V-4 (27.07.): comdare_permutation_codegen_cli entfaellt mit dem Permutations-Retire (Target existiert nicht mehr)
   476	    # #278 Job-Scope (2026-07-06, Job 214641): contract-/pmc-Tests laufen bereits HART in ihren eigenen
   477	    # Jobs (contract:* / pmc:amd) — im unit-Sammel-Lauf zaehlten sie als "Not Run" (5x). KEIN Auslassen:
   478	    # der Ausschluss verweist auf die dedizierten Gates; unit-Scope = alles andere.
   479	    COMDARE_TEST_CTEST_ARGS: "-LE contract|pmc"
