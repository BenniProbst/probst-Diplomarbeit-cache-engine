+    echo "FEHLER: Lauf-Kennung '$AF_SNAP_KENNUNG' ist kein schlichter Ordner-Namensteil" >&2; exit 1 ;;
+esac
+echo "   E-18-SNAP: Lauf-Kennung=$AF_SNAP_KENNUNG (runneruebergreifend eindeutiger Ordnername)"
+
