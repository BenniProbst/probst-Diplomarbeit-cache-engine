 grep -q "mkdir-Lock verloren" "$H/h2_lock.log" && ok "mkdir-Lock-Zweig genommen"
-pruef "Lock-Fall weicht auf Suffix aus" "$([ -d "$R/w_lock/measurement/thesis_compiles/$TS2-2" ] && echo ja || echo nein)" "ja"
