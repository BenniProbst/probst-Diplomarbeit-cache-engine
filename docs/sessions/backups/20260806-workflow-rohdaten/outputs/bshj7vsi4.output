+  while IFS='|' read -r zustand sicherung rel; do
+    [ -n "$rel" ] || continue
+    case "$zustand" in
+      neu)
+        if git -C "$AF_DEST_REPO" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
