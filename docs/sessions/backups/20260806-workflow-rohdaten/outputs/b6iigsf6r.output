d_test(NAME m3v2_pmc_smoke COMMAND m3v2_pmc_smoke)\r\n 1653: set_tests_properties(m3v2_pmc_smoke PROPERTIES LABELS \"phase_e;standalone;pmc\")\r\n 1654: \r\n 1655: # #230-Rest (W1, 2026-07-02) - Contract-Compile-Gate fuer den Host-Treiber-Stack des thesis_tiere-Harness:\r\n 1656: # cache_engine_builder_iterator.hpp + perm_runner.hpp + side-effect-freie Baum-/CSV-/Runner-Datenpfade. Kein\r\n 1657: # run_lazy, keine DLLs, keine Messung, keine CSV-Dateien - nur Compile+Smoke der Treiber-Schicht vor den\r\n 1658: # Node-Shape-Achsen. Gleicher schwerer Include-/Define-Satz wie m3v2_pmc_smoke.\r\n 1659: add_executable(test_harness_compile \"test_harness_compile.cpp\")\r\n 1660: target_compile_features(test_harness_compile PRIVATE cxx_std_23)\r\n 1661: target_include_directories(test_harness_compile PRIVATE\r\n 1662:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n 1663:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n 1664:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n 1665:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/builder\"\r\n 1666:     \"${PROJECT_SOURCE_DIR}/libs/common\"\r\n 1667:     \"${CMAKE_BINARY_DIR}/generated\"\r\n 1668:     ${COMDARE_ALL_AXIS_GENERATED_DIRS})\r\n 1669: target_link_libraries(test_harness_compile PRIVATE Boost::mp11)\r\n 1670: comdare_set_platform_defines(test_harness_compile)\r\n 1671: target_compile_definitions(test_harness_compile PRIVATE\r\n 1672:     COMDARE_MEASUREMENT_ON=1 COMDARE_CE_ENABLE_STATISTICS=1 COMDARE_EXPERIMENT_MODE_ON=1)\r\n 1673: add_test(NAME test_harness_compile COMMAND test_harness_compile)\r\n 1674: set_tests_properties(test_harness_compile PROPERTIES LABELS \"contract;standalone;harness\")\r\n 1675: \r\n 1676: # CE-DL2 (Task #152) — LINUX-PMC-Smoke fuer die LinuxPerfPmcSource (perf_event_open). Spiegel von m3v2_pmc_smoke,\r\n 1677: # aber LINUX-CONDITIONAL registriert: nur unter (UNIX AND NOT APPLE) — der Windows-/MSVC-Build sieht dieses Target\r\n 1678: # NIE (kein add_executable, keine Linux-Header). make_pmc_source() liefert auf Linux+COMDARE_ENABLE_PMC eine\r\n 1679: # LinuxPerfPmcSource; der Smoke klammert begin()/end() um eine speicherruehrende Pointer-Chasing-Schleife und\r\n 1680: # prueft LITERAL: Zugriff -> available==1 UND >=1 Counter != 0; kein Zugriff (paranoid/EACCES/Container) ->\r\n 1835: add_test(NAME test_d13_dll_runtime_measure COMMAND test_d13_dll_runtime_measure \"$<TARGET_FILE:perm_adhoc_buildvariant>\")\r\n 1836: set_tests_properties(test_d13_dll_runtime_measure PROPERTIES LABELS \"goal_v6;phase_d;dll_roundtrip\")\r\n 1837: \r\n 1838: message(STATUS \"Goal-V6 Phase D: ${CMAKE_CURRENT_LIST_LINE} — 28 add_test-D-Tests (16 leicht + 12 Boost) + 5 DLL-Round-Trip-Tests \"\r\n 1839:     \"(test_dgenus_dll/test_buildvariant_dll{,_real}/test_adhoc_buildvariant_dll/test_d13_dll_runtime_measure) als OFFIZIELLE CMake-Targets (6 SHARED-DLLs via $<TARGET_FILE>). \"\r\n 1840:     \"container_dll (test_d4b) bleibt scratch-verifiziert (Folge).\")\r\n 1841: \r\n 1842: # ─────────────────────────────────────────────────────────────────────────────\r\n 1843: # #172/#174/#175 LEICHTE Werkzeug-Tests CTest-registrieren (vorher NUR via ad-hoc build_*.bat/.ps1 baubar).\r\n 1844: # Selbe Begründung + selbes Muster wie der #155-Block + die GoalV6-D-Tests: plain `int main()`-Standalone\r\n 1845: # (KEIN gtest → add_test DIREKT, NICHT comdare_add_test), Return 0/1. KEIN DLL-/ADHOC-Bau, KEIN Boost/mp11\r\n 1846: # und KEIN rekursiver generated/-Include nötig — die zugehörigen Werkzeug-Header haben einen schlanken,\r\n 1847: # stabilen Include-Satz (verifiziert: nur std + libs/cache_engine{,/builder/...} + libs/common).\r\n 1848: #\r\n 1849: #   * test_cacheline_policy_selector (#174, Versprechen 2): CacheLinePolicySelector (GoF Strategy). Inkludiert\r\n 1850: #       anatomy/resource_controllable_tier.hpp + builder/cacheline_policy/cacheline_policy_selector.hpp\r\n 1851: #       (zieht builder/algorithm_resource_control.hpp) → Include-Root libs/cache_engine. Liegt direkt unter\r\n 1852: #       tests/unit/. Optionales CSV-Argument: der Test SKIPt sauber (Exit 0), wenn die untracked Pilot-CSV\r\n 1853: #       fehlt — der Heuristik-Kern-Beleg ist davon unabhängig, daher reproduzierbar ohne Fixture.\r\n 1854: #   * test_load_profile_writer (#175, Versprechen 3): write_load_profile_xml + extract_load_profile_from_\r\n 1855: #       measurements. Quelle liegt in libs/cache_engine/builder/workload_driver/. Inkludiert load_profile_\r\n 1856: #       parser.hpp (→ <serialization/.../xml_reader.hpp> aus libs/common, header-only/inline) + load_profile_\r\n 1857: #       writer.hpp. BRAUCHT Fixtures: ein LP-XML-Verzeichnis (getracktes algorithm_profiles/load_profiles)\r\n 1858: #       + eine Mess-CSV. Die echte Pilot-CSV ist untracked (build/) → für die G5-Reproduzierbarkeit wird\r\n 1859: #       eine schlanke, GETRACKTE Fixture-CSV (tests/unit/fixtures/load_profile_writer_pilot.csv) als Argument\r\n 1860: #       verdrahtet; Output landet im Build-Tree. So baut + läuft der Test aus einem frischen git-clone grün.\r\n 1861: \r\n 1862: # Output-Wurzel für die Test-Schreibvorgänge: bevorzugt das OS-Temp-Verzeichnis (TMPDIR/TEMP/TMP),\r\n 1863: # sonst der Build-Tree. Grund: wenn der Build-Tree unter einem synchronisierenden Ordner (OneDrive)\r\n 1864: # liegt, blockiert der Datei-Sync jeden geschriebenen Roundtrip-/Extract-XML minutenlang (verifiziert:\r\n 1865: # 478 s im OneDrive-Build-Tree vs 1 s im OS-Temp). Das ist umgebungs-, nicht code-bedingt; der Test\r\n 1866: # bleibt korrekt, aber wir halten ihn schnell + suite-tauglich, indem wir ins Temp schreiben.\r\n 1867: set(_comdare_test_out_root \"${CMAKE_CURRENT_BINARY_DIR}\")\r\n 1868: foreach(_tmpvar TMPDIR TEMP TMP)\r\n 1869:     if(DEFINED ENV{${_tmpvar}} AND IS_DIRECTORY \"$ENV{${_tmpvar}}\")\r\n 1870:         set(_comdare_test_out_root \"$ENV{${_tmpvar}}\")\r\n 1871:         break()\r\n 1872:     endif()\r\n 1873: endforeach()\r\n 1874: \r\n 1875: # (a) test_cacheline_policy_selector — Quelle unter tests/unit/, std-only Include-Satz.\r\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f2d77-4876-70e0-a7dd-2170b3561ac9"}}}
