"${CMAKE_BINARY_DIR}/generated/topics/${_axis_rel}\")\r\n   20:     endif()\r\n   21: endforeach()\r\n   22: # V41.F.2: physisch nach axes/<axis>/ migrierte Achsen (Glob topics/*/axis_* findet sie nicht) — generisch\r\n   23: # je migriertem axes/<axis>-Verzeichnis das generated-Dir ergaenzen, sonst C1083 in umbrella/compositions.\r\n   24: file(GLOB _comdare_axes_dirs LIST_DIRECTORIES true \"${PROJECT_SOURCE_DIR}/libs/cache_engine/axes/*\")\r\n   25: foreach(_axes_dir ${_comdare_axes_dirs})\r\n   26:     if(IS_DIRECTORY \"${_axes_dir}\")\r\n   27:         get_filename_component(_axes_name \"${_axes_dir}\" NAME)\r\n   28:         list(APPEND COMDARE_ALL_AXIS_GENERATED_DIRS \"${CMAKE_BINARY_DIR}/generated/axes/${_axes_name}\")\r\n   29:     endif()\r\n   30: endforeach()\r\n   31: \r\n   32: # Header-only INTERFACE-Library: Cache-Engine Concepts\r\n   33: add_library(comdare_cache_engine_concepts INTERFACE)\r\n   34: add_library(comdare::cache_engine_concepts ALIAS comdare_cache_engine_concepts)\r\n   35: target_include_directories(comdare_cache_engine_concepts INTERFACE\r\n   36:     \"${CMAKE_SOURCE_DIR}/libs/cache_engine/include\"\r\n   37:     \"${CMAKE_SOURCE_DIR}/libs/cache_engine/subsystems\")\r\n   38: target_compile_features(comdare_cache_engine_concepts INTERFACE cxx_std_23)\r\n   39: comdare_set_platform_defines(comdare_cache_engine_concepts)\r\n   40: \r\n   41: # Header-only INTERFACE-Library: PRT-ART Concepts\r\n   42: add_library(comdare_prt_art_concepts INTERFACE)\r\n   43: add_library(comdare::prt_art_concepts ALIAS comdare_prt_art_concepts)\r\n   44: target_include_directories(comdare_prt_art_concepts INTERFACE\r\n   45:     \"${CMAKE_SOURCE_DIR}/prt_art/include\")\r\n   46: target_compile_features(comdare_prt_art_concepts INTERFACE cxx_std_23)\r\n   47: target_link_libraries(comdare_prt_art_concepts INTERFACE comdare::cache_engine_concepts)\r\n   48: comdare_set_platform_defines(comdare_prt_art_concepts)\r\n   49: \r\n   50: # V41.F.6.1 E1 (2026-05