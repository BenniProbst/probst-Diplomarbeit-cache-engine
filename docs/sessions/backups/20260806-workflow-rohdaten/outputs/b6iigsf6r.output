_component(_pt_name \"${_pt_src}\" NAME_WE)\r\n  800:     comdare_add_test(${_pt_name} SOURCES \"${_pt_src}\")\r\n  801:     # Volle CE-Include-Roots: Pruefling-Slots inkludieren CE-Achsen-Header (topics/), die\r\n  802:     # Merge-Mechanik (anatomy/) + die generierten Achsen-Flags (Phase B Slot-Füllung).\r\n  803:     target_include_directories(${_pt_name} PRIVATE\r\n  804:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n  805:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n  806:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n  807:         \"${CMAKE_BINARY_DIR}/generated\"\r\n  808:         ${COMDARE_ALL_AXIS_GENERATED_DIRS}\r\n  809:         ${COMDARE_PRUEFLING_INCLUDE_DIRS})\r\n  810:     target_link_libraries(${_pt_name} PRIVATE Boost::mp11)\r\n  811:     message(STATUS \"comdare Plugin-Controller: Pruefling-Integration-Test ${_pt_name} registriert\")\r\n  812: endforeach()\r\n  813: \r\n  814: # V41.F.6.1.R7.5.e axis_filter (4 Wrappers + TYPED_TEST_SUITE Pattern aus axis_06_allocator)\r\n  815: comdare_add_test(test_v41_axis_filter\r\n  816:     SOURCES test_v41_axis_filter.cpp)\r\n  817: target_include_directories(test_v41_axis_filter PRIVATE\r\n  818:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n  819:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n  820:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n  821:     \"${CMAKE_BINARY_DIR}/generated\"\r\n  822:     \"${CMAKE_BINARY_DIR}/generated/axes/filter_axis\")\r\n  823: target_link_libraries(test_v41_axis_filter PRIVATE\r\n  824:     Boost::mp11)\r\n  825: \r\n  826: # V41 #43 s4 — SuRF-Filter-Organ (axis_filter/composable): Filter-Property-Tests (no-FN + FP-Rate + Range)\r\n  827: comdare_add_test(test_v41_axis_filter_surf_organ\r\n  828:     SOURCES test_v41_axis_filter_surf_organ.cpp)\r\n  829: target_include_directories(test_v41_axis_filter_surf_organ PRIVATE\r\n  830:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n 1320:         \"Build comdare_adhoc_emitter_cli first, then re-configure.\")\r\n 1321: endif()\r\n 1322: \r\n 1323: # ─────────────────────────────────────────────────────────────────────────────\r\n 1324: # Goal-V6 Phase D — standalone main()-Tests (KEIN gtest; eigenes main + errno-style return).\r\n 1325: # Behebt den Phase-E-Audit-Vorbehalt: vorher nur via git-ignorierte build/scratch_*.ps1 verifiziert\r\n 1326: # (autor-behauptet, nicht repo-reproduzierbar) → jetzt CTest-registriert (ctest baut + laeuft sie).\r\n 1327: # add_test direkt (nicht comdare_add_test, das ist gtest). Include-Roots = die scratch-verifizierten.\r\n 1328: # ─────────────────────────────────────────────────────────────────────────────\r\n 1329: # (a) leichtgewichtig: nur libs/cache_engine(+include/common); kein Boost/generated.\r\n 1330: set(COMDARE_GOALV6_LIGHT_DTESTS\r\n 1331:     test_d1_d2_selection      # L-SEL + L-73 (BuildSelection + provision_all O(K))\r\n 1332:     test_d3_ceb_generator     # L-77 (ceb_generator generate_all_real)\r\n 1333:     test_d7_build_variant     # L-74b (BuildVariantDefinition)\r\n 1334:     test_d7a_build_inspection # L-74a (Build-Variant-Inspection-ABI)\r\n 1335:     test_d7b_definition_per_node # L-74b (NodeValue build_def + build_def_real + 22-Vollstaendigkeit)\r\n 1336:     test_d8_operability       # L-74c (R5.B-Operabilitaets-Klassifikation)\r\n 1337:     test_d9_set               # L-76a (Set-Gattung Kern)\r\n 1338:     test_d9_set_adapter       # L-76a (SetAbiAdapter)\r\n 1339:     test_d10_sequence         # L-76b (Sequence-Gattung)\r\n 1340:     test_d11_view             # L-76c (View-Gattung)\r\n 1341:     test_genus_docks          # L-76a-c (Set/Sequence/View Pruef-Docks: Gattungs-API treiben + Observer + CSV)\r\n 1342:     test_d12_virus            # L-76d (Viren IVirusExecutionEngine + GraphBfs)\r\n 1343:     test_d13_runtime_measure  # L-MEAS (RuntimeMeasureVisitor)\r\n 1344:     test_d14_result_ingest    # L-CLUSTER gate-frei (result_ingest) + Audit-A1 MAJOR-MESS-09 Negativ-Tests (==176/binary_id)\r\n 1345:     test_d14b_perm_runner     # L-CLUSTER-E2E gate-frei (perm_runner → result_ingest Round-Trip)\r\n 1346:     test_a1_load_profile_opmix # Audit-A1 MAJOR-MESS-05 (op_mix-Pflicht: fehlend/leer → nullopt)\r\n 1347:     test_d14c_e2e_pipeline)   # L-CLUSTER-E2E gate-frei (durchgängige Pipeline, O(K))\r\n 1348: foreach(_dt IN LISTS COMDARE_GOALV6_LIGHT_DTESTS)\r\n 1349:     add_executable(${_dt} \"${_dt}.cpp\")\r\n 1350:     target_compile_features(${_dt} PRIVATE cxx_std_23)\r\n 1351:     target_include_directories(${_dt} PRIVATE\r\n 1352:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n 1353:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n 1354:         \"${PROJECT_SOURCE_DIR}/libs/common\")\r\n 1355:     comdare_set_platform_defines(${_dt})\r\n 1356:     add_test(NAME ${_dt} COMMAND ${_dt})\r\n 1357:     set_tests_properties(${_dt} PROPERTIES LABELS \"goal_v6;phase_d\")\r\n 1358: endforeach()\r\n 1359: \r\n 1360: # (b) Container-Gattungs-Tests: brauchen die q1/q2-Achsen-Registries → Boost::mp11 + generated-Flags.\r\n 1361: set(COMDARE_GOALV6_BOOST_DTESTS\r\n 1362:     test_container_genus            # #75 Container q2-Slot (in-process)\r\n 1363:     test_container_dock             # #75 Container-Pruef-Dock\r\n 1364:     test_d_v42_probe                # V42-Composition-Driver-Probe (telemetry default_ctor/ObservableAxis-Befund)\r\n 1365:     test_d_v42_probe2               # V42-Korrektur-Probe (LeafOnlyCounter: is_aggregate/{}-Block/default-init)\r\n 1366:     test_d_v42_telemetry_observable  # V42 L-74c ObservableTelemetry-Driver-Baustein (setzt STATISTICS in-Quelle)\r\n 1367:     test_d_v42_memory_layout_observable  # V42 L-74c ObservableMemoryLayout-Driver-Baustein (static+observe_scan)\r\n 1368:     test_d_v42_serialization_observable  # V42 L-74c ObservableSerialization-Driver-Baustein\r\n 1369:     test_d_v42_node_type_observable      # V42 L-74c ObservableNodeType-Driver-Baustein (N in ComposedStore)\r\n 1370:     test_d_v42_telemetry_registry_observable  # V42 L-74c telemetry-Registry-Pfad (StaticAxisVariants -> Huellen)\r\n 1371:     test_genus_permutation_engines            # L-76a-c per-Gattung PermutationEngines (Set/Sequence/View Factory+Engine)\r\n 1372:     test_axis_growth_policies                 # L-76b axis_growth Mehr-Policy-Achse (Doubling/GoldenRatio/FixedChunk/Exact + Registry)\r\n 1373:     test_axis_view_policies)                  # L-76c View-Achsen extent/layout/accessor (mdspan-Policies + Registries)\r\n 1374: foreach(_dt IN LISTS COMDARE_GOALV6_BOOST_DTESTS)\r\n 1375:     add_executable(${_dt} \"${_dt}.cpp\")\r\n 1376:     target_compile_features(${_dt} PRIVATE cxx_std_23)\r\n 1377:     target_include_directories(${_dt} PRIVATE\r\n 1378:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n 1379:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n 1380:         \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n 1381:         \"${PROJECT_SOURCE_DIR}/libs/common\"\r\n 1382:         \"${CMAKE_BINARY_DIR}/generated\"\r\n 1383:         ${COMDARE_ALL_AXIS_GENERATED_DIRS})\r\n 1384:     target_link_libraries(${_dt} PRIVATE Boost::mp11)\r\n 1385:     comdare_set_platform_defines(${_dt})\r\n 1386:     add_test(NAME ${_dt} COMMAND ${_dt})\r\n 1387:     set_tests_properties(${_dt} PROPERTIES LABELS \"goal_v6;phase_d\")\r\n 1388: endforeach()\r\n 1389: \r\n 1390: # ─────────────────────────────────────────────────────────────────────────────\r\n 1391: # #155 Phase-E-Standalone-Tests CTest-registrieren (vorher NICHT in CMake/ctest — nur als Quelle im Tree).\r\n 1392: # Identisches Muster wie die GoalV6-D-Tests darueber: plain `int main()`-Standalone (KEIN gtest, daher add_test\r\n 1393: # direkt, NICHT comdare_add_test), Return 0/1. KEIN DLL-/ADHOC-Bau — sie nutzen die normale cache-engine-Anatomie-\r\n 1394: # Header (anatomy/ compositions/ axes/ builder/experiment_tree/), also den boost/generated-Include-Satz.\r\n 1395: #   * test_migration_two_tier (#123, P4): 2-Tier IMigratableTier + organ_migrate_step + memento-parallel.\r\n 1396: #   * test_seg_coverage       (P-MD3): seg_*_ns-Attributions-Coverage ueber perm_runner (ART/HOT/Masstree).\r\n 1397: # test_v5_io_real_fixture ist leichter (nur std + Win32-API, kein Anatomie-Header) → eigener Block darunter.\r\n 1398: set(COMDARE_PHASE_E_BOOST_TESTS\r\n 1399:     test_migration_two_tier   # #123 P4 — 2-Tier-Migration (IMigratableTier + Memento parallel)\r\n 1400:     test_seg_coverage         # P-MD3 — seg_*_ns-Attributions-Coverage (Mess-Pfad-Organzeit)\r\n 1401:     # #155-Rest — 6 git-tracked aber bisher unregistrierte Phase-E-Verifikationstests (gleiche anatomy/axes-Kette).\r\n 1402:     test_filter_real_from_keys        # Filter-Achse (Bloom/Cuckoo/Xor/RangeSURF) real aus echten Keys\r\n 1403:     test_patricia_real                # path_compression-Achse (Patricia/None/RealTrie) real ersetzt\r\n 1404:     test_value_handle_real            # value_handle-Achse (inline/external_pool/immutable/versioned/chain) real\r\n 1405:     test_prefetch_real                # prefetch-Achse (RealDescent/HW/None/...) real ueber layout_aware_store\r\n 1406:     test_prefetch_adversarial_verify  # prefetch-Achse adversarial-Verifikation\r\n 1407:     test_prefetch_patha_t7            # prefetch Pfad-A T7 (measurable_workload)\r\n 1408:     # #188-4c-iii Review-BLOCKER (2026-07-02): test_cow_memento war git-tracked aber NIE registriert — er ist\r\n 1409:     # DIE Absicherung fuer tier_memento_is_copy_on_write()==true (CoW Rev. 2 + 4c-iii-Semantik-Delta: cow_capable_\r\n 1410:     # haengt nur noch am echten container_t-Substrat). Gleiche anatomy/axes-Include-Kette wie die Tests darueber.\r\n 1645:     \"${PROJECT_SOURCE_DIR}/libs/common\"\r\n 1646:     \"${CMAKE_BINARY_DIR}/generated\"\r\n 1647:     ${COMDARE_ALL_AXIS_GENERATED_DIRS})\r\n 1648: target_link_libraries(m3v2_pmc_smoke PRIVATE Boost::mp11)\r\n 1649: comdare_set_platform_defines(m3v2_pmc_smoke)\r\n 1650: target_compile_definitions(m3v2_pmc_smoke PRIVATE\r\n 1651:     COMDARE_MEASUREMENT_ON=1 COMDARE_CE_ENABLE_STATISTICS=1 COMDARE_EXPERIMENT_MODE_ON=1)\r\n 1652: add_test(NAME m3v2_pmc_smoke COMMAND m3v2_pmc_smoke)\r\n 1653: set_tests_properties(m3v2_pmc_smoke PROPERTIES LABELS \"phase_e;standalone;pmc\")\r\n 1654: \r\n 1655: # #230-Rest (W1, 2026-07-02) - Contract-Compile-Gate fuer den Host-Treiber-Stack des thesis_tiere-Harness:\r\n 1656: # cache_engine_builder_iterator.hpp + perm_runner.hpp + side-effect-freie Baum-/CSV-/Runner-Datenpfade. Kein\r\n 1657: # run_lazy, keine DLLs, keine Messung, keine CSV-Dateien - nur Compile+Smoke der Treiber-Schicht vor den\r\n 1658: # Node-Shape-Achsen. Gleicher schwerer Include-/Define-Satz wie m3v2_pmc_smoke.\r\n 1659: add_executable(test_harness_compile \"test_harness_compile.cpp\")\r\n 1660: target_compile_features(test_harness_compile PRIVATE cxx_std_23)\r\n 1661: target_include_directories(test_harness_compile PRIVATE\r\n 1662:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n 1663:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n 1664:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n 1665:     \"${PROJECT_SOURCE_DIR}/libs/cache_engine/builder\"\r\n 1666:     \"${PROJECT_SOURCE_DIR}/libs/common\"\r\n 1667:     \"${CMAKE_BINARY_DIR}/generated\"\r\n 1668:     ${COMDARE_ALL_AXIS_GENERATED_DIRS})\r\n 1669: target_link_libraries(test_harness_compile PRIVATE Boost::mp11)\r\n 1670: comdare_set_platform_defines(test_harness_compile)\r\n 1671: target_compile_definitions(test_harness_compile PRIVATE\r\n 1672:     COMDARE_MEASUREMENT_ON=1 COMDARE_CE_ENABLE_STATISTICS=1 COMDARE_EXPERIMENT_MODE_ON=1)\r\n 1673: add_test(NAME test_harness_compile COMMAND test_harness_compile)\r\n 1674: set_tests_properties(test_harness_compile PROPERTIES LABELS \"contract;standalone;harness\")\r\n 1675: \r\n 1676: # CE-DL2 (Task #152) — LINUX-PMC-Smoke fuer die LinuxPerfPmcSource (perf_event_open). Spiegel von m3v2_pmc_smoke,\r\n 1677: # aber LINUX-CONDITIONAL registriert: nur unter (UNIX AND NOT APPLE) — der Windows-/MSVC-Build sieht dieses Target\r\n 1678: # NIE (kein add_executable, keine Linux-Header). make_pmc_source() liefert auf Linux+COMDARE_ENABLE_PMC eine\r\n 1679: # LinuxPerfPmcSource; der Smoke klammert begin()/end() um eine speicherruehrende Pointer-Chasing-Schleife und\r\n 1680: # prueft LITERAL: Zugriff -> available==1 UND >=1 Counter != 0; kein Zugriff (paranoid/EACCES/Container) ->\r\n 1835: add_test(NAME test_d13_dll_runtime_measure COMMAND test_d13_dll_runtime_measure \"$<TARGET_FILE:perm_adhoc_buildvariant>\")\r\n 1836: set_tests_properties(test_d13_dll_runtime_measure PROPERTIES LABELS \"goal_v6;phase_d;dll_roundtrip\")\r\n 1837: \r\n 1838: message(STATUS \"Goal-V6 Phase D: ${CMAKE_CURRENT_LIST_LINE} — 28 add_test-D-Tests (16 leicht + 12 Boost) + 5 DLL-Round-Trip-Tests \"\r\n 1839:     \"(test_dgenus_dll/test_buildvariant_dll{,_real}/test_adhoc_buildvariant_dll/test_d13_dll_runtime_measure) als OFFIZIELLE CMake-Targets (6 SHARED-DLLs via $<TARGET_FILE>). \"\r\n 1840:     \"container_dll (test_d4b) bleibt scratch-verifiziert (Folge).\")\r\n 1841: \r\n 1842: # ─────────────────────────────────────────────────────────────────────────────\r\n 1843: # #172/#174/#175 LEICHTE Werkzeug-Tests CTest-registrieren (vorher NUR via ad-hoc build_*.bat/.ps1 baubar).\r\n 1844: # Selbe Begründung + selbes Muster wie der #155-Block + die GoalV6-D-Tests: plain `int main()`-Standalone\r\n 1845: # (KEIN gtest → add_test DIREKT, NICHT comdare_add_test), Return 0/1. KEIN DLL-/ADHOC-Bau, KEIN Boost/mp11\r\n 1846: # und KEIN rekursiver generated/-Include nötig — die zugehörigen Werkzeug-Header haben einen schlanken,\r\n 1847: # stabilen Include-Satz (verifiziert: nur std + libs/cache_engine{,/builder/...} + libs/common).\r\n 1848: #\r\n 1849: #   * test_cacheline_policy_selector (#174, Versprechen 2): CacheLinePolicySelector (GoF Strategy). Inkludiert\r\n 1850: #       anatomy/resource_controllable_tier.hpp + builder/cacheline_policy/cacheline_policy_selector.hpp\r\n 1851: #       (zieht builder/algorithm_resource_control.hpp) → Include-Root libs/cache_engine. Liegt direkt unter\r\n 1852: #       tests/unit/. Optionales CSV-Argument: der Test SKIPt sauber (Exit 0), wenn die untracked Pilot-CSV\r\n 1853: #       fehlt — der Heuristik-Kern-Beleg ist davon unabhängig, daher reproduzierbar ohne Fixture.\r\n 1854: #   * test_load_profile_writer (#175, Versprechen 3): write_load_profile_xml + extract_load_profile_from_\r\n 1855: #       measurements. Quelle liegt in libs/cache_engine/builder/workload_driver/. Inkludiert load_profile_\r\n 1856: #       parser.hpp (→ <serialization/.../xml_reader.hpp> aus libs/common, header-only/inline) + load_profile_\r\n 1857: #       writer.hpp. BRAUCHT Fixtures: ein LP-XML-Verzeichnis (getracktes algorithm_profiles/load_profiles)\r\n 1858: #       + eine Mess-CSV. Die echte Pilot-CSV ist untracked (build/) → für die G5-Reproduzierbarkeit wird\r\n 1859: #       eine schlanke, GETRACKTE Fixture-CSV (tests/unit/fixtures/load_profile_writer_pilot.csv) als Argument\r\n 1860: #       verdrahtet; Output landet im Build-Tree. So baut + läuft der Test aus einem frischen git-clone grün.\r\n 1861: \r\n 1862: # Output-Wurzel für die Test-Schreibvorgänge: bevorzugt das OS-Temp-Verzeichnis (TMPDIR/TEMP/TMP),\r\n 1863: # sonst der Build-Tree. Grund: wenn der Build-Tree unter einem synchronisierenden Ordner (OneDrive)\r\n 1864: # liegt, blockiert der Datei-Sync jeden geschriebenen Roundtrip-/Extract-XML minutenlang (verifiziert:\r\n 1865: # 478 s im OneDrive-Build-Tree vs 1 s im OS-Temp). Das ist umgebungs-, nicht code-bedingt; der Test\r\n 1866: # bleibt korrekt, aber wir halten ihn schnell + suite-tauglich, indem wir ins Temp schreiben.\r\n 1867: set(_comdare_test_out_root \"${CMAKE_CURRENT_BINARY_DIR}\")\r\n 1868: foreach(_tmpvar TMPDIR TEMP TMP)\r\n 1869:     if(DEFINED ENV{${_tmpvar}} AND IS_DIRECTORY \"$ENV{${_tmpvar}}\")\r\