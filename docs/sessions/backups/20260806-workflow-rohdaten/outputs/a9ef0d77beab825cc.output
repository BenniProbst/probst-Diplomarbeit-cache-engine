 > <log>` haelt zudem die Frisch-Truncate-Semantik beim GitLab-Retry\n1110-    // (LOGDIR liegt jetzt im clean-excludierten Bestand und kann Altstaende tragen).\n1111-    static void emit_driver_log_truncate(std::string& s, std::string const& indent, std::string const& log_path) {\n1112-        s += indent + \": > \\\"\" + log_path + \"\\\"   # #27: frisch truncieren, dann stdout+stderr im APPEND-Modus\\n\";\n1113-    }\n1114-\n1115-    // #27 (2026-07-23, Slice-inneres Fortschritts-Testat): die Redirect-Naht JEDER Treiber-Invocation. stdout+stderr-\n1116-    // Detail geht vollstaendig nach <log> (Trace-Hygiene, Artefakt) im APPEND-Modus (>> + tee -a: O_APPEND-Writes sind\n\n=== ceb_combo_compile_define ===\n257:[[nodiscard]] inline std::string ceb_combo_compile_define(std::string const& combo_legend) {\n258-    if (ceb_combo_is_full_set(combo_legend)) return \" -UCOMDARE_MEASUREMENT_COMBO\";\n259-    return \" \\\"-DCOMDARE_MEASUREMENT_COMBO=\" + combo_legend + \"\\\"\";\n260-}\n261-\n262-// ── PlanTextBuilder — ConcreteBuilder + der --dump-plan-Traeger. Deterministische Zeilen-Textform. ──────────\n263-//    Format (stabil, byte-reproduzierbar; keine host-abhaengigen Felder):\n264-//      # comdare-experiment-plan v1.1\n265-//      source_kind=<thesis|experiment>\n266-//      profile_id=<id>\n267-//      profile axes=<n> values=<m>          (v1.1: profil-seitige Substanz, additiv)\n268-//      registry_trio loaded=<0|1> organ=<engine> organ_axes=<n> organ_offers=<n> system=... measurement=...\n269-//      perm_count=<n>\n270-//      perm <i> opt=<id> simd=<id> opt_flag=<f> march_flag=<f> build_version_suffix=<s>\n271-//        step <j> kind=<k> label=<l> merge=<m> binary_id=<b> series=<s> pruefling_type=<p> lebewesen=<le>\n272-//             built_stem=<st>          (OP-9, additiv unter v1.1: der real gebaute Datei-Stem; \"-\" = keine id\n273-//                                       bzw. Stem ohne View-Index nicht bestimmbar, s. built_stem_field)\n274-class PlanT