+/// fail-loud abgelehnt (Fehler statt Phantom-Etikett, honest-100%); alle nicht ueber kOpTypeTable
+/// (op_type_filter.hpp) erreichbaren Kinds (YCSB_B/YCSB_D/Custom_HotKey) ebenso.
+[[nodiscard]] constexpr bool workload_kind_supported(cmd::WorkloadKind kind) noexcept {
+    switch (kind) {
+        case cmd::WorkloadKind::YCSB_C_ReadOnly:        // OP-1: lookup-only
+        case cmd::WorkloadKind::Custom_BulkInsert:      // OP-2: insert-only
+        case cmd::WorkloadKind::YCSB_A_Read50Write50:   // OP-3: 50/50 insert/lookup
+        case cmd::WorkloadKind::YCSB_F_ReadModifyWrite: // OP-5: echtes RMW (lookup -> insert(v+1))
+            return true;
+        default: return false;
+    }
+}
