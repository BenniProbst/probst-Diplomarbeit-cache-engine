+/// key_for -- deterministischer, injektiver uint64-Key je (index, seed): Multiplikation mit ungerader
+/// Konstante ist bijektiv mod 2^64, XOR seed konstant -> distinkte Indizes ergeben distinkte Keys.
+/// SINGLE-SOURCE fuer Prefill (drive_one_engine) UND Mess-Ops (KatalogTierEngineCallable), damit
+/// lookup-artige Ops exakt die Prefill-Keys treffen (gleiche Config + Seed => reproduzierbare Sequenz).
+[[nodiscard]] constexpr std::uint64_t key_for(std::uint64_t index, std::uint64_t seed) noexcept {
+    return (index * 2654435761ull) ^ seed;
+}
+
+/// value_for -- das Wert-Schema je Key (unveraendert zum INC-F-Stand: key*7+1).
+[[nodiscard]] constexpr std::uint64_t value_for(std::uint64_t key) noexcept { return key * 7u + 1u; }
