constexpr char esc[] = " \u2192 ";
constexpr char roh[] = {0x20, char(0xE2), char(0x86), char(0x92), 0x20, 0};
static_assert(sizeof(esc) == 6, "Spc+3B+Spc+NUL");
static_assert(sizeof(roh) == 6, "Referenz");
template <unsigned N> constexpr bool gleich(char const (&a)[N], char const (&b)[N]) {
    for (unsigned i = 0; i < N; ++i)
        if (a[i] != b[i]) return false;
    return true;
}
static_assert(gleich(esc, roh), "Escape emittiert exakt 20 E2 86 92 20");
constexpr char ascii_ersatz[] = " -> ";
static_assert(sizeof(ascii_ersatz) != sizeof(esc), "naives ASCII-> waere ANDERER String (Anker-Bruch)");
#include <cstdio>
int main() {
    for (unsigned i = 0; i + 1 < sizeof(esc); ++i) std::printf("%02X ", static_cast<unsigned char>(esc[i]));
