[dump-plan] PMC-BEFUND lage=amd vendor=AuthenticAMD events=3/4 biss=[cache_misses_l1=1;cache_misses_l3_ll=0;dtlb_misses=1;branch_misses=1] quelle=perf_event_open+cpuid+koeder beweist-nicht=runner-host
# comdare-experiment-plan v1.1
source_kind=thesis
profile_id=m3v2_study
profile axes=18 values=31
registry_trio loaded=1 organ=cache_engine organ_axes=18 organ_offers=83 system=cache_engine_system system_axes=3 system_offers=6 measurement=cache_engine_measurement measurement_axes=3 measurement_offers=20
