#pragma once
// Achsen-Binding-Registry (E4'-Strecke, 2026-07-10): die compile/dynamic-WURZEL des Doc-20-
// Messkurven-Typsystems (tree<axis compile/dynamic, ...>) als compile-time "Blut"-Registry —
// nach dem Muster measurement_axis_registry.hpp (P2: Enum + consteval-Array + static_assert +
// for_each). KEIN Runtime-Switch (P1): reine constexpr-Klassifikation der 19 Composition-Achsen.
//
// KARDINALITAETS-KLASSE KK-1 (Doc 20 §G): die Wurzel-Verzweigung ist eine Design-Konstante —
// 14 compile-time-Achsen (honest-0/statisch) + 5 laufzeit-steuerbare Achsen (RC-POD
// ComdareResourceControlV1). Fork-UNABHAENGIG (die map<>-Ebenen des Typsystems haengen an den
// 7 User-Forks aus Doc 20 §H, diese Wurzel nicht).
//
// GEERDET (nie geraten): Namen = kCompositionAxisNames (Single-Source, axis_path_serialization.hpp);
// dynamic-Zuordnung + Caps = ComdareResourceControlV1 + abi_adapter.hpp:226-231 (tier_query_resource_control).
// Achtung Drift-Falle (Memory axis_t_ids_vs_dir_numbers): die internen axis_NN-Verzeichniscodes
// stimmen NICHT mit der T0-T18/L00-L18-Slot-Ordnung ueberein — diese Registry keyt AUSSCHLIESSLICH
// auf die stabilen semantischen Slot-Namen.

#include <builder/experiment_tree/axis_path_serialization.hpp> // kCompositionAxisNames (19 Slots, Single-Source)
#include <cache_engine/measurement/system_axis.hpp>            // (nur fuer die measurement-Layer-Naht/Doku)
#include <anatomy/resource_controllable_tier.hpp>              // ComdareResourceControlV1 (POD-Struktur-Grounding)

#include <array>
#include <cstddef>
#include <cstdint>
#include <string_view>
#include <utility>

namespace comdare::cache_engine::builder::axis_binding {

namespace ex = ::comdare::cache_engine::builder::experiment;

/// Die Wurzel-Verzweigung des Typsystems: compile-time-statisch vs. laufzeit-steuerbar.
enum class AxisBinding : std::uint8_t {
    Compile = 0, ///< binary_id-wirksam, im B+-Baum als StaticAxisNode (14 Achsen)
    Dynamic = 1, ///< RC-POD-steuerbar zur Laufzeit EINER statischen Binary (DynamicVariableNode, 5 Achsen)
};

/// Fuer die 5 dynamischen Achsen: das steuernde ComdareResourceControlV1-Feld (Sentinel 0 = nicht setzen).
enum class RcField : std::uint8_t {
    None                 = 0, ///< compile-Achse: kein RC-Feld
    ThreadCount          = 1, ///< concurrency
    PrefetchDistance     = 2, ///< prefetch (Cache-Lines)
    PoolBudgetBytes      = 3, ///< allocator (Arena-Budget)
    BatchSize            = 4, ///< cache_traversal (Working-Set/Batch)
    InlineThresholdBytes = 5, ///< value_handle (Inline/External-Schwelle)
};

struct AxisBindingInfo {
    std::string_view name;     ///< exakt kCompositionAxisNames[i]
    AxisBinding      binding;  ///< Compile | Dynamic (tree-Wurzel)
    RcField          rc_field; ///< Dynamic: steuerndes RC-Feld; Compile: None
    std::uint64_t    rc_cap;   ///< Dynamic: Cap aus abi_adapter tier_query_resource_control; Compile: 0
};

inline constexpr std::size_t kAxisBindingCount = 19;

namespace detail {
[[nodiscard]] constexpr AxisBindingInfo compile_axis(std::string_view n) {
    return AxisBindingInfo{n, AxisBinding::Compile, RcField::None, 0};
}
[[nodiscard]] constexpr AxisBindingInfo dynamic_axis(std::string_view n, RcField f, std::uint64_t cap) {
    return AxisBindingInfo{n, AxisBinding::Dynamic, f, cap};
}
} // namespace detail

// Reihenfolge == kCompositionAxisNames (search_algo .. queuing_q2); Caps = abi_adapter.hpp:226-230.
inline constexpr std::array<AxisBindingInfo, kAxisBindingCount> kAxisBindingRegistry{{
    detail::compile_axis("search_algo"),                               // L00
    detail::dynamic_axis("cache_traversal", RcField::BatchSize, 4096), // L01 -> batch_size
    detail::compile_axis("mapping"),                                   // L02
    detail::compile_axis("path_compression"),                          // L03
    detail::compile_axis("node_type"),                                 // L04
    detail::compile_axis("memory_layout"),                             // L05
    detail::dynamic_axis("allocator", RcField::PoolBudgetBytes,
                         std::uint64_t{1} << 30),                             // L06 -> pool_budget_bytes (1 GiB)
    detail::dynamic_axis("prefetch", RcField::PrefetchDistance, 64),          // L07 -> prefetch_distance (CL)
    detail::dynamic_axis("concurrency", RcField::ThreadCount, 64),            // L08 -> thread_count
    detail::compile_axis("serialization"),                                    // L09
    detail::compile_axis("telemetry"),                                        // L10
    detail::dynamic_axis("value_handle", RcField::InlineThresholdBytes, 256), // L11 -> inline_threshold_bytes
    detail::compile_axis("isa"),                                              // L12
    detail::compile_axis("index_organization"),                               // L13
    detail::compile_axis("io_dispatch"),                                      // L14
    detail::compile_axis("migration_policy"),                                 // L15
    detail::compile_axis("filter"),                                           // L16
    detail::compile_axis("queuing_q1"),                                       // L17
    detail::compile_axis("queuing_q2"),                                       // L18
}};

/// Anzahl der laufzeit-steuerbaren (dynamischen) Achsen — muss der RC-POD-Struktur entsprechen.
[[nodiscard]] consteval std::size_t count_dynamic() {
    std::size_t n = 0;
    for (auto const& info : kAxisBindingRegistry)
        if (info.binding == AxisBinding::Dynamic) ++n;
    return n;
}
[[nodiscard]] consteval std::size_t count_compile() { return kAxisBindingCount - count_dynamic(); }

namespace detail {
[[nodiscard]] consteval bool registry_is_consistent() {
    for (std::size_t i = 0; i < kAxisBindingCount; ++i) {
        // (a) Namen positionsidentisch zu kCompositionAxisNames (Single-Source, kein Drift).
        if (kAxisBindingRegistry[i].name != ex::kCompositionAxisNames[i]) return false;
        // (b) Dynamic <=> RC-Feld gesetzt + Cap > 0; Compile <=> None + Cap 0.
        bool const is_dyn = kAxisBindingRegistry[i].binding == AxisBinding::Dynamic;
        if (is_dyn != (kAxisBindingRegistry[i].rc_field != RcField::None)) return false;
        if (is_dyn != (kAxisBindingRegistry[i].rc_cap != 0)) return false;
    }
    // (c) genau ein Slot je RC-Feld (Bijektion der 5 dynamischen Achsen auf die 5 RC-Felder).
    for (RcField f : {RcField::ThreadCount, RcField::PrefetchDistance, RcField::PoolBudgetBytes, RcField::BatchSize,
                      RcField::InlineThresholdBytes}) {
        std::size_t hits = 0;
        for (auto const& info : kAxisBindingRegistry)
            if (info.rc_field == f) ++hits;
        if (hits != 1) return false;
    }
    return true;
}
} // namespace detail

static_assert(detail::registry_is_consistent(),
              "kAxisBindingRegistry: Namen==kCompositionAxisNames, Dynamic<=>RC-Feld+Cap, RC-Feld-Bijektion");
static_assert(count_dynamic() == 5, "genau 5 laufzeit-steuerbare Achsen (RC-POD)");
static_assert(count_compile() == 14, "genau 14 compile-time-Achsen (honest-0/statisch)");

// Struktur-Kopplung an den RC-POD (Drift-Guard): 5 steuerbare uint64-Felder + 1 Meta-Feld
// (controllable_axis_count). Waechst der POD, bricht dieser Assert und erzwingt eine bewusste
// Aktualisierung der dynamic-Klassifikation.
static_assert((sizeof(::comdare::cache_engine::anatomy::ComdareResourceControlV1) / sizeof(std::uint64_t)) - 1 ==
                  count_dynamic(),
              "count_dynamic() muss den steuerbaren RC-POD-Feldern (ohne Meta) entsprechen");

/// constexpr-Lookup per Slot-Index (0..18 == kCompositionAxisNames-Reihenfolge).
[[nodiscard]] constexpr AxisBindingInfo const& axis_binding(std::size_t slot_index) noexcept {
    return kAxisBindingRegistry[slot_index];
}

/// Compile-time-Iteration ueber alle Achsen-Bindings (Metaprogrammierungs-Interface).
template <class Visitor>
constexpr void for_each_axis_binding(Visitor&& visitor) {
    [&]<std::size_t... I>(std::index_sequence<I...>) {
        (visitor(kAxisBindingRegistry[I]), ...);
    }(std::make_index_sequence<kAxisBindingCount>{});
}

} // namespace comdare::cache_engine::builder::axis_binding
