   65: // (Audit K9) Absichtlich NICHT std::map-konform: tier_insert meldet IMMER „neu" (true), auch beim Update → verletzt
   66: // die Oracle-Zusicherung RF3 (Duplikat-Insert muss false liefern). Das Konformitäts-Gate MUSS das erkennen und die
   67: // Hülle von der Messung ausschließen (gated≠gültig). Beleg, dass das Gate im Voll-Lauf-Pfad wirklich greift.
   68: struct BrokenTier final : ana::IObservableTier {
   69:     std::map<std::uint64_t, std::uint64_t> data;
   70:     [[nodiscard]] bool                     tier_insert(std::uint64_t k, std::uint64_t v) noexcept override {
   71:         data[k] = v;
   72:         return true;
   73:     } // BUG
   74:     [[nodiscard]] bool tier_lookup(std::uint64_t k, std::uint64_t* o) const noexcept override {
   75:         auto it = data.find(k);
   76:         if (it != data.end()) {
   77:             if (o) *o = it->second;
   78:             return true;
   79:         }
   80:         return false;
   81:     }
   82:     [[nodiscard]] bool          tier_erase(std::uint64_t k) noexcept override { return data.erase(k) > 0; }
   83:     void                        tier_clear() noexcept override { data.clear(); }
   84:     [[nodiscard]] std::uint64_t tier_size() const noexcept override { return data.size(); }
   85:     void                        tier_observe(ana::ComdareTierObserverSnapshot*) const noexcept override {}
   86: };
