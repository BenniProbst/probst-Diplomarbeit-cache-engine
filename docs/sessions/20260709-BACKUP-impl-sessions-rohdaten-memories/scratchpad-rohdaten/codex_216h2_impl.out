  115:     eq("Gate: alle Fälle bestanden", pr.conformance_cases_passed, pr.conformance_cases_total);
  116: 
  117:     // Round-Trip: die perm_runner-Zeile via result_ingest in den Baum spielen.
  118:     ex::ExperimentTree tree{std::make_shared<ex::ExperimentNodeFactory>()};
  119:     std::size_t const  n = ex::ingest_results(tree, line);
  120:     eq("ingest_results == 1", n, std::size_t{1});
  121: 
  122:     auto const nv = tree.node_value(bid);
  123:     tr("observer_real (über perm_runner gemessen + eingespielt)", nv.observer_real);
  124:     eq("search_insert_count == 100 (Mess→Format→Ingest identisch)", nv.observer.search_insert_count,
  125:        std::uint64_t{100});
  126:     eq("search_lookup_count == 100", nv.observer.search_lookup_count, std::uint64_t{100});
