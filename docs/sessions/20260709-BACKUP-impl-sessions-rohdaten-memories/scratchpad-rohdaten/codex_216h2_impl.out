   17: 
   18: // Mock-IObservableTier mit search_algo-Statistik (deterministisch).
   19: struct MockObsTier final : ana::IObservableTier {
   20:     std::map<std::uint64_t, std::uint64_t> data;
   21:     std::uint64_t                          inserts = 0;
   22:     mutable std::uint64_t                  lookups = 0, hits = 0;
   23:     // (Audit K9) std::map-konform (insert-or-assign): bei Duplikat WIRD der Wert aktualisiert; return true = NEUER Key.
   24:     // Exakt der Vertrag des Konformitäts-Gate-Oracles (RF3), identisch zu test_v5_conformance_gate::GoodTier. Der frühere
   25:     // emplace() ließ den Wert bei Duplikat stehen → Gate-Bruch (vom neu verdrahteten Gate korrekt aufgedeckt).
   26:     [[nodiscard]] bool tier_insert(std::uint64_t k, std::uint64_t v) noexcept override {
   27:         auto const r = data.insert({k, v});
   28:         if (!r.second) { r.first->second = v; }
   29:         ++inserts;
   30:         return r.second;
   31:     }
   32:     [[nodiscard]] bool tier_lookup(std::uint64_t k, std::uint64_t* o) const noexcept override {
   33:         ++lookups;
   34:         auto it = data.find(k);
   35:         if (it != data.end()) {
   36:             ++hits;
   37:             if (o) *o = it->second;
   38:             return true;
   39:         }
   40:         return false;
   41:     }
   42:     [[nodiscard]] bool tier_erase(std::uint64_t k) noexcept override { return data.erase(k) > 0; }
   43:     // (Audit K9) vertragstreu wie reale Tiere: tier_clear() nullt die Mess-Statistik je Lauf (real: search_organ_.reset(),
   44:     // perm_runner.hpp:95-97). Ohne dies würden die Konformitäts-Gate-Ops (RF1–7 + 2000 Zufalls-Ops) die Zähler verfälschen.
   45:     void tier_clear() noexcept override {
   46:         data.clear();
   47:         inserts = 0;
   48:         lookups = 0;
   49:         hits    = 0;
   50:     }
   51:     [[nodiscard]] std::uint64_t tier_size() const noexcept override { return data.size(); }
   52:     // Die EINE konsolidierte tier_observe — search-Stats nach axis_stats[0] (T0). Wird von run_observable_perm
   53:     // für das (volle-Matrix-)Wire-Format genutzt; ingest leitet die benannten Legacy-Felder daraus ab.
   54:     void tier_observe(ana::ComdareTierObserverSnapshot* o) const noexcept override {
   55:         if (!o) return;
   56:         o->axis_stats[0][0]      = lookups;
   57:         o->axis_stats[0][1]      = hits;
   58:         o->axis_stats[0][3]      = inserts; // T0 search lookup/hit/insert
   59:         o->tier_fill_level       = data.size();
   60:         o->observable_axis_count = 2;
   61:         o->filled_axis_count     = 1;
   62:     }
   63: };
