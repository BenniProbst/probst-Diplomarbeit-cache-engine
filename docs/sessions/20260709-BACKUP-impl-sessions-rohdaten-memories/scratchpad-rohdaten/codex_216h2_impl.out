 1800:     //   exact next touch.
 1801:     [[nodiscard]] std::size_t descent_slot_for_(std::uint64_t key) const noexcept {
 1802:         auto const&       st = container_algorithm_.store();
 1803:         std::size_t const n  = st.slot_count();
 1804:         if (n == 0) return 0;
 1805:         // Lower-Bound ueber die realen Store-Keys. SORTIERT → exakte next-touch-Position; UNSORTIERT → in-range Schaetzung.
 1806:         std::size_t lo = 0, hi = n;
 1807:         while (lo < hi) {
 1808:             std::size_t const m = lo + (hi - lo) / 2;
 1809:             if (st.key_at(m) < key)
 1810:                 lo = m + 1;
 1811:             else
 1812:                 hi = m;
 1813:         }
 1814:         return (lo < n) ? lo : (n - 1);
 1815:     }
