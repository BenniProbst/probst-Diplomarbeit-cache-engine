  129:     eq("observable_axis_count == 2", nv.observer.observable_axis_count, std::uint64_t{2});
  130: 
  131:     // (Audit K9) Negativ-Nachweis: eine NICHT-std::map-konforme Hülle wird vom Gate erkannt → KEINE gültige Mess-Zeile.
  132:     BrokenTier           broken;
  133:     ex::PermResult const bpr = ex::run_observable_perm(broken, "search_algo=Broken", 100);
  134:     tr("nicht-konform: Gate NICHT bestanden", !bpr.conformance_passed);
  135:     tr("nicht-konform: first_fail gesetzt (erste Oracle-Verletzung)", bpr.conformance_first_fail > 0);
  136:     tr("nicht-konform: NICHT als gültig gemessen (unified_real=false)", !bpr.unified_real);
  137: 
  138:     std::cout << "\n==== D14b perm_runner: " << (g_fail == 0 ? "ALLE OK" : (std::to_string(g_fail) + " FEHLER"))
  139:               << " ====\n";
  140:     return g_fail == 0 ? 0 : 1;
  141: }

