   88: static int g_fail = 0;
   89: template <class A, class B>
   90: static void eq(char const* w, A const& g, B const& e) {
   91:     bool ok = (g == e);
   92:     std::cout << (ok ? "  [OK]  " : "  [ERR] ") << w << " = " << g;
   93:     if (!ok) {
   94:         std::cout << " (erwartet " << e << ")";
   95:         ++g_fail;
   96:     }
   97:     std::cout << "\n";
   98: }
   99: static void tr(char const* w, bool c) {
  100:     std::cout << (c ? "  [OK]  " : "  [ERR] ") << w << "\n";
  101:     if (!c) ++g_fail;
  102: }
