   40: inline constexpr std::size_t kNoCompositions        = 0u;
   41: inline constexpr std::size_t kKnownCompositionCount = mp11::mp_size<KnownCompositionEntries>::value;
   42: 
   43: template <class Entry>
   44: using EntryCompositionIsComposition = std::bool_constant<an::IsComposition<typename Entry::composition>>;
   45: 
   46: template <class Entry>
   47: std::string label_for() {
   48:     using Composition = typename Entry::composition;
   49:     std::string label{std::string_view{Composition::name}};
   50:     label += " [";
   51:     label += std::string{std::string_view{Entry::short_name}};
   52:     label += "]";
   53:     return label;
   54: }
   55: 
   56: #if COMDARE_MEASUREMENT_ON
   57: 
   58: namespace dock = ::comdare::cache_engine::builder::pruef_dock;
   59: 
   60: inline constexpr std::uint64_t kNoFailures           = 0u;
   61: inline constexpr std::uint64_t kConformanceSeed      = 42u;
   62: inline constexpr std::uint64_t kConformanceRandomOps = 2000u;
   63: inline constexpr std::uint64_t kInitialInsertCount   = 64u;
   64: inline constexpr std::uint64_t kReuseInsertCount     = 8u;
   65: inline constexpr std::uint64_t kInitialKeyBase       = 1u;
   66: inline constexpr std::uint64_t kReuseKeyBase         = 10'000u;
   67: inline constexpr std::uint64_t kValueSalt            = 0x9E3779B97F4A7C15ull;
   68: inline constexpr std::uint64_t kLookupSentinel       = 0xBAD0C0DEu;
   69: 
   70: template <class Composition>
   71: using AdapterFor = an::SearchAlgorithmAbiAdapter<an::SearchAlgorithmAnatomy<Composition>>;
   72: 
   73: [[nodiscard]] std::uint64_t value_for(std::uint64_t key) noexcept { return key ^ kValueSalt; }
   74: 
   75: template <class Fn>
   76: void for_each_known_composition(Fn&& fn) {
   77:     mp11::mp_for_each<KnownCompositionEntries>([&](auto entry_tag) {
   78:         using KnownEntry = std::decay_t<decltype(entry_tag)>;
   79:         fn.template operator()<KnownEntry>();
   80:     });
   81: }
   82: 
   83: struct ConformanceRunner {
   84:     std::size_t visited = kNoCompositions;
   85: 
   86:     template <class Entry>
   87:     void operator()() {
   88:         using Composition = typename Entry::composition;
   89:         using Adapter     = AdapterFor<Composition>;
   90: 
   91:         SCOPED_TRACE(label_for<Entry>());
   92: 
   93:         auto  tier = std::make_unique<Adapter>();
   94:         auto& drv  = static_cast<an::IDriveableTier&>(*tier);
   95: 
   96:         auto const result = dock::run_conformance_gate(drv, kConformanceSeed, kConformanceRandomOps);
   97:         EXPECT_TRUE(result.passed()) << label_for<Entry>() << " cases=" << result.cases_passed << "/"
   98:                                      << result.cases_total << " first_fail=" << result.first_fail;
   99:         EXPECT_GT(result.cases_total, kNoFailures) << label_for<Entry>() << " Gate wurde nicht getrieben";
  100:         EXPECT_EQ(result.first_fail, kNoFailures) << label_for<Entry>() << " erste Gate-Verletzung";
  101: 
  102:         ++visited;
  103:     }
  104: };
  105: 
  106: struct SizeClearReuseRunner {
  107:     std::size_t visited = kNoCompositions;
  108: 
  109:     template <class Entry>
  110:     void operator()() {
  111:         using Composition = typename Entry::composition;
  112:         using Adapter     = AdapterFor<Composition>;
  113: 
  114:         SCOPED_TRACE(label_for<Entry>());
  115: 
  116:         auto  tier = std::make_unique<Adapter>();
  117:         auto& drv  = static_cast<an::IDriveableTier&>(*tier);
  118:         drv.tier_clear();
  119: 
  120:         for (std::uint64_t offset = kNoFailures; offset < kInitialInsertCount; ++offset) {
  121:             auto const key = kInitialKeyBase + offset;
  122:             EXPECT_TRUE(drv.tier_insert(key, value_for(key))) << label_for<Entry>() << " insert key=" << key;
  123:         }
  124:         EXPECT_EQ(drv.tier_size(), kInitialInsertCount) << label_for<Entry>() << " size nach Initial-Inserts";
  125: 
  126:         drv.tier_clear();
  127:         EXPECT_EQ(drv.tier_size(), kNoFailures) << label_for<Entry>() << " size nach clear";
  128: 
  129:         std::uint64_t stale_value = kLookupSentinel;
  130:         EXPECT_FALSE(drv.tier_lookup(kInitialKeyBase, &stale_value)) << label_for<Entry>() << " alter Key nach clear";
  131: 
  132:         for (std::uint64_t offset = kNoFailures; offset < kReuseInsertCount; ++offset) {
  133:             auto const key      = kReuseKeyBase + offset;
  134:             auto const expected = value_for(key);
  135:             EXPECT_TRUE(drv.tier_insert(key, expected)) << label_for<Entry>() << " reuse insert key=" << key;
  136: 
  137:             std::uint64_t actual = kLookupSentinel;
  138:             EXPECT_TRUE(drv.tier_lookup(key, &actual)) << label_for<Entry>() << " reuse lookup key=" << key;
  139:             EXPECT_EQ(actual, expected) << label_for<Entry>() << " reuse value key=" << key;
  140:         }
  141:         EXPECT_EQ(drv.tier_size(), kReuseInsertCount) << label_for<Entry>() << " size nach Wiederverwendung";
  142: 
  143:         ++visited;
  144:     }
  145: };
