    2: // V5-I2 (2026-05-31) — IDriveableTier: funktionaler Gattungs-Antrieb (IMMER einkompiliert, ABI-stabil).
    3: //
    4: // Doku: docs/architecture/messarchitektur_v5_design.md §5.2/§8.1 (Interface-Split), §7 (compile-time-Disjunktheit).
    5: //
    6: // Trennung der Belange (User-Direktive „Anatomy-ABI ⊥ Observer-Tier-Schnittstelle"):
    7: //   - IDriveableTier  = der reine FUNKTIONALE Gattungs-Antrieb (tier_insert/lookup/erase/clear/size, uint64-Key/Value).
    8: //                       IMMER in jeder Tier-Binary einkompiliert — auch in der Release-/funktional-only-DLL ohne Messung.
    9: //                       Über diese Schnittstelle treibt der host-seitige Prüfdock (abstract-factory-ähnlich) jede geladene
   10: //                       Binary generisch + fährt das std::map-Konformitäts-Gate (§6), unabhängig von der Mess-Ausstattung.
   11: //   - IObservableTier = NUR der Observer-Zugriff (tier_observe → Snapshot-POD); erbt IDriveableTier, wird aber NUR bei
   12: //                       Messung-AN (COMDARE_MEASUREMENT_ON) vom ABI-Adapter vererbt/exportiert (observable_tier.hpp).
   13: //   - IRollbackableTier (rollbackable_tier.hpp, V5-I6) = memento_all; ebenfalls NUR bei Messung-AN.
   14: //
   15: // ABI-SICHER nach demselben Designprinzip wie measurable_workload.hpp / observable_tier.hpp: ein eigenständiges
   16: // Sub-Interface, das der genus-typisierte ABI-Adapter erbt; der Host fragt es via dynamic_cast<IDriveableTier*> ab.
   17: // Der Antriebs-Teil quert die Grenze als reine vtable (uint64-Parameter, kein STL/POD-by-value) → ABI-stabil.
   18: 
   19: #include <cstdint>
   20: 
   21: namespace comdare::cache_engine::anatomy {
   22: 
   23: /// IDriveableTier — der funktionale Gattungs-Antrieb einer geladenen Tier-Anatomie (Pfad B, immer vorhanden).
   24: ///
   25: /// Gemeinsamer uint64-Key/Value-Raum nach Umstufung-B (alle sezierten Such-Organe einheitlich uint64). Der Host
   26: /// (CacheEngineBuilder/Prüfdock) treibt darüber generisch jede geladene Binary — für das Konformitäts-Gate gegen
   27: /// std::map UND für die eigentliche Last (Lastenprofil). KEIN Observer, KEIN Memento — rein funktional.
   28: class IDriveableTier {
   29: public:
   30:     virtual ~IDriveableTier() = default;
   31: 
   32:     /// Fügt (key,value) ein bzw. aktualisiert. Rückgabe: true wenn ein NEUER Schlüssel entstand.
   33:     [[nodiscard]] virtual bool tier_insert(std::uint64_t key, std::uint64_t value) noexcept = 0;
   34: 
   35:     /// Sucht key. Bei Treffer wird *out_value gesetzt (falls out_value != nullptr) und true geliefert.
   36:     [[nodiscard]] virtual bool tier_lookup(std::uint64_t key, std::uint64_t* out_value) const noexcept = 0;
   37: 
   38:     /// Entfernt key. Rückgabe: true wenn key vorhanden war.
   39:     [[nodiscard]] virtual bool tier_erase(std::uint64_t key) noexcept = 0;
   40: 
   41:     /// Leert den Tier-Zustand (Schlüssel; Statistik-Reset ist separat über reset()).
   42:     virtual void tier_clear() noexcept = 0;
   43: 
   44:     /// Logische Schlüsselzahl (Füllstand).
   45:     [[nodiscard]] virtual std::uint64_t tier_size() const noexcept = 0;
   46: };
   47: 
   48: } // namespace comdare::cache_engine::anatomy

