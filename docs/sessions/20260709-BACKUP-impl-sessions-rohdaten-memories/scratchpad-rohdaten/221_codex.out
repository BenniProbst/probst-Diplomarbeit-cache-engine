///   T13 = index_organization (search_engine::axis_01)
///   T14 = io_dispatch        (io::axis_io)
///   T15 = migration_policy   (migration::axis_migration)
///   T16 = filter             (filter::axis_filter)
///   T17 = queuing_q1         (queuing::axis_q1_queuing — buffer_strategy)
