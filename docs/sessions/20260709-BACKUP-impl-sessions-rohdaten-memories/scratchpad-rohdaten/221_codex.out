    [[nodiscard]] std::uint32_t runtime_distance_override() const noexcept {
        if constexpr (detail_real::prefetch_family_v<Strategy> == 1) return runtime_distance_override_;
        else return 0;
    }

    std::uint32_t runtime_distance_override_ = 0;

