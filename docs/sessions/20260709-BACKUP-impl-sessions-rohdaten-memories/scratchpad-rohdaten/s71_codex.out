    [[nodiscard]] bool tier_lookup(std::uint64_t key, std::uint64_t* out_value) const noexcept override {
        // #188-4c-iii (2026-07-02): lookup liest immer aus dem einzigen konstitutiven container_algorithm_-Zustand.
