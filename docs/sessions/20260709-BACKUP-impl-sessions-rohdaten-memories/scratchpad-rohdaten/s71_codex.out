    // Verifikation (tier1-Fuellstand). Additiv, bestehende Schnittstelle unveraendert.
    [[nodiscard]] Store&       store_mut() noexcept { return search_.store_mut(); }
    [[nodiscard]] Store const& store() const noexcept { return search_.store(); }

