    EXPECT_NE(csv.find("\nYCSB_C_read_only,40,1,"), std::string::npos); // Profil-2-Zeile
    // 3 Zeilen (Header + 2 Profile): genau 2 '\n' nach dem Header, 3 insgesamt.
    EXPECT_EQ(std::count(csv.begin(), csv.end(), '\n'), 3);
}

