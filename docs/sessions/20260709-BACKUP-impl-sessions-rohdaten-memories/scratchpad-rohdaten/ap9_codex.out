inline constexpr std::string_view cxx_flags = \"@COMDARE_PROVENANCE_CXX_FLAGS@\";
inline constexpr std::string_view isa_built_for = \"@COMDARE_PROVENANCE_ISA_BUILT_FOR@\";
inline constexpr std::string_view git_sha_super = \"@COMDARE_PROVENANCE_GIT_SHA_SUPER@\";
inline constexpr std::string_view git_sha_cache_engine = \"@COMDARE_PROVENANCE_GIT_SHA_CACHE_ENGINE@\";
