# comdare-cache-engine — Top-Level CMakeLists.txt
# Active Cache-Aware Hardware Adaptation Cache Engine for Trie-Based Index Structures
# TU Dresden Diplomarbeit · BEP Venture UG / Marke Comdare · Apache 2.0
#
# Phase 4.B Skelett — KEINE Implementation, nur Build-Struktur

cmake_minimum_required(VERSION 3.28)  # C++23 Modules-Support
project(comdare-cache-engine
        VERSION 0.1.0
        DESCRIPTION "Active Cache-Aware Hardware Adaptation Cache Engine"
        LANGUAGES CXX)

# ─────────────────────────────────────────────────────────────────────────────
# C++ Standard (F-EXTRA-1 — Hauptcompiler IMMER C++23)
# ─────────────────────────────────────────────────────────────────────────────
set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# ─────────────────────────────────────────────────────────────────────────────
# Build-Modi (F9 — Compile-Time vs Runtime SIMD-Detection, mutually exclusive)
# ─────────────────────────────────────────────────────────────────────────────
set(COMDARE_DETECTION_MODE "COMPILE_TIME" CACHE STRING
    "ISA-Detection: COMPILE_TIME oder RUNTIME (mutually exclusive)")
set_property(CACHE COMDARE_DETECTION_MODE PROPERTY STRINGS COMPILE_TIME RUNTIME)

# ─────────────────────────────────────────────────────────────────────────────
# Build-Optionen (F11 — Mikrobenchmarks)
# ─────────────────────────────────────────────────────────────────────────────
option(COMDARE_BUILD_BUILDER       "Build CacheEngineBuilder (main.cpp)"       ON)
option(COMDARE_BUILD_BENCHMARKS    "Build benchmark-Targets (YCSB + Custom)"   ON)
option(COMDARE_BUILD_TESTS         "Build Google-Tests (generic + specific)"   ON)
option(COMDARE_BUILD_PERMUTATIONS  "Pre-Build aller Modul-Permutationen"       OFF)
option(COMDARE_MICROBENCH_CONTINUOUS "Continuous Mikrobenchmarks (Builder-Modus)" OFF)

# ─────────────────────────────────────────────────────────────────────────────
# V5-#26 / Task #153 — Intel-PCM Windows-Cache-Miss-Quelle (WindowsPcmPmcSource)
# ─────────────────────────────────────────────────────────────────────────────
# Default OFF → der Build ist UNVERÄNDERT: es wird KEIN cpucounters.h gesucht, KEIN msr.sys gebraucht,
# die Factory (pmc_source_factory.hpp) liefert NullPmcSource (available=false, HW-Spalten ehrlich 0).
# ON → reale L2/L3-Cache-Miss-Messung über Intel PCM (BSD-3). Benötigt PCM-Header+Lib (COMDARE_PCM_DIR)
#      sowie ein signiertes msr.sys + Admin zur Laufzeit (System-Schritt, NICHT im Build).
#      Doku: docs/sessions/2026-06-18-windows-pcm-pmc-source-integration.md
option(COMDARE_ENABLE_PMC "Intel PCM Windows cache-miss source (WindowsPcmPmcSource, BSD-3)" OFF)
set(COMDARE_PCM_DIR "" CACHE PATH "Wurzel der Intel-PCM-Installation (enthält cpucounters.h + PCM-Lib)")
if(COMDARE_ENABLE_PMC)
    if(UNIX AND NOT APPLE)
        # ── Linux-Zweig (CE-DL2): LinuxPerfPmcSource via perf_event_open(2) ──
        # perf_event_open ist ein KERNEL-Syscall (kein glibc-Wrapper, KEINE Vendor-Lib) → das Compile-Makro
        # COMDARE_ENABLE_PMC genügt; der Header linux_perf_pmc_source.hpp ist selbst auf
        #   #if defined(COMDARE_ENABLE_PMC) && defined(__linux__)
        # geguardet, die OS-Wahl macht die Factory. Daher GLOBAL definieren (header-only Quelle, alle Targets).
        message(STATUS "COMDARE_ENABLE_PMC: Linux — LinuxPerfPmcSource (perf_event_open, keine Vendor-Lib).")
        add_compile_definitions(COMDARE_ENABLE_PMC)
        # Optionaler sekundärer PAPI-Pfad (perf bleibt primär): nur aktivieren, wenn explizit gewünscht UND
        # papi.h + libpapi gefunden. Sonst still aus (perf-only) — kein Build-Bruch.
        option(COMDARE_ENABLE_PAPI "Optionaler PAPI-Fallback für LinuxPerfPmcSource (perf_event_open bleibt primär)" OFF)
        if(COMDARE_ENABLE_PAPI)
            find_path(COMDARE_PAPI_INCLUDE_DIR papi.h)
            find_library(COMDARE_PAPI_LIBRARY NAMES papi)
            if(COMDARE_PAPI_INCLUDE_DIR AND COMDARE_PAPI_LIBRARY)
                message(STATUS "COMDARE_ENABLE_PAPI: PAPI gefunden — Header=${COMDARE_PAPI_INCLUDE_DIR} Lib=${COMDARE_PAPI_LIBRARY}")
                add_compile_definitions(COMDARE_ENABLE_PAPI)
                include_directories("${COMDARE_PAPI_INCLUDE_DIR}")
                link_libraries("${COMDARE_PAPI_LIBRARY}")
            else()
                message(WARNING "COMDARE_ENABLE_PAPI=ON, aber PAPI NICHT gefunden (papi.h / libpapi). "
                                "PAPI-Fallback effektiv AUS — perf_event_open bleibt das (primäre) Backend.")
            endif()
        endif()
    elseif(NOT WIN32)
        message(WARNING "COMDARE_ENABLE_PMC=ON, aber Ziel ist weder Windows noch Linux — keine reale PMC-Quelle. "
                        "Flag effektiv AUS (NullPmcSource).")
    else()
        find_path(COMDARE_PCM_INCLUDE_DIR cpucounters.h
            HINTS "${COMDARE_PCM_DIR}" "${COMDARE_PCM_DIR}/src" "${COMDARE_PCM_DIR}/include")
        find_library(COMDARE_PCM_LIBRARY
            NAMES pcm PCM libpcm
            HINTS "${COMDARE_PCM_DIR}" "${COMDARE_PCM_DIR}/lib" "${COMDARE_PCM_DIR}/build/lib")
        if(COMDARE_PCM_INCLUDE_DIR AND COMDARE_PCM_LIBRARY)
            message(STATUS "COMDARE_ENABLE_PMC: Intel PCM gefunden — Header=${COMDARE_PCM_INCLUDE_DIR} Lib=${COMDARE_PCM_LIBRARY}")
            # Global definieren + global verfügbar machen: die Quelle ist header-only (pmc_source_factory.hpp /
            # windows_pcm_pmc_source.hpp), daher COMDARE_ENABLE_PMC + PCM-Include für ALLE Targets, die sie ziehen.
            add_compile_definitions(COMDARE_ENABLE_PMC)
            include_directories("${COMDARE_PCM_INCLUDE_DIR}")
            link_libraries("${COMDARE_PCM_LIBRARY}")
        else()
            message(WARNING "COMDARE_ENABLE_PMC=ON, aber Intel PCM NICHT gefunden "
                            "(cpucounters.h / PCM-Lib). Setze -DCOMDARE_PCM_DIR=<pcm-root>. "
                            "Flag effektiv AUS (NullPmcSource, Build bleibt grün).")
        endif()
    endif()
endif()

# V41.E11 Plugin-Controller: per Konfiguration geladene Prüfling-Repos (Doku 20).
# Semikolon-Liste von Prüfling-Verzeichnissen (parallel zur cache-engine-Wurzel), die die
# cache-engine als CE-konforme Plugins laedt. Default leer = nur CE-Permutation (Stufe 1).
# Jedes Prüfling-Repo stellt <dir>/comdare_pruefling.cmake bereit (registriert seine
# Achsen-Slots/Targets). Die Diplomarbeit setzt diese Liste via -DCOMDARE_CE_PRUEFLINGE=...
set(COMDARE_CE_PRUEFLINGE "" CACHE STRING
    "Semikolon-Liste der zu ladenden Pruefling-Repo-Verzeichnisse (z.B. ${CMAKE_SOURCE_DIR}/../comdare-prt-art)")

# V41.P0 / V5-I1 (2026-05-31) — Mess-Master-Schalter (Compile-Release-Profil).
# Doku: docs/architecture/messarchitektur_v5_design.md §2.3 (NEU-Flags) + §7 (compile-time-Entfernung).
#   COMDARE_MEASUREMENT_MODE (Master): bindet observer_all + memento_all + Pfad-A-in-DLL ein.
#       DEFAULT ON = Messung eingebaut (User-Direktive A5: Compile-Release-Profil default Messung-an).
#   COMDARE_RELEASE_MODE (Komplement): reine funktional-getriebene Tier-Binary OHNE Mess-Overhead,
#       an die Forschung auslieferbar (observer_all+memento_all compile-time restlos entfernt).
#   Verhaeltnis (V5-Design §9 R7): RELEASE_MODE=ON erzwingt MEASUREMENT_MODE=OFF;
#       MEASUREMENT_MODE=OFF erzwingt COMDARE_CE_ENABLE_STATISTICS=OFF;
#       MEASUREMENT_MODE=ON definiert COMDARE_MEASUREMENT_ON=1 (zieht observer_all/memento_all in den Adapter, §7).
option(COMDARE_MEASUREMENT_MODE "V5: Messung (observer_all+memento_all) einkompilieren (Master)" ON)
option(COMDARE_RELEASE_MODE     "V5: Release-DLL ohne Messung (funktional-only, auslieferbar)"   OFF)
if(COMDARE_RELEASE_MODE)
    set(COMDARE_MEASUREMENT_MODE OFF CACHE BOOL "V5: durch COMDARE_RELEASE_MODE erzwungen" FORCE)
endif()
if(COMDARE_MEASUREMENT_MODE)
    add_compile_definitions(COMDARE_MEASUREMENT_ON=1)
else()
    # Funktional-only/Release: Statistics zwingend aus (observer_all+memento_all werden nicht vererbt, §7).
    set(COMDARE_CE_ENABLE_STATISTICS OFF CACHE BOOL "V5: durch !COMDARE_MEASUREMENT_MODE erzwungen" FORCE)
    message(STATUS "COMDARE V5: RELEASE/funktional-only -> Messung (observer_all+memento_all) NICHT einkompiliert")
endif()

# V41.F.6.1.A (2026-05-25) — Statistics/Mess-Overhead per CMake-Flag steuern
# Default ON: alle Topic+Achsen-Implementierungen enthalten statistics() + reset()
# als Pflicht-API (Mess-Reihen + Welch-Test brauchen das).
# Wenn OFF: statistics()+reset()+Statistik-Member werden komplett aus dem Binary
# herauspraepariert (#ifdef'd in den Achsen-Headers). Production-Export einer
# Final-Permutation OHNE Mess-Overhead. CacheEnginePermutationStrategy-Concept
# verlangt statistics()/reset() dann nicht mehr.
# V5-I1: COMDARE_MEASUREMENT_MODE ist der Master darueber (R7); bei MEASUREMENT_MODE=ON bleibt der Default ON.
option(COMDARE_CE_ENABLE_STATISTICS
    "V41.F.6.1.A: Topic+Achsen-Statistics enabled (jede Achse muss statistics()+reset() bieten)"
    ON)
if(COMDARE_CE_ENABLE_STATISTICS)
    add_compile_definitions(COMDARE_CE_ENABLE_STATISTICS=1)
endif()

# Audit #212 / K5b (2026-06-28) — per-Achsen-Observer-PUSH (std::function notify) als OPT-IN.
# DEFAULT OFF = zero-cost NullNotify in Mess- UND Produktiv-DLL (Apparat-Reinheit Meta #6; ueber die
# extern-C-Modulgrenze wird NIE ein Subscriber gesetzt -> der per-Op-notify ist toter Apparat-Overhead).
# Nur die Observer-Mechanik-Unit-Tests (tests/unit) schalten ihn per target_compile_definitions AN.
# Genistet unter STATISTICS (der MeasurableObserver existiert nur, wenn Statistics an sind).
option(COMDARE_CE_ENABLE_OBSERVER_PUSH
    "Audit #212/K5b: per-Achsen-Observer std::function-PUSH einkompilieren (Default OFF = zero-cost; nur Mechanik-Tests AN)"
    OFF)
if(COMDARE_CE_ENABLE_STATISTICS AND COMDARE_CE_ENABLE_OBSERVER_PUSH)
    add_compile_definitions(COMDARE_CE_ENABLE_OBSERVER_PUSH=1)
endif()

# V41.F.6.1.C Stufe 1 (2026-05-25): Zentrale Vendor-Aktivierungs-Flags pro Topic-Achse
# (W6-Pattern: konfigurierte Vendor in mp_list akkumuliert, Compiler verwirft Rest)
# Default ON wenn Vendor-Source im ext/ vorhanden; spaeter dynamisch durch
# CacheEngineBuilder-App ueberschreibbar (siehe §15.7)
option(COMDARE_AXIS_06_ENABLE_STD       "Allocator A22 std::malloc/free (libc)"      ON)
