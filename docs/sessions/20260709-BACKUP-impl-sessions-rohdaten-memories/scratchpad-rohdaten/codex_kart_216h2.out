37:// ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
38:// WorkloadRunResult - Mess-Ergebnis EINES Lastprofils ber EIN Tier
39:// ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
40:
41:/// Roh-Wall-Clock-ns je Op-Kind (GETRENNT, Doku 24 õ2.1) + Wall-Clock-korrelierter Observer-POD am Ende.
42:struct WorkloadRunResult {
43:    std::string                     profile_name{};
44:    std::uint64_t                   op_count  = 0;
45:    bool                            two_phase = false; ///< true = Rollback aktiv (sonst Kalt-Messung)
46:    std::vector<std::int64_t>       insert_ns{};
47:    std::vector<std::int64_t>       lookup_ns{};
48:    std::vector<std::int64_t>       erase_ns{};
49:    std::vector<std::int64_t>       clear_ns{};
50:    std::vector<std::int64_t>       scan_ns{};     ///< V5-#49-E: Range-Scan-Latenzen (leer wenn Tier nicht scanbar)
51:    std::vector<std::int64_t>       rmw_ns{};      ///< V5-#49-F: Read-Modify-Write-Latenzen
52:    std::uint64_t                   read_sink = 0; ///< Anti-Wegoptimierungs-Senke (gemessene Lookups + Scans)
53:    an::ComdareTierObserverSnapshot observer{};    ///< EIN konsolidierter Observer-POD am Lauf-Ende (korreliert, I1)
54:};
55:
56:// ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
57:// run_workload_profile - generischer Host-Treiber EINES Lastprofils
58:// ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
59:
60:/// Treibt die (vorgenerierte, reproduzierbare) Op-Sequenz `ops` ber das Tier; jede gemessene Op via
61:/// Zwei-Phasen-Treiber (V5-I7) wenn `rollback != nullptr`. `ops` wird typischerweise via
62:/// `WorkloadGenerator(config).generate_all()` erzeugt - dieselbe Config+Seed ? identische Sequenz ber alle
63:/// Binaries (Reproduzierbarkeit-Pflicht). Latenzen werden je Op-Kind getrennt gesammelt.
64:[[nodiscard]] inline WorkloadRunResult run_workload_profile(
65:    an::IObservableTier& tier, an::IRollbackableTier* rollback, std::vector<WorkloadOp> const& ops,
66:    std::string_view    profile_name,
67:    an::IScannableTier* scan = nullptr) { // V5-#49-E: optional (alte DLLs  nullptr  Scan-Ops bersprungen)
68:    using clock = std::chrono::steady_clock;
69:    WorkloadRunResult r;
70:    r.profile_name = std::string(profile_name);
71:    r.op_count     = ops.size();
72:    r.two_phase    = (rollback != nullptr);
73:
74:    for (auto const& op : ops) {
75:        switch (op.kind) {
76:            case WorkloadOpKind::Insert: {
77:                auto const ns = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
78:                    auto const t0 = clock::now();
79:                    (void)tier.tier_insert(op.key, op.value);
80:                    auto const t1 = clock::now();
81:                    return ac::detail::abi_dur_ns(t0, t1);
82:                });
83:                r.insert_ns.push_back(ns);
84:                break;
85:            }
86:            case WorkloadOpKind::Lookup: {
87:                std::uint64_t measured_out = 0;
88:                bool          measured_hit = false;
89:                auto const    ns           = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
90:                    std::uint64_t out = 0;
91:                    auto const    t0  = clock::now();
92:                    bool const    hit = tier.tier_lookup(op.key, &out);
93:                    auto const    t1  = clock::now();
94:                    measured_hit      = hit;
95:                    measured_out      = out; // spiegelt nach two_phase_measure die MESS-Phase
96:                    return ac::detail::abi_dur_ns(t0, t1);
97:                });
98:                r.read_sink += measured_hit ? measured_out : 0u;
99:                r.lookup_ns.push_back(ns);
100:                break;
101:            }
102:            case WorkloadOpKind::Erase: {
103:                auto const ns = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
104:                    auto const t0 = clock::now();
105:                    (void)tier.tier_erase(op.key);
106:                    auto const t1 = clock::now();
107:                    return ac::detail::abi_dur_ns(t0, t1);
108:                });
109:                r.erase_ns.push_back(ns);
110:                break;
111:            }
112:            case WorkloadOpKind::Clear: {
113:                auto const ns = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
114:                    auto const t0 = clock::now();
115:                    tier.tier_clear();
116:                    auto const t1 = clock::now();
117:                    return ac::detail::abi_dur_ns(t0, t1);
118:                });
119:                r.clear_ns.push_back(ns);
120:                break;
121:            }
122:            case WorkloadOpKind::Scan: { // V5-#49-E: Range-Scan ab op.key ber op.value (=scan_length) Records
123:                if (scan != nullptr) {
124:                    std::uint64_t scan_sum = 0;
125:                    auto const    ns       = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
126:                        std::uint64_t cs = 0;
127:                        auto const    t0 = clock::now();
128:                        (void)scan->tier_scan(op.key, op.value, &cs);
129:                        auto const t1 = clock::now();
130:                        scan_sum      = cs; // spiegelt nach two_phase_measure die MESS-Phase
131:                        return ac::detail::abi_dur_ns(t0, t1);
132:                    });
133:                    r.read_sink += scan_sum;
134:                    r.scan_ns.push_back(ns);
135:                }
136:                // scan == nullptr  Tier nicht scanbar (alte DLL / Release): Op ehrlich bersprungen (kein Fake-Sample).
137:                break;
138:            }
139:            case WorkloadOpKind::ReadModifyWrite: { // V5-#49-F: lookup  modifizieren  upsert als EINE Op
140:                auto const ns = ac::detail::two_phase_measure(rollback, [&]() -> std::int64_t {
141:                    std::uint64_t       cur      = 0;
142:                    auto const          t0       = clock::now();
143:                    bool const          hit      = tier.tier_lookup(op.key, &cur); // READ
144:                    std::uint64_t const modified = (hit ? cur : 0u) ^ op.value;    // MODIFY (deterministisch)
145:                    (void)tier.tier_insert(op.key, modified);                      // WRITE (ComposedSearch-Upsert)
146:                    auto const t1 = clock::now();
147:                    return ac::detail::abi_dur_ns(t0, t1);
148:                });
149:                r.rmw_ns.push_back(ns);
150:                break;
151:            }
152:        }
153:    }
154:
155:    tier.tier_observe(&r.observer); // EIN korrelierter Observer-POD am Lauf-Ende
156:    return r;
157:}
