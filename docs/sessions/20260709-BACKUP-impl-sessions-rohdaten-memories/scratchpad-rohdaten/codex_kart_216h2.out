23:};
24:
25:class RepetitionPlan {
26:public:
27:    /// Default 3 Wiederholungen (konfigurierbar); 0  auf 1 normalisiert (mind. ein Lauf).
28:    explicit RepetitionPlan(std::uint32_t repetitions = 3) noexcept : reps_{repetitions == 0 ? 1u : repetitions} {}
29:
30:    [[nodiscard]] std::uint32_t repetitions() const noexcept { return reps_; }
31:
32:    /// Fhrt `measure(repetition_index)` GENAU reps_-mal aus und sammelt JEDE Wiederholung SEPARAT
33:    /// (kein Mittelwert, keine Interpolation). measure liefert {micros_per_op, op_count} der Wiederholung.
34:    template <class MeasureFn>
35:    [[nodiscard]] std::vector<RepetitionRecord> run(std::string const& setting_id, MeasureFn&& measure) const {
36:        std::vector<RepetitionRecord> out;
37:        out.reserve(reps_);
38:        for (std::uint32_t r = 0; r < reps_; ++r) {
39:            auto const m = measure(r); // {micros_per_op, op_count}
40:            out.push_back(RepetitionRecord{setting_id, r, m.first, m.second});
41:        }
42:        return out;
43:    }
