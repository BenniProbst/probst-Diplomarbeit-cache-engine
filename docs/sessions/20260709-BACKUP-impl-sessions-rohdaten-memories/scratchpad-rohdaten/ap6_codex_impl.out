  17: /// PackedBitmapMemoryLayout — Bit-packed (1 Bit pro Slot), succinct.
  18: /// Typischer Layout fuer LOUDS / SuRF Filter-Trees. Sehr kompakt
  19: /// (n * lg(sigma) bits), aber hoeherer Decode-Aufwand pro Lookup.
  20: class PackedBitmapMemoryLayout : public MemoryLayoutStrategyBase<PackedBitmapMemoryLayout> {
  21: public:
  22:     using topic_tag = ::comdare::cache_engine::memory_layout::concepts::MemoryLayoutTopicTag;
  23:     using axis_tag  = subaxes::packing_density_tag;
  24:     using family_id = std::integral_constant<int, 4>;
  25: 
  26:     static constexpr bool enabled = flags::packed_bitmap_enabled;
  27: 
  28:     [[nodiscard]] static constexpr std::size_t      cache_line_size() noexcept { return 8; } // 64 bit = 1 word
  29:     [[nodiscard]] static constexpr std::string_view name() noexcept { return "memory_layout_packed_bitmap"; }
  30: 
  31:     // REALE Repraesentation (P-MD1-ERDUNG #167): succinct hot/cold column-split (succinct data structures,
  32:     // LOUDS/SuRF-Geist). Der Store legt PRO Chunk drei Regionen an: eine 2-B-HOT-Key-Spalte (low16 jedes Keys),
