  41: // ─────────────────────────────────────────────────────────────────────────────
  42: // Der gemeinsame Müll-Korpus (~16 Einträge). Bewusst gemischt: leere/abgeschnittene
  43: // Fragmente, ungültige Strukturen, Binär-Bytes inkl. eingebettetem '\0', pathologische
  44: // Größen (sehr langes Attribut, sehr tiefe Verschachtelung) und wohlgeformtes-XML-mit-
  45: // falschem-Schema. KEINER davon ist ein gültiges comdare_load_profile.
  46: // ─────────────────────────────────────────────────────────────────────────────
  47: [[nodiscard]] std::vector<std::string> make_garbage_inputs() {
  48:     std::vector<std::string> in;
  49: 
  50:     in.emplace_back("");        // 1  komplett leer
  51:     in.emplace_back(" ");       // 2  nur Whitespace
  52:     in.emplace_back("<");       // 3  nacktes '<'
  53:     in.emplace_back("<a");      // 4  Tag ohne Abschluss
  54:     in.emplace_back("<a>");     // 5  offenes Element, kein close
  55:     in.emplace_back("<a></b>"); // 6  falsch verschachtelt / mismatched close
  56:     in.emplace_back("<<<>>>");  // 7  Klammer-Salat
  57:     // 8  Binär-Müll inkl. eingebettetem '\0' (kein gültiges UTF-8, nicht null-terminiert).
  58:     {
  59:         static constexpr unsigned char raw[] = {0x00,         0x01,         0x02, 0xFF, 0x3C /*'<'*/, 0x00,
  60:                                                 0x61 /*'a'*/, 0x3E /*'>'*/, 0xFE, 0x00, 0x7F};

