 1862: # Output-Wurzel für die Test-Schreibvorgänge: bevorzugt das OS-Temp-Verzeichnis (TMPDIR/TEMP/TMP),
 1863: # sonst der Build-Tree. Grund: wenn der Build-Tree unter einem synchronisierenden Ordner (OneDrive)
 1864: # liegt, blockiert der Datei-Sync jeden geschriebenen Roundtrip-/Extract-XML minutenlang (verifiziert:
 1865: # 478 s im OneDrive-Build-Tree vs 1 s im OS-Temp). Das ist umgebungs-, nicht code-bedingt; der Test
 1866: # bleibt korrekt, aber wir halten ihn schnell + suite-tauglich, indem wir ins Temp schreiben.
 1867: set(_comdare_test_out_root "${CMAKE_CURRENT_BINARY_DIR}")
 1868: foreach(_tmpvar TMPDIR TEMP TMP)
 1869:     if(DEFINED ENV{${_tmpvar}} AND IS_DIRECTORY "$ENV{${_tmpvar}}")
 1870:         set(_comdare_test_out_root "$ENV{${_tmpvar}}")
 1871:         break()
 1872:     endif()
 1873: endforeach()
