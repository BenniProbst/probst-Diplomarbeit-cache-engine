Ich ziehe noch eine kleine Parsing-Kante glatt: ein numerisch zu großer `--pin-core` soll wirklich no-op bleiben, auch wenn vorher ein gültiger Wert gesetzt wurde. Dafür setze ich das optionale Pinning in diesem Fall explizit zurück.
exec
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" -Command '$path = '"'apps/f15_compare/main.cpp'
"'$resolved = Resolve-Path -LiteralPath $path
$text = [System.IO.File]::ReadAllText($resolved)
$nl = if ($text.Contains("`r`n")) { "`r`n" } else { "`n" }
$old = @(
'"'        } else if (parse_flag_u64(a, \"--pin-core=\", u)) {',
'            if (u <= static_cast<std::uint64_t>(std::numeric_limits<unsigned>::max())) {',
'                pin_core = static_cast<unsigned>(u);',
'            }',
'        } else {'
) -join "'$nl
$new = @(
'"'        } else if (parse_flag_u64(a, \"--pin-core=\", u)) {',
'            if (u <= static_cast<std::uint64_t>(std::numeric_limits<unsigned>::max())) {',
'                pin_core = static_cast<unsigned>(u);',
'            } else {',
'                pin_core.reset();',
'            }',
'        } else {'
) -join "'$nl
if (-not $text.Contains($old)) { throw '"'pin-core parse block not found' }
"'$text = $text.Replace($old, $new)
[System.IO.File]::WriteAllText($resolved, $text, [System.Text.UTF8Encoding]::new($false))' in C:\Users\benja\OneDrive\Desktop\Diplomarbeit - Datenbanken\Code\external\comdare-cache-engine
