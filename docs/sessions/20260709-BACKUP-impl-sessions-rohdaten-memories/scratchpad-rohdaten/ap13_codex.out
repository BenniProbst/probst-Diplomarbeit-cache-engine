              << "  --batches=N    Batches (= Latenz-Samples pro DLL), Default 128\n"
              << "  --seed=N       RNG-Seed, Default 11\n"
              << "  --csv=PATH     Report zusaetzlich als CSV schreiben\n"
              << "  --json=PATH    Report zusaetzlich als JSON schreiben\n"
