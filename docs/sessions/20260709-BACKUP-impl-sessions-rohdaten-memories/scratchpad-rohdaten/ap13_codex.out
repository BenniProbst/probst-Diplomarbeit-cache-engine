#pragma once

// AP-13/#247 (IPinningPolicy-Teil, v1 Core-Index): host-seitiges Mess-Thread-Pinning (opt-in, Default no-op).
//
// Pinnt den — single-threaded — Mess-Thread (die Op-Schleife in workload_orchestrator::run_workload_profile)
// auf einen festen Core. Zweck: Varianz-Reduktion auf Hybrid-CPUs (P/E-Cores, z. B. i7-1270P), M3-Relevanz —
// eine stabile Kern-Zuordnung verhindert Migration zwischen P- und E-Cores waehrend der Messung.
//
// Rein HOST-SEITIGE Mess-Runtime: aendert Mess-*Werte* (Varianz sinkt), aber NICHT Schema/Identitaet —
// analog AP-9 (Provenance-Sidecar) und AP-1 (additive Spalten). Beruehrt NICHT binary_id, permutation_axes,
// golden-320, den ABI-POD (ComdareTierObserverSnapshot), conformance_gate oder die 16/25-CSV-Spalten.
//
// BEWUSST GETRENNT von platform::IPinningPolicy (core_layout.hpp) und subsystems/c02_pinning_engine:
// jene sind die *Modell*-Ebene (subject-under-study, empfehlen einen CoreId, wenden nichts an). DIES ist der
// Host-Mess-Runtime-Applier mit echtem RAII-Syscall. Ebenen NICHT vermischen.
//
// P/E-Core-Auto-Erkennung (CPUID Leaf 0x1A / Windows GetLogicalProcessorInformationEx / Linux sysfs) ist
// bewusst NICHT Teil von v1 — sie erfordert eine golden-nahe Aenderung der verriegelten Plattform-Property-
// Tests und ist ein separater Follow-up. v1 nimmt den vom Nutzer gegebenen Core-Index (--pin-core=N).

#include <cstdint>
#include <optional>

#if defined(_WIN32)
#  ifndef WIN32_LEAN_AND_MEAN
#    define WIN32_LEAN_AND_MEAN
#  endif
#  ifndef NOMINMAX
#    define NOMINMAX
#  endif
#  include <windows.h>
#elif defined(__linux__)
#  include <sched.h>
#endif

namespace comdare::cache_engine::builder {

// RAII-Guard: pinnt bei Konstruktion den AKTUELLEN Thread auf `core`, restauriert bei Zerstoerung die
// vorherige Affinitaetsmaske. Fehler (ungueltiger Core / Syscall-Fehler / nicht unterstuetzte Plattform)
// => no-op mit active()==false. Wirft NIE (eine Messung darf nie am Pinning scheitern).
//
// Non-copyable UND non-movable: als lokaler Scope-Guard gedacht; Rueckgabe-by-value der Policies nutzt die
// garantierte Copy-Elision von C++17 (prvalue), daher ist kein Move-Konstruktor noetig.
class ScopedThreadPin {
public:
    ScopedThreadPin() noexcept = default; // inaktiv (no-op) — der NoPin-Zustand

    explicit ScopedThreadPin(unsigned core) noexcept {
#if defined(_WIN32)
        DWORD_PTR const mask = (core < 64u) ? (static_cast<DWORD_PTR>(1) << core) : static_cast<DWORD_PTR>(0);
        if (mask != 0) {
            DWORD_PTR const prev = ::SetThreadAffinityMask(::GetCurrentThread(), mask); // 0 = Fehler
            if (prev != 0) {
                prev_mask_ = prev;
                active_    = true;
            }
        }
#elif defined(__linux__)
        cpu_set_t prev;
        CPU_ZERO(&prev);
        if (::sched_getaffinity(0, sizeof(prev), &prev) == 0) {
            cpu_set_t want;
            CPU_ZERO(&want);
            CPU_SET(static_cast<int>(core), &want);
            if (::sched_setaffinity(0, sizeof(want), &want) == 0) {
                prev_mask_ = prev;
                active_    = true;
            }
        }
#else
        (void)core; // keine Affinitaets-API (z. B. macOS): ehrliches no-op
#endif
    }

    ScopedThreadPin(ScopedThreadPin const&)            = delete;
    ScopedThreadPin& operator=(ScopedThreadPin const&) = delete;
    ScopedThreadPin(ScopedThreadPin&&)                 = delete;
    ScopedThreadPin& operator=(ScopedThreadPin&&)      = delete;

    ~ScopedThreadPin() {
        if (!active_) {
            return;
        }
#if defined(_WIN32)
        ::SetThreadAffinityMask(::GetCurrentThread(), prev_mask_);
#elif defined(__linux__)
        ::sched_setaffinity(0, sizeof(prev_mask_), &prev_mask_);
#endif
    }

    // true nur, wenn tatsaechlich gepinnt wurde (erfolgreicher Syscall auf unterstuetzter Plattform).
    [[nodiscard]] bool active() const noexcept { return active_; }

private:
    bool active_ = false;
#if defined(_WIN32)
    DWORD_PTR prev_mask_ = 0;
#elif defined(__linux__)
    cpu_set_t prev_mask_{};
#endif
};

// Default-Policy: kein Pinning (echtes no-op) — Bestandsmessungen unveraendert.
struct NoPinPolicy {
    [[nodiscard]] ScopedThreadPin pin() const noexcept { return ScopedThreadPin{}; }
};

// Core-Index-Policy: pinnt den Mess-Thread auf einen festen Core.
struct CorePinPolicy {
    unsigned core = 0;
    [[nodiscard]] ScopedThreadPin pin() const noexcept { return ScopedThreadPin{core}; }
};

// Fabrik: opt-in via optionalem Core-Index. Kein Wert => NoPin (no-op). Rueckgabe per garantierter Elision.
[[nodiscard]] inline ScopedThreadPin make_scoped_pin(std::optional<unsigned> core) noexcept {
    return core.has_value() ? ScopedThreadPin{*core} : ScopedThreadPin{};
}

} // namespace comdare::cache_engine::builder


