Der stdout-Format-Fallback hat Nicht-ASCII-Kommentare und die Skip-Zeile durch eine falsche Text-Decodierung mojibake-verzerrt. Ich repariere die UTF-8-Roundtrip-Kodierung jetzt und lasse clang-format danach mit explizitem UTF-8 erneut laufen.
exec
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" -NoProfile -Command "@'
from pathlib import Path
files = [
    Path('libs/cache_engine/builder/pruef_dock/conformance_gate.hpp'),
    Path('tests/unit/test_conformance_gate.cpp'),
    Path('tests/unit/test_v5_conformance_gate.cpp'),
]
for path in files:
    text = path.read_text(encoding='utf-8')
    fixed = text.encode('latin1').decode('utf-8')
    path.write_text(fixed, encoding='utf-8')
