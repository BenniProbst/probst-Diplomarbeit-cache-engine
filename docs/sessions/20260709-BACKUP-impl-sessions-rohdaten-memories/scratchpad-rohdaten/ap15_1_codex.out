from pathlib import Path
import subprocess
import tempfile
import xml.etree.ElementTree as ET

root = Path.cwd()
vsdev = Path('C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/Tools/VsDevCmd.bat')
out_dir = root / 'build/tests/unit/Release'
