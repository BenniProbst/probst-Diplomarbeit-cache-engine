    'COMDARE_CE_ENABLE_STATISTICS=1', 'COMDARE_A06_IS_ORIGINAL_CODEGEN=1', 'COMDARE_A03A_IS_ORIGINAL_CODEGEN=1',
    'COMDARE_AQ1_IS_ORIGINAL_CODEGEN=1', 'CMAKE_INTDIR=\"Release\"'
]
base_includes = [root / 'build/generated', root / 'libs/cache_engine', root / 'libs/cache_engine/include']
gtest_includes = [root / 'build/_deps/googletest-src/googletest/include', root / 'build/_deps/googletest-src/googletest']
gtest_libs = [root / 'build/lib/Release/gtest.lib', root / 'build/lib/Release/gtest_main.lib', root / 'build/lib/Release/gtest.lib']
system_libs = ['kernel32.lib', 'user32.lib', 'gdi32.lib', 'winspool.lib', 'shell32.lib', 'ole32.lib', 'oleaut32.lib', 'uuid.lib', 'comdlg32.lib', 'advapi32.lib']

def release_includes_from_vcxproj(project):
    ns = {'msb': 'http://schemas.microsoft.com/developer/msbuild/2003'}
    root_xml = ET.parse(project).getroot()
    includes = []
    for group in root_xml.findall('msb:ItemDefinitionGroup', ns):
        if \"Release|x64\" not in group.attrib.get('Condition', ''):
            continue
        for item in group.findall('msb:ClCompile', ns):
            for elem in item.findall('msb:AdditionalIncludeDirectories', ns):
                if not elem.text:
                    continue
                for raw in elem.text.split(';'):
                    raw = raw.strip()
                    if not raw or raw.startswith('%('):
                        continue
                    p = Path(raw)
                    if p not in includes:
                        includes.append(p)
    return includes

def write_rsp(name, source, includes, libs):
    rsp = tmp / f'{name}.rsp'
    exe = out_dir / f'{name}.exe'
    obj = out_dir / f'{name}.obj'
    pdb = out_dir / f'{name}.pdb'
    lines = [
        '/nologo', '/EHsc', '/MD', '/O2', '/Ob2', '/std:c++latest', '/utf-8', '/W1', '/WX-', '/diagnostics:column',
        '/D_MBCS'
    ]
    lines += [f'/D{d}' for d in common_defines]
    seen = set()
    for inc in includes:
        key = str(inc)
        if key in seen:
            continue
        seen.add(key)
        lines.append(f'/I\"{inc}\"')
    lines += [f'/Fo\"{obj}\"', f'/Fd\"{pdb}\"', f'\"{source}\"', f'/Fe\"{exe}\"', '/link']
    lines += [f'\"{lib}\"' for lib in libs]
    lines += system_libs
    rsp.write_text('\\n'.join(lines) + '\\n', encoding='utf-8')
    return rsp

