from pathlib import Path
import subprocess
import xml.etree.ElementTree as ET

root = Path.cwd()
vsdev = Path('C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/Tools/VsDevCmd.bat')
out_dir = root / 'build/tests/unit/Release'
out_dir.mkdir(parents=True, exist_ok=True)
tmp = Path('C:/tmp')
tmp.mkdir(parents=True, exist_ok=True)

common_defines = [
    'WIN32', '_WINDOWS', 'NDEBUG', '_CRT_SECURE_NO_WARNINGS', 'NOMINMAX', 'WIN32_LEAN_AND_MEAN',
    'COMDARE_OS_NAME=\"Windows\"', 'COMDARE_ARCH_NAME=\"x86_64\"', 'COMDARE_BLOCK_AO_PLATFORM_NAME=\"i7-1270P\"',
    'COMDARE_CACHE_LINE_SIZE=64', 'COMDARE_OS_WINDOWS=1', 'COMDARE_ARCH_X86_64=1', 'COMDARE_MEASUREMENT_ON=1',
    'COMDARE_CE_ENABLE_STATISTICS=1', 'COMDARE_A06_IS_ORIGINAL_CODEGEN=1', 'COMDARE_A03A_IS_ORIGINAL_CODEGEN=1',
    'COMDARE_AQ1_IS_ORIGINAL_CODEGEN=1', 'CMAKE_INTDIR=\"Release\"'
]
base_includes = [root / 'build/generated', root / 'libs/cache_engine', root / 'libs/cache_engine/include']
gtest_includes = [root / 'build/_deps/googletest-src/googletest/include', root / 'build/_deps/googletest-src/googletest']
gtest_libs = [root / 'build/lib/Release/gtest.lib', root / 'build/lib/Release/gtest_main.lib', root / 'build/lib/Release/gtest.lib']
system_libs = ['kernel32.lib', 'user32.lib', 'gdi32.lib', 'winspool.lib', 'shell32.lib', 'ole32.lib', 'oleaut32.lib', 'uuid.lib', 'comdlg32.lib', 'advapi32.lib']


def release_includes_from_vcxproj(project):
    ns = {'msb': 'http://schemas.microsoft.com/developer/msbuild/2003'}
    root_xml = ET.parse(project).getroot()
    includes = []
    for group in root_xml.findall('msb:ItemDefinitionGroup', ns):
        if \"Release|x64\" not in group.attrib.get('Condition', ''):
            continue
        for item in group.findall('msb:ClCompile', ns):
            for elem in item.findall('msb:AdditionalIncludeDirectories', ns):
                if not elem.text:
                    continue
                for raw in elem.text.split(';'):
                    raw = raw.strip()
                    if not raw or raw.startswith('%('):
                        continue
                    p = Path(raw)
                    if p not in includes:
                        includes.append(p)
    return includes


def write_rsp(name, source, includes, libs):
    rsp = tmp / f'{name}.rsp'
    exe = out_dir / f'{name}.exe'
    obj = out_dir / f'{name}.obj'
    pdb = out_dir / f'{name}.pdb'
    lines = [
        '/nologo', '/EHsc', '/MD', '/O2', '/Ob2', '/std:c++latest', '/utf-8', '/W1', '/WX-', '/diagnostics:column',
        '/D_MBCS'
    ]
    lines += [f'/D{d}' for d in common_defines]
    seen = set()
    for inc in includes:
        key = str(inc)
        if key in seen:
            continue
        seen.add(key)
        lines.append(f'/I\"{inc}\"')
    lines += [f'/Fo\"{obj}\"', f'/Fd\"{pdb}\"', f'\"{source}\"', f'/Fe\"{exe}\"', '/link']
    lines += [f'\"{lib}\"' for lib in libs]
    lines += system_libs
    rsp.write_text('\\n'.join(lines) + '\\n', encoding='utf-8')
    return rsp

builds = [
    ('test_conformance_gate', root / 'tests/unit/test_conformance_gate.cpp', base_includes, []),
    ('test_v5_conformance_gate', root / 'tests/unit/test_v5_conformance_gate.cpp', base_includes + gtest_includes, gtest_libs),
    ('test_188_4c0_known_compositions_conformance', root / 'tests/unit/test_188_4c0_known_compositions_conformance.cpp',
     release_includes_from_vcxproj(root / 'build/tests/unit/test_188_4c0_known_compositions_conformance.vcxproj') + gtest_includes,
     gtest_libs),
]

for name, source, includes, libs in builds:
    rsp = write_rsp(name, source, includes, libs)
    cmd = f'\"{vsdev}\" -arch=x64 -host_arch=x64 && cl @\"{rsp}\"'
    print(f'=== manual cl build {name} ===')
    result = subprocess.run(['cmd.exe', '/s', '/c', cmd], cwd=root, text=True, encoding='utf-8', errors='replace')
    if result.returncode "'!= 0:
        raise SystemExit(result.returncode)
