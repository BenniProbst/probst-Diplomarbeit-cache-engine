    'WIN32','_WINDOWS','NDEBUG','_CRT_SECURE_NO_WARNINGS','NOMINMAX','WIN32_LEAN_AND_MEAN','COMDARE_OS_NAME=\"Windows\"',
    'COMDARE_ARCH_NAME=\"x86_64\"','COMDARE_BLOCK_AO_PLATFORM_NAME=\"i7-1270P\"','COMDARE_CACHE_LINE_SIZE=64',
    'COMDARE_OS_WINDOWS=1','COMDARE_ARCH_X86_64=1','COMDARE_MEASUREMENT_ON=1','COMDARE_CE_ENABLE_STATISTICS=1',
    'COMDARE_A06_IS_ORIGINAL_CODEGEN=1','COMDARE_A03A_IS_ORIGINAL_CODEGEN=1','COMDARE_AQ1_IS_ORIGINAL_CODEGEN=1',
    'CMAKE_INTDIR=\"Release\"'
]
includes = [root / 'build/generated', root / 'libs/cache_engine', root / 'libs/cache_engine/include']
compile_lines = ['/nologo','/c','/EHsc','/MD','/O2','/Ob2','/std:c++latest','/utf-8','/W1','/WX-','/diagnostics:column','/D_MBCS']
compile_lines += [f'/D{d}' for d in defines]
compile_lines += [f'/I\"{i}\"' for i in includes]
compile_lines += [f'/Fo\"{obj}\"', f'/Fd\"{pdb}\"', f'\"{source}\"']
crsp.write_text('\\n'.join(compile_lines) + '\\n', encoding='utf-8')
link_lines = ['/NOLOGO', f'/OUT:\"{exe}\"', '/SUBSYSTEM:CONSOLE', f'\"{obj}\"', 'kernel32.lib','user32.lib','gdi32.lib','winspool.lib','shell32.lib','ole32.lib','oleaut32.lib','uuid.lib','comdlg32.lib','advapi32.lib']
lrsp.write_text('\\n'.join(link_lines) + '\\n', encoding='utf-8')
script.write_text(f'@echo off\\r\\ncall \"{vsdev}\" -arch=x64 -host_arch=x64\\r\\necho === rebuild {name} ===\\r\\ncl @\"{crsp}\"\\r\\nif errorlevel 1 exit /b 1\\r\\nlink @\"{lrsp}\"\\r\\nif errorlevel 1 exit /b 1\\r\\n', encoding='utf-8')
raise SystemExit(subprocess.run(['cmd.exe','/d','/c',str(script)], cwd=root, text=True, encoding='utf-8', errors='replace').returncode)
