    ('test_conformance_gate', root / 'tests/unit/test_conformance_gate.cpp', base_includes, []),
    ('test_v5_conformance_gate', root / 'tests/unit/test_v5_conformance_gate.cpp', base_includes + gtest_includes, gtest_libs),
