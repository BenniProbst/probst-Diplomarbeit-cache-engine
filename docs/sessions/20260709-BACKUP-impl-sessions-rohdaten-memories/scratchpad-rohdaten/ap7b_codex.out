hnis das generated-Dir ergaenzen, sonst C1083 in umbrella/compositions.\r\n24:file(GLOB _comdare_axes_dirs LIST_DIRECTORIES true \"${PROJECT_SOURCE_DIR}/libs/cache_engine/axes/*\")\r\n25:foreach(_axes_dir ${_comdare_axes_dirs})\r\n26:    if(IS_DIRECTORY \"${_axes_dir}\")\r\n27:        get_filename_component(_axes_name \"${_axes_dir}\" NAME)\r\n28:        list(APPEND COMDARE_ALL_AXIS_GENERATED_DIRS \"${CMAKE_BINARY_DIR}/generated/axes/${_axes_name}\")\r\n29:    endif()\r\n30:endforeach()\r\n31:\r\n32:# Header-only INTERFACE-Library: Cache-Engine Concepts\r\n33:add_library(comdare_cache_engine_concepts INTERFACE)\r\n34:add_library(comdare::cache_engine_concepts ALIAS comdare_cache_engine_concepts)\r\n35:target_include_directories(comdare_cache_engine_concepts INTERFACE\r\n36:    \"${CMAKE_SOURCE_DIR}/libs/cache_engine/include\"\r\n37:    \"${CMAKE_SOURCE_DIR}/libs/cache_engine/subsystems\")\r\n38:target_compile_features(comdare_cache_engine_concepts INTERFACE cxx_std_23)\r\n39:comdare_set_platform_defines(comdare_cache_engine_concepts)\r\n40:\r\n41:# Header-only INTERFACE-Library: PRT-ART Concepts\r\n42:add_library(comdare_prt_art_concepts INTERFACE)\r\n43:add_library(comdare::prt_art_concepts ALIAS comdare_prt_art_concepts)\r\n44:target_include_directories(comdare_prt_art_concepts INTERFACE\r\n45:    \"${CMAKE_SOURCE_DIR}/prt_art/include\")\r\n46:target_compile_features(comdare_prt_art_concepts INTERFACE cxx_std_23)\r\n47:target_link_libraries(comdare_prt_art_concepts INTERFACE comdare::cache_engine_concepts)\r\n48:comdare_set_platform_defines(comdare_prt_art_concepts)\r\n49:\r\n50:# V41.F.6.1 E1 (2026-05-29) - Legacy-prt_art-Concept-Tests gaten: sie inkludieren\r\n51:# prt_art/concepts|page_structures-Header, die in der F.6-Migration nach cache-engine-Achsen\r\n52:# verschoben wurden und im STANDALONE-Build (ohne befuelltes prt-art-Submodul) NICHT vorhanden sind\r\n53:# \u001a wuerden mit C1083 als _NOT_BUILT scheitern. Root-cause-korrekt: nur registrieren, wenn die