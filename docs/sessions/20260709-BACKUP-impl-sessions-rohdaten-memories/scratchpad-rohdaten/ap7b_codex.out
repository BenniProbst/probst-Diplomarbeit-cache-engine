undenen Werte. counter!=0 ist HW-/Policy-abhaengig\r\n1677:# (prod-Runner) und wird NICHT auf jedem Runner garantiert. Standalone (plain int main, baut KEINE DLLs).\r\n1678:if(UNIX AND NOT APPLE)\r\n1679:    add_executable(linux_perf_pmc_smoke \"thesis_tiere/linux_perf_pmc_smoke.cpp\")\r\n1680:    target_compile_features(linux_perf_pmc_smoke PRIVATE cxx_std_23)\r\n1681:    target_include_directories(linux_perf_pmc_smoke PRIVATE\r\n1682:        \"${PROJECT_SOURCE_DIR}/libs/cache_engine\"\r\n1683:        \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\"\r\n1684:        \"${PROJECT_SOURCE_DIR}/libs/cache_engine/src\"\r\n1685:        \"${PROJECT_SOURCE_DIR}/libs/cache_engine/builder\"\r\n1686:        \"${PROJECT_SOURCE_DIR}/libs/common\"\r\n1687:        \"${CMAKE_BINARY_DIR}/generated\"\r\n1688:        ${COMDARE_ALL_AXIS_GENERATED_DIRS})\r\n1689:    comdare_set_platform_defines(linux_perf_pmc_smoke)\r\n1690:    target_compile_definitions(linux_perf_pmc_smoke PRIVATE\r\n1691:        COMDARE_MEASUREMENT_ON=1 COMDARE_CE_ENABLE_STATISTICS=1 COMDARE_EXPERIMENT_MODE_ON=1)\r\n1692:    add_test(NAME linux_perf_pmc_smoke COMMAND linux_perf_pmc_smoke)\r\n1693:    set_tests_properties(linux_perf_pmc_smoke PROPERTIES LABELS \"phase_e;standalone;pmc;linux\")\r\n1694:endif()\r\n1695:\r\n1696:# ─────────────────────────────────────────────────────────────────────────────\r\n1697:# Goal-V6 L-76/L-74a — DLL-Round-Trips als OFFIZIELLE CMake-Targets (vorher nur committete PS1-Skripte). Die 5\r\n1698:# boost-freien Permutations-/Build-Varianten-DLLs (interne Organe) + ihre Loader-Tests. Die DLL-Pfade gehen via\r\n1699:# $<TARGET_FILE:..> als add_test-Argumente → kein Lade-Ort-Rätselraten (Multi-Config-robust). C++23.\r\n1700:# ─────────────────────────────────────────────────────────────────────────────\r\n1701:set(_goalv6_dll_dir \"${CMAKE_BINARY_DIR}/generated/goalv6_dll_modules\")\r\n1702:set(_src_perm_set_d9               genus_module_set.cpp)\r\n1703:set(_src_perm_sequence_d10      