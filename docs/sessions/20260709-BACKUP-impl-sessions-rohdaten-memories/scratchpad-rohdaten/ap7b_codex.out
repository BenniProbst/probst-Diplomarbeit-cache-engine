OURCE_DIR}/libs/cache_engine\" \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\")\r\n1816:target_compile_features(test_adhoc_buildvariant_dll PRIVATE cxx_std_23)\r\n1817:target_link_libraries(test_adhoc_buildvariant_dll PRIVATE comdare::anatomy_module_loader)\r\n1818:add_dependencies(test_adhoc_buildvariant_dll perm_adhoc_buildvariant)\r\n1819:add_test(NAME test_adhoc_buildvariant_dll COMMAND test_adhoc_buildvariant_dll \"$<TARGET_FILE:perm_adhoc_buildvariant>\")\r\n1820:set_tests_properties(test_adhoc_buildvariant_dll PROPERTIES LABELS \"goal_v6;phase_d;dll_roundtrip\")\r\n1821:\r\n1822:# L-MEAS — RuntimeMeasureVisitor über die ECHTE geladene DLL (dynamic_cast IObservableTier + IResourceControllableTier\r\n1823:# aus DEMSELBEN Tier → Host-Bridge → Mess-Schleife je dyn. Einstellung × repeats, kein Reload). Reuse perm_adhoc_buildvariant.\r\n1824:add_executable(test_d13_dll_runtime_measure test_d13_dll_runtime_measure.cpp)\r\n1825:target_include_directories(test_d13_dll_runtime_measure PRIVATE\r\n1826:    \"${PROJECT_SOURCE_DIR}/libs/cache_engine\" \"${PROJECT_SOURCE_DIR}/libs/cache_engine/include\")\r\n1827:target_compile_features(test_d13_dll_runtime_measure PRIVATE cxx_std_23)\r\n1828:target_link_libraries(test_d13_dll_runtime_measure PRIVATE comdare::anatomy_module_loader)\r\n1829:add_dependencies(test_d13_dll_runtime_measure perm_adhoc_buildvariant)\r\n1830:add_test(NAME test_d13_dll_runtime_measure COMMAND test_d13_dll_runtime_measure \"$<TARGET_FILE:perm_adhoc_buildvariant>\")\r\n1831:set_tests_properties(test_d13_dll_runtime_measure PROPERTIES LABELS \"goal_v6;phase_d;dll_roundtrip\")\r\n1832:\r\n1833:message(STATUS \"Goal-V6 Phase D: ${CMAKE_CURRENT_LIST_LINE} — 28 add_test-D-Tests (16 leicht + 12 Boost) + 5 DLL-Round-Trip-Tests \"\r\n1834:    \"(test_dgenus_dll/test_buildvariant_dll{,_real}/test_adhoc_buildvariant_dll/test_d13_dll_runtime_measure) als OFFIZIELLE CMake-Targets (6 SHARED-DLLs via $<TARGET_FILE>). \"\r\n1835:    \"container_dll (test_d4b) bleibt scratch-verifiziert (Folge).\")\r\n1836:\r\n1837:# ─────────────────────────────────────────────────────────────────────────────\r\n1838:# #172/#174/#175 LEICHTE Werkzeug-Tests CTest-registrieren (vorher NUR via ad-hoc build_*.bat/.ps1 baubar).\r\n1839:# Selbe Begründung + selbes Muster wie der #155-Block + die GoalV6-D-Tests: plain `int main()`-Standalone\r\n1840:# (KEIN gtest → add_test DIREKT, NICHT comdare_add_test), Return 0/1. KEIN DLL-/ADHOC-Bau, KEIN Boost/mp11\r\n1841:# und KEIN rekursiver generated/-Include nötig — die zugehörigen Werkzeug-Header haben einen schlanken,\r\n1842:# stabilen Include-Satz (verifiziert: nur std + libs/cache_engine{,/builder/...} + libs/common).\r\n1843:#\r\n1844:#   * test_cacheline_policy_selector (#174, Versprechen 2): CacheLinePolicySelector (GoF Strategy). Inkludiert\r\n1845:#       anatomy/resource_controllable_tier.hpp + builder/cacheline_policy/cacheline_policy_selector.hpp\r\n1846:#       (zieht builder/algorithm_resource_control.hpp) → Include-Root libs/cache_engine. Liegt direkt unter\r\n1847:#       tests/unit/. Optionales CSV-Argument: der Test SKIPt sauber (Exit 0), wenn die untracked Pilot-CSV\r\n1848:#       fehlt — der Heuristik-Kern-Beleg ist davon unabhängig, daher reproduzierbar ohne Fixture.\r\n1849:#   * test_load_profile_writer (#175, Versprechen 3): write_load_profile_xml + extract_load_profile_from_\r\n1850:#       measurements. Quelle liegt in libs/cache_engine/builder/workload_driver/. Inkludiert load_profile_\r\n1851:#       parser.hpp (→ <serialization/.../xml_reader.hpp> aus libs/common, header-only/inline) + load_profile_\r\n1852:#       writer.hpp. BRAUCHT Fixtures: ein LP-XML-Verzeichnis (getracktes algorithm_profiles/load_profiles)\r\n1853:#       + eine Mess-CSV. Die echte Pilot-CSV ist untracked (build/) → für die G5-Reproduzierbarkeit wird\r\n1854:#       eine schlanke, GETRACKTE Fixture-CSV (tests/unit/fixtures/load_profile_writer_pilot.csv) als Argument\r\n1855:#       verdrahtet; Output landet im Build-Tree. So baut + läuft der Test aus einem frischen git-clone grün.\r\n1856:\r\n1857:# Output-Wurzel für die Test-Schreibvorgänge: bevorzugt das OS-Temp-Verzeichnis (TMPDIR/TEMP/TMP),\r\n1858:# sonst der Build-Tree. Grund: wenn der Build-Tree unter einem synchronisierenden Ordner (OneDrive)\r\n1859:# liegt, blockiert der Datei-Sync jeden geschriebenen Roundtrip-/Extract-XML minutenlang (verifiziert:\r\n1860:# 478 s im OneDrive-Build-Tree vs 1 s im OS-Temp). Das ist umgebungs-, nicht code-bedingt; der Test\r\n1861:# bleibt korrekt, aber wir halten ihn schnell + suite-tauglich, indem wir ins Temp schreiben.\r\n1862:set(_comdare_test_out_root \"${CMAKE_CURRENT_BINARY_DIR}\")\r\n1863:foreach(_tmpvar TMPDIR TEMP TMP)\r\n1864:    if(DEFINED ENV{${_tmpvar}} AND IS_DIRECTORY \"$ENV{${_tmpvar}}\")\r\n1865:        set(_comdare_test_out_root \"$ENV{${_tmpvar}}\")\r\n1866:        break()\r\n1867:    endif()\r\n1868:endforeach()\r\n1869:\r\n1870:# (a) test_cacheline_policy_selector — Quelle unter tests/unit/, std-only Include-Satz.\r\n1871:add_executable(test_cacheline_policy_selector \"test_cacheline_policy_selector.cpp\")\r\n1872:target_compile_features(test_cacheline_policy_selector PRIVATE cxx_std_23)\r\n1873:target_include_directories(test_cacheline_policy_selector PRIVATE\r\n1874:    \"${PROJECT_SOURCE_DIR}/libs/cache_engine\")\r\n1875:comdare_set_platform_defines(test_cacheline_policy_selector)\r\n1876:# Optionales CSV-Arg (echte Pilot-CSV, falls vorhanden) — fehlt sie, SKIPt der Test diesen Teil sauber.\r\n1877:add_test(NAME test_cacheline_policy_selector COMMAND test_cacheline_policy_selector\r\n1878:    \"${CMAKE_SOURCE_DIR}/build/thesis_tiere/m3v2_sota_pilot_measurements.csv\")\r\n1879:set_tests_properties(test_cacheline_policy_selector PROPERTIES\r\n1880:    LABELS \"tools;cacheline;strategy\" TIMEOUT 60)\r\n1881:\r\n1882:# (b) test_load_profile_writer — Quelle in libs/.../workload_driver/, header-only Chain + getrackte Fixtures.\r\n1883:add_executable(test_load_profile_writer\r\n1884:    \"${PROJECT_SOURCE_DIR}/libs/cache_engine/builder/workload_driver/test_load_profile_writer.cpp\")\r\n1885:target_compile_features(test_load_profile_writer PRIVATE cxx_std_23)\r\n1886:target_include_directories(test_load_profile_writer PRIVATE\r\n1887:    \"${PROJECT_SOURCE_DIR}/libs/cache_engine/builder/workload_driver\"  # load_profile_parser/_writer.hpp\r\n1888:    \"${PROJECT_SOURCE_DIR}/libs/common\")                                # serialization/.../xml_reader.hpp\r\n1889:comdare_set_platform_defines(test_load_profile_writer)\r\n1890:add_test(NAME test_load_profile_writer COMMAND test_load_profile_writer\r\n1891:    \"${CMAKE_SOURCE_DIR}/libs/cache_engine/algorithm_profiles/load_profiles\"   # arg1: getracktes LP-XML-Verzeichnis\r\n1892:    \"${CMAKE_CURRENT_SOURCE_DIR}/fixtures/load_profile_writer_pilot.csv\"        # arg2: getrackte Fixture-Mess-CSV\r\n1893:    \"${_comdare_test_out_root}/comdare_load_profile_writer_out\")                # arg3: Output (Temp, nicht OneDrive)\r\n1894:# TIMEOUT großzügig: 1 s im OS-Temp, aber Sync-/AV-Umgebungen können Datei-Writes verzögern.\r\n1895:set_tests_properties(test_load_profile_writer PROPERTIES\r\n1896:    LABELS \"tools;workload_driver;xml_export\" TIMEOUT 300)\r\n1897:\r\n1898:message(STATUS \"tools-tests: test_cacheline_policy_selector (#174) + test_load_profile_writer (#175) \"\r\n1899:    \"als add_test registriert (best_binary_selector-Tool = tools/best_binary_selector add_executable).\")\r\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f2bdb-65f3-7bb0-b29d-101356e9cf3a"}}}
