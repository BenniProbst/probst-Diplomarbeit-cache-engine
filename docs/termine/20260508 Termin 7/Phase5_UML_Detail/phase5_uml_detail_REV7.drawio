        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="e2" target="e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed2l" value="optimiert via" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="ed2">
