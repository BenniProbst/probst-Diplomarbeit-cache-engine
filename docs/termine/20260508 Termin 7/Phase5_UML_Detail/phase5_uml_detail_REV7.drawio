        <mxCell id="ed1l" value="konsumiert" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="ed1">
