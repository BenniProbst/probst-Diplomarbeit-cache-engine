        <mxCell id="sub" value="V31 Stand: 22 Adapter mit COMDARE_HAVE_X-Flag-Pattern. Adapter wrappen ext/-Originalcode unter cache-engine/adapters/sota/ und cache-engine/adapters/allocator/. Smoke-Tests gruen." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
