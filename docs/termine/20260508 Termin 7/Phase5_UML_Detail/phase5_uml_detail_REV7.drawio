          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="Phase 1 - DISCOVER&#xa;━━━━━━━&#xa;IPlatformProbe entdeckt:&#xa;- ICacheTopology (L1/L2/L3/HBM)&#xa;- ICoreLayout (P/E-Cores)&#xa;- IIsaFeatureSet (AVX-512, NEON)&#xa;- IBusTopology (NUMA, CCD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="Phase 2 - MEASURE&#xa;━━━━━━━&#xa;Mikrobenchmarks:&#xa;- clflush-cycle&#xa;- All-Pairs-Pinning&#xa;- Cache-Coherence-Cost&#xa;- DDR5-Latency-Calibration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="160" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="Phase 3 - CLASSIFY&#xa;━━━━━━━&#xa;IPlatformPropertyClassifier:&#xa;PlatformPropertySet =&#xa;{ has_asymmetric_l3,&#xa;  has_hybrid_cores,&#xa;  preferred_pinning,&#xa;  usable_simd_width,&#xa;  + 8 NEUE REV 5 }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="860" y="160" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase4" value="Phase 4 - PUBLISH&#xa;━━━━━━━&#xa;ICacheEngineOptionPublisher&#xa;publish_options_to(modules)&#xa;━━━━━━━&#xa;Permutations erhalten nur die&#xa;Optionen die sie konsumieren&#xa;koennen (compile-time-Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1270" y="160" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase5" value="Phase 5 - BIND&#xa;━━━━━━━&#xa;ICacheStrategy-Visitor wird&#xa;CacheEngineStrategy:&#xa;Pattern -&gt; Plural-Strategy -&gt;&#xa;Singular-Strategy -&gt; Heuristic&#xa;━━━━━━━&#xa;Saeule A und B physisch verbunden&#xa;NEU REV 5: 4 Build-Varianten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1680" y="160" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase6" value="Phase 6 - EXECUTE (REV 5 KORRIGIERT - vorher uebersprungen!)&#xa;━━━━━━━&#xa;IExecutingEngine.execute() -&gt;&#xa;  ISearchEngine.search() -&gt;&#xa;    IFanout.distribute() -&gt;&#xa;      ISearchPagesStrategy -&gt;&#xa;        ISearchPageStrategy(N) -&gt;&#xa;          ICacheStrategy(N) -&gt;&#xa;            IHeuristic.score()&#xa;━━━━━━━&#xa;ISearchPageStructureInterpreter dekodiert (NEU REV 5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="phase7" value="Phase 7 - COMPARE (F15 - die Forschungsmission)&#xa;━━━━━━━&#xa;Permutations-Builds + Experiment-Loop:&#xa;V1 BaseEngineStrategy (ohne CacheEngine, Baseline)&#xa;V2 CacheEngineStrategy + HEURISTIC_STATIC&#xa;V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#xa;V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#xa;Vergleich pro 4-Ebenen-Tupel x 4 Engine-Varianten:&#xa;Throughput / Latency / Cache-Miss / Bandwidth /&#xa;Cache-Coherence-Bus-Verkehr / Energieverbrauch&#xa;═════ ECHTE Permutationsmaschine ═════" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="500" width="1100" height="240" as="geometry" />
        </mxCell>
        <mxCell id="vec_a" value="VERTIKALE EBENEN-AUFRUFE (Saeule A oben - Saeule B unten)&#xa;━━━━━━━&#xa;Ebene 1 (IExecutingEngine) waehlt zwischen Search-/Future-Engine&#xa;Ebene 2 (Saeule A) sucht physisch in PRT-ART-Strukturen&#xa;Ebene 3 (Saeule B) liefert die HW-Bindung jeder Saeule-A-Wahl&#xa;━━━━━━━&#xa;Visitor-Pattern: ICacheStrategy.visit(BaseEngineStrategy) vs visit(CacheEngineStrategy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="2320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase1" target="phase2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase2" target="phase3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase3" target="phase4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase4" target="phase5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5_neu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="phase5" target="phase6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5l" value="KORRIGIERT REV 5" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFE0B2;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="e5_neu">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6_neu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="phase6" target="phase7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K12" name="K12 Forschungsmission F15 + Cache+Search Cross">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K12 KONZEPT - Forschungsmission F15 + Cache+Search Cross-Permutation (REV 5 erweitert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A03700;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="User-Korrektur 2026-05-11: Bausteine der Cache-Engine permutieren GEGEN Permutationen der Search-Engine (Cross-Matrix)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mission" value="FORSCHUNGSMISSION&#xa;━━━━━━━&#xa;Saeule B Cache-Engine erzeugt durch Plattform-Modell-Auswertung Permutations-Familien,&#xa;die Saeule A vorher fest entscheidet - und beweist, dass diese dynamische Komposition&#xa;messbar bessere Lookup-Zeiten als statisch vordefinierte Algorithmen liefert auf&#xa;konkreter Plattform (z.B. Block AO Ryzen 9 9950X3D + i9-14900KS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="160" width="1840" height="180" as="geometry" />
        </mxCell>
        <mxCell id="search_dim" value="SUCH-DIMENSION (Saeule A) - K06 ISearchEngine-Familien&#xa;━━━━━━━&#xa;- 21 Patterns (S1-S21)&#xa;- 41 Plural-Strategien (S22-S26)&#xa;- 74 Singular-Strategien (S27-S30)&#xa;- 12+ neue Hybrid-Auflosungen (§9.18-§9.22)&#xa;━━━━━━━&#xa;Total: 21 x 41 x 74 = ~63.714 Such-Tupel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="700" height="280" as="geometry" />
        </mxCell>
        <mxCell id="cross" value="x x x CROSS-PERMUTATION (NEU REV 5) x x x&#xa;━━━━━━━&#xa;Jede Such-Engine-Konfiguration (Saeule-A-Tupel)&#xa;wird gegen alle Cache-Engine-Modi (Saeule-B-Tupel)&#xa;gemessen, um die beste Cross-Kombination zu finden.&#xa;━━━━━━━&#xa;Beispiel-7-Tupel:&#xa;Such-Tupel: {LayerMixPattern, Trie-Familie,&#xa;             AdaptiveRadixTreeStrategy,&#xa;             AdaptivePrefetchDistanceHeuristic}&#xa;Cache-Tupel: {F1.AdaptiveFootprint,&#xa;              F5.SoftwarePrefetch,&#xa;              F24.TelemetryDriven}&#xa;Engine-Choice: V3 INFORMED_KALIBRIERT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="380" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="cache_dim" value="CACHE-DIMENSION (Saeule B) - K10 Cache-Familien&#xa;━━━━━━━&#xa;- 29 Cache-Familien (F1-F29)&#xa;- ~80-85 IHeuristic-Konkretisierungen&#xa;- 28+ Plattform-Concepts&#xa;- 12+ neue Hybrid-Auflosungen (§10.21-§10.32)&#xa;━━━━━━━&#xa;Total: 29 x 80 = ~2.320 Cache-Tupel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1660" y="380" width="700" height="280" as="geometry" />
        </mxCell>
        <mxCell id="engine_dim" value="ENGINE-CHOICE-DIMENSION (REV 5 NEU - K3 Erweiterung)&#xa;━━━━━━━&#xa;4 Build-Varianten pro Tupel:&#xa;V1 BaseEngineStrategy (Baseline F15)&#xa;V2 CacheEngineStrategy + HEURISTIC_STATIC&#xa;V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#xa;V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#xa;━━━━━━━&#xa;= ~63.714 x ~2.320 x 4 = ~590 Mio. theoretische Tupel&#xa;ConstraintFilter (compile-time-Concepts) reduziert auf&#xa;~10.000-50.000 valide Permutationen pro Plattform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="2280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="report" value="PFLICHT-REPORTING (Termin 6 T6-AA): 5 Rohlaeufe, keine Mittelung von Perzentilen, getrennte Ausweisung nach Plattform x Core-Typ x ISA x Cache-Engine-Modus&#xa;━━━━━━━&#xa;D1 Plattform: 9 Pflicht (VisionFive 2 / RPi 5 / Mac mini M1 / ODROID-H4 / i7-1270P / i9-14900KS / Ryzen 9 9950X3D / Barnard / Grace Hopper GH200)&#xa;D2 ISA: 5 (scalar / x86_avx2 / x86_avx512 / arm_neon / arm_sve2)&#xa;D3 Core-Typ: 2 (cpu_core P / cpu_atom E)&#xa;D4 Cache-Engine-Modus: 3 (passiv / Warm-up / online-adaptiv)&#xa;D14 Suchalgorithmus-Baseline: ART / HOT / Masstree / B^2-tree / CoCo-trie / START / Wormhole + PRT-ART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1020" width="2280" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K13" name="K13 Future-Proof-Prinzipien">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K13 KONZEPT - 7 Future-Proof-Prinzipien (REV 5 aus REV 4)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#311B92;strokeColor=#1A0E5C;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Software-Engineering-Prinzipien fuer langlebige Architektur - Open/Closed, Modular, Encapsulation, SRP, SoC, API-First, DSM" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#311B92;fontColor=#311B92;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="P1 Open/Closed-Prinzip&#xa;━━━━━━━&#xa;Concept-Klassen (ICacheStrategy, IPage, IHeuristic, ISearchPageStructure, ISearchPageStructureInterpreter)&#xa;sind closed for modification - Methoden-Signaturen sind Contracts&#xa;Konkretisierungen sind open for extension via C++23 Templates + requires-Klausel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="P2 Modular Architecture&#xa;━━━━━━━&#xa;Jede Achse einer Matrix (Layer-Matrix-Hybrid) ist unabhaengig austauschbar&#xa;Konkretisierungen pro Cache-Familie pro ISA pro Plattform-Property pro Concurrency-Mechanik pro Telemetry-Strategie&#xa;Verzeichnis-Granularitaet: pro Achse pro Familie pro Konkretisierung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1210" y="160" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="P3 Encapsulation through stable contracts&#xa;━━━━━━━&#xa;Concept-Header (i_*.hpp) sind die einzigen oeffentlichen API-Punkte&#xa;Implementierungs-Header (*.hpp ohne i_-Praefix) sind privat zur Konkretisierungs-Achse&#xa;Aenderungen innerhalb einer Achse beeinflussen keine anderen Achsen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="P4 Single Responsibility auf Architektur-Ebene&#xa;━━━━━━━&#xa;IPage = logische Seiten-Abstraktion&#xa;ISearchPageStructure = Codierung (NEU REV 5)&#xa;ISearchPageStructureInterpreter = Decodier-Logik (NEU REV 5)&#xa;ICacheStrategy = Read/Write/Layout-Routing-Visitor&#xa;IHeuristic = Wert-/Kostenberechnung&#xa;IPlatformProbe = Auto-Discovery der Plattform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1210" y="360" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="P5 Separation of Concerns&#xa;━━━━━━━&#xa;Saeulen A (Strategien) und B (Plattform-Modell) sind disjunkt&#xa;Engine konsumiert nur abstrakte Schnittstellen - kennt keine konkreten Implementierungen&#xa;DecisionLambdaTrees vermitteln Events zwischen den Saeulen ohne direkte Abhaengigkeit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="P6 API-First Design&#xa;━━━━━━━&#xa;Jede Erweiterung beginnt mit einer Concept-Erweiterung (oder neuem Concept-Header)&#xa;Erst wenn die API stabil ist, folgen Konkretisierungen&#xa;Aenderungen an Concepts erfordern formelle Architektur-Korrekturrunde (REV 1-2-3-4-5 Vorgehen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1210" y="560" width="1130" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="P7 Dependency Structure Matrix (DSM)&#xa;━━━━━━━&#xa;DSM-Matrix mit allen Concepts als Zeilen + Spalten&#xa;Zellen markieren vorhandene Abhaengigkeiten (uses, composes, inherits)&#xa;Ziel: Block-Triangulare Struktur (saubere Layer-Trennung)&#xa;Tooling: Lattix / Structure101 / eigenes Skript&#xa;Phase-6+ Werkzeug fuer architektonisches Reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="2280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="Web-Recherche-Quellen (REV 4 §8, 11 URLs):&#xa;codewave.com / moldstud.com / buildsimple.substack.com / superblocks.com / transcenda.com / ResearchGate / strapi.io /&#xa;O&#39;Reilly Layered Architecture Patterns / Wikipedia Multitier / DZone DSM / Bitloops Layered Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="2280" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K14" name="K14 Layer-Matrix-Hybrid + DSM">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K14 KONZEPT - Layer-Matrix-Hybrid + DSM (REV 5 aus REV 4 MX1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#0D47A1;strokeColor=#062F6B;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Antwort auf Architekt-Frage: Reichen Layer? Oder Matrix? HYBRID = Layer fuer Architektur-Reasoning + Matrix fuer Konkretisierungs-Skalierung" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#0D47A1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer" value="LAYER-DIMENSION (vertikal, klassisch)&#xa;━━━━━━━&#xa;Drei Ebenen aus K01: Engine | Strategien | CacheEngine&#xa;Ein Concept gehoert genau einem Layer&#xa;Klare Abhaengigkeits-Richtung (oben -&gt; unten)&#xa;━━━━━━━&#xa;Vorteil: Encapsulation, stabile Contracts, einfaches Reasoning,&#xa;Open/Closed pro Layer (siehe K13 P1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="1100" height="240" as="geometry" />
        </mxCell>
        <mxCell id="matrix" value="MATRIX-DIMENSION (horizontal, fuer F15-Bausteine-Quer-Permutation)&#xa;━━━━━━━&#xa;Pro Layer existiert eine Matrix der Konkretisierungen entlang mehrerer orthogonaler Achsen.&#xa;━━━━━━━&#xa;Konkrete Achsen (REV 5 erweitert):&#xa;- Cache-Familie F1-F29 (siehe K10)&#xa;- Such-Familie S1-S30 (NEU REV 5 K06)&#xa;- Strategie-Ebene A-D (Pattern / Plural / Singular / Heuristic)&#xa;- Plattform-Property (12+ aus PlatformPropertySet)&#xa;- ISA-Feature (AVX-512, BMI2, NEON, SVE2, RISC-V V-Ext)&#xa;- Concurrency-Mechanik (OLC, ROWEX, RCU 6-Flavors, Hazard, EBR, QSBR)&#xa;- Telemetry-Strategie (PerNode, LeafOnly, Sampled, Retroactive)&#xa;- Cache-Engine-Modus (Static / Warmup / Adaptive - NEU REV 5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="160" width="1180" height="320" as="geometry" />
        </mxCell>
        <mxCell id="hybrid" value="HYBRID-EMPFEHLUNG: Layer + Matrix kombiniert&#xa;━━━━━━━&#xa;Beispiel-Verzeichnis (ICacheStrategy):&#xa;search_engine/&#xa;concepts/&#xa;  i_cache_strategy.hpp                    (Concept-Header - Contract)&#xa;  i_search_page_structure.hpp             (NEU REV 5)&#xa;  i_search_page_structure_interpreter.hpp (NEU REV 5)&#xa;cache_strategies/                          (Matrix-Layer)&#xa;  visitor_variants/                        (Achse 1)&#xa;    base_engine_strategy.hpp               (1A)&#xa;    cache_engine_strategy.hpp              (1B)&#xa;  families/                                (Achse 2)&#xa;    f01_adaptive_footprint/                (F1)&#xa;      art_node_footprint_strategy.hpp      (P01)&#xa;      hot_layout_footprint_strategy.hpp    (P02)&#xa;    f02_succinct_encoding/                 (F2)&#xa;      louds_jacobson_encoding_strategy.hpp (P09)&#xa;      ...&#xa;search_page_structures/                    (NEU REV 5)&#xa;  redirect_structure.hpp / redirect_interpreter.hpp&#xa;  dense_byte_structure.hpp / dense_byte_interpreter.hpp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1700" height="500" as="geometry" />
        </mxCell>
        <mxCell id="dsm" value="DSM (Phase 6+ Werkzeug)&#xa;━━━━━━━&#xa;Dependency Structure Matrix mit allen&#xa;Concepts als Zeilen + Spalten&#xa;Zellen markieren vorhandene&#xa;Abhaengigkeiten (uses, composes, inherits)&#xa;━━━━━━━&#xa;Ziel: Block-Triangulare Struktur&#xa;(saubere Layer-Trennung)&#xa;━━━━━━━&#xa;Tooling-Optionen:&#xa;- Lattix (kommerziell)&#xa;- Structure101 (kommerziell)&#xa;- eigenes Skript ueber clang-AST&#xa;━━━━━━━&#xa;DSM erkennt Layer-Verletzungen,&#xa;zyklische Abhaengigkeiten und&#xa;potentielle Refactoring-Stellen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1800" y="500" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="beweis" value="Was MX1/K14 beweist (REV 5.1 erweitert):&#xa;━━━━━━━&#xa;Layer alleine reicht NICHT, weil F15-Permutationen orthogonal zu Layern verlaufen.&#xa;Matrix alleine reicht NICHT, weil sie Abhaengigkeitsrichtung verliert.&#xa;HYBRID = Layer fuer Architektur-Reasoning + Matrix fuer Konkretisierungs-Skalierung.&#xa;━━━━━━━&#xa;DISJUNKTE PERMUTATIONEN (NEU REV 5.1):&#xa;ICacheEngine-Familien-Permutationen (C1-C12, K15) sind DISJUNKT zu ISearchEngine-Familien-Permutationen (S1-S30, K06).&#xa;ALLE Cross-Rekombinationen muessen als Ergebnisse betrachtet werden.&#xa;Eine andere ExecutionEngine (z.B. ICompactingEngine, ISortingEngine) wuerde dieselben C1-C12-Cache-Engine-Permutationen GEHALTEN durchgehen.&#xa;-&gt; Cache-Engine ist wiederverwendbarer Optimierungs-Service ueber alle ExecutionEngines hinweg.&#xa;━━━━━━━&#xa;Verzeichnis-Konvention concepts/ + cache_strategies/[axis]/[family]/ ist die OPERATIVE Umsetzung." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="2300" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="U01" name="U01 IExecutingEngine + ISearchEngine + IFutureEngine">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="U01 UML - IExecutingEngine + ISearchEngine + IFutureEngine (vollstaendige Klassen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="UML 2.x Konvention: + public, # protected, - private, ~ package; «concept»-Stereotyp; const/noexcept/override sichtbar" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="iee" value="«concept» IExecutingEngine&#xa;━━━━━━━ Attribute (protected) ━━━━━━━&#xa;# cache_engine_ : optional&lt;CacheEngine&amp;&gt;&#xa;# observer_registry_ : ObserverRegistry&amp;&#xa;# lifecycle_state_ : EngineLifecycleState&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ execute&lt;Op&gt;(operation : Op&amp;) : Result&lt;Op&gt;&#xa;+ warm_up() : void&#xa;+ reset() : void&#xa;+ shutdown() : void&#xa;+ telemetry_hooks() const : ObserverSlots&#xa;+ bind_cache_engine(engine : CacheEngine&amp;) : void&#xa;+ unbind_cache_engine() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="160" width="800" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ise" value="«concept» ISearchEngine : IExecutingEngine&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- root_page_ : IRootPage&amp;&#xa;- page_structure_ : ISearchPageStructure&amp;&#xa;- page_structure_interpreter_ : ISearchPageStructureInterpreter&amp; (NEU REV 5)&#xa;- cache_strategy_ : ICacheStrategy&amp;&#xa;- prt_art_container_ : comdare::prt_art&lt;K, V&gt;&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ lookup(key : K) const : optional&lt;V&gt;&#xa;+ insert(key : K, value : V) : InsertResult&#xa;+ erase(key : K) : EraseResult&#xa;+ range_scan(begin : K, end : K) : RangeIterator&#xa;+ prefix_lookup(prefix : K) : PrefixIterator (NEU REV 5)&#xa;+ prefix_enumeration(prefix : K) : EnumerationIterator (NEU REV 5)&#xa;+ begin() / end() / rbegin() / rend() / cbegin() / cend()&#xa;+ size() const noexcept : size_t&#xa;+ empty() const noexcept : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1100" height="500" as="geometry" />
        </mxCell>
        <mxCell id="ife" value="«concept» IFutureEngine : IExecutingEngine&#xa;━━━━━━━&#xa;Architektur-Slot, leer in PRT-ART&#xa;━━━━━━━ Zukuenftige Konkretisierungen ━━━━━━━&#xa;ICompactingEngine (Datenpacker)&#xa;IDeduplicationEngine (Duplikat-Erkennung)&#xa;ISortingEngine (Sortier-Operator)&#xa;IRetentionEngine (TTL/Lifetime-Management)&#xa;━━━━━━━&#xa;ALLE nutzen die selbe CacheEngine-Schnittstelle&#xa;ueber geerbte bind_cache_engine()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="700" width="1100" height="500" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;endArrow=block;endFill=0;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ise" target="iee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;endArrow=block;endFill=0;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ife" target="iee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="U02" name="U02 Page-Familie 3-Schichten + IRootNode (REV 5.1)">
    <mxGraphModel dx="2416" dy="1602" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" vertex="1">
          <mxGeometry height="20" width="700" x="1700" as="geometry" />
        </mxCell>
        <mxCell id="t" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" value="U02 UML - Saeule A Page-Familie mit IRootNode + 3-Schichten-Trennung (REV 5.1 KORRIGIERT)" vertex="1">
          <mxGeometry height="50" width="2320" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" value="REV 5.1 KORREKTUR: IRootPage (irrefuehrend, physisch) -&gt; IRootNode (KONZEPTIONELL, auf SearchPage). 3-Schichten-Audit aller Klassen." vertex="1">
          <mxGeometry height="40" width="2320" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="lbl_konzept" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" value="SCHICHT 1 KONZEPT (Bausteine - was)" vertex="1">
          <mxGeometry height="30" width="2320" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="iroot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» IRootNode&lt;R&gt; (NEU REV 5.1 - vorher faelschlich IRootPage)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- fanout_ : IFanout&amp;&#xa;- placement_page_ : ISearchPage&amp; (Wurzel-Knoten residiert AUF einer SearchPage)&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ root_fanout() const : IFanout&amp;&#xa;+ set_root_fanout(fanout : IFanout&amp;) : void&#xa;+ algorithm_signature() const : AlgorithmSignature&#xa;+ supports_concurrent_root_swap() const noexcept : bool&#xa;+ placement_page() const : ISearchPage&amp;&#xa;━━━━━━━ Constraint REV 5.1 ━━━━━━━&#xa;inv: IRootNode ist KONZEPTIONELLE Wurzel, NICHT physisch&#xa;inv: liegt auf einer ISearchPage darunter (placement)&#xa;inv: fanout_ ist genau 1" vertex="1">
          <mxGeometry height="320" width="760" x="40" y="180" as="geometry" />
        </mxCell>
        <mxCell id="ifan" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» IFanout&lt;F&gt; (KONZEPT)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- pages_ : vector&lt;ISearchPage&amp;&gt; (KORRIGIERT REV 5.1)&#xa;- pages_strategy_ : ISearchPagesStrategy&amp;&#xa;- pages_strategy_pattern_ : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ visit_each_page(visitor : auto&amp;&amp;) const : void&#xa;+ lookup_page(byte : uint8_t) const : ISearchPage*&#xa;+ insert_page(page : ISearchPage&amp;) : InsertPageResult&#xa;+ remove_page(page : ISearchPage&amp;) : RemovePageResult&#xa;+ pages_count() const noexcept : size_t&#xa;+ pages_strategy() const : ISearchPagesStrategy&amp;&#xa;+ pages_strategy_pattern() const : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━ KORREKTUR REV 5.1 ━━━━━━━&#xa;FRUEHER: composes [N] INode (FALSCH!)&#xa;JETZT: contains [N] ISearchPage; INodes sitzen AUF Pages" vertex="1">
          <mxGeometry height="320" width="780" x="820" y="180" as="geometry" />
        </mxCell>
        <mxCell id="inode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» INode&lt;N&gt; (KORRIGIERT REV 5.1) - Mikro-Verweis (Slot-Eintrag)&#xa;━━━━━━━ Tagged Union mit Discriminator (Masstree keylenx_) ━━━━━━━&#xa;~ enum NodeRefKind { ValueRef, ChildRef, LayerRef, SiblingRef, SuffixRef }&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- placement_page_ : ISearchPage&amp; (residiert AUF dieser Page)&#xa;- slot_index_ : uint8_t (logischer Index ueber permutation_)&#xa;- ikey_ : ikey_type (8-Byte slice in Masstree)&#xa;- ref_kind_ : NodeRefKind&#xa;- payload_ : Variant&lt;ValueHandle, ChildPtr, LayerPtr, SiblingPtr, SuffixPtr&gt;&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ kind() const noexcept : NodeRefKind&#xa;+ as_value_handle() const : ValueHandle&#xa;+ as_child_ptr() const : ISearchPage*&#xa;+ as_layer_ptr() const : IRootNode*&#xa;+ as_sibling_ptr() const : ISearchPage*&#xa;+ as_suffix_ptr() const : SuffixPtr&#xa;+ key_byte_at(slot : uint8_t) const : uint8_t&#xa;━━━━━━━ KORREKTUR REV 5.1 (Masstree) ━━━━━━━&#xa;HAT KEINE eigenstaendige Speicher-Adresse! Adressiert via permutation_index durch Interpreter (Facade).&#xa;FRUEHER: Verzweigungs-/Daten-Einheit (zu grob)&#xa;JETZT: Mikro-Verweis (Slot-Eintrag), Tagged Union mit 5 Discriminator-Werten" vertex="1">
          <mxGeometry height="500" width="740" x="1620" y="180" as="geometry" />
        </mxCell>
        <mxCell id="lbl_strat" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;" value="SCHICHT 2 STRATEGIE (Wie? = CacheEngine als Kleber)" vertex="1">
          <mxGeometry height="30" width="2320" x="40" y="540" as="geometry" />
        </mxCell>
        <mxCell id="ispage" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» ISearchPage&lt;S&gt; (Knoten-Objekt = logische Such-Seite)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- nodes_ : array&lt;INode, W&gt; (W = Fanout-Width, z.B. 15 in Masstree)&#xa;- node_count_ : uint8_t (nkeys_ in Masstree)&#xa;- structure_ : ISearchPageStructure&amp; (Strategy + Facade)&#xa;- mapped_cache_pages_ : vector&lt;ICachePage&amp;&gt; (typisch 1, fragmentiert moeglich)&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ lookup(key : KeyView) const : LookupResult&#xa;+ insert(key, value) : InsertResult&#xa;+ structure() const : ISearchPageStructure&amp;&#xa;+ accept(visitor : ICacheStrategy&amp;) : void&#xa;+ contains_node(slot : uint8_t) const noexcept : bool&#xa;━━━━━━━ Beispiele ━━━━━━━&#xa;Masstree leaf: 256 B = 4 Cache-Lines, W=15&#xa;ART Node16: ~144 B, W=16&#xa;HOT Compound: 32-64 B = 1 Cache-Line, W=k-bit&#xa;━━━━━━━ Constraint REV 5.1 ━━━━━━━&#xa;inv: structure_ + interpreter (1 Singleton via Facade)&#xa;inv: contains [W] INode (logisch)&#xa;inv: mapped onto [1..K] ICachePage" vertex="1">
          <mxGeometry height="500" width="800" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="isps" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» ISearchPageStructure&lt;SST&gt; (Strategy + Facade-Singleton)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- encoding_ : Encoding (Enum: Redirect/DenseByte/Multilevel/SparsePatricia/DecisionSpan/CustomAligned)&#xa;- layout_invariants_ : LayoutInvariantSet&#xa;- raw_bytes_ : span&lt;byte&gt;&#xa;- interpreter_ : ISearchPageStructureInterpreter const&amp; (FACADE Singleton)&#xa;━━━━━━━ Methoden (public) - Facade-Pattern (GoF) ━━━━━━━&#xa;+ encoding() const noexcept : Encoding&#xa;+ raw_bytes() const noexcept : span&lt;byte const&gt;&#xa;+ layout_invariants() const : LayoutInvariantSet const&amp;&#xa;+ check_invariants() const : bool&#xa;+ find(key) const : INode* (delegiert an interpreter_)&#xa;+ scan(range) const : Iterator (delegiert an interpreter_)&#xa;+ prefetch(hint) const : void (delegiert an interpreter_)&#xa;+ interpreter() const : ISearchPageStructureInterpreter const&amp;&#xa;━━━━━━━ 6 Konkretisierungen mit ihren Singleton-Interpretern ━━━━━━━&#xa;RedirectStructure -&gt; RedirectInterpreter (memcmp byte-prefix)&#xa;DenseByteStructure -&gt; DenseByteInterpreter (linear scan SIMD)&#xa;MultilevelDenseStructure -&gt; MultilevelInterpreter (Cost-DP-Suche)&#xa;SparsePatriciaStructure -&gt; PatriciaInterpreter (single/multi-mask AVX2/BMI2)&#xa;DecisionSpanStructure -&gt; B2Interpreter (Decision-then-Span page-lokale Suche)&#xa;CustomAlignedStructure -&gt; CustomInterpreter (B^2-aehnlich, eigene Optimierungen)" vertex="1">
          <mxGeometry height="500" width="780" x="860" y="580" as="geometry" />
        </mxCell>
        <mxCell id="ispi" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» ISearchPageStructureInterpreter&lt;SSI&gt; (Singleton, Element der Structure)&#xa;━━━━━━━ Pattern ━━━━━━━&#xa;Singleton-pro-Layout-Variante (eine Instanz pro Encoding-Variante)&#xa;Tree haelt EINEN Verweis pro Layout (nicht pro INode!)&#xa;Spart 8 B vtable-Pointer pro INode (kritisch bei 16-B-INodes)&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ static instance() : Interpreter const&amp;  (Singleton)&#xa;+ interpret(structure : ISearchPageStructure const&amp;, key : KeyView) const : InterpretResult&#xa;+ next_slot(structure, key : KeyView) const : SlotHandle&#xa;+ value_handle_for(structure, slot : SlotHandle) const : ValueHandle&#xa;+ child_handle_for(structure, slot : SlotHandle) const : ChildHandle&#xa;+ make_iterator(structure, mode : IteratorMode) const : Iterator&#xa;+ prefetch(structure, hint : Hint) const : void&#xa;+ supports_simd() const noexcept : bool&#xa;━━━━━━━ Praezedenz aus der Literatur ━━━━━━━&#xa;LLVM TargetInfo (ein Singleton pro Target-Architektur)&#xa;Java HotSpot CodeBlob, Protobuf MessageLite&#xa;FAST 3-Level Embedding (Page-Block / Cache-Line-Block / SIMD-Block)" vertex="1">
          <mxGeometry height="380" width="700" x="1660" y="700" as="geometry" />
        </mxCell>
        <mxCell id="lbl_phys" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;" value="SCHICHT 3 PHYSISCH (Wo? = Hardware-Cache)" vertex="1">
          <mxGeometry height="30" width="2320" x="40" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="icpage" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» ICachePage&lt;C&gt; (physische Cache-Page-Einheit)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- size_bytes : size_t (z.B. 4 KiB Standard, 2 MiB Huge)&#xa;- carried_inodes : vector&lt;INodeReference&gt;  (ganze ODER fragmentierte INodes!)&#xa;- carried_search_pages : vector&lt;ISearchPage*&gt;  (typisch K=1 wenn aligned)&#xa;- alignment : size_t (z.B. 64 bei x86, 256 bei A64FX)&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ carries_node(inode : INode const&amp;) const : InodeFragmentationKind&#xa;+ carries_search_page(page : ISearchPage const&amp;) const : bool&#xa;+ flush(target_tier : TierKind) : void&#xa;+ residency() const : ResidencyKind&#xa;━━━━━━━ Granularitaeten REV 5.1 ━━━━━━━&#xa;Cache-Line (B0): 64 B (x86), 128 B (Apple Silicon), 256 B (A64FX)&#xa;Cache-Page    : 4 KiB Standard, 2 MiB Huge&#xa;Disk-Page     : 4-64 KiB (klassisch), 4 MiB+ NVMe&#xa;━━━━━━━ Worst-Case ━━━━━━━&#xa;INode an Cache-Line-Grenze gesplittet -&gt; 2 ICachePage-Loads fuer 1 INode-Lookup&#xa;ICacheStrategy MUSS dies erkennen + ggf. mehrere ICachePages prefetchen" vertex="1">
          <mxGeometry height="440" width="1140" x="40" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="icline" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" value="«concept» ICacheLine&lt;CL&gt; (Hardware-Atomic-Transfer-Einheit)&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- size : size_t (PLATTFORM-SPEZIFISCH, NIE hardcoded!)&#xa;- state : enum MESI / MOESI&#xa;- residency : ICacheLevel const&amp; (L1/L2/L3/HBM/V-Cache)&#xa;- tag : address_t&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ size_bytes() const noexcept : size_t&#xa;+ residency() const noexcept : ICacheLevel const&amp;&#xa;+ state() const noexcept : MESIState&#xa;+ contains(addr : address_t) const noexcept : bool&#xa;━━━━━━━ C++17 Plattform-Abstraktion ━━━━━━━&#xa;static constexpr size_t destructive_size = std::hardware_destructive_interference_size;&#xa;static constexpr size_t constructive_size = std::hardware_constructive_interference_size;&#xa;━━━━━━━ Plattform-Werte (Stand 2026) ━━━━━━━&#xa;x86-64 (Intel/AMD): 64 B&#xa;ARM Cortex-A: 64 B&#xa;Apple Silicon (M1-M4): 128 B (P-Cores)&#xa;Fujitsu A64FX (Fugaku): 256 B&#xa;IBM POWER9/POWER10: 128 B" vertex="1">
          <mxGeometry height="440" width="1160" x="1200" y="1140" as="geometry" />
        </mxCell>
