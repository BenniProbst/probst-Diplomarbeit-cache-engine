        </mxCell>
        <mxCell id="t" value="U04 UML - Hybrid-Command Klassen + 17 Composition-Commands + 5 NEU Aufloesungen REV 5" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="IStrategyCommand + HybridCompositionCommand + ICompositionRule + Beispiel-Atom-Command (HashAnchorLookup)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="iscmd" value="«abstract» IStrategyCommand&#xa;━━━━━━━ Methoden (public abstract) ━━━━━━━&#xa;+ virtual execute(context : StrategyContext&amp;) : Result = 0&#xa;+ virtual can_compose_with(other : IStrategyCommand&amp;) const : bool = 0&#xa;+ virtual command_kind() const noexcept : CommandKind = 0&#xa;+ virtual estimated_cost(context : StrategyContext&amp;) const : Cost = 0&#xa;+ virtual ~IStrategyCommand() = default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="160" width="900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="hcc" value="«composite» HybridCompositionCommand : IStrategyCommand&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- parts_ : vector&lt;unique_ptr&lt;IStrategyCommand&gt;&gt;&#xa;- composition_rule_ : unique_ptr&lt;ICompositionRule&gt;&#xa;- composition_id_ : CompositionId&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ execute(context : StrategyContext&amp;) override : Result&#xa;+ add_part(part : unique_ptr&lt;IStrategyCommand&gt;) : void&#xa;+ remove_part(idx : size_t) : void&#xa;+ part_count() const noexcept : size_t&#xa;+ composition_rule() const : ICompositionRule&amp;&#xa;+ set_composition_rule(rule : unique_ptr&lt;ICompositionRule&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="800" height="320" as="geometry" />
        </mxCell>
