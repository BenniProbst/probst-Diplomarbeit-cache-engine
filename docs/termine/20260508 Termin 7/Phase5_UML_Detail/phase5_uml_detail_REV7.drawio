        <mxCell id="sota_hdr" value="SOTA-Adapter (12 in adapters/sota/) - V31.K1 + V31.K3" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
