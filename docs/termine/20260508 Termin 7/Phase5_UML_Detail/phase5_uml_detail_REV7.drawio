  <diagram id="K05" name="K05 PRT-ART Bausteinkombination">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K05 KONZEPT - PRT-ART vollstaendige Bausteinkombination (REV 5 NEU aus Termin 1-6)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="7-Quellen-Hybrid + 6 Seitentypen + 3 Iteratoren-Pflicht + ValueHandle (Inline/External/ChainRef)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="schicht" value="ARCHITEKTUR-FREEZE in 4 SCHICHTEN (Termin 4 Scope-Freeze)&#xa;━━━━━━━&#xa;A. Trie-Huelle mit Redirect-Knoten fuer kollabierte Praefixpfade (CoCo-trie-Idee)&#xa;B. Suchseitenfamilie mit mehreren implementierten Seitentypen&#xa;C. Terminale Knoten mit ValueHandle als Uebergang zur Payload&#xa;D. Cache-Engine als explizite Steuerungsschicht fuer Layout, Prefetch, Affinity, Rebuild" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="2240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="hybrid" value="7-QUELLEN-HYBRID (Termin 1+2 Bausteinkombination)&#xa;━━━━━━━&#xa;1. Redirect-Page / Trie-Huelle           CoCo-trie (Belazzougui/Boffa)        Praefixorientiert + data-aware Subtrie-Collapse&#xa;2. Dense-Byte-Page                       ART (Leis/Kemper/Neumann 2013)         1-Byte direkte Adressierung, Node4/16/48/256&#xa;3. Multilevel-Dense-Page                  START (Fent et al.)                   Mehrbyteig + Cost-Modell + Schwellwert-Umschaltung&#xa;4. Sparse-Patricia-Page                   HOT (Binna et al. 2018)               Diskriminierende Bits, k-constrained, 9 Layouts&#xa;5. Decision-Span-Page                     B^2-Tree (Schmeisser et al. 2022)     Page-lokale Decision/Span Subtrees pro 64 KiB&#xa;6. PRT-Custom-Cache-Page                  CSS+CSB+ + B^2                        Cache-line-aligned, pool-relative Handles&#xa;7. Subbaumgrenzen / Fences               Masstree (Mao/Kohler/Morris)          getrange-Semantik (NICHT als lokaler B+)&#xa;Plus: Hardwareprofil-Kalibrierung         Processor-conscious CSB+ (Samuel)     Hardware-Discovery + ISA-spezifische Schwellwerte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="2240" height="280" as="geometry" />
        </mxCell>
        <mxCell id="seitentypen" value="6 SEITENTYPEN MIT P0/P1/P2-PRIORITAET (Termin 4 Scope-Freeze)&#xa;━━━━━━━&#xa;Seitentyp                  Quelle           Prio  ISearchPageStructure         ISearchPageStructureInterpreter&#xa;Redirect-Knoten            CoCo-trie         P0    RedirectStructure            RedirectInterpreter&#xa;Dense-Byte-Page            ART               P0    DenseByteStructure           DenseByteInterpreter&#xa;Sparse-Patricia-Page       HOT               P0/P1 SparsePatriciaStructure      PatriciaInterpreter&#xa;Multilevel-Dense-Page      START             P1    MultilevelDenseStructure     MultilevelInterpreter&#xa;Decision-Span-Page         B^2-Tree          P2    DecisionSpanStructure        B2Interpreter&#xa;Custom-Aligned-Page        PRT-ART intern    P2    CustomAlignedStructure       CustomInterpreter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="2240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="iter" value="ITERATOREN-FAMILIE (Pflicht: 3 Iteratoren mit beiden Richtungen, User-Direktive)&#xa;━━━━━━━&#xa;class comdare::prt_art&lt;Key, Value&gt;&#xa;+ iterator (mutable forward) + const_iterator + reverse_iterator + const_reverse_iterator&#xa;+ range_iterator (lex-Modus, getrange-Semantik aus Masstree) + key_iterator + value_iterator + prefix_iterator (NEU REV 5)&#xa;━━━━━━━&#xa;Concept-Iteratoren: INodeIterator (visit_each_child) + ISearchPageIterator (Range-Scan) + ISearchPageStrategyIterator (Cross-Algorithm)&#xa;━━━━━━━&#xa;3 Iterator-Semantik-Modi (Termin 2): Default-Modus | Lokaler Ordnungsmodus | Lex-Modus (Prefix Enumeration + Range)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="900" width="2240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="vh" value="VALUE HANDLE (Pflicht-Datenpfad)&#xa;━━━━━━━&#xa;ValueHandle drei Auspraegungen (compile-time + runtime parametrisierbar):&#xa;- Inline       : Value direkt im terminalen Knoten (kleine Werte)&#xa;- External     : Pointer auf externen Payload-Speicher (grosse Werte)&#xa;- ChainRef     : verkettete Referenz fuer Multi-Value (vertagt P3)&#xa;━━━━━━━&#xa;Inline-vs-External-Grenze ist H3-Hypothese (architektur+workloadabhaengig) und MUSS aktiv ueber Kostenmodell gewaehlt werden" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1120" width="2240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="invarianten" value="6 INVARIANTEN (Termin 2 hart eingefroren) + 4 HYPOTHESEN (Termin 4)&#xa;━━━━━━━&#xa;I1: Lookup traversiert ausschliesslich Navigationsknoten bis terminaler Knoten oder Miss&#xa;I2: Terminaler Knoten besitzt genau ein ValueHandle; Payload extern Default, optional inline&#xa;I3: Redirect-Knoten komprimieren eindeutige Restpfade, NICHT echte Mehrfachverzweigung&#xa;I4: Lokale Seitencodierung darf variieren -&gt; ISearchPageStructureInterpreter PFLICHT (NEU REV 5)&#xa;I5: Seitentyp-Umschaltungen sind explizite Policy-Entscheidungen, KEINE festen universellen Schwellwerte&#xa;I6: Concurrency bleibt im Kernumfang auf spaetere Erweiterung begrenzt&#xa;━━━━━━━&#xa;H1: Aktive Cache-Engine verbessert CLU/Footprint/Laufzeit  H2: Dense/Sparse/Multilevel gewinnen je nach Workload  H3: Inline-vs-Handle aktiv waehlen  H4: Online-Umlagerung+Prefetching nur wirksam wenn Seitentyp+Wertablage+Affinity gemeinsam modelliert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1340" width="2240" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K06" name="K06 ISearchEngine-Familien-Taxonomie">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K06 KONZEPT - ISearchEngine-Familien-Taxonomie S1-S30 (NEU REV 5 analog 11_md)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Such-Algorithmus-Strategie-Familien analog 29 Cache-Strategie-Familien fuer ICacheEngine - 21 Patterns + 5 Plural-Familien + 4 Singular-Cluster + 5 NEUE Hybrid-Aufloesungen" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="komp" value="EBENE A KOMPOSITION-PATTERNS S1-S10&#xa;━━━━━━━&#xa;S1  IAllPagesUniformPattern (P11/P12/P14/P21)               atomar&#xa;S2  ILayerMixPattern (P03/P10/P04/P22)                      HYBRID 4 Sub-Patterns&#xa;S3  IInnerVsLeafPattern (P02/P10/P04/P19/P22)               HYBRID 5 Sub-Patterns&#xa;S4  IHotVsColdPattern (P26/P28/P10)                          HYBRID 3 Sub-Patterns&#xa;S5  IDynamicRebalancePattern (P05/P18/P19/P20)              HYBRID 4 Sub-Patterns (NEU §9.18+§9.19)&#xa;S6  IHierarchicalFractalPattern (P22/P15/P06)                HYBRID 3 Sub-Patterns&#xa;S7  IOrthogonalRuntimeParametrizedPattern (P23/P26/P14)     HYBRID 3 Sub-Patterns&#xa;S8  IMultiStrategyOrchestrationPattern (P07/P26/P15)        HYBRID 3 Sub-Patterns&#xa;S9  IHeterogeneousAdaptivePattern (P20)                     HYBRID (Aufl. §9 #17)&#xa;S10 IBoundaryNodePartitionPattern (P20)                     atomar / Sub-Pattern" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="1100" height="320" as="geometry" />
        </mxCell>
        <mxCell id="adapt" value="EBENE A ADAPTIVITAETS-PATTERNS S11-S16 + AUFBAUVERFAHREN-PATTERNS S17-S21&#xa;━━━━━━━&#xa;S11 IOfflineSelfTuningPattern (P05 START)                  HYBRID (§9 #9)&#xa;S12 IOnlineProbabilityRebalancePattern (P28/P26)            HYBRID (P28 §9 #7)&#xa;S13 IOnEveryStructureModificationPattern (P19 Local Reloc) HYBRID (NEU §9.18)&#xa;S14 IPeriodicGlobalRelocationPattern (P19 Composite P18)   HYBRID (NEU §9.19)&#xa;S15 IBulkLoadLevelByLevelPattern (P11/P12/P14)              atomar&#xa;S16 ICompoundFastBuildPattern (P02/P04)                     HYBRID (P02 §9 #5, P04 §9 #3)&#xa;━━━━━━━&#xa;S17 IBfsLevelByLevelPagePackingPattern (P18 Saikkonen)      atomar&#xa;S18 IRecursiveDfsBlockPackingPattern (P17 vEB / P11 CSS)    HYBRID (P17 NEU §9.20)&#xa;S19 IProbabilityGreedyPagePackingPattern (P16 / P28)        atomar&#xa;S20 IPostOrderDpPattern (P04 / P05)                         HYBRID (§9 #3+#9)&#xa;S21 IRecursiveCommonPrefixDecompositionPattern (P06 B^2)    HYBRID (§9 #12)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1220" y="160" width="1100" height="320" as="geometry" />
        </mxCell>
        <mxCell id="plural" value="EBENE B PLURAL-STRATEGIEN S22-S26 (41 total)&#xa;━━━━━━━&#xa;S22 BPlus-Familie (12) - BPlusTreePerLayer P03, ClassicBPlus, CSS-Full P11, CSS-Level P11, CSBPlus-Basic/Segmented/FullPrealloc P12, WideNodeBPlus P21, FractalBPlus-DiskFirst/CacheFirst P22, LargeNodeBPlus P13, EmbeddedSecondaryIndex P06&#xa;S23 Trie-Familie (8) - AdaptiveRadixTree P01, MultilevelAdaptiveRadix P05, KConstrainedHot P02, MacroNodeCollapsing P04, LoudsDenseSparse P10, JacobsonLouds P09, WormholeTriple P07, PathCompressedTrie P01/P02&#xa;S24 Hybrid-Familie (8) - TripleHashThenBPlus P07, StaticPreSortedDirectory P11, EmbeddedDecisionSpanTree P06, JumpPointerArray-Ext/Int P21, DualJumpPointerArray P22, JumpPointerVersionChain P26, MicroIndexing P22&#xa;S25 Layout-Theorie-Familie (14) - vEB P17 (4 Varianten), CacheSensitiveMultiLevel P18, LocalReloc P19 (2 Varianten), ProbabilityWeightedRootBlock P16, ProbabilityGreedy P16, RelaxedGreedy P16, CacheObliviousProbabilityLayout P16, BTreeOfCacheLines P15, VerticalPartitioning P15, HotPathLayout P28&#xa;S26 Adaptive-Layout-Selectors (3) - AdaptiveLeafSelector P20, OfflineSelfTuning P05, ConfigurationLookup P14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="2240" height="280" as="geometry" />
        </mxCell>
        <mxCell id="singular" value="EBENE C SINGULAR-STRATEGIEN S27-S30 (74 total)&#xa;━━━━━━━&#xa;S27 Intra-Page Search-Strategien (22) - LinearScanWithinNode, BinarySearchWithinNode, LoopUnrolledBinarySearch, SimdParallelKeyComparison-SSE/AVX2, SimdParallelHeadComparison, Fingerprinting-PointLookup, DenseOffsetLookup-FDL, HintNarrowedBinarySearch, InterpolationSearch, PoorMansNormalizedKeySearch, RankSelectNavigation, TaggedHashSlotLookup, SpeculativeHashedAccess, IncrementalHashing, LoudsLookup, DfudsRankAccess, ExtensionSpanSearch-B^2, ByteRangeDecision-B^2, DiscriminativeBitsSelection, PrefixingLinearSearch&#xa;S28 Intra-Page Insert/Update-Strategien (15) - PermutationFieldInsertion (P03), AdaptiveLayoutInsertion (P20), KConstrainedSubtreePartitioning (P02 4-Wege), LazyDeletion, LazySortInsertion-Fingerprinting, SequentialInsertHeuristic, SmartSplit, BulkLoadLevelByLevelInsertion, InsertionPathPrefetch, SiblingRedistributionPrefetch, RebuildOnSplit-B^2, BoundaryAwareSeparatorSelection-FDL, NodeReplacement-ROWEX, OverflowLeaf-Wormhole, ContentionSplit&#xa;S29 Intra-Page Layout-/Encoding-Strategien (28) - PrefixTruncation, Heads-PoorMansNormalized, Hints, Fingerprinting-LeafLayout, SemiDenseLeafLayout-SDL, FullyDenseLeafLayout-FDL, IndirectionVector, InfixSpeicherung-B^2, SpanNodeLcpCompression-B^2, LinearizedCompoundNode-HOT, PointerElimination, NodeGroupContiguous, SegmentedNodeGroup, OrderPreservingCompression, KeyNormalization, NextNeighborDifferencing, PointerToExtentsCompression, IntegerSliceFormation, AdaptiveSuffixPlacement, PartialKeyEncoding, LcpAwareIntegerEncoding, EncodingSelection, AlphabetAwareEncoding, SuffixTruncation, PerNodeTypeFindChild, MultilevelNode, RewiredNode, MultilevelNode4&#xa;S30 Concurrency-Strategien innerhalb Page (9 - 2 Hybride NEU §9.21+§9.22) - OptimisticLockCoupling-OLC (P03/P06/P08/P20), ROWEX (P02/P08), RCU (P29), HazardPointers (P30), EpochBasedReclamation, HandOverHandOptimistic, QuiescentStateBased, TripleClassConcurrency-Wormhole (NEU Aufl. §9.21), CopyOnWrite (P02 HOT/P19), DualHashTableCopyOnWrite (NEU Aufl. §9.22)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="2240" height="540" as="geometry" />
        </mxCell>
        <mxCell id="hybrid_neu" value="NEU REV 5 - 5 fehlende Hybrid-Aufloesungen (User-Kritik 2026-05-11)&#xa;━━━━━━━&#xa;§9.18 S13 P19 LocalReloc           OnModRelocation + LocalAlphaRelocation + WaitFreeRelocation                  -&gt; OnEveryStructureModificationCompositionCommand&#xa;§9.19 S14 P18+P19 GlobalReloc      BfsGlobalRelocation + LocalReloc-Composite + PeriodicTrigger                  -&gt; PeriodicGlobalRelocationCompositionCommand&#xa;§9.20 S18 P17 vEB Layout            VEBClassic + DynamicVEBPma + BufferNodesVEB + IndirectedVEB                   -&gt; VEBLayoutVariantCompositionCommand&#xa;§9.21 S30 P07 TripleConcurrency     Class1Rcu + Class2RWLock + Class3MutEx                                        -&gt; WormholeTripleConcurrencyCompositionCommand&#xa;§9.22 S30 P07 DualHashTable         T1MetaTrieHash + T2CowMetaTrieHash + BarrierSwap                              -&gt; WormholeDualHashTableCompositionCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="2240" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K07" name="K07 IPlatformProbe Auto-Discovery + 28 Concepts">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K07 KONZEPT - IPlatformProbe Auto-Discovery (5 Schritte) + 28 NEUE Saeule-B-Concepts (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="KEINE plattform-spezifischen Klassen + 28 fehlende Saeule-B-Concepts aus 13_md §6+§7 ergaenzt" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ipp" value="IPlatformProbe (REV 3 vorhanden)&#xa;━━━━━━━&#xa;ALLGEMEIN OHNE CPU-Spezialisierung&#xa;━━━━━━━&#xa;+ discover_cache_topology() : ICacheTopology&#xa;+ discover_core_layout() : ICoreLayout&#xa;+ discover_isa_features() : IIsaFeatureSet&#xa;+ discover_interconnect() : IBusTopology&#xa;+ measure_cache_latencies()&#xa;+ measure_bandwidths()&#xa;+ measure_cache_coherence_cost()&#xa;+ measure_pinning_effects()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ippc" value="IPlatformPropertyClassifier (REV 3 vorhanden)&#xa;━━━━━━━&#xa;+ classify(probe_results) : PlatformPropertySet&#xa;━━━━━━━&#xa;PlatformPropertySet (REV 5 erweitert auf 12+ Properties):&#xa;has_asymmetric_l3, has_hybrid_cores, has_hbm_tier, preferred_pinning,&#xa;usable_simd_width, has_software_prefetch, coherence_cost_threshold,&#xa;branch_predictor (NEU), has_bmi2_pext_pdep (NEU), primary_storage (NEU),&#xa;page_cache_model (NEU), memory_channels (NEU), has_3d_v_cache (NEU),&#xa;has_intel_thread_director (NEU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="780" height="280" as="geometry" />
        </mxCell>
        <mxCell id="iceop" value="ICacheEngineOptionPublisher (REV 3 vorhanden)&#xa;━━━━━━━&#xa;+ register_module(module : PermutationModule&amp;)&#xa;+ unregister_module(module)&#xa;+ publish_options_to_all() : void&#xa;+ filter_options_for(module) : OptionSet&#xa;+ properties() const : PlatformPropertySet const&amp;&#xa;━━━━━━━&#xa;Jede Permutation erhaelt nur die Optionen, die ihre Bausteine&#xa;tatsaechlich konsumieren koennen (compile-time-gefiltert via Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1480" y="160" width="840" height="280" as="geometry" />
        </mxCell>
        <mxCell id="schritte" value="5-SCHRITT-PFLICHT (CacheEngineBuilder pro Permutations-Build):&#xa;━━━━━━━&#xa;1. DISCOVER (statisch)  - CPUID / sysfs / /proc/cpuinfo / hwloc&#xa;2. MEASURE (dynamisch)  - Mikrobenchmark (clflush-cycle / All-Pairs-Pinning / Cache-Coherence-Calibration)&#xa;3. CLASSIFY            - Properties zusammenstellen (12+ Properties REV 5)&#xa;4. PUBLISH             - Properties allen Permutations-Modulen als Konfigurations-Optionen&#xa;5. BIND                - Pro Permutation entscheidet ICacheStrategy-Visitor, welche Properties konsumiert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="2240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="neu1" value="NEU REV 5 - 28 fehlende Saeule-B-Concepts (Teil 1: Hardware + Memory)&#xa;━━━━━━━&#xa;1.  IRankSelectPrimitive       - popcount / Jacobson 2-Level / Poppy (P09/P10/P04)&#xa;2.  IModelAcquisitionStrategy  - wie wird ILivePlatformModel gewonnen? (P05)&#xa;3.  IVirtualMemoryStrategy     - DirectMapping / RewiredSharedPages / HugePages (P05 Rewiring)&#xa;4.  IBranchPredictorModel      - Mispredict-Cost als Plattform-Kennzahl (P01/P13)&#xa;5.  IBitManipulationFeatureGate - BMI2 PEXT/PDEP, AVX2, popcount + Fallback (P02 HOT)&#xa;6.  IStorageMedium             - DRAM/NVRAM/SSD/HDD-Hierarchy (P10 SuRF, P22)&#xa;7.  IPageCacheModel            - OS Page Cache + App Block Cache 2-stufig (P10 SuRF)&#xa;8.  IConcurrencyProtocol       - eigene Saeule C, orthogonal A/B (P02/P03/P08/P29/P30)&#xa;9.  IRebuildScheduler          - VACUUM-aehnliche Trigger (P05 START Self-Tuning)&#xa;10. IRebuildCostModel          - Bauzeit O(N h^2) bei P04 CoCo&#xa;11. IWorkloadModel             - Read-Only/Read-Mostly/Write-Heavy/Mixed/Skewed/Range-Heavy&#xa;12. ICellProbeModel vs IWordProbeModel - 2 alternative Plattform-Modelle (P09 Jacobson)&#xa;13. IPositionalCorrespondencePrefetch - Prefetch via Layout-Invarianten (P10 SuRF)&#xa;14. ICacheConflictModel        - FullAssociative vs SetAssociative (P18)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="1100" height="380" as="geometry" />
        </mxCell>
        <mxCell id="neu2" value="NEU REV 5 - 28 fehlende Saeule-B-Concepts (Teil 2: ISA + Memory-Decorator + Encoding)&#xa;━━━━━━━&#xa;15. ITemporalCacheStrategy     - Instruction-Cache, P15 §7 (REV 2 ICachePage ist Daten-orientiert)&#xa;16. IIntelligentDMA            - Configurator/AGU/DataFetcher/Crawler (P31 iDMA)&#xa;17. IComputeOffload            - PE/iDMA/App-Core/FPGA (P31)&#xa;18. IHardwareExtension Sub-Hierarchie - WAH/PLWAH/COMPAX, Hash-Lookup, MergeSort, RiscBaseISA, SSE/AVX/SGX/THUMB/NEON (P31 TUD Goldstandard)&#xa;19. IMemoryDecorator (NFP)     - latency/throughput/transience/reliability/wearout/random-accessibility/cache-coherence (P33 VAMPIR)&#xa;20. IHeterogeneousAllocator (V-malloc) - heterogene Memory-Auswahl (P33)&#xa;21. IMigrationPolicy           - transparente Daten-Migration zwischen Memory-Tiers (P33 Compensation)&#xa;22. ICompileTimeNegotiator     - Multi-Query Compile-Time-Negotiation (P33)&#xa;23. IPipelineScheduler         - Operation-Pipelines mit Memory-Awareness (P33)&#xa;24. IAccessPatternStrategy     - sequential/strided/simd (P32 To-Stride)&#xa;25. IPaddingStrategy           - 576-Byte-Padding fuer Cache-Set-Disalignment (P32)&#xa;26. IInformationTheoreticLowerBound - Optimality-Marker fuer Encoding (P09)&#xa;27. IPositionalAddressing      - Implicit Addressing via Position-in-Bitstring (P09)&#xa;28. ITopologyEncoding          - LOUDS/DFUDS/BP/Pointer/BitArray (orthogonal zu IFanout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1220" y="700" width="1100" height="380" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ipp" target="ippc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ippc" target="iceop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K08" name="K08 Plattform-Modell verfeinert">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K08 KONZEPT - Plattform-Modell verfeinert nach 33-Paper-Code (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="REV 3 Concepts + 11 NEUE Verfeinerungen aus 33-Paper-Code-Adapter + 5 Block-AO-OFFEN-Punkte" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="grp_cache" value="Cache-Hierarchie (REV 3 + REV 4 erweitert)&#xa;━━━━━━━&#xa;ICacheLevel - L1/L2/L3/HBM/V-Cache (size, latency, bandwidth, tier_kind enum)&#xa;ICacheLine - Granularitaet (typ. 64 B, 256 B ARM A64FX)&#xa;ICacheTopology - gesamte Hierarchie + asymmetric_l3 + per_ccd Map&#xa;ICacheResidency - Cache whereabouts (Cached/HeaderCached/Uncached)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="grp_cpu" value="CPU-Kerne (generisch, KEINE CPU-Spezialisierung)&#xa;━━━━━━━&#xa;ICpuCore - core_class als generic enum&#xa;ICoreLayout - Topologie ohne CPU-Namen&#xa;ICoreToThreadMap - Thread-zu-Core, IPinningPolicy generisch&#xa;IPinningPolicy - LARGEST_L3_CCD | HIGH_IPC_CORES | NUMA_LOCAL | ROUND_ROBIN&#xa;NEU REV 5: Cross-Socket-cost + first-touch-policy + NUMA-node-binding (Cluster A/B/E)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="grp_isa" value="Hardware-Erweiterungen (ISA-Features) + Bus&#xa;━━━━━━━&#xa;IHardwareExtension (AVX-512, BMI2, NEON, SVE2, RISC-V V-Ext)&#xa;IIsaFeatureSet (gesamte Verfuegbarkeit, Auto-discovered)&#xa;IInterconnect - CCD-CCD, Core-Cache, NUMA, PCIe, NVLink&#xa;IBusTopology + IMemoryBandwidthModel - Live-Bandbreiten + Bottleneck-Detection&#xa;NEU REV 5: ITlbModel (dTLB / sTLB) als eigenes Concept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1560" y="160" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="grp_live" value="Echtzeit-Modelle&#xa;━━━━━━━&#xa;ILivePlatformModel - Echtzeit-Modell, periodisch aktualisiert (~100ms-Tick)&#xa;ILiveCpuModel - Per-Core-Lasten + Hot-Path-Score&#xa;Update-Source: perf-Counter / sysfs / cpuid&#xa;NEU REV 5: Hardware-Counter-Feedback als STATISCHE Strategy fuer adaptives Resizing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="grp_sync" value="Concurrency (NEU REV 5 detailliert)&#xa;━━━━━━━&#xa;IConcurrencyProtocol (eigene Saeule C):&#xa;6-Flavor-RCU (qsbr/mb/membarrier/signal aus URCU Desnoyers 2012)&#xa;Hazard Pointers (P30) + EpochBased + ROWEX + OLC&#xa;NEU REV 5: IRangeAtomicityProtocol (P08 ROWEX-Range-Konflikt)&#xa;NEU REV 5: ICompositionMode (OneNodePerPage / MultipleNodesPerPage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1220" y="380" width="1040" height="160" as="geometry" />
        </mxCell>
        <mxCell id="grp_storage" value="Storage + Memory-Tiers (NEU REV 5 durchgaengig)&#xa;━━━━━━━&#xa;IStorageMedium (DRAM/NVRAM/SSD/HDD-Hierarchy)&#xa;IPageCacheModel (OS Page Cache + App Block Cache 2-stufig)&#xa;NVRAM/Persistent Memory durchgaengig (statt nur P25/P31)&#xa;ITenancyModel (Multi-Tenancy/Cache-Pollution NEU statt &#39;dedicated&#39;)&#xa;IEnergyModel (Cache-Coherence-Energiekosten quantitativ, P24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="1100" height="160" as="geometry" />
        </mxCell>
