        <mxCell id="g_layout" value="LAYOUT-Familien (F1-F8)&#xa;━━━━━━━&#xa;F1  IAdaptiveFootprintStrategy (P01/P02/P05/P12/P14/P20/P28) HYBRID&#xa;F2  ISuccinctEncodingStrategy (P09/P04/P10/P11/P12/P14) HYBRID&#xa;F3  ICacheLineAlignedStrategy (P01/P02/P07/P11/P12/P14/P15/P32) atomar&#xa;F4  IMultiCacheLineNodeStrategy (P03/P13/P21/P22) HYBRID&#xa;F5  ISoftwarePrefetchStrategy (P02/P03/P10/P14/P15/P21/P22/P25/P26/P27) HYBRID&#xa;F6  IPointerChasingResolutionStrategy (P21/P22/P26) HYBRID&#xa;F7  ISimdAcceleratedLookupStrategy (P01/P02/P03/P10/P20/P31) atomar&#xa;F8  IPathCollapseStrategy (P01/P02/P04/P05/P06/P07/P08) HYBRID NEU §10.21" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1">
