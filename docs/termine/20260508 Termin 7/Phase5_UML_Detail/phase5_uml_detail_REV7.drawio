  <diagram id="DISAMB" name="ANTI-VERMISCHUNG 4-Ebenen Achsen-Strategien-CE-Services-Familien">
    <mxGraphModel dx="2400" dy="2000" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2200" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-18 / R.12 / Anti-Vermischung-Master - siehe docs/architektur/11_axes_vs_strategies_disambiguation.md" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1700" y="0" width="700" height="20" as="geometry"/></mxCell>
        <mxCell id="t" value="ANTI-VERMISCHUNG (NEU R.12, 2026-05-18) - 4 unabhaengige Konzept-Ebenen klar getrennt" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Loest die 12 identifizierten Vermischungen in K-Tabs (R.1-R.10). Pro Ebene: Was ist es? Wer benutzt es? Wie viele Items? Quelle. Pfeile zwischen Ebenen: konfiguriert / instantiiert / konsumiert." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" value="EBENE I - BAUSTEINE-ACHSEN (Algorithmus-Permutations-Dimensionen)&#10;━━━━━━━ 13 Hauptachsen (Stand 2026-05-18 nach N-Phase) ━━━━━━━&#10;1 PAGE-TYPE | 2 NODE-TYPE | 3.A Algo-Traversal | 3.B Cache-Traversal | 3.M Mapping (NEU)&#10;4 VALUEHANDLE | 5 MEMORY-LAYOUT&#10;6.1 Allocation-Strategy | 6.2 Reclamation | 6.3 NUMA | 6.4 HugePage | 6.5 FreeList&#10;7 PREFETCH&#10;8.1 Concurrency-Pattern | 8.2 Locking-Mode&#10;9 ISA | 10 MEASUREMENT | 11 TELEMETRY-COLLECTION&#10;12 HARDWARE-STRATEGY (NEU) | 13 SCHEDULING-STRATEGY (NEU)&#10;━━━━━━━ Quelle: docs/bausteine/01_bausteine_matrix.md - Master ━━━━━━━&#10;Pro Algorithmus: pro Achse genau eine Baustein-Klasse (Reuse SOTA oder Neu-Impl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=4;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="2320" height="260" as="geometry"/></mxCell>
        <mxCell id="arr12" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=3;dashed=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr12l" value="konsumiert (Pruefling -&gt; CE-Service) | konfiguriert (CEB -&gt; CE-Sub-Engine)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="arr12"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e2" value="EBENE II - CE-SUB-ENGINES (CE-INTERNAL Services)&#10;━━━━━━━ 12 Sub-Engines C1-C12 (K15) ━━━━━━━&#10;C1 Cache-Layout-Engine (~28 Atome) | C2 Cache-Pinning-Engine (~10)&#10;C3 Cache-Prefetch-Engine (~25) | C4 Cache-Coherence-Engine (~12)&#10;C5 Cache-Telemetry-Engine (~22) | C6 Cache-Allocation-Engine (~17)&#10;C7 Cache-Migration-Engine (~12) | C8 Cache-Encoding-Engine (~28)&#10;C9 Cache-Heuristik-Familie (~73 ORTHOGONAL)&#10;C10 Cache-Topologie-Engine (~17) | C11 Cache-Scheduler-Engine (~13)&#10;C12 Cache-Filter-Engine (~9)&#10;━━━━━━━ Quelle: docs/architektur/04_konzepte_saeule_b.md ━━━━━━━&#10;Eigentumsverhaeltnis: cache-engine/libs/cache_engine/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=4;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="2320" height="260" as="geometry"/></mxCell>
        <mxCell id="arr23" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=3;dashed=1;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr23l" value="instantiiert per Permutations-Config" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="arr23"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e3" value="EBENE III - CACHE-STRATEGIEN (Implementations von CE-Sub-Engines)&#10;━━━━━━━ 29 Strategien F1-F29 (K10) ━━━━━━━&#10;F1-F8   LAYOUT-Familien      (gehoeren zu C1)&#10;F9-F14  ENCODING + PREFETCH  (gehoeren zu C8 + C3)&#10;F15     HERZSTUECK Vergleich (gehoert zu C9 Heuristik - Forschungs-F)&#10;F16-F19 NODE-Familien        (gehoeren zu C1 + C8)&#10;F20-F25 CONCURRENCY-Familien (gehoeren zu C4 Coherence)&#10;F26-F29 TELEMETRIE-Familien  (gehoeren zu C5)&#10;━━━━━━━ Quelle: docs/architektur/09_taxonomien.md ━━━━━━━&#10;Pro CE-Sub-Engine: eine oder mehrere F-Strategien je nach Permutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=4;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="2320" height="220" as="geometry"/></mxCell>
        <mxCell id="arr14" value="" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0;strokeColor=#311B92;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="e1" target="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr14l" value="implementiert" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#311B92;" vertex="1" connectable="0" parent="arr14"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e4" value="EBENE IV - SUCH-ENGINE-FAMILIEN (Implementations von Algorithmus-Achsen)&#10;━━━━━━━ 30 Familien S1-S30 (K06) ━━━━━━━&#10;S1-S10  Komposition-Patterns&#10;S11-S16 Adaptivitaet-Patterns&#10;S17-S21 Aufbauverfahren-Patterns&#10;S22-S26 Plural-Strategien (BPlus/Trie/Hybrid/Layout-Theorie/Adaptive-Selectors)&#10;S27-S30 Singular-Strategien (Intra-Page-Search/Update/Layout/Concurrency)&#10;━━━━━━━ Quelle: docs/architektur/03_konzepte_saeule_a.md ━━━━━━━&#10;Pro Algorithmus-Achse (Ebene I): eine S-Familie ausgewaehlt + Strategien konfiguriert&#10;━━━━━━━ Pruefling-Beispiel ━━━━━━━&#10;PRT-ART (comdare-prt-art) implementiert Ebene IV fuer alle 13 Algorithmus-Achsen (O-Phase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#311B92;strokeWidth=4;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="2320" height="280" as="geometry"/></mxCell>
        <mxCell id="warn" value="ANTI-VERMISCHUNGS-REGELN&#10;━━━━━━━&#10;1. F1-F29 sind NICHT Algorithmus-Achsen (Ebene III, nicht Ebene I) - siehe R.1&#10;2. C1-C12 sind NICHT Algorithmus-Achsen (Ebene II, nicht Ebene I) - siehe R.2&#10;3. C8 Hardware-Probing (K09) ist Ebene II (Heuristik in CE), NICHT die NEUE Achse 12 HARDWARE-STRATEGY (Ebene I) - siehe R.3&#10;4. S-Familien (K06) und F-Familien (K10) sind unterschiedliche Ebenen: S = Ebene IV (Algorithmus-Seite), F = Ebene III (Cache-Seite) - siehe R.4&#10;5. K05b 4 Suchtypen sind Sub-Permutation auf Achse 2 NODE-TYPE (Ebene I), nicht eigene Achse - siehe R.5&#10;6. K05e 4+2 Pools sind 7 Pool-INSTANZEN unter Achse 6.1 Allocation, nicht 7 verschiedene Allokatoren - siehe R.6&#10;7. K05g Concurrency: bidirektionale Klaerung Pruefling-eigen vs CE-Disziplin-Reuse - siehe R.7&#10;8. K04 4-Ebenen-Strategien (A/B/C/D) sind Implementations-Tiefe pro S-Familie, NICHT 4 Achsen - siehe R.8&#10;9. K03 V1-V4 sind ENGINE-CHOICE-DIMENSION (4-fache Permutations-Multiplikator), nicht F-Familien - siehe R.9&#10;10. K12 F15-Familie (Cache-Strategie III) NICHT verwechseln mit F15-Forschungsmission (META) - siehe R.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="2320" height="280" as="geometry"/></mxCell>
        <mxCell id="cross" value="CROSS-REFERENZ &amp; KONSEQUENZEN&#10;━━━━━━━&#10;Master-Doku: docs/architektur/11_axes_vs_strategies_disambiguation.md (R.11 DONE)&#10;Master-Schichten: docs/architektur/10_schichten_modell_M.md (M.2 DONE)&#10;━━━━━━━ Konsequenzen ━━━━━━━&#10;P-Phase: Pro K-Tab im drawio REV8 ein Ebene-Label am Tab-Titel (z.B. K10 = Ebene III, K15 = Ebene II)&#10;N-Phase: Bausteine-Matrix mit klarer Ebene-I-Markierung + Cross-Ref auf konsumierte C/F (siehe Tabelle in 11_disambig...md §3)&#10;O-Phase: PRT-ART-Klassen explizit als Ebene IV markieren in comdare-prt-art-Headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="2320" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
