        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K04 KONZEPT - 4-Ebenen-Strategien + Multiplizitaeten (REV 5 unveraendert vs REV 3, User-bestaetigt)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A04000;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Pattern (1 pro IFanout) - Plural-Strategy (N pro Pattern) - Singular-Strategy (1 pro Page) - Heuristic (beliebig)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea" value="EBENE A - ISearchPagesStrategyPattern (1 pro IFanout)&#xa;━━━━━━━&#xa;21 Patterns aus 12_md (siehe K06):&#xa;10 Komposition: AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold | DynamicRebalance | HierarchicalFractal | OrthogonalRuntimeParametrized | MultiStrategyOrchestration | HeterogeneousAdaptive | BoundaryNodePartition&#xa;6 Adaptivitaet: OfflineSelfTuning | OnlineProbabilityRebalance | OnEveryStructureModification | PeriodicGlobalRelocation | BulkLoadLevelByLevel | CompoundFastBuild&#xa;5 Aufbauverfahren: BfsLevelByLevelPagePacking | RecursiveDfsBlockPacking | ProbabilityGreedyPagePacking | PostOrderDp | RecursiveCommonPrefixDecomposition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="2200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="eb" value="EBENE B - ISearchPagesStrategy PLURAL (N pro Pattern)&#xa;━━━━━━━&#xa;41 Plural-Strategien aus 12_md §2:&#xa;12 BPlus-Familie | 8 Trie-Familie | 8 Hybrid-Familie | 10 Layout-Theorie-Familie | 3 AdaptiveSelectors&#xa;━━━━━━━&#xa;Beispiele: BPlusTreePerLayerStrategy (P03), AdaptiveRadixTreeStrategy (P01), KConstrainedHotStrategy (P02), MacroNodeCollapsingStrategy (P04),&#xa;LoudsDenseSparseStrategy (P10), WormholeTripleStrategy (P07), FractalBPlusStrategy (P22), HotPathLayoutStrategy (P28)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="2200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ec" value="EBENE C - ISearchPageStrategy SINGULAR (1 pro ISearchPage)&#xa;━━━━━━━&#xa;74 Singular-Strategien aus 12_md §3:&#xa;22 Intra-Page Search-Strategien | 15 Insert/Update | 28 Layout/Encoding | 9 Concurrency-innerhalb-Page&#xa;━━━━━━━&#xa;Beispiele: PermutationFieldInsertion (P03), AdaptiveLayoutSelection (P20), CompoundContainer (P02), DecisionPageStrategy (P06), SpanPageStrategy (P06), DiscriminativeBitsSelection (P02 HOT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="2200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ed" value="EBENE D - IHeuristic (beliebig viele - parametrieren die Strategien)&#xa;━━━━━━━&#xa;~80-85 paper-abgeleitete Heuristiken aus 13_md §9 + 12_md §4 (siehe K09):&#xa;19 Layout-Selection | 12 Cost-Modell | 8 AdaptivePrefetch | 6 Workload-Detection | 6 Cache-Coherence | 9 Telemetry | 10 Auswahl/Kompat | 4 Hardware-Probing&#xa;━━━━━━━&#xa;Beispiele: AdaptivePrefetchDistance (P23) | CacheCostDP (P05) | CacheCoherenceCost (P28 Block AN) | WidthCostModel (P13) | ProbabilityLayout (P16) |&#xa;LargestL3CcdPinning (allgemein) | HotPathOnHighIpcCore (allgemein) | StrideVsSequential (P32) | LeafOnlyCounter (P28-Mail)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="820" width="2200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="MULTIPLIZITAETEN (K3.4 + REV 5):&#xa;1 IFanout has-1 ISearchPagesStrategy (NEU REV 5)&#xa;1 IFanout has-1 ISearchPagesStrategyPattern (eindeutig pro Fanout)&#xa;1 ISearchPagesStrategyPattern has-N ISearchPageStrategy (eine pro ISearchPage)&#xa;1 ISearchPage has-1 ISearchPageStructure + 1 ISearchPageStructureInterpreter (NEU REV 5)&#xa;1 IHeuristic kann beliebig viele Strategien parametrieren - Iteratoren orthogonal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1080" width="2200" height="160" as="geometry" />
