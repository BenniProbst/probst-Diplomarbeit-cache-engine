  <diagram id="K02" name="K02 3-Schichten Konzept-Strategie-Physisch (REV 5.1)">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K02 KONZEPT - 3-Schichten-Architektur (Konzept / Strategie / Physisch) + INode-Korrektur (REV 5.1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="REV 5.1 KORREKTUR: INode = Mikro-Verweis (Slot-Eintrag) auf ISearchPage. IFanout HAT ISearchPages. ISearchPage HAT INodes. ICachePage traegt INodes (ganz oder fragmentiert). Strategie-Schicht ist Kleber zwischen Konzept und Physisch (CacheEngine)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer1" value="SCHICHT 1 - KONZEPT (Was sind die Algorithmus-Bausteine?)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="iroot" value="IRootNode&lt;R&gt; (NEU REV 5.1 - vorher fae. IRootPage)&#xa;━━━━━━━&#xa;Algorithmus-Wurzel als KONZEPTIONELLE Ebene&#xa;Liegt auf einer ISearchPage darunter&#xa;composes 1 IFanout (KEIN direkter Speicher!)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ifan" value="IFanout&lt;F&gt;&#xa;━━━━━━━&#xa;Verzweigungs-Abstraktion (Konzept)&#xa;contains [N] ISearchPage via «contains»&#xa;has 1 ISearchPagesStrategy + 1 Pattern&#xa;━━━━━━━&#xa;KORREKTUR REV 5.1: KEIN direktes&#xa;composes [N] INode mehr!&#xa;INodes sind nur INDIREKT ueber ISearchPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="inode" value="INode&lt;N&gt; = Mikro-Verweis (KORRIGIERT REV 5.1)&#xa;━━━━━━━&#xa;Slot-Eintrag in einer Liste eines IFanouts&#xa;Tagged Union mit Discriminator (Masstree keylenx_):&#xa;- ValueRef     (Wert direkt)&#xa;- ChildRef     (Pointer auf naechsten Knoten)&#xa;- LayerRef     (Layer-Pointer Border-Slot keylenx==128)&#xa;- SiblingRef   (next/prev B-link)&#xa;- SuffixRef    (External-Suffix-Pointer keylenx==64)&#xa;━━━━━━━&#xa;HAT KEINE eigenstaendige Speicher-Adresse!&#xa;Adressiert via permutation_index durch Interpreter (Facade)&#xa;━━━━━━━&#xa;Quelle Masstree P03: Slot in `leaf` mit ikey0_[i] + keylenx_[i] + lv_[i]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="200" width="1140" height="240" as="geometry" />
        </mxCell>
        <mxCell id="layer2" value="SCHICHT 2 - STRATEGIE (Wie verbinden wir Konzept und physische Cache optimal? = CacheEngine als KLEBER)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ispage" value="ISearchPage&lt;S&gt; (Knoten-Objekt = logische Such-Seite)&#xa;━━━━━━━&#xa;contains [W] INode (W = Fanout-Width, z.B. 15 in Masstree)&#xa;has EXACTLY 1 ISearchPageStructure&#xa;has EXACTLY 1 ISearchPageStructureInterpreter&#xa;mapped onto [1..K] ICachePage  via ICacheStrategy&#xa;━━━━━━━&#xa;Beispiele: Masstree leaf 256 B, ART Node16 ~144 B, HOT Compound 32-64 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1140" height="220" as="geometry" />
        </mxCell>
        <mxCell id="isps" value="ISearchPageStructure&lt;SST&gt; (Strategy + Singleton-Facade)&#xa;━━━━━━━&#xa;encoding : Encoding (PRT-ART-Seitentyp-Kodierung)&#xa;layout_invariants : LayoutInvariantSet&#xa;raw_bytes : span&lt;byte&gt;&#xa;━━━━━━━&#xa;HAT (Composition) ISearchPageStructureInterpreter (Singleton)&#xa;Bietet Such-/Iterator-Methoden via FACADE Pattern (GoF):&#xa;+ find(key) / scan(range) / prefetch(hint)&#xa;+ make_iterator(mode) / advance / position&#xa;━━━━━━━&#xa;6 Konkretisierungen + Singleton-Interpreter:&#xa;RedirectStructure -&gt; RedirectInterpreter (memcmp byte-prefix)&#xa;DenseByteStructure -&gt; DenseByteInterpreter (linear scan SIMD)&#xa;MultilevelDenseStructure -&gt; MultilevelInterpreter (Cost-DP-Suche)&#xa;SparsePatriciaStructure -&gt; PatriciaInterpreter (single/multi-mask AVX2)&#xa;DecisionSpanStructure -&gt; B2Interpreter (Decision-then-Span)&#xa;CustomAlignedStructure -&gt; CustomInterpreter (B^2-aehnlich)&#xa;━━━━━━━&#xa;FACADE: Tree haelt EINEN Verweis pro Layout-Variante (Singleton).&#xa;Spart 8 B vtable-Pointer pro INode (kritisch bei 16-B-INodes!).&#xa;Praezedenz: LLVM TargetInfo, Protobuf MessageLite, FAST 3-Level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="520" width="1110" height="500" as="geometry" />
        </mxCell>
        <mxCell id="strat" value="ISearchPagesStrategy + Pattern + ISearchPageStrategy + ICacheStrategy (Visitor) - 4-Ebenen-Strategien siehe K04, K06&#xa;━━━━━━━&#xa;Strategie-Schicht ist KLEBER zwischen Konzept-Schicht (IFanout/INode/IRootNode) und Physik-Schicht (ICachePage/ICacheLine).&#xa;Sie ist TEIL der CacheEngine. Cache-Engine hat 12 internal Familien C1-C12 (siehe K15) - Layout, Pinning, Prefetch, Coherence, Telemetry, Allocation, Migration, Encoding, Heuristik, Topologie, Scheduler, Filter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1140" height="240" as="geometry" />
        </mxCell>
        <mxCell id="layer3" value="SCHICHT 3 - PHYSISCH (Wo liegt es im Speicher? = Hardware-Cache-Repraesentation)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="icpage" value="ICachePage&lt;C&gt; (physische Cache-Page-Einheit)&#xa;━━━━━━━&#xa;has size = N x ICacheLine.size (z.B. 4 KiB = 64 x 64 B)&#xa;carries [0..M] INode (KORRIGIERT: ganz ODER fragmentiert)&#xa;carries [0..K] ISearchPage (typisch K=1 wenn aligned)&#xa;━━━━━━━&#xa;3 Granularitaeten:&#xa;Cache-Line (B0): 64 B (x86), 128 B (Apple Silicon), 256 B (A64FX)&#xa;Cache-Page    : 4 KiB Standard, 2 MiB Huge&#xa;Disk-Page     : 4-64 KiB (klassisch), 4 MiB+ NVMe&#xa;━━━━━━━&#xa;Worst-Case-Fragmentierung: INode an Cache-Line-Grenze gesplittet&#xa;-&gt; 2 ICachePage-Loads fuer 1 INode-Lookup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="1140" height="280" as="geometry" />
        </mxCell>
        <mxCell id="icline" value="ICacheLine&lt;CL&gt; (Hardware-Atomic-Transfer-Einheit)&#xa;━━━━━━━&#xa;size : 64 B / 128 B / 256 B je nach Plattform&#xa;state : MESI / MOESI&#xa;residency : ICacheLevel (L1/L2/L3/HBM/V-Cache)&#xa;━━━━━━━&#xa;Plattform-spezifisch (NIE hardcoded 64 B!):&#xa;C++17: std::hardware_destructive_interference_size&#xa;x86-64: 64 B   ARM Cortex-A: 64 B   Apple Silicon: 128 B   A64FX: 256 B   POWER9/10: 128 B&#xa;━━━━━━━&#xa;False-Sharing-Avoidance: alignas(hardware_destructive_interference_size)&#xa;Cache-Line-Aware Familien: CSS, CSB+, FAST, ART, HOT, vEB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1100" width="1110" height="280" as="geometry" />
        </mxCell>
        <mxCell id="cache_engine_box" value="CACHE-ENGINE als HARMONISIERER der 3 Schichten (Hauptaufgabe REV 5.1)&#xa;━━━━━━━&#xa;Optimiert die Kommunikation + Darstellung zwischen Konzept-Ebene (IRootNode/IFanout/INode) und Physik-Ebene (ICachePage/ICacheLine).&#xa;Strategie-Schicht (CacheEngine-internal) waehlt aus 12 ICacheEngine-Familien (C1-C12, siehe K15) die optimale Kombination fuer:&#xa;- Performance (Throughput/Latency/Cache-Miss-Rate)&#xa;- Speicherplatz (Footprint/Compression-Ratio)&#xa;- Coherence (False-Sharing-Vermeidung)&#xa;━━━━━━━&#xa;Drei Ziele harmonisieren: KONZEPT (was) - STRATEGIE (wie optimal) - PHYSISCH (wo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1410" width="2280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="r_iroot_ifan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="iroot" target="ifan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_ifan_ispage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ifan" target="ispage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_ifan_lbl" value="contains [N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ifan_ispage">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r_ispage_inode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.8;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ispage" target="inode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_ispage_lbl" value="contains [W=15]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ispage_inode">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r_ispage_isps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="ispage" target="isps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_ispage_lbl2" value="has 1 (Facade)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="r_ispage_isps">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r_ispage_icpage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#1B5E20;strokeWidth=3;" edge="1" parent="1" source="ispage" target="icpage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_ispage_lbl3" value="mapped via ICacheStrategy" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#1B5E20;" vertex="1" connectable="0" parent="r_ispage_icpage">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r_icpage_icline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="icpage" target="icline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r_icpage_lbl" value="composes [N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_icpage_icline">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="K03" name="K03 ICacheStrategy + CacheEngineBuilder Permutationsdimension">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="K03 KONZEPT - ICacheStrategy als Permutationsdimension (REV 5 erweitert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="User waehlt Compile-Time ODER CacheEngineBuilder erzeugt Permutationsdimension fuer F15-Vergleich" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ics" value="ICacheStrategy&lt;CS&gt;&#xa;━━━━━━━&#xa;Visitor-Pattern Wurzel (3 visit-Slots REV 4/5)&#xa;+ visit(read_op : PageReadOp&amp;)&#xa;+ visit(write_op : PageWriteOp&amp;)&#xa;+ visit(layout_op : PageLayoutOp&amp;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="800" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bes" value="V1 BaseEngineStrategy : ICacheStrategy&#xa;━━━━━━━&#xa;NICHT-OPTIMIERTE Read/Write/Layout-Variante&#xa;StaticEngine-Pfad: Originalcode-Bauteil&#xa;Baseline fuer F15-Vergleich&#xa;━━━━━━━&#xa;KEINE ILivePlatformModel-Konsultation&#xa;KEINE Heuristik-Aufrufe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="V2 CacheEngineStrategy + HEURISTIC_STATIC&#xa;━━━━━━━&#xa;Cache-Engine aktiv + statische Defaults&#xa;OHNE Plattformkalibrierung&#xa;━━━━━━━&#xa;feste Schwellen, keine Mikrobenchmarks&#xa;Termin 6 Modus 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="400" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#xa;━━━━━━━&#xa;Cache-Engine + einmalige Mikrobenchmarks&#xa;daraus folgen feste Plattformregeln&#xa;━━━━━━━&#xa;Warm-up-Phase, Kalibrierungs-Heuristik&#xa;Termin 6 Modus 2 (CSB+ processor-conscious-Erbe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1220" y="400" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#xa;━━━━━━━&#xa;Cache-Engine + Warm-up + laufende&#xa;Rekalibrierung/Umschaltung bei Zugriffsmuster-Aenderung&#xa;━━━━━━━&#xa;Online-Adaption, Khan-Erbe + START-Optimizer&#xa;Termin 6 Modus 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1800" y="400" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="builder" value="CacheEngineBuilder.build_permutations() (NEU REV 5)&#xa;━━━━━━━&#xa;Pro Search-Engine-Permutation entstehen 4 Builds:&#xa;V1 = BaseEngineStrategy (Baseline F15)&#xa;V2 = CacheEngineStrategy + HEURISTIC_STATIC&#xa;V3 = CacheEngineStrategy + INFORMED_KALIBRIERT&#xa;V4 = CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#xa;━━━━━━━&#xa;F15 vergleicht alle 4 systematisch:&#xa;Hat die CacheEngine-Investition messbaren Mehrwert?&#xa;In welchem Modus? Auf welcher Plattform?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="700" width="1840" height="240" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="ENGINE-CHOICE-DIMENSION: Compile-Time-Wahl (Template-Parameter) ODER CacheEngineBuilder-generiert (Permutationsdimension)&#xa;F15-Cross: jede Such-Permutation x 4 Engine-Choice-Varianten = 4-fache Anzahl Tupel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="980" width="1840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.1;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="bes" target="ics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.4;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v2" target="ics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.6;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v3" target="ics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.9;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v4" target="ics">
          <mxGeometry relative="1" as="geometry" />
