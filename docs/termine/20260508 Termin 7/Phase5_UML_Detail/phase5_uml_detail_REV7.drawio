        <mxCell id="alloc_list" value="A01 jemalloc   - jemalloc-Adapter (BSD-2)&#xa;A02 tcmalloc   - tcmalloc-Adapter (Apache-2.0)&#xa;A03 ptmalloc   - ptmalloc3 (keine LICENSE, Architekt-Direktive II OK)&#xa;A04 mimalloc   - MIT [V31.K2 PILOT, used_aligned_alloc_-Flag-Fix]&#xa;A05 snmalloc   - snmalloc (MIT)&#xa;A06 rpmalloc   - rpmalloc (Public Domain)&#xa;A07 scalloc    - scalloc (BSD-2)&#xa;A08 LRMalloc   - LRMalloc (BSD-2)&#xa;A09 Hoard      - Hoard (GPL-2 / Apache-2.0 dual)&#xa;A20 Coz        - Coz-Profiler (BSD-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="200" width="1140" height="280" as="geometry" />
        </mxCell>
        <mxCell id="pattern_hdr" value="COMDARE_HAVE_X Flag-Pattern (V31 Pilot)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="2320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pattern" value="Pro Adapter wird per CMake-Probe ein COMDARE_HAVE_X gesetzt:&#xa;━━━━━━━&#xa;option(COMDARE_USE_UNODB Use unodb if found OFF)&#xa;find_package(unodb QUIET)&#xa;if(unodb_FOUND OR COMDARE_USE_UNODB)&#xa;  set(COMDARE_HAVE_UNODB 1)&#xa;else()&#xa;  set(COMDARE_HAVE_UNODB 0)  // Fallback auf eigene Re-Impl&#xa;endif()&#xa;configure_file(... comdare_haves.h.in)&#xa;━━━━━━━&#xa;Im Code:&#xa;#include &lt;comdare/cache_engine/comdare_haves.h&gt;&#xa;#if COMDARE_HAVE_UNODB&#xa;  // Direct call into unodb&#xa;#else&#xa;  // Eigene Re-Impl Fallback (legacy_reimpl/)&#xa;#endif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1140" height="380" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle" value="ADAPTER-LIFECYCLE (Phase 5 Workload-Routing)&#xa;━━━━━━━&#xa;1. xml_config_parser laedt algorithm_profiles/sota/p01_art.xml&#xa;2. ResolveBaustein erstellt PermutationDescriptor mit Adapter-Auswahl&#xa;3. ExperimentDriver Phase 5 ruft adapter-&gt;execute(workload)&#xa;4. Adapter wrappt Original-Aufruf und sammelt Mess-Daten&#xa;5. PermutationResult.workload_used wird gesetzt (V20)&#xa;6. ResultAggregator schreibt CSV/JSON inkl. Adapter-Identitaet&#xa;━━━━━━━&#xa;Adapter-Subklassen-Hierarchie:&#xa;ISearchEngine  (cache-engine ABI)&#xa;  ISotaSearchEngine  (Marker fuer SOTA-Wrapper)&#xa;    UnodbAdapter, HotAdapter, MasstreeAdapter, ...&#xa;  IAllocatorAdapter  (Marker fuer Allokator-Wrapper)&#xa;    JemallocAdapter, TcmallocAdapter, MimallocAdapter, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1220" y="560" width="1140" height="380" as="geometry" />
        </mxCell>
        <mxCell id="cross_ref" value="CROSS-REFERENZ&#xa;━━━━━━━&#xa;Adapter-Quellcode: comdare-cache-engine/adapters/sota/ und allocator/&#xa;Profil-XML: comdare-cache-engine/algorithm_profiles/{sota,allocator}/&#xa;Bausteine-Mapping: docs/bausteine/01_bausteine_matrix.md (Achse 1 PAGE-TYPE, Achse 5 ALLOCATOR)&#xa;Lizenz-Status: comdare-cache-engine/NOTICE (Architekt-Direktive II)&#xa;Forschungslandkarte: docs/forschungslandkarte/02_cluster_A_trie.md ff." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="2320" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
