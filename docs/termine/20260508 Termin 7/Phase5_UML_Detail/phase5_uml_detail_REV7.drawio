        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
