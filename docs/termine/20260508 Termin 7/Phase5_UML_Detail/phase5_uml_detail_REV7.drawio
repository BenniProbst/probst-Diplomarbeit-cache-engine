        <mxCell id="iclevel" value="«concept» ICacheLevel&lt;L&gt;&#xa;━━━━━━━ Attribute (public) ━━━━━━━&#xa;+ size_bytes : size_t&#xa;+ line_size_bytes : size_t (typ. 64, 256 ARM A64FX)&#xa;+ associativity : int&#xa;+ latency_cycles : double&#xa;+ bandwidth_gbps : double&#xa;+ tier_kind : enum L1 / L2 / L3 / HBM / V_CACHE&#xa;━━━━━━━ Methoden ━━━━━━━&#xa;+ effective_capacity() : size_t&#xa;+ measured_at(timestamp) : MeasureSnapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
