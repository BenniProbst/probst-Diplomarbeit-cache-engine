        <mxCell id="g_compare" value="VERGLEICH-Familie (F15) - HERZSTUECK&#xa;━━━━━━━&#xa;F15 IProbabilityWeightedLayoutStrategy (P16/P28) HERZSTUECK F15&#xa;━━━━━━━&#xa;PRT-ART staedtet F15 als Forschungsstrategie:&#xa;- vergleicht die anderen 28 Familien systematisch&#xa;- BaseEngineStrategy = ohne CacheEngine&#xa;- CacheEngineStrategy = mit Plattform-Heuristiken&#xa;- 4 Engine-Choice-Varianten pro Tupel (NEU REV 5 K3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
