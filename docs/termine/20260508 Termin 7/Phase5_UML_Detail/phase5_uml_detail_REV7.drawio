  <diagram id="U03" name="U03 Strategy-Familie + ICacheStrategy + Iteratoren">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rev7stamp" value="REV7 Stand 2026-05-15 / V31.F / K-H Konsolidierungs-Sprint - siehe Tab REV7-Master fuer Snapshot" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="U03 UML - Saeule A Strategy-Familie + ICacheStrategy + Iteratoren-Familie (vollstaendige Klassen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="ISearchPagesStrategy/Pattern/Strategy + ICacheStrategy Visitor (3 visit-Slots) + 3 Pflicht-Iteratoren" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ispsl" value="«concept» ISearchPagesStrategy&lt;SPS&gt;&#xa;━━━━━━━ Attribute (protected) ━━━━━━━&#xa;# structure_ : ISearchPageStructureContainer&amp;&#xa;# pattern_ : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ on_insert_request(key : K, value : V) : OpResult&#xa;+ on_remove_request(key : K) : OpResult&#xa;+ on_consolidation_barrier(event : Event&amp;) : void&#xa;+ on_capacity_exceeded(page : ISearchPage&amp;) : void&#xa;+ get_target_page(key : K) const : ISearchPage&amp;&#xa;+ pattern() const : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━ Constraint K3.4 REV 5 ━━━━━━━&#xa;inv: 1 pro IFanout (eindeutig)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="760" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ispspat" value="«concept» ISearchPagesStrategyPattern&lt;SSP&gt;&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- per_page_strategies_ : map&lt;PageId, ISearchPageStrategy&amp;&gt;&#xa;- pattern_kind_ : PatternKind&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ assign_strategy(page : PageId, strat : ISearchPageStrategy&amp;)&#xa;+ strategy_for(page : PageId) const : ISearchPageStrategy&amp;&#xa;+ kind() const : PatternKind&#xa;+ visit_assignments(visitor : auto&amp;&amp;) const : void&#xa;━━━━━━━ PatternKind enum (10 Komposition + 6 Adapt + 5 Aufbau) ━━━━━━━&#xa;AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold |&#xa;DynamicRebalance | HierarchicalFractal |&#xa;OrthogonalRuntimeParametrized | MultiStrategyOrchestration |&#xa;HeterogeneousAdaptive | BoundaryNodePartition | ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="780" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ispssing" value="«concept» ISearchPageStrategy&lt;SP&gt;&#xa;━━━━━━━ Attribute (protected) ━━━━━━━&#xa;# owning_page_ : ISearchPage&amp;&#xa;# layout_invariants_ : LayoutInvariantSet&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ insert_into(slot : Slot, key : K, value : V) : OpResult&#xa;+ remove_from(slot : Slot) : OpResult&#xa;+ should_split() const noexcept : bool&#xa;+ should_merge_with(other : ISearchPage&amp;) const : bool&#xa;+ check_invariants() const : bool&#xa;━━━━━━━ Constraint K3.4 ━━━━━━━&#xa;inv: 1 pro ISearchPage; ISearchPagesStrategyPattern hat N davon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1620" y="160" width="740" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ics" value="«concept, visitor» ICacheStrategy&lt;CS&gt;&#xa;━━━━━━━ Methoden (public) ━━━━━━━&#xa;+ visit(read_op : PageReadOp&amp;) : void&#xa;+ visit(write_op : PageWriteOp&amp;) : void&#xa;+ visit(layout_op : PageLayoutOp&amp;) : void  ★ NEU REV 4/5 ★&#xa;━━━━━━━ Konkretisierungen ━━━━━━━&#xa;A) BaseEngineStrategy (Baseline F15) - StaticEngine-Pfad ohne CacheEngine&#xa;B) CacheEngineStrategy (CacheEngine-aktiv) - mit ILivePlatformModel + IHeuristic&#xa;━━━━━━━ Permutationsdimension (NEU REV 5 K3) ━━━━━━━&#xa;CacheEngineBuilder erzeugt 4 Build-Varianten:&#xa;V1 BaseEngine | V2 CacheEngine+Static | V3 CacheEngine+Warmup | V4 CacheEngine+Adaptive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1130" height="380" as="geometry" />
        </mxCell>
        <mxCell id="iter" value="Iteratoren-Familie (Pflicht REV 5)&#xa;━━━━━━━ Concept-Iteratoren ━━━━━━━&#xa;«concept» INodeIterator&lt;NI&gt;&#xa;  + byte_at() / next() / done() / current()&#xa;«concept» ISearchPageIterator&lt;SI&gt;&#xa;  + page_at() / next_page() / range_advance(steps)&#xa;«concept» ISearchPageStrategyIterator&lt;SSI&gt;&#xa;  + strategy_at() / next_strategy() / cross_algorithm_permutation()&#xa;━━━━━━━ class comdare::prt_art&lt;K, V&gt; (vollstaendig) ━━━━━━━&#xa;+ iterator (mutable forward) operator++ / operator* / operator-&gt;&#xa;+ const_iterator + reverse_iterator + const_reverse_iterator&#xa;+ range_iterator (lex-Modus, getrange-Semantik aus Masstree)&#xa;+ key_iterator + value_iterator + prefix_iterator (NEU REV 5)&#xa;+ begin / end / cbegin / cend / rbegin / rend / crbegin / crend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="580" width="1170" height="380" as="geometry" />
        </mxCell>
        <mxCell id="modes" value="3 Iterator-Semantik-Modi (Termin 2)&#xa;━━━━━━━&#xa;Default-Modus           : keine garantierte Enumerationsreihenfolge (nur Punkt-Suche)&#xa;Lokaler Ordnungsmodus   : geordnete Eintraege innerhalb einer Seite/Knotengruppe&#xa;Lex-Modus               : global lexikographisch (Prefix Enumeration + Range)&#xa;━━━━━━━&#xa;User-Direktive: &#39;Iterator wird in all unseren Arbeiten immer vollstaendig implementiert&#39;&#xa;=&gt; beide Richtungen (asc + desc) + custom Modus (Termin 2 API-Entscheidung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="2320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ispsl" target="ispspat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ispspat" target="ispssing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="U04" name="U04 Hybrid-Command Klassen">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
