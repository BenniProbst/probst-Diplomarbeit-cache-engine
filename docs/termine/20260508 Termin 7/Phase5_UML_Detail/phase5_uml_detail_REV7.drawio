        <mxCell id="legend" value="LEGENDE REV 5&#xa;Hellblau = Engine-Schicht (Ebene 1)&#xa;Hellgruen = Saeule A Suchalgorithmus (Ebene 2)&#xa;Lila = Saeule B CacheEngine + Plattform-Modell (Ebene 3)&#xa;Pfeile = Konsumiert / Optimiert via&#xa;NEU REV 5: ISearchPageStructure + ISearchPageStructureInterpreter,&#xa;28 fehlende Saeule-B-Concepts, ICacheStrategy als Permutationsdimension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1">
