          <mxGeometry x="1700" y="0" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t" value="U05 UML - Saeule B Plattform-Probe + IPlatformPropertyClassifier + ICacheEngineOptionPublisher" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="vollstaendige Klassen-Definitionen mit Variablen + Methoden + 5-Schritt-Pflichtsequenz" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ipp" value="«concept» IPlatformProbe&#xa;━━━━━━━ Methoden (public abstract) ━━━━━━━&#xa;Discover-Phase:&#xa;+ discover_cache_topology() : ICacheTopology&#xa;+ discover_core_layout() : ICoreLayout&#xa;+ discover_isa_features() : IIsaFeatureSet&#xa;+ discover_interconnect() : IBusTopology&#xa;━━━━━━━ Measure-Phase ━━━━━━━&#xa;+ measure_cache_latencies() : map&lt;TierPair, Cycles&gt;&#xa;+ measure_bandwidths() : map&lt;InterconnectId, Gbps&gt;&#xa;+ measure_cache_coherence_cost() : CoherenceCostFunction&#xa;+ measure_pinning_effects() : map&lt;PinningPolicy, Speedup&gt;&#xa;━━━━━━━ NEU REV 5 ━━━━━━━&#xa;+ measure_branch_predictor_cost() : Cycles&#xa;+ measure_tlb_effects() : TlbProfile&#xa;+ probe_storage_medium() : StorageMediumKind" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="780" height="500" as="geometry" />
        </mxCell>
        <mxCell id="ippc" value="«concept» IPlatformPropertyClassifier&#xa;━━━━━━━ Methoden ━━━━━━━&#xa;+ classify(probe_results : ProbeResults const&amp;) : PlatformPropertySet&#xa;━━━━━━━ PlatformPropertySet (REV 5 erweitert auf 14 Properties) ━━━━━━━&#xa;has_asymmetric_l3 : bool&#xa;has_hybrid_cores : bool&#xa;has_hbm_tier : bool&#xa;preferred_pinning : PinningPolicy&#xa;usable_simd_width : int&#xa;has_software_prefetch : bool&#xa;coherence_cost_threshold : double&#xa;━━━━━━━ NEU REV 5 ━━━━━━━&#xa;branch_predictor : BranchPredictorModel (24-Cycle vs 14-Cycle Mispredict)&#xa;has_bmi2_pext_pdep : bool&#xa;primary_storage : StorageMediumKind (DRAM/NVRAM)&#xa;page_cache_model : PageCacheModel&#xa;memory_channels : int (DDR5-Bandwidth-Modell)&#xa;has_3d_v_cache : bool (Block AO Ryzen 9950X3D)&#xa;has_intel_thread_director : bool (Block AO i9-14900KS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="800" height="500" as="geometry" />
        </mxCell>
        <mxCell id="iceop" value="«concept» ICacheEngineOptionPublisher&#xa;━━━━━━━ Attribute (private) ━━━━━━━&#xa;- properties_ : PlatformPropertySet&#xa;- registered_modules_ : vector&lt;PermutationModule*&gt;&#xa;━━━━━━━ Methoden (public abstract) ━━━━━━━&#xa;+ register_module(module : PermutationModule&amp;) : void&#xa;+ unregister_module(module : PermutationModule&amp;) : void&#xa;+ publish_options_to_all() : void&#xa;+ filter_options_for(module : PermutationModule&amp;) : OptionSet&#xa;+ properties() const : PlatformPropertySet const&amp;&#xa;━━━━━━━ Mechanik ━━━━━━━&#xa;Jede Permutation erhaelt nur die Optionen, die ihre&#xa;Bausteine tatsaechlich konsumieren koennen&#xa;(compile-time-gefiltert via Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1660" y="160" width="700" height="500" as="geometry" />
        </mxCell>
        <mxCell id="schritte" value="5-Schritt-Pflicht-Sequenz (CacheEngineBuilder, REV 5)&#xa;━━━━━━━&#xa;1. DISCOVER  - probe.discover_*()                          (statisch via CPUID/sysfs/hwloc)&#xa;2. MEASURE   - probe.measure_*() + neue REV 5 measure_*()  (Mikrobenchmark)&#xa;3. CLASSIFY  - classifier.classify(probe_results)          (-&gt; PlatformPropertySet 14 Properties)&#xa;4. PUBLISH   - publisher.register_module + publish_options_to_all()&#xa;5. BIND      - pro Permutation entscheidet ICacheStrategy (Visitor) was konsumiert wird&#xa;━━━━━━━&#xa;Wirkung: CacheEngine ist plattform-agnostisch im Code, plattform-konkret im Verhalten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="2320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ipp" target="ippc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ippc" target="iceop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
