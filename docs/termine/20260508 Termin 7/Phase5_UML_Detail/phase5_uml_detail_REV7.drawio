        <mxCell id="sub" value="Trennungs-Prinzip: Engine konsumiert CacheEngine - Strategien wissen nichts direkt von CPU/Caches" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="EBENE 1 - IExecutingEngine (Wurzel-Abstraktion)&#xa;ISearchEngine | IFutureEngine&#xa;konsumiert CacheEngine als Optimierungs-Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=14;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="1200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="EBENE 2 - Suchalgorithmus-Datenstruktur (Saeule A)&#xa;IPage / IRootPage / IFanout / INode / ISearchPage / ISearchPageStructure (NEU REV 5)&#xa;ISearchPageStructureInterpreter (NEU REV 5) / ICachePage / ICacheStrategy (Visitor)&#xa;ISearchPagesStrategy (1 pro IFanout) / ISearchPagesStrategyPattern / ISearchPageStrategy&#xa;IStrategyCommand / HybridCompositionCommand / Iteratoren-Familie (3 Pflicht)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="2160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="EBENE 3 - CacheEngine + Plattform-Modell (Saeule B)&#xa;IPlatformProbe (Auto-Discovery 5 Schritte) / IPlatformPropertyClassifier / ICacheEngineOptionPublisher&#xa;ICacheLevel / ICacheLine / ICacheTopology / ICacheResidency / ICpuCore / ICoreLayout / IPinningPolicy / IInterconnect / IBusTopology&#xa;NEU REV 5: IRankSelectPrimitive / IBranchPredictorModel / IBitManipulationFeatureGate / IStorageMedium / IPageCacheModel / IConcurrencyProtocol&#xa;IRebuildScheduler / IRebuildCostModel / IWorkloadModel / ICellProbeModel vs IWordProbeModel / IPositionalAddressing / ITopologyEncoding (28 NEUE Concepts)&#xa;ILivePlatformModel / ILiveCpuModel / IScheduler / IHeuristic (~80-85 Heuristiken) / DecisionLambdaTrees" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="720" width="2160" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="e1" target="e2">
          <mxGeometry relative="1" as="geometry" />
