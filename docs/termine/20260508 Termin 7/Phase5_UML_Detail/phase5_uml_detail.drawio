  <diagram id="03_telemetry" name="03 Telemetry (Achse 11 NEU 2026-05-09)">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_tel" value="03 Telemetry-Collection-Strategy (Achse 11 NEU 2026-05-09 — Kuehn-Erkenntnisse)&#xa;Quelle: P28 Kuehn-Mailverlauf 2026-05-08; Glossar v7 BLOCK AI-AN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FCE4EC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="its" value="«concept» ITelemetryStrategy&lt;T&gt;&#xa;━━━━━━━&#xa;orthogonal zu Achse 10 (Mess-Kategorie):&#xa;Achse 10 = WAS gemessen wird&#xa;Achse 11 = WIE Telemetrie erfasst wird" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pernode" value="«WARNING» PerNodeCounter&#xa;━━━━━━━&#xa;Quelle: P28 Original-Paper&#xa;Cache-Coherence-Anti-Pattern (Block AI)&#xa;━━━━━━━&#xa;requires NotInTopLevels&#xa;DecisionTree: CacheCoherenceDetectionTree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=#B71C1C;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leafonly" value="LeafOnlyCounter&#xa;━━━━━━━&#xa;Quelle: P28 Kuehn 2026-05-08 (NEU, NICHT im Paper!)&#xa;Counter NUR in Blatt-Knoten&#xa;━━━━━━━&#xa;requires Companion&lt;RetroactiveAggregation&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leafsamp" value="LeafOnlySampledCounter&lt;N&gt;&#xa;━━━━━━━&#xa;Quelle: P28 Kuehn 2026-05-08 (NEU, NICHT im Paper!)&#xa;Sampling-Variante: jeder N-te Zugriff zaehlt&#xa;━━━━━━━&#xa;Parameter N: 1 / 100 / 1000 (default) / 10000&#xa;DecisionTree: SamplingRateAdjustmentTree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="retro" value="«barrier» RetroactiveAggregation&#xa;━━━━━━━&#xa;Quelle: P28 Kuehn 2026-05-08 (NEU)&#xa;Wurzel-Up-Traversal vor Reordering&#xa;Single-Threaded BARRIERE-Phase&#xa;━━━━━━━&#xa;trigger: ConsolidationBarrierEvent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1160" y="280" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pathread" value="PathReadCounter&#xa;━━━━━━━&#xa;Quelle: P26 Zhang FGCS 2024&#xa;Read-Counter pro Block, Hot-Path-Detection&#xa;━━━━━━━&#xa;DecisionTree: HotPathRecognitionTree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="probhint" value="«comdare eigen» ProbabilityHintsHeader&#xa;━━━━━━━&#xa;Quelle: PRT-ART eigen (T4-Designentscheidung)&#xa;Quantisierte Wahrscheinlichkeits-Sketches im Page-Header&#xa;━━━━━━━&#xa;Bit-Layout: F1 Build-Flag (16 oder 32 bit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="460" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="caw_box" value="«CoherenceAwareWriteDecisionTree» (Block AN)&#xa;━━━━━━━&#xa;cost_cache_coherence = f(node_depth, num_cores_sharing,&#xa;                          write_freq, cache_line_size)&#xa;━━━━━━━&#xa;SKIP: Per-Node-Updates an Wurzelnaehe unter Multi-Core&#xa;DELAY: Reordering bis ConsolidationBarrier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="460" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="permbank" value="PermutationFlags.telemetry_bank (NEU 2026-05-09)&#xa;━━━━━━━&#xa;ConstraintFilter:&#xa;LeafOnlyCounter ⇒ RetroactiveAggregation (Abhaengigkeit)&#xa;PerNodeCounter + Multi-Core ⇒ WARNING (Cache-Coherence-Anti-Pattern)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#FFE0B2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="460" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="tel_e1" style="endArrow=block;endFill=0;html=1;dashed=1;" edge="1" parent="1" source="pernode" target="its">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tel_e2" style="endArrow=block;endFill=0;html=1;dashed=1;" edge="1" parent="1" source="leafonly" target="its">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tel_e3" style="endArrow=block;endFill=0;html=1;dashed=1;" edge="1" parent="1" source="leafsamp" target="its">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tel_e4" style="endArrow=block;endFill=0;html=1;dashed=1;" edge="1" parent="1" source="pathread" target="its">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tel_e5" style="endArrow=block;endFill=0;html=1;dashed=1;" edge="1" parent="1" source="probhint" target="its">
