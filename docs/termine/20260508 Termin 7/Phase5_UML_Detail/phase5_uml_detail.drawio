  <diagram id="04_measurement" name="04 Measurement (Achse 10, F1, F-EXTRA-7)">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_m" value="04 Measurement — F1 constexpr Mess-Spezialisierung pro (Mess-Kategorie x Algo-Detail)&#xa;F-EXTRA-7 Default-Hooks + Algo-spezifische Overrides via requires HasMeasurement" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1820" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cat" value="«enum» MeasurementCategory&#xa;━━━━━━━&#xa;CLU&#xa;CACHE_MISS_L1 / L2 / L3&#xa;DTLB_MISS&#xa;BRANCH_MISS&#xa;LATENCY_MEAN / P50 / P95 / P99 / P999&#xa;THROUGHPUT&#xa;ENERGY_J&#xa;FILL_BUFFER_OCCUPANCY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="det" value="«enum» AlgoDetail&#xa;━━━━━━━&#xa;ART_NODE4/16/48/256&#xa;HOT_COMPOUND_K32 / BINODE&#xa;MASSTREE_INTERNAL / BORDER&#xa;COCO_MACRONODE&#xa;START_MULTIBYTE&#xa;B2TREE_DECISION / SPAN&#xa;SURF_LOUDS_DENSE / SPARSE&#xa;PRTART_*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="280" height="220" as="geometry" />
        </mxCell>

        <mxCell id="measure" value="«template constexpr»&#xa;Measure&lt;Cat, Detail&gt;&#xa;━━━━━━━&#xa;+ at_lookup_begin(ctx) noexcept&#xa;+ at_lookup_end(ctx) noexcept&#xa;+ at_node_visit(ref, ctx) noexcept&#xa;+ extract() noexcept : double&#xa;━━━━━━━&#xa;Default-Hook (no-op) + Spezialisierungen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="hasmeasconcept" value="«concept»&#xa;HasMeasurement&lt;Algo, Cat&gt;&#xa;━━━━━━━&#xa;Compile-Time-Filter:&#xa;aktiviert nur Mess-Kategorien,&#xa;die der Algo unterstuetzt&#xa;━━━━━━━&#xa;requires { Measure&lt;Cat, AlgoDetailFor&lt;Algo&gt;&gt;::at_node_visit }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="hooks" value="MeasurementHooks (F11)&#xa;━━━━━━━&#xa;trigger : CONTINUOUS | SAMPLED_1_N&#xa;sample_n : size_t = 1000 (default Production)&#xa;━━━━━━━&#xa;+ maybe_record(record) inline noexcept&#xa;━━━━━━━&#xa;Builder-Modus → CONTINUOUS&#xa;Production-Modus → SAMPLED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1440" y="120" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="ctx" value="Context (thread_local)&#xa;━━━━━━━&#xa;cache_lines_used / cache_misses_l1/l2/l3&#xa;dtlb_misses / branch_misses&#xa;lookup_start_ns / lookup_end_ns" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="example" value="Beispiel: Measure&lt;CLU, ART_NODE256&gt;::at_node_visit&#xa;━━━━━━━&#xa;ctx.cache_lines_used += unodb::node256_used_bytes(ref) / 64;&#xa;━━━━━━━&#xa;Bit-genaue Berechnung der effektiv genutzten Bytes — algo-spezifisch (F-EXTRA-7)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#FFF9C4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="500" height="120" as="geometry" />
        </mxCell>

        <mxCell id="m_e1" style="endArrow=open;startArrow=none;html=1;" edge="1" parent="1" source="measure" target="cat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e2" style="endArrow=open;startArrow=none;html=1;" edge="1" parent="1" source="measure" target="det">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e3" style="endArrow=open;startArrow=none;html=1;dashed=1;" edge="1" parent="1" source="hasmeasconcept" target="measure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e4" style="endArrow=open;startArrow=none;html=1;" edge="1" parent="1" source="hooks" target="measure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m_e5" style="endArrow=diamondThin;endFill=0;startArrow=none;html=1;" edge="1" parent="1" source="measure" target="ctx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="05_hardware_isa" name="05 Hardware/ISA + Block AO">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_h" value="05 Hardware/ISA — F4 Permutationsraum + ISA-Filter, F9 Compile/Runtime ISA-Detection, F10-K Flag-System (CPUID-Vorbild)&#xa;Block AO: Production-Plattform (Ryzen 9950X3D + i9-14900KS, 64 GB DDR5-5600 CL36)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="probe" value="PlatformProbe (F9)&#xa;━━━━━━━&#xa;+ detect() : PlatformProfile&#xa;Compile-Time + Runtime-Modus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="PlatformProfile&#xa;━━━━━━━&#xa;cpu_model : string&#xa;cpu_class : enum&#xa;cache_topology : CacheTopology&#xa;isa_features : IsaFlagBank&#xa;cores_layout : CoreLayout&#xa;memory_latency_cycles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="ryzen" value="«extends» RyzenX3DProbe&#xa;━━━━━━━&#xa;ccd_count : 2&#xa;v_cache_ccd : CCD0 (96 MiB L3)&#xa;standard_ccd : CCD1 (32 MiB L3)&#xa;━━━━━━━&#xa;+ recommend_pinning() : V_CACHE_CCD&#xa;━━━━━━━&#xa;Block AO Production-Plattform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="intel" value="«extends» IntelHybridProbe&#xa;━━━━━━━&#xa;p_core_count : 8&#xa;e_core_count : 16&#xa;━━━━━━━&#xa;+ recommend_pinning() : P_CORE&#xa;+ perf_event_separation() : true&#xa;cpu_core/* vs cpu_atom/*&#xa;━━━━━━━&#xa;Block AO Production-Plattform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="permflags" value="«struct value, F10-K» PermutationFlags&#xa;━━━━━━━&#xa;page_bank : uint64_t&#xa;node_bank : uint64_t&#xa;traversal_bank : uint64_t&#xa;value_handle_bank : uint64_t&#xa;memory_layout_bank : uint64_t&#xa;allocator_bank : uint64_t&#xa;prefetch_bank : uint64_t&#xa;concurrency_bank : uint64_t&#xa;isa_bank : uint64_t&#xa;telemetry_bank : uint64_t  (NEU 2026-05-09)&#xa;━━━━━━━&#xa;+ to_identifier() : string_view&#xa;+ is_valid_combination() : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="380" height="280" as="geometry" />
