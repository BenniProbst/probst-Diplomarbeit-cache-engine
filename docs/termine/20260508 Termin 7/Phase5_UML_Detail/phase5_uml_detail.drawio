  <diagram id="06_engine_choice_builder" name="06 Engine Choice + Builder">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_b" value="06 Engine Choice + CacheEngineBuilder — F12-K Heap-Singleton im Builder-Prozess; F-EXTRA-1 Compiler-Layering; F-EXTRA-5 NO-PYTHON" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="builder" value="«orchestrator, main» CacheEngineBuilder&#xa;━━━━━━━&#xa;F12: lebt als main.cpp-Prozess (Binary pro Plattform)&#xa;F12-K: enthaelt CacheEngine als Heap-Singleton&#xa;━━━━━━━&#xa;+ run() : ExitCode&#xa;+ scan_modules() : vector&lt;ModuleSpec&gt;&#xa;+ build_missing_modules() : void&#xa;+ run_single_experiment(spec) : Result&#xa;+ run_all_permutations() : vector&lt;Result&gt;&#xa;+ set_mode(mode : CacheEngineMode) : void&#xa;━━━━━━━&#xa;Block AP — Modes:&#xa;HEURISTIC_STATIC | INFORMED_KALIBRIERT | AUTOMATIC_ADAPTIVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="420" height="280" as="geometry" />
        </mxCell>

        <mxCell id="ce_ref" value="CacheEngine&#xa;(Heap-Singleton)&#xa;━━━━━━━&#xa;siehe Tab 02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="modreg" value="ModulePermutationRegistry&#xa;━━━━━━━&#xa;registry : map&lt;PermutationFlags, ModuleSpec&gt;&#xa;module_root : path&#xa;━━━━━━━&#xa;+ scan_modules()&#xa;+ identify_missing()&#xa;+ register(spec)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="540" y="220" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="codegen" value="«NO PYTHON» CMakeShBatCodegenDriver (F-EXTRA-5 REVIDIERT durch H6)&#xa;━━━━━━━&#xa;codegen_cmake : tools/permutation_codegen/codegen.cmake&#xa;codegen_sh    : tools/permutation_codegen/codegen.sh&#xa;codegen_bat   : tools/permutation_codegen/codegen.bat&#xa;━━━━━━━&#xa;+ invoke(target, output_dir) : ExitCode&#xa;+ verify_synchronization() : bool&#xa;━━━━━━━&#xa;inv: KEIN Python (Talos-OS-Kompatibilitaet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="420" height="200" as="geometry" />
        </mxCell>

        <mxCell id="static_ec" value="StaticEngineChoice (Production)&#xa;━━━━━━━&#xa;ABI-stabil; std::map-API&#xa;━━━━━━━&#xa;+ at(key) / operator[]&#xa;+ insert / find / erase&#xa;+ verify_abi(expected) : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1320" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cache_ec" value="CacheEngineChoice (Experimental)&#xa;━━━━━━━&#xa;CacheEngine aktiv, DecisionTrees, Adaptation&#xa;━━━━━━━&#xa;+ run_in_mode(mode) : ExperimentResult" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1680" y="120" width="320" height="160" as="geometry" />
        </mxCell>

        <mxCell id="layer1" value="«C++23 Schale» ModulWrapperC23&#xa;━━━━━━━&#xa;Concept-Bindungen, Adapter, ABI-Interface&#xa;Compiler: GCC 14+ / Clang 17+ / MSVC 19.39+" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="420" height="100" as="geometry" />
