        <mxCell id="layer2" value="«Original-Compiler» BausteinInternal (F-EXTRA-1)&#xa;━━━━━━━&#xa;P01 GCC 4.7+/10+   P02 GCC 5+ (BMI2/AVX2)&#xa;P03 GCC 4.6+        P04 GCC 11+ (C++20)&#xa;P05 GCC 7+          P06a/b GCC 9+&#xa;P07 GCC 7+ (SSE4.2/CRC)  P10 g++ -mpopcnt&#xa;P25 GCC 11+         P29 GCC 4+ (LGPL)&#xa;━━━━━━━&#xa;Habich-Direktive: Originalcode EXAKT KOPIERT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="layer3" value="«StaticLinker»&#xa;━━━━━━━&#xa;Schale + Internals → ABI-stabiles .so/.dll/.dylib&#xa;Pro Permutation eine Modul-Datei" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1080" y="500" width="380" height="100" as="geometry" />
