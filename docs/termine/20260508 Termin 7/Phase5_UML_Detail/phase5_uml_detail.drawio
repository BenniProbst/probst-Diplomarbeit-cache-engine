        <mxCell id="constraint" value="ConstraintFilter (F4 compile-time)&#xa;━━━━━━━&#xa;is_consistent(flags) : constexpr bool&#xa;━━━━━━━&#xa;Beispiele:&#xa; • AVX-512 ⇒ Target X86_AVX512F&#xa; • NEON ⇒ ARM&#xa; • LeafOnlyCounter ⇒ RetroactiveAggregation (Block AJ)&#xa; • Page-Type/Node-Type Kompatibilitaet&#xa; • B2Tree-Page ⇒ MEMORY_EMBEDDED_TREE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57C00;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
