        <mxCell id="isabank" value="comdare::flags::IsaBank (Auswahl)&#xa;━━━━━━━&#xa;SCALAR_X86_64 = 1ULL &lt;&lt; 0&#xa;X86_SSE4_2    = 1ULL &lt;&lt; 4&#xa;X86_AVX2      = 1ULL &lt;&lt; 5&#xa;X86_AVX512F   = 1ULL &lt;&lt; 6&#xa;X86_BMI2      = 1ULL &lt;&lt; 7&#xa;ARM_NEON      = 1ULL &lt;&lt; 8&#xa;ARM_SVE2      = 1ULL &lt;&lt; 10&#xa;RISCV_V       = 1ULL &lt;&lt; 11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
