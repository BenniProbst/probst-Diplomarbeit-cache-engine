        <mxCell id="artef" value="BuildArtefact (PK: artefact_id)&#xa;━━━━━━━&#xa;module_id (FK)&#xa;binary_path&#xa;binary_size_bytes&#xa;binary_sha256&#xa;abi_signature  (F-EXTRA-8)&#xa;main_compiler / bauteil_compilers : JSONB&#xa;build_timestamp&#xa;abi_test_status (BIT_IDENTICAL | FUNCTIONAL | DIVERGENT)&#xa;habich_log_path  (bei DIVERGENT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6D4C41;strokeColor=#3E2723;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
