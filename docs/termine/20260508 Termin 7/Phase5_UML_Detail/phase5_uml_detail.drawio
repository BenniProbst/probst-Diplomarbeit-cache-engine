  <diagram id="02_cache_engine" name="02 Cache Engine">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_ce" value="02 Cache Engine — F1 Heap-Singleton + F2 Push synchron + F6 ConcurrencyManager + F-EXTRA-6 DecisionLambdaTrees PRO Baustein&#xa;F12-K: lebt im CacheEngineBuilder-Prozess als globale Variable" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cacheengine" value="«singleton, heap-allocated» CacheEngine&#xa;━━━━━━━━━━━━━━━&#xa;- instance_ptr_ : unique_ptr&#xa;- initialize_once_ : once_flag&#xa;━━━━━━━━━━━━━━━&#xa;+ static instance() : CacheEngine&amp;&#xa;+ notify(event) : void  «inline noexcept»&#xa;+ reset_state() : void&#xa;+ warm_up_for_module(...)&#xa;+ bind_loaded_module(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="cm" value="«singleton» ConcurrencyManager&#xa;━━━━━━━&#xa;Policy-Template-Komposition&#xa;8 Disziplinen + 3 Mechaniken (F6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dlr" value="DecisionLambdaTreeRegistry&#xa;━━━━━━━&#xa;trees_per_module : map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="imb" value="InMemoryMeasurementBuffer (F5)&#xa;━━━━━━━&#xa;append-only, lock-free pro Thread" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="orr" value="ObserverRegistry (F2)&#xa;━━━━━━━&#xa;synchroner Push + Lambda-Tree-Filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chm" value="CacheHierarchyManager (F4)&#xa;━━━━━━━&#xa;HBM/V-Cache/DIMM Hybrid (Block AO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#303F9F;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="idlt" value="«abstract» IDecisionLambdaTree&lt;EventT, DecisionClassT&gt;&#xa;━━━━━━━&#xa;enum Decision : EXECUTE | DELAY | SKIP&#xa;━━━━━━━&#xa;+ evaluate(event, ctx) : Decision  «noexcept»&#xa;+ configure(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t_pgrelo" value="PageRelocationTree&lt;PageT&gt;&#xa;Lambda: load_factor + cache_coherence_cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_pgtype" value="PageTypeChangeTree&lt;PageT&gt;&#xa;Node4 → Node16 → 48 → 256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="450" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_pref" value="PrefetchAdjustmentTree&lt;TraversalT&gt;&#xa;adaptive Prefetch-Distanz (P23)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_hot" value="HotPathRecognitionTree&lt;TraversalT&gt;&#xa;Read-Counter-Threshold (P26)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="450" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_alloc" value="AllocatorRebalanceTree&lt;AllocatorT&gt;&#xa;Pool ↔ Arena ↔ HBM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1100" y="380" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_csw" value="ConcurrencyDisciplineSwitchTree&#xa;OLC ↔ ROWEX ↔ RCU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1100" y="450" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_vh" value="ValueHandleSelectionTree&#xa;switch_array Auswahl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1400" y="380" width="280" height="60" as="geometry" />
