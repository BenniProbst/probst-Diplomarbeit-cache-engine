  <diagram id="U05" name="U05 Saeule B Plattform-Probe + Auto-Discovery">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U05 UML - Saeule B Plattform-Probe + IPlatformPropertyClassifier + ICacheEngineOptionPublisher" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="vollstaendige Klassen-Definitionen mit Variablen + Methoden + 5-Schritt-Pflichtsequenz" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ipp" value="«concept» IPlatformProbe&#10;━━━━━━━ Methoden (public abstract) ━━━━━━━&#10;Discover-Phase:&#10;+ discover_cache_topology() : ICacheTopology&#10;+ discover_core_layout() : ICoreLayout&#10;+ discover_isa_features() : IIsaFeatureSet&#10;+ discover_interconnect() : IBusTopology&#10;━━━━━━━ Measure-Phase ━━━━━━━&#10;+ measure_cache_latencies() : map&lt;TierPair, Cycles&gt;&#10;+ measure_bandwidths() : map&lt;InterconnectId, Gbps&gt;&#10;+ measure_cache_coherence_cost() : CoherenceCostFunction&#10;+ measure_pinning_effects() : map&lt;PinningPolicy, Speedup&gt;&#10;━━━━━━━ NEU REV 5 ━━━━━━━&#10;+ measure_branch_predictor_cost() : Cycles&#10;+ measure_tlb_effects() : TlbProfile&#10;+ probe_storage_medium() : StorageMediumKind" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="780" height="500" as="geometry"/></mxCell>
        <mxCell id="ippc" value="«concept» IPlatformPropertyClassifier&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ classify(probe_results : ProbeResults const&amp;) : PlatformPropertySet&#10;━━━━━━━ PlatformPropertySet (REV 5 erweitert auf 14 Properties) ━━━━━━━&#10;has_asymmetric_l3 : bool&#10;has_hybrid_cores : bool&#10;has_hbm_tier : bool&#10;preferred_pinning : PinningPolicy&#10;usable_simd_width : int&#10;has_software_prefetch : bool&#10;coherence_cost_threshold : double&#10;━━━━━━━ NEU REV 5 ━━━━━━━&#10;branch_predictor : BranchPredictorModel (24-Cycle vs 14-Cycle Mispredict)&#10;has_bmi2_pext_pdep : bool&#10;primary_storage : StorageMediumKind (DRAM/NVRAM)&#10;page_cache_model : PageCacheModel&#10;memory_channels : int (DDR5-Bandwidth-Modell)&#10;has_3d_v_cache : bool (Block AO Ryzen 9950X3D)&#10;has_intel_thread_director : bool (Block AO i9-14900KS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="160" width="800" height="500" as="geometry"/></mxCell>
        <mxCell id="iceop" value="«concept» ICacheEngineOptionPublisher&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- properties_ : PlatformPropertySet&#10;- registered_modules_ : vector&lt;PermutationModule*&gt;&#10;━━━━━━━ Methoden (public abstract) ━━━━━━━&#10;+ register_module(module : PermutationModule&amp;) : void&#10;+ unregister_module(module : PermutationModule&amp;) : void&#10;+ publish_options_to_all() : void&#10;+ filter_options_for(module : PermutationModule&amp;) : OptionSet&#10;+ properties() const : PlatformPropertySet const&amp;&#10;━━━━━━━ Mechanik ━━━━━━━&#10;Jede Permutation erhaelt nur die Optionen, die ihre&#10;Bausteine tatsaechlich konsumieren koennen&#10;(compile-time-gefiltert via Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1660" y="160" width="700" height="500" as="geometry"/></mxCell>
        <mxCell id="schritte" value="5-Schritt-Pflicht-Sequenz (CacheEngineBuilder, REV 5)&#10;━━━━━━━&#10;1. DISCOVER  - probe.discover_*()                          (statisch via CPUID/sysfs/hwloc)&#10;2. MEASURE   - probe.measure_*() + neue REV 5 measure_*()  (Mikrobenchmark)&#10;3. CLASSIFY  - classifier.classify(probe_results)          (-&gt; PlatformPropertySet 14 Properties)&#10;4. PUBLISH   - publisher.register_module + publish_options_to_all()&#10;5. BIND      - pro Permutation entscheidet ICacheStrategy (Visitor) was konsumiert wird&#10;━━━━━━━&#10;Wirkung: CacheEngine ist plattform-agnostisch im Code, plattform-konkret im Verhalten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="2320" height="240" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ipp" target="ippc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ippc" target="iceop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U06" name="U06 Saeule B Cache + IHeuristic + 28 Concepts">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U06 UML - Saeule B Cache-Hierarchie + IHeuristic + 28 NEU REV 5 Concepts" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="vollstaendige Klassen + Cluster-Uebersicht der ~80-85 Heuristiken + 28 fehlende Concepts integriert" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iclevel" value="«concept» ICacheLevel&lt;L&gt;&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ size_bytes : size_t&#10;+ line_size_bytes : size_t (typ. 64, 256 ARM A64FX)&#10;+ associativity : int&#10;+ latency_cycles : double&#10;+ bandwidth_gbps : double&#10;+ tier_kind : enum L1 / L2 / L3 / HBM / V_CACHE&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ effective_capacity() : size_t&#10;+ measured_at(timestamp) : MeasureSnapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="700" height="280" as="geometry"/></mxCell>
        <mxCell id="ictopo" value="«concept» ICacheTopology&lt;CT&gt;&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- levels_ : vector&lt;ICacheLevel&amp;&gt;&#10;- per_ccd_ : map&lt;CcdId, ICacheLevel&amp;&gt;&#10;- asymmetric_l3_ : bool (Auto-discovered)&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ levels() const : span&lt;ICacheLevel const&amp;&gt;&#10;+ level_count() const noexcept : size_t&#10;+ has_asymmetric_l3() const noexcept : bool&#10;+ largest_l3_ccd() const : optional&lt;CcdId&gt;&#10;+ tier_for(ptr : void*) : optional&lt;TierKind&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="780" height="280" as="geometry"/></mxCell>
        <mxCell id="icres" value="«concept» ICacheResidency&lt;CR&gt;&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ residency_of(page : ICachePage&amp;) : ResidencyKind&#10;+ track_access(page : ICachePage&amp;) : void&#10;+ track_eviction(page : ICachePage&amp;) : void&#10;+ pinning_hint_for(page : ICachePage&amp;) : optional&lt;TierKind&gt;&#10;+ snapshot() : ResidencyMap&#10;━━━━━━━ ResidencyKind enum ━━━━━━━&#10;Cached | HeaderCached | Uncached | Evicted | Pinned" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1600" y="160" width="760" height="280" as="geometry"/></mxCell>
        <mxCell id="iheur" value="«concept» IHeuristic&lt;H&gt; (REV 5 erweitert)&#10;━━━━━━━ Attribute (protected) ━━━━━━━&#10;# live_model_ : ILivePlatformModel&amp;&#10;# property_set_ : PlatformPropertySet const&amp;&#10;━━━━━━━ Methoden (public abstract) ━━━━━━━&#10;+ recommend(input : HeuristicInput const&amp;) : Recommendation&#10;+ estimated_value(input : HeuristicInput const&amp;) const : double&#10;+ confidence() const noexcept : double  (0.0-1.0) ★ NEU REV 4/5 ★&#10;+ heuristic_kind() const noexcept : HeuristicKind&#10;━━━━━━━ Konkretisierungen (~80-85 in 8 Clustern aus K09) ━━━━━━━&#10;C1 Layout-Selection (19) - AdaptiveLayoutSelection P01, DataAwareCollapsing P04, ProbabilityWeightedRootBlock P16, ...&#10;C2 Cost-Modell (12) - CacheCostDP P05, OptimalNodeSize P13, OptimalWidthMultiTier P22, ...&#10;C3 AdaptivePrefetch (8) - AdaptivePrefetchDistance P23, StrideVsSequential P32, ...&#10;C4-C8 (siehe K09)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="neu1" value="28 NEU REV 5 Concepts (Teil 1: Hardware + Memory)&#10;━━━━━━━&#10;«concept» IRankSelectPrimitive (P09/P10/P04)&#10;«concept» IModelAcquisitionStrategy (P05)&#10;«concept» IVirtualMemoryStrategy (P05 Rewiring)&#10;«concept» IBranchPredictorModel (P01/P13)&#10;«concept» IBitManipulationFeatureGate (P02 HOT)&#10;«concept» IStorageMedium (P10 SuRF, P22)&#10;«concept» IPageCacheModel (P10 SuRF)&#10;«concept» IConcurrencyProtocol (Saeule C)&#10;«concept» IRebuildScheduler (P05)&#10;«concept» IRebuildCostModel (P04)&#10;«concept» IWorkloadModel (P05 future)&#10;«concept» ICellProbeModel vs IWordProbeModel (P09)&#10;«concept» IPositionalCorrespondencePrefetch (P10)&#10;«concept» ICacheConflictModel (P18)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="neu2" value="28 NEU REV 5 Concepts (Teil 2: ISA + Memory-Decorator + Encoding)&#10;━━━━━━━&#10;«concept» ITemporalCacheStrategy (P15)&#10;«concept» IIntelligentDMA (P31 iDMA)&#10;«concept» IComputeOffload (P31)&#10;«concept» IHardwareExtension Sub-Hierarchie (P31)&#10;«concept» IMemoryDecorator NFP (P33 VAMPIR)&#10;«concept» IHeterogeneousAllocator V-malloc (P33)&#10;«concept» IMigrationPolicy (P33)&#10;«concept» ICompileTimeNegotiator (P33)&#10;«concept» IPipelineScheduler (P33)&#10;«concept» IAccessPatternStrategy (P32)&#10;«concept» IPaddingStrategy (P32)&#10;«concept» IInformationTheoreticLowerBound (P09)&#10;«concept» IPositionalAddressing (P09)&#10;«concept» ITopologyEncoding (LOUDS/DFUDS/BP/Pointer/BitArray)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="900" width="1140" height="380" as="geometry"/></mxCell>
