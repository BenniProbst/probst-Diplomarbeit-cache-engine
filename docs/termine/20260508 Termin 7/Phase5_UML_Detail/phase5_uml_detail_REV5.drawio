        <mxCell id="t" value="K10 KONZEPT - 29 Cache-Strategie-Familien F1-F29 + 12 NEUE Hybrid-Aufloesungen (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="REV 5 fix User-Kritik 2026-05-11: 8 fehlende Hybrid-Layouts (F8/F11/F13/F14/F22/F25/F27/F28) als Command-Pattern aufgeloest" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="g_layout" value="LAYOUT-Familien (F1-F8)&#10;━━━━━━━&#10;F1  IAdaptiveFootprintStrategy (P01/P02/P05/P12/P14/P20/P28) HYBRID&#10;F2  ISuccinctEncodingStrategy (P09/P04/P10/P11/P12/P14) HYBRID&#10;F3  ICacheLineAlignedStrategy (P01/P02/P07/P11/P12/P14/P15/P32) atomar&#10;F4  IMultiCacheLineNodeStrategy (P03/P13/P21/P22) HYBRID&#10;F5  ISoftwarePrefetchStrategy (P02/P03/P10/P14/P15/P21/P22/P25/P26/P27) HYBRID&#10;F6  IPointerChasingResolutionStrategy (P21/P22/P26) HYBRID&#10;F7  ISimdAcceleratedLookupStrategy (P01/P02/P03/P10/P20/P31) atomar&#10;F8  IPathCollapseStrategy (P01/P02/P04/P05/P06/P07/P08) HYBRID NEU §10.21" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="780" height="280" as="geometry"/></mxCell>
        <mxCell id="g_pref" value="ENCODING + PREFETCH-Familien (F9-F14)&#10;━━━━━━━&#10;F9  ILayerDependentEncodingStrategy (P02/P05/P10/P20/P28) TEILWEISE HYBRID&#10;F10 IPointerTagDispatchStrategy (P01/P02/P05/P07) atomar&#10;F11 IEmbeddedSecondaryIndexStrategy (P06/P07/P11/P22/P26) HYBRID NEU §10.22-§10.24&#10;F12 IIndirectionVectorStrategy (P03/P06/P07/P15/P20) atomar&#10;F13 ICacheObliviousLayoutStrategy (P16/P17/P18/P22) HYBRID NEU §10.25&#10;F14 ICacheSensitiveMultiLevelLayoutStrategy (P18/P19/P28) HYBRID NEU §10.26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="160" width="780" height="280" as="geometry"/></mxCell>
        <mxCell id="g_compare" value="VERGLEICH-Familie (F15) - HERZSTUECK&#10;━━━━━━━&#10;F15 IProbabilityWeightedLayoutStrategy (P16/P28) HERZSTUECK F15&#10;━━━━━━━&#10;PRT-ART staedtet F15 als Forschungsstrategie:&#10;- vergleicht die anderen 28 Familien systematisch&#10;- BaseEngineStrategy = ohne CacheEngine&#10;- CacheEngineStrategy = mit Plattform-Heuristiken&#10;- 4 Engine-Choice-Varianten pro Tupel (NEU REV 5 K3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1640" y="160" width="720" height="280" as="geometry"/></mxCell>
        <mxCell id="g_node" value="NODE-Familien (F16-F19)&#10;━━━━━━━&#10;F16 ICompressionStrategy (P15/P20/P28) atomar&#10;F17 IPoorMansNormalizedKeyStrategy (P15/P20/P28) atomar&#10;F18 INoSharedWriteStrategy (P03/P08/P29/P30) atomar&#10;F19 IHotColdLayerEncodingStrategy / IFilterStrategy (P10) atomar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="780" height="240" as="geometry"/></mxCell>
        <mxCell id="g_sync" value="CONCURRENCY-Familien (F20-F25)&#10;━━━━━━━&#10;F20 IBlockOrientedRankSelectStrategy (P09/P10/P04) atomar&#10;F21 IVirtualMemoryRewiringStrategy (P05) atomar&#10;F22 ICodeSpecializationStrategy (P11/P12/P14/P23) HYBRID NEU §10.27+§10.28&#10;F23 IAdaptiveRuntimePrefetchDistanceStrategy (P23/P25) HYBRID&#10;F24 ITelemetryDrivenStrategy (P26/P27/P28/P28-Mail) HYBRID&#10;F25 ISyncMechanikenStrategy (P03/P06/P07/P08/P29/P30/P02) HYBRID NEU §10.29+§10.30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="460" width="780" height="240" as="geometry"/></mxCell>
        <mxCell id="g_pin" value="TELEMETRIE-Familien (F26-F29)&#10;━━━━━━━&#10;F26 IStrideAccessPatternStrategy (P32 TUD) atomar&#10;F27 INfpDecoratorStrategy (P33 VAMPIR + P25 + P22) HYBRID NEU §10.31&#10;F28 IHardwareOffloadStrategy (P31 Ungethuem TUD iDMA) HYBRID NEU §10.32&#10;F29 IFilterStrategy (P10 SuRF) atomar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1640" y="460" width="720" height="240" as="geometry"/></mxCell>
        <mxCell id="hybrid_neu" value="NEU REV 5 - 12 fehlende Hybrid-Aufloesungen (User-Kritik 2026-05-11 zu K10)&#10;━━━━━━━&#10;§10.21  F8 PathCollapse                P02 HOT k-constrained + P04 CoCo Macro+DP + P05 START Multilevel&#10;        Atome: KConstrainedPartitioning + MacroNodeCollapse + DataAwareCollapseDP + MultilevelCollapse&#10;        -&gt; PathCollapseFamilyCompositionCommand&#10;§10.22  F11 EmbeddedSecondaryIndex P11  CSS Embedded Directory&#10;        Atome: EmbeddedDirectory + PartialPointer  -&gt; CSSEmbeddedDirectoryCompositionCommand&#10;§10.23  F11 EmbeddedSecondaryIndex P22  Chen Fractal in-page B+&#10;        Atome: InPageBPlus + MicroIndexing  -&gt; FractalInPageBPlusCompositionCommand&#10;§10.24  F11 EmbeddedSecondaryIndex P26  Zhang PathPrefetcher + SearchBlockTable&#10;        Atome: PathPrefetcher + SearchBlockTable  -&gt; ZhangSearchBlockTableCompositionCommand&#10;§10.25  F13 CacheObliviousLayout P17    vEB + DynamicVEB + PackedMemoryArray + BufferNodes + Indirected&#10;        Atome: VEBClassic + DynamicVEBPma + BufferNodesVEB + IndirectedVEB  -&gt; VEBLayoutVariantCompositionCommand&#10;§10.26  F14 CacheSensitiveMultiLevel P18 MultiLevelCacheSensitive + AliasingCorrection&#10;        Atome: MultiLevelCacheSensitive + AliasingCorrection  -&gt; SaikkonenMultiLevelCompositionCommand&#10;§10.27  F22 CodeSpecialization P12      basic + uniform + variable&#10;        Atome: BasicCSB + UniformCSB + VariableCSB  -&gt; CSBCodeVariantsCompositionCommand&#10;§10.28  F22 CodeSpecialization P23      Khan TemplateSpecializer 2-5 Modify-Locations&#10;        Atome: TemplateSpecializer + ModifyLocation[1-5]  -&gt; KhanTemplateSpecializerCompositionCommand&#10;§10.29  F25 SyncMechaniken P07          Wormhole RCU + RW-Lock + MutEx&#10;        Atome: Class1Rcu + Class2RWLock + Class3MutEx  -&gt; WormholeTripleConcurrencyCompositionCommand&#10;§10.30  F25 SyncMechaniken P08          ART OLC + ROWEX&#10;        Atome: OLC + ROWEX  -&gt; ARTSyncVariantCompositionCommand&#10;§10.31  F27 NfpDecorator P33            VAMPIR NFP-Decorator + V-malloc + Compensation + Migration&#10;        Atome: NfpDecorator + VMalloc + Compensation + Migration  -&gt; VampirNfpCompositionCommand&#10;§10.32  F28 HardwareOffload P31         iDMA Configurator + AGU + DataFetcher + Crawler&#10;        Atome: IdmaConfigurator + IdmaAgu + IdmaDataFetcher + IdmaCrawler  -&gt; UngethuemIdmaCompositionCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="2320" height="540" as="geometry"/></mxCell>
        <mxCell id="hint_F15" value="REGEL: F15 ist KEINE Disziplin - F15 ist die VERGLEICHS-FUNKTION ueber alle anderen Familien.&#10;Phase 7 instanziiert F15 systematisch fuer alle 4-Tupel x 4 Engine-Choice-Varianten.&#10;Permutations-Raum erweitert sich um 12 weitere Atom-Sets x Composition-Variants (REV 5 NEU)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="2320" height="120" as="geometry"/></mxCell>
