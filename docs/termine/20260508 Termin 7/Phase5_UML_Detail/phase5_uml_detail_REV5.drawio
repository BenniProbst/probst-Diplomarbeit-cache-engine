  </diagram>

  <diagram id="K07a" name="K07a Discover-Phase Atoms">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07a KONZEPT - IPlatformProbe DISCOVER-Phase (Sub-Split aus K07, REV 5.3)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Schritt 1 von 5 - Statische Plattform-Erkennung ueber CPUID/sysfs/hwloc/ProcCpuinfo. ALLE Discover-Atoms aus 33 Papern + Standard-Tools." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="g_static" value="STATISCHE DISCOVER-ATOMS (Hardware-Identitaet aus OS/CPU-Registern)&#10;━━━━━━━&#10;CpuidProbeAtom              - x86 CPUID-Instruction (Vendor, Family, Model, Stepping, Cache-Level-Sizes)&#10;SysfsProbeAtom               - Linux /sys/devices/system/cpu/ (Topologie, Core-IDs, Cache-Sharing)&#10;HwlocProbeAtom               - libhwloc Portable Topology (NUMA-Nodes, Bindings, Affinity-Masks)&#10;ProcCpuinfoProbeAtom         - Linux /proc/cpuinfo (Flags, Frequency, Model-Name)&#10;CpuFeaturesProbeAtom         - cpu_features library (gcc __builtin_cpu_supports + ARM HWCAP)&#10;DmidecodeProbeAtom           - SMBIOS DMI Tables (Memory-Channels, DIMM-Specs, Package-Layout)&#10;LscpuProbeAtom               - util-linux lscpu (komplette CPU-Spec)&#10;SysconfPageSizeProbeAtom     - sysconf(_SC_PAGESIZE) + sysconf(_SC_LEVEL1_DCACHE_LINESIZE)&#10;LikwidProbeAtom              - LIKWID likwid-topology (HPC-Tool fuer Cache-Topologie)&#10;ProcMeminfoProbeAtom         - /proc/meminfo (HugePages-Verfuegbarkeit, Memory-Ebenen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2320" height="320" as="geometry"/></mxCell>
        <mxCell id="g_topo" value="TOPOLOGIE-DISCOVER (Cache + Core + Bus Auto-Discovery)&#10;━━━━━━━&#10;DiscoverCacheTopologyAtom    - L1/L2/L3/HBM/V-Cache Hierarchie + Sharing-Domains (Quelle: hwloc + CPUID-Leaf-04)&#10;DiscoverCoreLayoutAtom       - Anzahl Sockets/CCDs/Cores, P-vs-E-Cores, SMT-Siblings (Quelle: sysfs/hwloc)&#10;DiscoverIsaFeaturesAtom      - AVX-512/AVX2/SSE/BMI2/NEON/SVE2/RISC-V V-Ext (Quelle: CPUID + cpu_features)&#10;DiscoverInterconnectAtom     - NUMA-Distance-Matrix, Inter-CCD-Latency (Quelle: hwloc + numactl)&#10;DiscoverMemoryHierarchyAtom  - DRAM/HBM/NVRAM/CXL Ebenen (Quelle: hwloc + dmidecode)&#10;DiscoverHugePagesAtom        - 2 MiB / 1 GiB Page-Sizes verfuegbar (Quelle: /proc/meminfo + /sys/kernel/mm/hugepages/)&#10;DiscoverNvramTierAtom         - Persistent Memory Detection (Quelle: ndctl + libpmem)&#10;DiscoverHbmTierAtom          - HBM-Bandwidth-Ebene (Quelle: hwloc-info NUMA-Type=HBM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="2320" height="280" as="geometry"/></mxCell>
        <mxCell id="g_cpu" value="CPU-FEATURE-DISCOVER (Hardware-Erweiterungen)&#10;━━━━━━━&#10;HasAvx512Atom         - AVX-512 inkl. F/CD/ER/PF/BW/DQ/VL Subsets (P02 HOT, P10 SuRF, P32 To-Stride)&#10;HasAvx2Atom            - AVX2 + FMA (P02 HOT default, P10 Sparse-Filter)&#10;HasBmi2Atom            - BMI2 PEXT/PDEP fuer HOT Single/Multi-Mask (P02 HOT)&#10;HasPopcntAtom         - POPCNT fuer rank/select (P09 LOUDS, P10 SuRF, P04 CoCo)&#10;HasCrc32cAtom         - SSE4.2 CRC32C fuer Hash-Anchors (P07 Wormhole)&#10;HasSveAtom             - ARM SVE / SVE2 mit dynamischer Vector-Length (P32 To-Stride future)&#10;HasNeonAtom            - ARM NEON 128-Bit (P10 SuRF, P02 HOT cross-platform)&#10;HasRiscvVAtom          - RISC-V V-Extension (P32 future, dynamische Vector-Length)&#10;HasAmxAtom             - Intel AMX (Sapphire Rapids, beobachtbar in Block AO)&#10;HasIntelThreadDirectorAtom - Intel Thread Director Hint (Block AO i9-14900KS)&#10;Has3dVCacheAtom       - AMD 3D V-Cache Detection (Block AO Ryzen 9 9950X3D)&#10;HasHbmAtom              - HBM2/HBM3/LPDDR5X (P25 Mahling, P33 VAMPIR, Grace Hopper)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="hint_paper" value="PAPER-MAPPING (welche Discover-Atoms aus welchen Papern):&#10;━━━━━━━&#10;P05 START: ClflushNodeProbe (gehoert zu K07b Measure), CpuidProbe + DiscoverCacheTopology fuer Cost-Modell&#10;P13 Hankins/Patel: DiscoverCacheTopology + HasPopcnt fuer Cardenas-Formel&#10;P15 Graefe Survey: alle Topologie-Atoms (B-Trees-of-Cache-Lines)&#10;P25 Mahling: DiscoverHbmTier + DiscoverNvramTier fuer Multi-Ebenen-Allocation&#10;P28 Kuehn: DiscoverCoreLayout + HasIntelThreadDirector fuer Hot-Path-Layout&#10;P31 Ungethuem: HasAmx + DiscoverInterconnect fuer iDMA-Detection&#10;P32 To-Stride: HasAvx512 + HasSve fuer Stride-Pattern-Selection&#10;P33 VAMPIR: DiscoverHbmTier + DiscoverNvramTier + DiscoverInterconnect&#10;━━━━━━━&#10;OUTPUT: ProbeResults Struct mit allen Discover-Werten -&gt; an K07b MEASURE weitergereicht" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="2320" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K07b" name="K07b Measure-Phase Atoms">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07b KONZEPT - IPlatformProbe MEASURE-Phase (Mikrobenchmark-Atoms)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Schritt 2 von 5 - Aktive Vermessung der Plattform-Eigenschaften mit Mikrobenchmarks. ALLE Measure-Atoms aus den 33 Papern." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="g_lat" value="LATENZ-MESSUNGS-ATOMS (CPU-Cache + Memory-Hierarchie)&#10;━━━━━━━&#10;ClflushCycleMeasureAtom        - clflush + rdtsc-Schleife pro Ebenen-Paar (P05 START)&#10;CacheLineLatencyAtom           - L1/L2/L3-Hit + Memory-Miss-Latenz in Cycles (P13 Hankins/Patel, P32)&#10;TlbMissLatencyAtom              - DTLB-Miss + STLB-Miss Cycles (P13 Eq.18, P32 To-Stride)&#10;BranchMispredictLatencyAtom   - Branch-Mispredict Cycles (Pipeline-Flush-Cost, P13 Eq.16)&#10;CacheCoherenceCostAtom         - Inter-Socket-Coherence-Cost-Funktion (P28 Block AN, P03 Masstree)&#10;PointerChasingLatencyAtom     - dependent-load Latenz fuer Pointer-Chasing (P21 Chen, P22 Fractal)&#10;DDR5RefreshLatencyAtom         - Refresh-Cycle-Effekte (Block AO DDR5-5600, P32)&#10;NumaLocalRemoteRatioAtom      - local/remote NUMA-Latenz-Verhaeltnis (P25/P29/P32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2320" height="280" as="geometry"/></mxCell>
        <mxCell id="g_bw" value="BANDBREITEN-MESSUNGS-ATOMS&#10;━━━━━━━&#10;StreamBenchmarkAtom            - STREAM Triad/Copy/Add/Scale (Memory-Bandwidth, klassisch)&#10;McCalpinBandwidthAtom          - McCalpin pro NUMA-Node (P25 Mahling Multi-Ebenen)&#10;HbmBandwidthAtom               - HBM2/HBM3/LPDDR5X Peak-Bandwidth (P25 Grace, P33 VAMPIR)&#10;PerInterconnectBandwidthAtom  - CCD-CCD, Core-Cache, Cache-Memory, NUMA, PCIe, NVLink (P31)&#10;BurstLengthMeasureAtom         - DRAM Burst-Length (P31 Ungethuem)&#10;MshrCapacityAtom               - Miss-Status-Holding-Register Tiefe (P25 Mahling FB_FULL)&#10;PrefetcherStreamLimitAtom     - Hardware-Prefetcher Stream-Limit pro Generation (P32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="2320" height="240" as="geometry"/></mxCell>
        <mxCell id="g_pin" value="PINNING-EFFEKT-MESSUNG (All-Pairs-Pinning Mikrobenchmark)&#10;━━━━━━━&#10;AllPairsPinningProbeAtom        - Cross-Core-Latenz vermessen (P25, P32)&#10;CcdPinningEffectAtom           - CCD-Bound vs CCD-Migrate Performance (Block AO Ryzen 9 9950X3D)&#10;PEHybridPinningEffectAtom     - P-Core vs E-Core Performance pro Workload (Block AO i9-14900KS)&#10;HighIpcCorePinningAtom         - Cores mit hoeherem IPC bevorzugen (allgemeine Heuristik)&#10;LargestL3CcdPinningAtom        - CCD mit groesstem L3 bevorzugen (allgemein, ehemals X3D)&#10;FirstTouchPolicyMeasureAtom   - Linux first-touch Effekt vermessen (P28 Kuehn)&#10;SimdThroughputProbeAtom        - SIMD-Throughput pro ISA-Variante (Empfehlung)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="2320" height="240" as="geometry"/></mxCell>
        <mxCell id="g_telemetry" value="TELEMETRY-COUNTER-MESSUNG (Hardware-Performance-Counter Setup)&#10;━━━━━━━&#10;PerfmonReaderAtom               - perfmon-Tool-Counter-Reader (P12 CSB+)&#10;PapiReaderAtom                  - PAPI library counter API (P13 Hankins/Patel)&#10;VTuneReaderAtom                 - Intel VTune (P28 Kuehn)&#10;PmuSamplerAtom                  - Linux perf event_open + ring-buffer (alle Rang 3)&#10;DTLBSTLBCapacityProbeAtom     - DTLB/STLB Capacity-Measurement (P28, P32)&#10;FbFullCounterMeasureAtom        - L1D_PEND_MISS.FB_FULL (Intel-spezifisch, P25)&#10;BranchPredictorRateMeasureAtom - Branch-Mispredict-Rate Sampling (implizit P13)&#10;CacheCoherenceMessageRateAtom - Inter-Socket-Message-Counter (P28 NEU 2026-05-08 Mail)&#10;━━━━━━━&#10;OUTPUT: MeasureResults Struct mit allen Cycle-Werten + Bandwidth-Werten + Pinning-Effekten -&gt; an K07c CLASSIFY weitergereicht" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="2320" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K07c" name="K07c Classify+Publish+PlatformPropertySet">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07c KONZEPT - CLASSIFY + PUBLISH + PlatformPropertySet (14+ Properties)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Schritt 3+4 von 5 - Properties klassifizieren + an Permutations-Module publishen. Alle 14+ Plattform-Properties detailliert." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ippc" value="«concept» IPlatformPropertyClassifier&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ classify(probe : ProbeResults, measure : MeasureResults) : PlatformPropertySet&#10;+ classify_pressure(snap : PlatformSnapshot) : PressureState  (siehe U09)&#10;+ negate_negative_recommendations(workload : WorkloadProfile) : NegativeFilterSet (P24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2320" height="160" as="geometry"/></mxCell>
        <mxCell id="props" value="«struct» PlatformPropertySet (14+ Properties REV 5.3 detailliert)&#10;━━━━━━━ Hardware-Properties (REV 3 + REV 4) ━━━━━━━&#10;has_asymmetric_l3 : bool                  Discovered (Ryzen 9 9950X3D, ehemals X3DAware)&#10;has_hybrid_cores : bool                   Discovered (Intel Hybrid, ehemals IntelHybrid)&#10;has_hbm_tier : bool                       Discovered (Grace Hopper, A64FX)&#10;preferred_pinning : PinningPolicy         Gemessen (LARGEST_L3_CCD / HIGH_IPC_CORES / NUMA_LOCAL / ROUND_ROBIN)&#10;usable_simd_width : int                   Gemessen (128 SSE / 256 AVX2 / 512 AVX-512 / SVE-Length)&#10;has_software_prefetch : bool              Gemessen (PREFETCHT0 verfuegbar + effektiv)&#10;coherence_cost_threshold : double         Gemessen (P28 Block AN)&#10;━━━━━━━ NEUE Properties REV 5 ━━━━━━━&#10;branch_predictor : BranchPredictorModel   Gemessen (24-Cycle vs 14-Cycle Mispredict-Cost)&#10;has_bmi2_pext_pdep : bool                Discovered (BMI2 PEXT/PDEP fuer HOT P02)&#10;primary_storage : StorageMediumKind       Discovered (DRAM/NVRAM)&#10;page_cache_model : PageCacheModel         Discovered (OS-Page-Cache vs App-Cache, P10 SuRF)&#10;memory_channels : int                     Discovered (DDR5-Bandwidth-Modell, Block AO)&#10;has_3d_v_cache : bool                     Discovered (Block AO Ryzen 9 9950X3D)&#10;has_intel_thread_director : bool          Discovered (Block AO i9-14900KS)&#10;━━━━━━━ NEUE Properties REV 5.3 ━━━━━━━&#10;tlb_capacity : TlbCapacity (DTLB/STLB)    Gemessen (P28, P32)&#10;mshr_depth : int                          Gemessen (Mahling P25 FB_FULL)&#10;dram_burst_length : int                  Discovered (P31 Ungethuem)&#10;has_amx : bool                            Discovered (Intel AMX, beobachtbar)&#10;has_riscv_vector : bool                   Discovered (RISC-V V-Ext, future)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="2320" height="640" as="geometry"/></mxCell>
        <mxCell id="iceop" value="«concept» ICacheEngineOptionPublisher (Schritt 4 PUBLISH)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- properties_ : PlatformPropertySet&#10;- registered_modules_ : vector&lt;PermutationModule*&gt;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ register_module(module : PermutationModule&amp;) : void&#10;+ unregister_module(module) : void&#10;+ publish_options_to_all() : void&#10;+ filter_options_for(module) : OptionSet      (compile-time-gefiltert via Concepts)&#10;+ properties() const : PlatformPropertySet const&amp;&#10;━━━━━━━ Mechanik ━━━━━━━&#10;Jede Permutation erhaelt nur die Optionen, die ihre Bausteine konsumieren koennen.&#10;C++23 requires-Klausel filtert Konkretisierungen, die inkompatible Properties haben.&#10;Beispiel: HOT-Multi-Mask braucht has_avx2=true UND has_bmi2_pext_pdep=true." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="2320" height="280" as="geometry"/></mxCell>
        <mxCell id="hint" value="REV 5.3 NEUE PROPERTIES (5 zusaetzlich): tlb_capacity, mshr_depth, dram_burst_length, has_amx, has_riscv_vector. Vermessen in K07b, klassifiziert hier in K07c, publiziert an Permutations-Module via ICacheEngineOptionPublisher." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="2320" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K07d" name="K07d 28 Saeule-B-Concepts detailliert">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07d KONZEPT - 28 NEUE Saeule-B-Concept-Klassen mit Methoden (Detail aus REV 5.1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Vollstaendige Concept-Definitionen aller 28 fehlenden Saeule-B-Klassen (war nur als Liste in K07; jetzt mit Methoden + Konkretisierungen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="grp1" value="Hardware-Probing + Memory-Hierarchie Concepts&#10;━━━━━━━&#10;1.  «concept» IRankSelectPrimitive  -  popcount/Jacobson-Two-Level/Poppy (P09/P10/P04)&#10;     + rank(pos) const : size_t   + select(idx) const : size_t   + popcount(range) const : size_t&#10;2.  «concept» IModelAcquisitionStrategy  -  wie wird ILivePlatformModel gewonnen? (P05)&#10;     + acquire() : ILivePlatformModel   + refresh_period() const : milliseconds   + cost_estimate() const : Cycles&#10;3.  «concept» IVirtualMemoryStrategy  -  DirectMapping/RewiredSharedPages/HugePages (P05 START)&#10;     + map(virtual_addr, physical_addr) : void   + remap(virt, new_phys) : void   + supports_huge_pages() const : bool&#10;4.  «concept» IBranchPredictorModel  -  Mispredict-Cost als Plattform-Kennzahl (P01/P13)&#10;     + mispredict_cycles() const : int   + predict_taken(branch_addr) const : bool&#10;5.  «concept» IBitManipulationFeatureGate  -  BMI2 PEXT/PDEP/popcount + Fallback (P02 HOT)&#10;     + has_pext() const : bool   + has_pdep() const : bool   + fallback_pext(mask, val) : Bits&#10;6.  «concept» IStorageMedium  -  DRAM/NVRAM/SSD/HDD-Hierarchy (P10 SuRF, P22 Fractal)&#10;     + tier_kind() const : StorageMediumKind   + latency_class() const : LatencyClass   + persistence() const : bool&#10;7.  «concept» IPageCacheModel  -  OS Page Cache + App Block Cache 2-stufig (P10 SuRF)&#10;     + os_cache_size() const : size_t   + app_cache_size() const : size_t   + hit_ratio() const : double" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="grp2" value="Concurrency + Scheduling + Workload Concepts&#10;━━━━━━━&#10;8.  «concept» IConcurrencyProtocol  -  eigene Saeule C, orthogonal A/B (P02/P03/P08/P29/P30)&#10;     + protocol_kind() const : ProtocolKind   + acquire(node) : Token   + release(token) : void   + reclaim(node) : void&#10;9.  «concept» IRebuildScheduler  -  VACUUM-aehnliche Trigger (P05 START Self-Tuning)&#10;     + schedule_rebuild(criteria : RebuildCriteria) : Handle   + on_threshold_reached(thresh) : void   + abort(handle) : void&#10;10. «concept» IRebuildCostModel  -  Bauzeit O(N h^2) bei P04 CoCo&#10;     + estimate_rebuild_cost(workload) : Cost   + worth_rebuilding(workload) const : bool&#10;11. «concept» IWorkloadModel  -  Read-Only/Read-Mostly/Write-Heavy/Mixed/Skewed (P05 future)&#10;     + workload_kind() const : WorkloadKind   + read_write_ratio() const : double   + skew_factor() const : double&#10;12. «concept» ICellProbeModel vs IWordProbeModel  -  2 alternative Plattform-Modelle (P09 Jacobson)&#10;     + cell_size() const : size_t   + word_size() const : size_t&#10;13. «concept» IPositionalCorrespondencePrefetch  -  Prefetch via Layout-Invariante (P10 SuRF)&#10;     + position_for(child_idx, parent_pos) : Position   + emit_prefetch(positions) : void&#10;14. «concept» ICacheConflictModel  -  FullAssociative vs SetAssociative (P18 Saikkonen)&#10;     + associativity() const : int   + set_count() const : int   + conflict_probability(addr_a, addr_b) : double" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="grp3" value="ISA-Features + Compute-Offload + Memory-Decorator Concepts&#10;━━━━━━━&#10;15. «concept» ITemporalCacheStrategy  -  Instruction-Cache, P15 Sektion 7&#10;     + has_separate_icache() const : bool   + icache_size() const : size_t   + prefetch_instruction(addr) : void&#10;16. «concept» IIntelligentDMA  -  Configurator/AGU/DataFetcher/Crawler (P31 iDMA)&#10;     + configure(transfer_spec) : Handle   + start(handle) : void   + wait(handle) : void&#10;17. «concept» IComputeOffload  -  PE/iDMA/App-Core/FPGA (P31)&#10;     + offload_target() const : OffloadTarget   + submit(operation) : Future   + cost(operation) : Cycles&#10;18. «concept» IHardwareExtension Sub-Hierarchie  -  WAH/PLWAH/COMPAX, Hash-Lookup, MergeSort (P31 TUD)&#10;     + extension_kind() const : ExtensionKind   + apply(operation, data) : Result   + cost_model() const : CostModel&#10;19. «concept» IMemoryDecorator (NFP)  -  latency/throughput/transience/reliability/wearout (P33 VAMPIR)&#10;     + nfp_properties() const : NfpPropertySet   + decorate(allocation) : DecoratedAllocation&#10;20. «concept» IHeterogeneousAllocator (V-malloc)  -  heterogene Memory-Auswahl (P33)&#10;     + allocate(size, nfp_hint : NfpHint) : void*   + select_tier(nfp_hint) : TierKind&#10;21. «concept» IMigrationPolicy  -  transparente Migration zwischen Ebenen (P33 Compensation)&#10;     + should_migrate(page, target_tier) const : bool   + migrate(page, target_tier) : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="grp4" value="Pipeline + Encoding + Topologie Concepts&#10;━━━━━━━&#10;22. «concept» ICompileTimeNegotiator  -  Multi-Query Compile-Time-Negotiation (P33)&#10;     + negotiate(queries : list&lt;Query&gt;) : NegotiationResult   + select_best_combo() : Combo&#10;23. «concept» IPipelineScheduler  -  Operation-Pipelines mit Memory-Awareness (P33)&#10;     + schedule(pipeline : Pipeline) : Schedule   + memory_aware_reorder(ops) : list&lt;Op&gt;&#10;24. «concept» IAccessPatternStrategy  -  sequential/strided/simd (P32 To-Stride)&#10;     + pattern_kind() const : AccessPatternKind   + recommend_layout(workload) : LayoutHint&#10;25. «concept» IPaddingStrategy  -  576-Byte-Padding fuer Cache-Set-Disalignment (P32)&#10;     + padding_size_bytes() const : size_t   + apply_padding(allocation) : Allocation&#10;26. «concept» IInformationTheoreticLowerBound  -  Optimality-Marker fuer Encoding (P09)&#10;     + lower_bound_bits(structure) const : size_t   + actual_bits(structure) const : size_t   + efficiency() const : double&#10;27. «concept» IPositionalAddressing  -  Implicit Addressing via Position-in-Bitstring (P09)&#10;     + position_to_address(pos) const : address_t   + address_to_position(addr) const : size_t&#10;28. «concept» ITopologyEncoding  -  LOUDS/DFUDS/BP/Pointer/BitArray (orthogonal zu IFanout)&#10;     + encoding_kind() const : TopologyEncodingKind   + encode(tree) : EncodedTree   + decode(encoded) : Tree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="2320" height="380" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08a" name="K08a Cache-Hierarchie Detail">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08a KONZEPT - Cache-Hierarchie Detail (ICacheLevel + ICacheLine + ICacheTopology + ICacheResidency)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Sub-Split aus K08 Plattform-Modell - Vollstaendige Cache-Hierarchie + 33-Paper-Verfeinerungen (NUMA / TLB / NVRAM / Energy)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iclevel" value="«concept» ICacheLevel&lt;L&gt; (vollstaendig)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ tier_kind : enum L1 / L2 / L3 / HBM / V_CACHE / DRAM / NVRAM / SSD&#10;+ size_bytes : size_t&#10;+ line_size_bytes : size_t (typ. 64, 256 ARM A64FX, 128 Apple Silicon)&#10;+ associativity : int (z.B. 8/16/64)&#10;+ ways : int&#10;+ sets : int&#10;+ latency_cycles : double (Hit-Latenz)&#10;+ bandwidth_gbps : double&#10;+ inclusive : bool (inclusive vs exclusive cache)&#10;+ shared_cores : vector&lt;CoreId&gt; (welche Cores teilen)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ effective_capacity() : size_t&#10;+ measured_at(timestamp) : MeasureSnapshot&#10;+ refresh_latency() const : RefreshCycle  (NEU REV 5.3 - DDR5 Refresh-Cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="icline" value="«concept» ICacheLine&lt;CL&gt; (Hardware-Atomic-Transfer)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ size : size_t (PLATTFORM-SPEZIFISCH, NIE hardcoded!)&#10;+ state : enum MESI / MOESI&#10;+ residency : ICacheLevel const&amp;&#10;+ tag : address_t&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ size_bytes() const noexcept : size_t&#10;+ contains(addr : address_t) const noexcept : bool&#10;━━━━━━━ C++17 Plattform-Abstraktion ━━━━━━━&#10;static constexpr size_t destructive_size = std::hardware_destructive_interference_size;&#10;static constexpr size_t constructive_size = std::hardware_constructive_interference_size;&#10;━━━━━━━ Plattform-Werte (Stand 2026) ━━━━━━━&#10;x86-64 (Intel/AMD): 64 B&#10;ARM Cortex-A: 64 B&#10;Apple Silicon (M1-M4): 128 B (P-Cores)&#10;Fujitsu A64FX (Fugaku): 256 B (4-way associativ)&#10;IBM POWER9/POWER10: 128 B (sektoriert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="ictopo" value="«concept» ICacheTopology&lt;CT&gt; (Hierarchie + asymmetric_l3 + per_ccd Map)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- levels_ : vector&lt;ICacheLevel&amp;&gt; (in Hierarchie-Reihenfolge L1-L2-L3-HBM-V_CACHE)&#10;- per_ccd_ : map&lt;CcdId, ICacheLevel&amp;&gt; (Block AO Ryzen 9 9950X3D)&#10;- asymmetric_l3_ : bool (Auto-discovered)&#10;- l3_per_ccd : map&lt;CcdId, size_t&gt; (96+32 MiB bei Ryzen 9 9950X3D)&#10;- numa_local_remote_ratio : double (NEU REV 5.3 - cross-socket cost)&#10;- has_3d_v_cache : bool (NEU REV 5.3 - Block AO)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ levels() const : span&lt;ICacheLevel const&amp;&gt;&#10;+ level_count() const noexcept : size_t&#10;+ has_asymmetric_l3() const noexcept : bool&#10;+ largest_l3_ccd() const : optional&lt;CcdId&gt;&#10;+ tier_for(ptr : void*) : optional&lt;TierKind&gt;&#10;+ cross_ccd_latency(src, dst) const : Cycles  (NEU REV 5.3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="icres" value="«concept» ICacheResidency&lt;CR&gt; (Cache whereabouts)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- residency_map_ : map&lt;ICachePage*, ResidencyKind&gt;&#10;- access_history_ : RingBuffer&lt;AccessRecord&gt; (NEU REV 5.3 - fuer Hot-Path-Detection)&#10;- eviction_log_ : RingBuffer&lt;EvictionRecord&gt;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ residency_of(page : ICachePage&amp;) : ResidencyKind&#10;+ track_access(page : ICachePage&amp;) : void&#10;+ track_eviction(page : ICachePage&amp;) : void&#10;+ pinning_hint_for(page : ICachePage&amp;) : optional&lt;TierKind&gt;&#10;+ snapshot() : ResidencyMap&#10;+ hot_pages() const : vector&lt;ICachePage*&gt; (NEU REV 5.3 P28 Hot-Path)&#10;━━━━━━━ ResidencyKind enum ━━━━━━━&#10;Cached | HeaderCached | Uncached | Evicted | Pinned | Migrated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="paper_verf" value="33-PAPER-VERFEINERUNGEN fuer Cache-Hierarchie (REV 5.1+5.3 Adapter)&#10;━━━━━━━&#10;P05 START: ClflushNodeProbe + LatencyProbe -&gt; ICacheLevel.latency_cycles + cache_topology Discovery&#10;P10 SuRF: 2-stufige PageCacheModel (OS + App) -&gt; IPageCacheModel orthogonal&#10;P13 Hankins/Patel: TLB-Aware-Sizing -&gt; ITlbModel als eigenes Concept (NEU REV 5)&#10;P22 Chen Fractal: Multi-Ebenen-Cache-Disk -&gt; ICacheTopology mit DRAM+SSD/HDD-Ebenen-Kind&#10;P25 Mahling: HBM2/HBM3/LPDDR5X-Ebene + MSHR-Pressure -&gt; ICacheLevel.tier_kind=HBM + mshr_depth&#10;P28 Kuehn Block AN: Cache-Coherence-Cost-Probe -&gt; ICacheTopology.cross_ccd_latency&#10;P29 RCU: 6-Flavor-RCU (qsbr/mb/membarrier/signal) statt 4 -&gt; IConcurrencyProtocol-Sub-Hierarchie&#10;P31 Ungethuem: iDMA-Configurator -&gt; IIntelligentDMA als eigenes Concept&#10;P32 To-Stride: DTLB/STLB-Capacity-Probe -&gt; ITlbModel.dtlb_size + stlb_size&#10;P33 VAMPIR: NFP-Decorator (latency/throughput/transience) -&gt; IMemoryDecorator als orthogonales Concept&#10;Block AO Ryzen 9 9950X3D: has_3d_v_cache + asymmetric_l3_per_ccd&#10;Block AO i9-14900KS: hybrid_cores + IntelThreadDirector + memory_channels DDR5-5600" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="2320" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08b" name="K08b CPU-Modell + Pinning + NUMA">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08b KONZEPT - CPU-Modell + Pinning + NUMA Detail (Sub-Split aus K08)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Generisches CPU-Modell ohne CPU-Spezialisierung + 33-Paper-NUMA-Verfeinerungen + 6-Flavor-RCU-Klassifikation" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="icpu" value="«concept» ICpuCore&lt;C&gt;&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ core_id : CoreId&#10;+ core_class : enum P_CORE / E_CORE / CCD0_HIGH_L3 / CCD1_LOW_L3 / ARM_A78 / ARM_A55 / RISCV / ...&#10;+ assigned_caches : vector&lt;ICacheLevel*&gt; (welche Cache-Ebenen sieht der Kern?)&#10;+ hyperthreading : optional&lt;HtSibling&gt;&#10;+ ipc_class : double (NEU REV 5.3 - gemessen IPC pro Core-Typ)&#10;+ frequency_max : Hz (NEU REV 5.3 - max Boost-Frequency)&#10;+ thread_director_hint : Optional&lt;PerformanceClass&gt; (NEU REV 5.3 - Intel Hybrid)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ caches() const : span&lt;ICacheLevel const&amp;&gt;&#10;+ has_smt() const noexcept : bool&#10;+ ipc_class() const noexcept : double" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="iclayout" value="«concept» ICoreLayout&lt;CL&gt; (Topologie ohne CPU-Namen)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- cores_ : vector&lt;ICpuCore&amp;&gt;&#10;- p_core_count : int   (Block AO i9 8 P-Cores)&#10;- e_core_count : int   (Block AO i9 16 E-Cores)&#10;- ccd_count : int      (Block AO Ryzen 9 9950X3D 2 CCDs)&#10;- socket_count : int   (Multi-Socket)&#10;- numa_node_count : int&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ cores() const : span&lt;ICpuCore const&amp;&gt;&#10;+ is_hybrid() const noexcept : bool&#10;+ has_asymmetric_l3() const noexcept : bool&#10;+ p_cores() const : vector&lt;ICpuCore*&gt;&#10;+ e_cores() const : vector&lt;ICpuCore*&gt;&#10;+ cores_per_ccd(ccd : CcdId) const : vector&lt;ICpuCore*&gt;&#10;+ cores_per_numa(node : NumaNode) const : vector&lt;ICpuCore*&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="ictm" value="«concept» ICoreToThreadMap&lt;CTM&gt; (Mapping Threads -&gt; Kerne)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- pinning_policy_ : IPinningPolicy&amp;&#10;- current_assignment_ : map&lt;thread::id, CoreId&gt;&#10;- rebalance_trigger_ : ConsolidationBarrierEvent&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ pin_thread(tid : thread::id, core : CoreId) : void&#10;+ unpin_thread(tid : thread::id) : void&#10;+ rebalance() : void&#10;+ assignment_for(tid : thread::id) const : optional&lt;CoreId&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="ipin" value="«concept» IPinningPolicy&lt;P&gt;&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ policy_kind : enum LARGEST_L3_CCD / HIGH_IPC_CORES / NUMA_LOCAL / ROUND_ROBIN / FIRST_TOUCH / NUMACTL_BIND / CROSS_SOCKET_AVOID / PER_CCD_LOCKING&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ pin(thread, layout : ICoreLayout const&amp;) : CoreId&#10;+ rebalance(load : map&lt;CoreId, double&gt;) : Reassignment&#10;━━━━━━━ Konkretisierungen (NEU REV 5.3 - aus 33 Papern) ━━━━━━━&#10;LargestL3CcdPinningPolicy (allgemein, ehemals X3DAware)&#10;HotPathOnHighIpcCorePolicy (allgemein, ehemals IntelHybrid)&#10;NumaLocalPolicy (P25 Mahling)&#10;FirstTouchPolicy (P28 Kuehn)&#10;NumactlBindPolicy (P25/P32)&#10;CrossSocketAvoidancePolicy (P03 Masstree)&#10;PerCcdLockingPolicy (allgemein)&#10;IntelThreadDirectorHintPolicy (Block AO i9-14900KS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="numa_verf" value="NUMA + CONCURRENCY VERFEINERUNGEN REV 5.3 (33-Paper-Code-Adapter)&#10;━━━━━━━&#10;NUMA (vorher schwach modelliert, jetzt durchgaengig):&#10;- Cross-Socket-cost in IPinningPolicy (P25 Mahling)&#10;- NUMA-node-binding via NumactlBindPolicy (P32 To-Stride)&#10;- First-touch-policy als Default (P28 Kuehn)&#10;- numa_local_remote_ratio in ICacheTopology (NEU)&#10;━━━━━━━&#10;6-Flavor-RCU-Klassifikation (statt nur 4 in P29):&#10;- qsbr-RCU (Quiescent State Based, P07 Wormhole)&#10;- mb-RCU (Memory Barrier-based)&#10;- membarrier-RCU (sys_membarrier-based)&#10;- signal-RCU (signal-based)&#10;- preempt-RCU (preemptable, kernel-only)&#10;- tasks-RCU (kernel tasks)&#10;━━━━━━━&#10;Alle als IConcurrencyProtocol-Konkretisierungen (siehe K07d Concept #8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="2320" height="380" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08c" name="K08c Bus + ISA + Hardware-Extensions">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08c KONZEPT - Bus + ISA + Hardware-Extensions Detail" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Inter-Component-Communication + ISA-Feature-Set + Hardware-Erweiterungen + ITlbModel (NEU REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iic" value="«concept» IInterconnect&lt;IC&gt; (Verbindung zwischen Komponenten)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ source : Node*  (CCD/Core/Cache/MemController)&#10;+ target : Node*&#10;+ bandwidth_gbps : double&#10;+ latency_ns : double&#10;+ link_class : enum INTRA_CCD / INTER_CCD / MEMORY_BUS / NUMA_LINK / PCIE / NVLINK / CXL / INFINITY_FABRIC / RING_BUS / MESH&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ effective_bandwidth() const : double&#10;+ is_saturated() const noexcept : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="ibt" value="«concept» IBusTopology&lt;BT&gt;&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- interconnects_ : vector&lt;IInterconnect&amp;&gt;&#10;- inter_chiplet_links : map&lt;CcdPair, IInterconnect*&gt;  (Block AO Ryzen Infinity Fabric)&#10;- intra_cluster_links : map&lt;CorePair, IInterconnect*&gt; (Block AO i9 Ring-Bus)&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ link_between(src : Node*, dst : Node*) : optional&lt;IInterconnect*&gt;&#10;+ shortest_path(src, dst) : vector&lt;IInterconnect*&gt;&#10;+ bottleneck_link() const : optional&lt;IInterconnect*&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="imbm" value="«concept» IMemoryBandwidthModel&lt;MBM&gt;&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- per_link_capacity : map&lt;IInterconnect*, double&gt;&#10;- current_utilization : map&lt;IInterconnect*, double&gt; (Live-Messung via perf)&#10;- bottleneck_detection : function&lt;Bottleneck()&gt;&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ utilization_of(link : IInterconnect&amp;) const : double&#10;+ saturation_threshold() const : double&#10;+ detect_bottleneck() : optional&lt;Bottleneck&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="itlb" value="«concept» ITlbModel (NEU REV 5)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ dtlb_size : int (Data-TLB Eintraege, P28/P32)&#10;+ stlb_size : int (Second-Level-TLB)&#10;+ dtlb_associativity : int&#10;+ has_huge_page_tlb : bool (2 MiB / 1 GiB)&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ effective_capacity() : int&#10;+ miss_cost_cycles() const : int&#10;━━━━━━━ Belegpapiere ━━━━━━━&#10;P13 Hankins/Patel: TLB-Aware-Sizing&#10;P28 Kuehn: TLB-Druck als Hot-Path-Faktor&#10;P32 To-Stride: DTLB/STLB-Capacity-Probe (Mikrobenchmark)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="420" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="ihx" value="«concept» IHardwareExtension&lt;HX&gt; (eine ISA-Feature-Bank)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ feature_name : string  (z.B. AVX-512, BMI2, NEON, SVE2)&#10;+ bit_position : int  (in IsaFlagBank, F10-K)&#10;+ cost_model : map&lt;Operation, Cycles&gt;&#10;+ dependent_features : vector&lt;HardwareExtension*&gt;&#10;+ vendor : enum INTEL / AMD / ARM / RISCV / IBM / FUJITSU&#10;━━━━━━━ NEU REV 5.3 Sub-Hierarchie aus P31 Ungethuem TUD ━━━━━━━&#10;BitmapCompressionExt: WAH / PLWAH / COMPAX&#10;HashLookupExt: Hash / Lookup / Insert / CityHash32 / Sampling&#10;MergeSortExt: MergeSort / Intersection / Union / Difference / SortMergeJoin / SortMergeAggregation&#10;RiscBaseISA-Sub: RV64I / RV64M / RV64C / RV64F&#10;SIMD-Sub: SSE / SSE2 / SSE3 / SSSE3 / SSE4.1 / SSE4.2 / AVX / AVX2 / AVX-512&#10;ARM-Sub: NEON / SVE / SVE2 / Crypto / SHA / FP16&#10;Spezial: SGX / THUMB / AMX / MMX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="iisa" value="«concept» IIsaFeatureSet&lt;IFS&gt; (gesamte ISA-Feature-Verfuegbarkeit)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- extensions_ : vector&lt;IHardwareExtension&amp;&gt;&#10;- x86_features : SseAvxBmiSet&#10;- arm_features : NeonSveSet&#10;- riscv_features : RiscVVSet&#10;- discovered_at : timestamp&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ has_extension(name : string) const : bool&#10;+ has_avx512() const noexcept : bool&#10;+ has_bmi2() const noexcept : bool&#10;+ has_neon() const noexcept : bool&#10;+ has_sve(width : int) const : bool&#10;+ best_simd_width_for(workload : WorkloadKind) const : int&#10;━━━━━━━ Live-Wartung ━━━━━━━&#10;Wird bei jedem CacheEngine-Snapshot abgefragt (~100 ms-Tick).&#10;Compile-Time-Filter via C++23 requires-Klausel (z.B. requires HotInterpreter has_avx2 + has_bmi2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="680" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="hint_isa" value="ISA-FEATURE-MAPPING auf 33 Paper:&#10;P02 HOT: BMI2 PEXT/PDEP + AVX2 (Single/Multi-Mask), Fallback fuer non-BMI2&#10;P10 SuRF: SSE 128-Bit Sparse-Filter, AVX-512 fuer Dense-Filter&#10;P14 Itanium: lfetch.nt1 (Itanium-spezifisch, Legacy)&#10;P25 Mahling: ARM NEON KEEP/STREAM Targets, Coroutine-Variante mit weak/strong Reliability auf A64FX&#10;P31 Ungethuem TUD: WAH/PLWAH/COMPAX Bitmap-Compression, Hash-Lookup, MergeSort auf Tomahawk-PE&#10;P32 To-Stride TUD: AVX-512 + SVE Strided-Pattern, ohne ISA-Feature-Gate scheitert auf 30-42 Partitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="2320" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08d" name="K08d Live-Modell + Block AO + Adapter">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08d KONZEPT - Live-Modell + Block AO Production-Plattform + Plattform-Adapter (5 OFFEN-Punkte)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Echtzeit-Modell + 5 OFFEN-Punkte aus 13_md §10.5 Block AO + ICacheStrategy-Adapter" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ilpm" value="«concept» ILivePlatformModel&lt;LPM&gt; (Echzeit-Modell)&#10;━━━━━━━ Komposition ━━━━━━━&#10;+ cache_topology : ICacheTopology&#10;+ cache_residency : ICacheResidency  (waehrend Lookup-Workload aktualisiert)&#10;+ core_layout : ICoreLayout&#10;+ core_thread_map : ICoreToThreadMap&#10;+ isa_features : IIsaFeatureSet&#10;+ bus_topology : IBusTopology&#10;+ bandwidth_model : IMemoryBandwidthModel&#10;+ tlb_model : ITlbModel  (NEU REV 5)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- update_period : milliseconds  (z.B. 100 ms-Tick)&#10;- update_source : enum PERF_COUNTER / SYSFS / CPUID / PAPI / VTUNE&#10;- snapshot_history : RingBuffer&lt;PlatformSnapshot&gt; (NEU REV 5.3 fuer Trend-Analyse)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ refresh() : void&#10;+ snapshot() const : PlatformSnapshot&#10;+ pressure_state() const : PressureState  (siehe U09 State-Pattern)&#10;+ subscribe(observer) : Token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="ilcm" value="«concept» ILiveCpuModel&lt;LCM&gt; (Live-Sicht auf Per-Core-Lasten)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- per_core_utilization : map&lt;CoreId, double&gt;&#10;- per_core_cache_pressure : map&lt;CoreId, double&gt;&#10;- per_core_hot_path_score : map&lt;CoreId, double&gt;&#10;- per_core_ipc : map&lt;CoreId, double&gt;  (NEU REV 5.3)&#10;- per_core_branch_mispredict_rate : map&lt;CoreId, double&gt;  (NEU REV 5.3)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ utilization_of(core) const : double&#10;+ hot_path_cores() const : vector&lt;CoreId&gt;  (Top-N nach hot_path_score)&#10;+ idle_cores() const : vector&lt;CoreId&gt;  (utilization &lt; threshold)&#10;+ saturated_cores() const : vector&lt;CoreId&gt;  (utilization &gt; threshold)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="block_ao" value="BLOCK AO PRODUCTION-PLATTFORM (5 OFFEN-Punkte aus 13_md §10.5)&#10;━━━━━━━&#10;42. Cache-Coherence-Pressure-Quantifizierung 3D V-Cache (Ryzen 9 9950X3D)&#10;     - keines der 33 Paper modelliert 3D-stacked Cache&#10;     - LOESUNG REV 5.3: ICacheTopology.has_3d_v_cache + cross_ccd_latency() + asymmetric_l3_per_ccd&#10;━━━━━━━&#10;43. P/E-Core-Heterogenitaet i9-14900KS (Hybrid-Architecture)&#10;     - keines der 33 Paper modelliert Hybrid-Architecture&#10;     - LOESUNG REV 5.3: ICpuCore.thread_director_hint + ICoreLayout.is_hybrid() + IPinningPolicy::HotPathOnHighIpcCorePolicy&#10;     - IntelThreadDirector-Integration ist Eigenleistung&#10;━━━━━━━&#10;44. Bandwidth-Aware Layout fuer DDR5-5600 (Multi-Channel + Refresh-Cycle)&#10;     - P31 DDR2 / P32 DDR4/5 nur implizit&#10;     - LOESUNG REV 5.3: ICacheLevel.refresh_latency() + memory_channels in PlatformPropertySet&#10;━━━━━━━&#10;45. Live-Probing der Plattform-Konstanten via CPUID + __cpu_indicator_init&#10;     - kein Paper liefert Code-Template&#10;     - LOESUNG REV 5.3: CpuidProbeAtom + ProcCpuinfoProbeAtom in K07a&#10;━━━━━━━&#10;46. Cross-CCX-Coherence-Latenz Ryzen 9 9950X3D&#10;     - nicht in 33 Papern modelliert&#10;     - LOESUNG REV 5.3: ICacheTopology.cross_ccd_latency(src, dst) + AllPairsPinningProbeAtom in K07b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="adapter" value="ICACHESTRATEGY-ADAPTER (wie ICacheEngine die Live-Daten an ICacheStrategy zurueckgibt)&#10;━━━━━━━&#10;CacheEngineStrategy konsumiert ILivePlatformModel via Visitor-Pattern (siehe U09):&#10;1. ICacheStrategy.visit(read_op) -&gt; ruft engine.advise(RequestContext)&#10;2. ICacheEngine.snapshot() liefert PlatformSnapshot mit Live-Werten&#10;3. ICacheEngine klassifiziert PressureState (Idle/Warmup/Saturated/CoherenceStorm/Recovery)&#10;4. Pipeline ueber 12 Sub-Engines C1-C12 liefert konsolidierte CacheRecommendation&#10;5. CacheRecommendation enthaelt:&#10;   - alloc_hint (Ebenen-Wahl basierend auf has_hbm_tier + bandwidth_model.bottleneck)&#10;   - prefetch_advice (Distance basierend auf cache_topology.latency + tlb_capacity)&#10;   - layout_proposal (Knoten-Geometrie basierend auf cache_line_size + has_3d_v_cache)&#10;   - migration_directive (Ebenen-Wechsel basierend auf hot_path_cores + residency snapshot)&#10;   - pinning_directive (Core-Bindung basierend auf preferred_pinning + hybrid_cores)&#10;━━━━━━━&#10;Wirkung: ICacheStrategy ist plattform-agnostisch im Code, plattform-konkret im Verhalten ueber das Live-Modell." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="2320" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
