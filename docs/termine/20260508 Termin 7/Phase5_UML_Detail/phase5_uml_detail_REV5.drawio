  <diagram id="U03" name="U03 Strategy-Familie + ICacheStrategy + Iteratoren">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U03 UML - Saeule A Strategy-Familie + ICacheStrategy + Iteratoren-Familie (vollstaendige Klassen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="ISearchPagesStrategy/Pattern/Strategy + ICacheStrategy Visitor (3 visit-Slots) + 3 Pflicht-Iteratoren" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ispsl" value="«concept» ISearchPagesStrategy&lt;SPS&gt;&#10;━━━━━━━ Attribute (protected) ━━━━━━━&#10;# structure_ : ISearchPageStructureContainer&amp;&#10;# pattern_ : ISearchPagesStrategyPattern&amp;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ on_insert_request(key : K, value : V) : OpResult&#10;+ on_remove_request(key : K) : OpResult&#10;+ on_consolidation_barrier(event : Event&amp;) : void&#10;+ on_capacity_exceeded(page : ISearchPage&amp;) : void&#10;+ get_target_page(key : K) const : ISearchPage&amp;&#10;+ pattern() const : ISearchPagesStrategyPattern&amp;&#10;━━━━━━━ Constraint K3.4 REV 5 ━━━━━━━&#10;inv: 1 pro IFanout (eindeutig)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="760" height="380" as="geometry"/></mxCell>
        <mxCell id="ispspat" value="«concept» ISearchPagesStrategyPattern&lt;SSP&gt;&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- per_page_strategies_ : map&lt;PageId, ISearchPageStrategy&amp;&gt;&#10;- pattern_kind_ : PatternKind&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ assign_strategy(page : PageId, strat : ISearchPageStrategy&amp;)&#10;+ strategy_for(page : PageId) const : ISearchPageStrategy&amp;&#10;+ kind() const : PatternKind&#10;+ visit_assignments(visitor : auto&amp;&amp;) const : void&#10;━━━━━━━ PatternKind enum (10 Komposition + 6 Adapt + 5 Aufbau) ━━━━━━━&#10;AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold |&#10;DynamicRebalance | HierarchicalFractal |&#10;OrthogonalRuntimeParametrized | MultiStrategyOrchestration |&#10;HeterogeneousAdaptive | BoundaryNodePartition | ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="780" height="380" as="geometry"/></mxCell>
        <mxCell id="ispssing" value="«concept» ISearchPageStrategy&lt;SP&gt;&#10;━━━━━━━ Attribute (protected) ━━━━━━━&#10;# owning_page_ : ISearchPage&amp;&#10;# layout_invariants_ : LayoutInvariantSet&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ insert_into(slot : Slot, key : K, value : V) : OpResult&#10;+ remove_from(slot : Slot) : OpResult&#10;+ should_split() const noexcept : bool&#10;+ should_merge_with(other : ISearchPage&amp;) const : bool&#10;+ check_invariants() const : bool&#10;━━━━━━━ Constraint K3.4 ━━━━━━━&#10;inv: 1 pro ISearchPage; ISearchPagesStrategyPattern hat N davon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1620" y="160" width="740" height="380" as="geometry"/></mxCell>
        <mxCell id="ics" value="«concept, visitor» ICacheStrategy&lt;CS&gt;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ visit(read_op : PageReadOp&amp;) : void&#10;+ visit(write_op : PageWriteOp&amp;) : void&#10;+ visit(layout_op : PageLayoutOp&amp;) : void  ★ NEU REV 4/5 ★&#10;━━━━━━━ Konkretisierungen ━━━━━━━&#10;A) BaseEngineStrategy (Baseline F15) - StaticEngine-Pfad ohne CacheEngine&#10;B) CacheEngineStrategy (CacheEngine-aktiv) - mit ILivePlatformModel + IHeuristic&#10;━━━━━━━ Permutationsdimension (NEU REV 5 K3) ━━━━━━━&#10;CacheEngineBuilder erzeugt 4 Build-Varianten:&#10;V1 BaseEngine | V2 CacheEngine+Static | V3 CacheEngine+Warmup | V4 CacheEngine+Adaptive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1130" height="380" as="geometry"/></mxCell>
        <mxCell id="iter" value="Iteratoren-Familie (Pflicht REV 5)&#10;━━━━━━━ Concept-Iteratoren ━━━━━━━&#10;«concept» INodeIterator&lt;NI&gt;&#10;  + byte_at() / next() / done() / current()&#10;«concept» ISearchPageIterator&lt;SI&gt;&#10;  + page_at() / next_page() / range_advance(steps)&#10;«concept» ISearchPageStrategyIterator&lt;SSI&gt;&#10;  + strategy_at() / next_strategy() / cross_algorithm_permutation()&#10;━━━━━━━ class comdare::prt_art&lt;K, V&gt; (vollstaendig) ━━━━━━━&#10;+ iterator (mutable forward) operator++ / operator* / operator-&gt;&#10;+ const_iterator + reverse_iterator + const_reverse_iterator&#10;+ range_iterator (lex-Modus, getrange-Semantik aus Masstree)&#10;+ key_iterator + value_iterator + prefix_iterator (NEU REV 5)&#10;+ begin / end / cbegin / cend / rbegin / rend / crbegin / crend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="580" width="1170" height="380" as="geometry"/></mxCell>
        <mxCell id="modes" value="3 Iterator-Semantik-Modi (Termin 2)&#10;━━━━━━━&#10;Default-Modus           : keine garantierte Enumerationsreihenfolge (nur Punkt-Suche)&#10;Lokaler Ordnungsmodus   : geordnete Eintraege innerhalb einer Seite/Knotengruppe&#10;Lex-Modus               : global lexikographisch (Prefix Enumeration + Range)&#10;━━━━━━━&#10;User-Direktive: 'Iterator wird in all unseren Arbeiten immer vollstaendig implementiert'&#10;=&gt; beide Richtungen (asc + desc) + custom Modus (Termin 2 API-Entscheidung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="2320" height="180" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ispsl" target="ispspat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ispspat" target="ispssing"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U04" name="U04 Hybrid-Command Klassen">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U04 UML - Hybrid-Command Klassen + 17 Composition-Commands + 5 NEU Aufloesungen REV 5" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="IStrategyCommand + HybridCompositionCommand + ICompositionRule + Beispiel-Atom-Command (HashAnchorLookup)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iscmd" value="«abstract» IStrategyCommand&#10;━━━━━━━ Methoden (public abstract) ━━━━━━━&#10;+ virtual execute(context : StrategyContext&amp;) : Result = 0&#10;+ virtual can_compose_with(other : IStrategyCommand&amp;) const : bool = 0&#10;+ virtual command_kind() const noexcept : CommandKind = 0&#10;+ virtual estimated_cost(context : StrategyContext&amp;) const : Cost = 0&#10;+ virtual ~IStrategyCommand() = default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="900" height="220" as="geometry"/></mxCell>
        <mxCell id="hcc" value="«composite» HybridCompositionCommand : IStrategyCommand&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- parts_ : vector&lt;unique_ptr&lt;IStrategyCommand&gt;&gt;&#10;- composition_rule_ : unique_ptr&lt;ICompositionRule&gt;&#10;- composition_id_ : CompositionId&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ execute(context : StrategyContext&amp;) override : Result&#10;+ add_part(part : unique_ptr&lt;IStrategyCommand&gt;) : void&#10;+ remove_part(idx : size_t) : void&#10;+ part_count() const noexcept : size_t&#10;+ composition_rule() const : ICompositionRule&amp;&#10;+ set_composition_rule(rule : unique_ptr&lt;ICompositionRule&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="800" height="320" as="geometry"/></mxCell>
        <mxCell id="icr" value="«concept» ICompositionRule&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ apply(parts : span&lt;IStrategyCommand*&gt;, ctx : StrategyContext&amp;) : ExecutionPlan&#10;+ rule_kind() const noexcept : RuleKind&#10;+ supports_parallel() const noexcept : bool&#10;━━━━━━━ Konkretisierungen ━━━━━━━&#10;SequentialRule&#10;ParallelRule&#10;ConditionalRule (mit ConditionPredicate)&#10;RecursiveRule (mit DepthLimit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="700" height="320" as="geometry"/></mxCell>
        <mxCell id="atom" value="Atom-Beispiel: HashAnchorLookupCommand : IStrategyCommand (P07 Wormhole)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- anchor_table_ : AnchorTable&amp;&#10;- hash_function_ : HashFn&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ execute(ctx : StrategyContext&amp;) override : Result&#10;+ can_compose_with(other) override : bool&#10;+ command_kind() override : CommandKind::HashAnchor&#10;+ estimated_cost(ctx) override : Cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1660" y="440" width="700" height="320" as="geometry"/></mxCell>
        <mxCell id="comps" value="22 HybridCompositionCommand-Konkretisierungen (17 REV 4 + 5 NEU REV 5)&#10;━━━━━━━ REV 4 (17) ━━━━━━━&#10;01 MasstreeSliceLayered            10 ChenPrefetchedBPlus&#10;02 CutoffLevelLouds                11 HankinsPatelCostModel&#10;03 HOTAdaptiveLayoutSelection      12 ZhangFGCSPointerResolution&#10;04 TripleLayerLookup               13 STARTAdaptive&#10;05 B2TreeRecursiveCommonPrefix     14 KhanRuntimeAdaptive&#10;06 CoCoLevelLDecision              15 SamuelConfigurationTable&#10;07 CoCoEncodingPool                16 BTreesAreBackHeterogeneousAdaptive&#10;08 ThreePrefetcherOrchestration    17 SequentialInsertComposition&#10;09 KuehnHotPathOptimization&#10;━━━━━━━ NEU REV 5 (5 + 12 K10) ━━━━━━━&#10;18 OnEveryStructureModification (S13 P19)&#10;19 PeriodicGlobalRelocation (S14 P18+P19)&#10;20 VEBLayoutVariant (S18 P17)&#10;21 WormholeTripleConcurrency (S30 P07)&#10;22 WormholeDualHashTable (S30 P07)&#10;PLUS 12 NEUE K10 Cache-Familien-Aufloesungen (PathCollapseFamilyComp, CSSEmbeddedDirComp, FractalInPageBPlusComp, ZhangSearchBlockTableComp, VEBLayoutVariantComp, SaikkonenMultiLevelComp, CSBCodeVariantsComp, KhanTemplateSpecializerComp, ARTSyncVariantComp, VampirNfpComp, UngethuemIdmaComp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="2320" height="440" as="geometry"/></mxCell>
