<mxfile host="app.diagrams.net" modified="2026-05-11T00:00:00.000Z" agent="claude-rev5" version="24.0.0" type="device">
  <diagram id="K01" name="K01 Drei-Ebenen-Architektur">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K01 KONZEPT - Drei-Ebenen-Architektur (REV 5 Wurzel-Sicht)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Trennungs-Prinzip: Engine konsumiert CacheEngine - Strategien wissen nichts direkt von CPU/Caches" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" value="EBENE 1 - IExecutingEngine (Wurzel-Abstraktion)&#10;ISearchEngine | IFutureEngine&#10;konsumiert CacheEngine als Optimierungs-Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=14;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="1200" height="120" as="geometry"/></mxCell>
        <mxCell id="e2" value="EBENE 2 - Suchalgorithmus-Datenstruktur (Saeule A)&#10;IPage / IRootPage / IFanout / INode / ISearchPage / ISearchPageStructure (NEU REV 5)&#10;ISearchPageStructureInterpreter (NEU REV 5) / ICachePage / ICacheStrategy (Visitor)&#10;ISearchPagesStrategy (1 pro IFanout) / ISearchPagesStrategyPattern / ISearchPageStrategy&#10;IStrategyCommand / HybridCompositionCommand / Iteratoren-Familie (3 Pflicht)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="2160" height="200" as="geometry"/></mxCell>
        <mxCell id="e3" value="EBENE 3 - CacheEngine + Plattform-Modell (Saeule B)&#10;IPlatformProbe (Auto-Discovery 5 Schritte) / IPlatformPropertyClassifier / ICacheEngineOptionPublisher&#10;ICacheLevel / ICacheLine / ICacheTopology / ICacheResidency / ICpuCore / ICoreLayout / IPinningPolicy / IInterconnect / IBusTopology&#10;NEU REV 5: IRankSelectPrimitive / IBranchPredictorModel / IBitManipulationFeatureGate / IStorageMedium / IPageCacheModel / IConcurrencyProtocol&#10;IRebuildScheduler / IRebuildCostModel / IWorkloadModel / ICellProbeModel vs IWordProbeModel / IPositionalAddressing / ITopologyEncoding (28 NEUE Concepts)&#10;ILivePlatformModel / ILiveCpuModel / IScheduler / IHeuristic (~80-85 Heuristiken) / DecisionLambdaTrees" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="2160" height="280" as="geometry"/></mxCell>
        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1l" value="konsumiert" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="ed1"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed2l" value="optimiert via" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="ed2"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="legend" value="LEGENDE REV 5&#10;Hellblau = Engine-Schicht (Ebene 1)&#10;Hellgruen = Saeule A Suchalgorithmus (Ebene 2)&#10;Lila = Saeule B CacheEngine + Plattform-Modell (Ebene 3)&#10;Pfeile = Konsumiert / Optimiert via&#10;NEU REV 5: ISearchPageStructure + ISearchPageStructureInterpreter,&#10;28 fehlende Saeule-B-Concepts, ICacheStrategy als Permutationsdimension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1100" width="900" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K02" name="K02 3-Schichten Konzept-Strategie-Physisch (REV 5.1)">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K02 KONZEPT - 3-Schichten-Architektur (Konzept / Strategie / Physisch) + INode-Korrektur (REV 5.1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="REV 5.1 KORREKTUR: INode = Mikro-Verweis (Slot-Eintrag) auf ISearchPage. IFanout HAT ISearchPages. ISearchPage HAT INodes. ICachePage traegt INodes (ganz oder fragmentiert). Strategie-Schicht ist Kleber zwischen Konzept und Physisch (CacheEngine)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="layer1" value="SCHICHT 1 - KONZEPT (Was sind die Algorithmus-Bausteine?)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iroot" value="IRootNode&lt;R&gt; (NEU REV 5.1 - vorher fae. IRootPage)&#10;━━━━━━━&#10;Algorithmus-Wurzel als KONZEPTIONELLE Ebene&#10;Liegt auf einer ISearchPage darunter&#10;composes 1 IFanout (KEIN direkter Speicher!)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="540" height="120" as="geometry"/></mxCell>
        <mxCell id="ifan" value="IFanout&lt;F&gt;&#10;━━━━━━━&#10;Verzweigungs-Abstraktion (Konzept)&#10;contains [N] ISearchPage via «contains»&#10;has 1 ISearchPagesStrategy + 1 Pattern&#10;━━━━━━━&#10;KORREKTUR REV 5.1: KEIN direktes&#10;composes [N] INode mehr!&#10;INodes sind nur INDIREKT ueber ISearchPage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="540" height="160" as="geometry"/></mxCell>
        <mxCell id="inode" value="INode&lt;N&gt; = Mikro-Verweis (KORRIGIERT REV 5.1)&#10;━━━━━━━&#10;Slot-Eintrag in einer Liste eines IFanouts&#10;Tagged Union mit Discriminator (Masstree keylenx_):&#10;- ValueRef     (Wert direkt)&#10;- ChildRef     (Pointer auf naechsten Knoten)&#10;- LayerRef     (Layer-Pointer Border-Slot keylenx==128)&#10;- SiblingRef   (next/prev B-link)&#10;- SuffixRef    (External-Suffix-Pointer keylenx==64)&#10;━━━━━━━&#10;HAT KEINE eigenstaendige Speicher-Adresse!&#10;Adressiert via permutation_index durch Interpreter (Facade)&#10;━━━━━━━&#10;Quelle Masstree P03: Slot in `leaf` mit ikey0_[i] + keylenx_[i] + lv_[i]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="layer2" value="SCHICHT 2 - STRATEGIE (Wie verbinden wir Konzept und physische Cache optimal? = CacheEngine als KLEBER)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ispage" value="ISearchPage&lt;S&gt; (Knoten-Objekt = logische Such-Seite)&#10;━━━━━━━&#10;contains [W] INode (W = Fanout-Width, z.B. 15 in Masstree)&#10;has EXACTLY 1 ISearchPageStructure&#10;has EXACTLY 1 ISearchPageStructureInterpreter&#10;mapped onto [1..K] ICachePage  via ICacheStrategy&#10;━━━━━━━&#10;Beispiele: Masstree leaf 256 B, ART Node16 ~144 B, HOT Compound 32-64 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1140" height="220" as="geometry"/></mxCell>
        <mxCell id="isps" value="ISearchPageStructure&lt;SST&gt; (Strategy + Singleton-Facade)&#10;━━━━━━━&#10;encoding : Encoding (PRT-ART-Seitentyp-Kodierung)&#10;layout_invariants : LayoutInvariantSet&#10;raw_bytes : span&lt;byte&gt;&#10;━━━━━━━&#10;HAT (Composition) ISearchPageStructureInterpreter (Singleton)&#10;Bietet Such-/Iterator-Methoden via FACADE Pattern (GoF):&#10;+ find(key) / scan(range) / prefetch(hint)&#10;+ make_iterator(mode) / advance / position&#10;━━━━━━━&#10;6 Konkretisierungen + Singleton-Interpreter:&#10;RedirectStructure -&gt; RedirectInterpreter (memcmp byte-prefix)&#10;DenseByteStructure -&gt; DenseByteInterpreter (linear scan SIMD)&#10;MultilevelDenseStructure -&gt; MultilevelInterpreter (Cost-DP-Suche)&#10;SparsePatriciaStructure -&gt; PatriciaInterpreter (single/multi-mask AVX2)&#10;DecisionSpanStructure -&gt; B2Interpreter (Decision-then-Span)&#10;CustomAlignedStructure -&gt; CustomInterpreter (B^2-aehnlich)&#10;━━━━━━━&#10;FACADE: Tree haelt EINEN Verweis pro Layout-Variante (Singleton).&#10;Spart 8 B vtable-Pointer pro INode (kritisch bei 16-B-INodes!).&#10;Praezedenz: LLVM TargetInfo, Protobuf MessageLite, FAST 3-Level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="520" width="1110" height="500" as="geometry"/></mxCell>
        <mxCell id="strat" value="ISearchPagesStrategy + Pattern + ISearchPageStrategy + ICacheStrategy (Visitor) - 4-Ebenen-Strategien siehe K04, K06&#10;━━━━━━━&#10;Strategie-Schicht ist KLEBER zwischen Konzept-Schicht (IFanout/INode/IRootNode) und Physik-Schicht (ICachePage/ICacheLine).&#10;Sie ist TEIL der CacheEngine. Cache-Engine hat 12 internal Familien C1-C12 (siehe K15) - Layout, Pinning, Prefetch, Coherence, Telemetry, Allocation, Migration, Encoding, Heuristik, Topologie, Scheduler, Filter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="layer3" value="SCHICHT 3 - PHYSISCH (Wo liegt es im Speicher? = Hardware-Cache-Repraesentation)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="icpage" value="ICachePage&lt;C&gt; (physische Cache-Page-Einheit)&#10;━━━━━━━&#10;has size = N x ICacheLine.size (z.B. 4 KiB = 64 x 64 B)&#10;carries [0..M] INode (KORRIGIERT: ganz ODER fragmentiert)&#10;carries [0..K] ISearchPage (typisch K=1 wenn aligned)&#10;━━━━━━━&#10;3 Granularitaeten:&#10;Cache-Line (B0): 64 B (x86), 128 B (Apple Silicon), 256 B (A64FX)&#10;Cache-Page    : 4 KiB Standard, 2 MiB Huge&#10;Disk-Page     : 4-64 KiB (klassisch), 4 MiB+ NVMe&#10;━━━━━━━&#10;Worst-Case-Fragmentierung: INode an Cache-Line-Grenze gesplittet&#10;-&gt; 2 ICachePage-Loads fuer 1 INode-Lookup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="1140" height="280" as="geometry"/></mxCell>
        <mxCell id="icline" value="ICacheLine&lt;CL&gt; (Hardware-Atomic-Transfer-Einheit)&#10;━━━━━━━&#10;size : 64 B / 128 B / 256 B je nach Plattform&#10;state : MESI / MOESI&#10;residency : ICacheLevel (L1/L2/L3/HBM/V-Cache)&#10;━━━━━━━&#10;Plattform-spezifisch (NIE hardcoded 64 B!):&#10;C++17: std::hardware_destructive_interference_size&#10;x86-64: 64 B   ARM Cortex-A: 64 B   Apple Silicon: 128 B   A64FX: 256 B   POWER9/10: 128 B&#10;━━━━━━━&#10;False-Sharing-Avoidance: alignas(hardware_destructive_interference_size)&#10;Cache-Line-Aware Familien: CSS, CSB+, FAST, ART, HOT, vEB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="1100" width="1110" height="280" as="geometry"/></mxCell>
        <mxCell id="cache_engine_box" value="CACHE-ENGINE als HARMONISIERER der 3 Schichten (Hauptaufgabe REV 5.1)&#10;━━━━━━━&#10;Optimiert die Kommunikation + Darstellung zwischen Konzept-Ebene (IRootNode/IFanout/INode) und Physik-Ebene (ICachePage/ICacheLine).&#10;Strategie-Schicht (CacheEngine-internal) waehlt aus 12 ICacheEngine-Familien (C1-C12, siehe K15) die optimale Kombination fuer:&#10;- Performance (Throughput/Latency/Cache-Miss-Rate)&#10;- Speicherplatz (Footprint/Compression-Ratio)&#10;- Coherence (False-Sharing-Vermeidung)&#10;━━━━━━━&#10;Drei Ziele harmonisieren: KONZEPT (was) - STRATEGIE (wie optimal) - PHYSISCH (wo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1410" width="2280" height="220" as="geometry"/></mxCell>
        <mxCell id="r_iroot_ifan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="iroot" target="ifan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ifan_ispage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ifan" target="ispage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ifan_lbl" value="contains [N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ifan_ispage"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_inode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.8;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ispage" target="inode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ispage_lbl" value="contains [W=15]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ispage_inode"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_isps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="ispage" target="isps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ispage_lbl2" value="has 1 (Facade)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="r_ispage_isps"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_icpage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#1B5E20;strokeWidth=3;" edge="1" parent="1" source="ispage" target="icpage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ispage_lbl3" value="mapped via ICacheStrategy" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#1B5E20;" vertex="1" connectable="0" parent="r_ispage_icpage"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_icpage_icline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="icpage" target="icline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_icpage_lbl" value="composes [N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_icpage_icline"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K03" name="K03 ICacheStrategy + CacheEngineBuilder Permutationsdimension">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K03 KONZEPT - ICacheStrategy als Permutationsdimension (REV 5 erweitert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="User waehlt Compile-Time ODER CacheEngineBuilder erzeugt Permutationsdimension fuer F15-Vergleich" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ics" value="ICacheStrategy&lt;CS&gt;&#10;━━━━━━━&#10;Visitor-Pattern Wurzel (3 visit-Slots REV 4/5)&#10;+ visit(read_op : PageReadOp&amp;)&#10;+ visit(write_op : PageWriteOp&amp;)&#10;+ visit(layout_op : PageLayoutOp&amp;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="bes" value="V1 BaseEngineStrategy : ICacheStrategy&#10;━━━━━━━&#10;NICHT-OPTIMIERTE Read/Write/Layout-Variante&#10;StaticEngine-Pfad: Originalcode-Bauteil&#10;Baseline fuer F15-Vergleich&#10;━━━━━━━&#10;KEINE ILivePlatformModel-Konsultation&#10;KEINE Heuristik-Aufrufe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="540" height="200" as="geometry"/></mxCell>
        <mxCell id="v2" value="V2 CacheEngineStrategy + HEURISTIC_STATIC&#10;━━━━━━━&#10;Cache-Engine aktiv + statische Defaults&#10;OHNE Plattformkalibrierung&#10;━━━━━━━&#10;feste Schwellen, keine Mikrobenchmarks&#10;Termin 6 Modus 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="540" height="200" as="geometry"/></mxCell>
        <mxCell id="v3" value="V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#10;━━━━━━━&#10;Cache-Engine + einmalige Mikrobenchmarks&#10;daraus folgen feste Plattformregeln&#10;━━━━━━━&#10;Warm-up-Phase, Kalibrierungs-Heuristik&#10;Termin 6 Modus 2 (CSB+ processor-conscious-Erbe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="540" height="200" as="geometry"/></mxCell>
        <mxCell id="v4" value="V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#10;━━━━━━━&#10;Cache-Engine + Warm-up + laufende&#10;Rekalibrierung/Umschaltung bei Zugriffsmuster-Aenderung&#10;━━━━━━━&#10;Online-Adaption, Khan-Erbe + START-Optimizer&#10;Termin 6 Modus 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1800" y="400" width="540" height="200" as="geometry"/></mxCell>
        <mxCell id="builder" value="CacheEngineBuilder.build_permutations() (NEU REV 5)&#10;━━━━━━━&#10;Pro Search-Engine-Permutation entstehen 4 Builds:&#10;V1 = BaseEngineStrategy (Baseline F15)&#10;V2 = CacheEngineStrategy + HEURISTIC_STATIC&#10;V3 = CacheEngineStrategy + INFORMED_KALIBRIERT&#10;V4 = CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#10;━━━━━━━&#10;F15 vergleicht alle 4 systematisch:&#10;Hat die CacheEngine-Investition messbaren Mehrwert?&#10;In welchem Modus? Auf welcher Plattform?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="700" width="1840" height="240" as="geometry"/></mxCell>
        <mxCell id="hint" value="ENGINE-CHOICE-DIMENSION: Compile-Time-Wahl (Template-Parameter) ODER CacheEngineBuilder-generiert (Permutationsdimension)&#10;F15-Cross: jede Such-Permutation x 4 Engine-Choice-Varianten = 4-fache Anzahl Tupel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="980" width="1840" height="100" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.1;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="bes" target="ics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.4;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v2" target="ics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.6;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v3" target="ics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.9;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="v4" target="ics"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K04" name="K04 4-Ebenen-Strategien">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K04 KONZEPT - 4-Ebenen-Strategien + Multiplizitaeten (REV 5 unveraendert vs REV 3, User-bestaetigt)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A04000;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Pattern (1 pro IFanout) - Plural-Strategy (N pro Pattern) - Singular-Strategy (1 pro Page) - Heuristic (beliebig)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ea" value="EBENE A - ISearchPagesStrategyPattern (1 pro IFanout)&#10;━━━━━━━&#10;21 Patterns aus 12_md (siehe K06):&#10;10 Komposition: AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold | DynamicRebalance | HierarchicalFractal | OrthogonalRuntimeParametrized | MultiStrategyOrchestration | HeterogeneousAdaptive | BoundaryNodePartition&#10;6 Adaptivitaet: OfflineSelfTuning | OnlineProbabilityRebalance | OnEveryStructureModification | PeriodicGlobalRelocation | BulkLoadLevelByLevel | CompoundFastBuild&#10;5 Aufbauverfahren: BfsLevelByLevelPagePacking | RecursiveDfsBlockPacking | ProbabilityGreedyPagePacking | PostOrderDp | RecursiveCommonPrefixDecomposition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="2200" height="200" as="geometry"/></mxCell>
        <mxCell id="eb" value="EBENE B - ISearchPagesStrategy PLURAL (N pro Pattern)&#10;━━━━━━━&#10;41 Plural-Strategien aus 12_md §2:&#10;12 BPlus-Familie | 8 Trie-Familie | 8 Hybrid-Familie | 10 Layout-Theorie-Familie | 3 AdaptiveSelectors&#10;━━━━━━━&#10;Beispiele: BPlusTreePerLayerStrategy (P03), AdaptiveRadixTreeStrategy (P01), KConstrainedHotStrategy (P02), MacroNodeCollapsingStrategy (P04),&#10;LoudsDenseSparseStrategy (P10), WormholeTripleStrategy (P07), FractalBPlusStrategy (P22), HotPathLayoutStrategy (P28)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="2200" height="200" as="geometry"/></mxCell>
        <mxCell id="ec" value="EBENE C - ISearchPageStrategy SINGULAR (1 pro ISearchPage)&#10;━━━━━━━&#10;74 Singular-Strategien aus 12_md §3:&#10;22 Intra-Page Search-Strategien | 15 Insert/Update | 28 Layout/Encoding | 9 Concurrency-innerhalb-Page&#10;━━━━━━━&#10;Beispiele: PermutationFieldInsertion (P03), AdaptiveLayoutSelection (P20), CompoundContainer (P02), DecisionPageStrategy (P06), SpanPageStrategy (P06), DiscriminativeBitsSelection (P02 HOT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="2200" height="200" as="geometry"/></mxCell>
        <mxCell id="ed" value="EBENE D - IHeuristic (beliebig viele - parametrieren die Strategien)&#10;━━━━━━━&#10;~80-85 paper-abgeleitete Heuristiken aus 13_md §9 + 12_md §4 (siehe K09):&#10;19 Layout-Selection | 12 Cost-Modell | 8 AdaptivePrefetch | 6 Workload-Detection | 6 Cache-Coherence | 9 Telemetry | 10 Auswahl/Kompat | 4 Hardware-Probing&#10;━━━━━━━&#10;Beispiele: AdaptivePrefetchDistance (P23) | CacheCostDP (P05) | CacheCoherenceCost (P28 Block AN) | WidthCostModel (P13) | ProbabilityLayout (P16) |&#10;LargestL3CcdPinning (allgemein) | HotPathOnHighIpcCore (allgemein) | StrideVsSequential (P32) | LeafOnlyCounter (P28-Mail)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="820" width="2200" height="220" as="geometry"/></mxCell>
        <mxCell id="legend" value="MULTIPLIZITAETEN (K3.4 + REV 5):&#10;1 IFanout has-1 ISearchPagesStrategy (NEU REV 5)&#10;1 IFanout has-1 ISearchPagesStrategyPattern (eindeutig pro Fanout)&#10;1 ISearchPagesStrategyPattern has-N ISearchPageStrategy (eine pro ISearchPage)&#10;1 ISearchPage has-1 ISearchPageStructure + 1 ISearchPageStructureInterpreter (NEU REV 5)&#10;1 IHeuristic kann beliebig viele Strategien parametrieren - Iteratoren orthogonal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="1080" width="2200" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K05" name="K05 PRT-ART Bausteinkombination">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K05 KONZEPT - PRT-ART vollstaendige Bausteinkombination (REV 5 NEU aus Termin 1-6)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="7-Quellen-Hybrid + 6 Seitentypen + 3 Iteratoren-Pflicht + ValueHandle (Inline/External/ChainRef)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="schicht" value="ARCHITEKTUR-FREEZE in 4 SCHICHTEN (Termin 4 Scope-Freeze)&#10;━━━━━━━&#10;A. Trie-Huelle mit Redirect-Knoten fuer kollabierte Praefixpfade (CoCo-trie-Idee)&#10;B. Suchseitenfamilie mit mehreren implementierten Seitentypen&#10;C. Terminale Knoten mit ValueHandle als Uebergang zur Payload&#10;D. Cache-Engine als explizite Steuerungsschicht fuer Layout, Prefetch, Affinity, Rebuild" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="2240" height="160" as="geometry"/></mxCell>
        <mxCell id="hybrid" value="7-QUELLEN-HYBRID (Termin 1+2 Bausteinkombination)&#10;━━━━━━━&#10;1. Redirect-Page / Trie-Huelle           CoCo-trie (Belazzougui/Boffa)        Praefixorientiert + data-aware Subtrie-Collapse&#10;2. Dense-Byte-Page                       ART (Leis/Kemper/Neumann 2013)         1-Byte direkte Adressierung, Node4/16/48/256&#10;3. Multilevel-Dense-Page                  START (Fent et al.)                   Mehrbyteig + Cost-Modell + Schwellwert-Umschaltung&#10;4. Sparse-Patricia-Page                   HOT (Binna et al. 2018)               Diskriminierende Bits, k-constrained, 9 Layouts&#10;5. Decision-Span-Page                     B^2-Tree (Schmeisser et al. 2022)     Page-lokale Decision/Span Subtrees pro 64 KiB&#10;6. PRT-Custom-Cache-Page                  CSS+CSB+ + B^2                        Cache-line-aligned, pool-relative Handles&#10;7. Subbaumgrenzen / Fences               Masstree (Mao/Kohler/Morris)          getrange-Semantik (NICHT als lokaler B+)&#10;Plus: Hardwareprofil-Kalibrierung         Processor-conscious CSB+ (Samuel)     Hardware-Discovery + ISA-spezifische Schwellwerte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="2240" height="280" as="geometry"/></mxCell>
        <mxCell id="seitentypen" value="6 SEITENTYPEN MIT P0/P1/P2-PRIORITAET (Termin 4 Scope-Freeze)&#10;━━━━━━━&#10;Seitentyp                  Quelle           Prio  ISearchPageStructure         ISearchPageStructureInterpreter&#10;Redirect-Knoten            CoCo-trie         P0    RedirectStructure            RedirectInterpreter&#10;Dense-Byte-Page            ART               P0    DenseByteStructure           DenseByteInterpreter&#10;Sparse-Patricia-Page       HOT               P0/P1 SparsePatriciaStructure      PatriciaInterpreter&#10;Multilevel-Dense-Page      START             P1    MultilevelDenseStructure     MultilevelInterpreter&#10;Decision-Span-Page         B^2-Tree          P2    DecisionSpanStructure        B2Interpreter&#10;Custom-Aligned-Page        PRT-ART intern    P2    CustomAlignedStructure       CustomInterpreter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="2240" height="240" as="geometry"/></mxCell>
        <mxCell id="iter" value="ITERATOREN-FAMILIE (Pflicht: 3 Iteratoren mit beiden Richtungen, User-Direktive)&#10;━━━━━━━&#10;class comdare::prt_art&lt;Key, Value&gt;&#10;+ iterator (mutable forward) + const_iterator + reverse_iterator + const_reverse_iterator&#10;+ range_iterator (lex-Modus, getrange-Semantik aus Masstree) + key_iterator + value_iterator + prefix_iterator (NEU REV 5)&#10;━━━━━━━&#10;Concept-Iteratoren: INodeIterator (visit_each_child) + ISearchPageIterator (Range-Scan) + ISearchPageStrategyIterator (Cross-Algorithm)&#10;━━━━━━━&#10;3 Iterator-Semantik-Modi (Termin 2): Default-Modus | Lokaler Ordnungsmodus | Lex-Modus (Prefix Enumeration + Range)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="2240" height="200" as="geometry"/></mxCell>
        <mxCell id="vh" value="VALUE HANDLE (Pflicht-Datenpfad)&#10;━━━━━━━&#10;ValueHandle drei Auspraegungen (compile-time + runtime parametrisierbar):&#10;- Inline       : Value direkt im terminalen Knoten (kleine Werte)&#10;- External     : Pointer auf externen Payload-Speicher (grosse Werte)&#10;- ChainRef     : verkettete Referenz fuer Multi-Value (vertagt P3)&#10;━━━━━━━&#10;Inline-vs-External-Grenze ist H3-Hypothese (architektur+workloadabhaengig) und MUSS aktiv ueber Kostenmodell gewaehlt werden" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1120" width="2240" height="200" as="geometry"/></mxCell>
        <mxCell id="invarianten" value="6 INVARIANTEN (Termin 2 hart eingefroren) + 4 HYPOTHESEN (Termin 4)&#10;━━━━━━━&#10;I1: Lookup traversiert ausschliesslich Navigationsknoten bis terminaler Knoten oder Miss&#10;I2: Terminaler Knoten besitzt genau ein ValueHandle; Payload extern Default, optional inline&#10;I3: Redirect-Knoten komprimieren eindeutige Restpfade, NICHT echte Mehrfachverzweigung&#10;I4: Lokale Seitencodierung darf variieren -&gt; ISearchPageStructureInterpreter PFLICHT (NEU REV 5)&#10;I5: Seitentyp-Umschaltungen sind explizite Policy-Entscheidungen, KEINE festen universellen Schwellwerte&#10;I6: Concurrency bleibt im Kernumfang auf spaetere Erweiterung begrenzt&#10;━━━━━━━&#10;H1: Aktive Cache-Engine verbessert CLU/Footprint/Laufzeit  H2: Dense/Sparse/Multilevel gewinnen je nach Workload  H3: Inline-vs-Handle aktiv waehlen  H4: Online-Umlagerung+Prefetching nur wirksam wenn Seitentyp+Wertablage+Affinity gemeinsam modelliert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1340" width="2240" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K06" name="K06 ISearchEngine-Familien-Taxonomie">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K06 KONZEPT - ISearchEngine-Familien-Taxonomie S1-S30 (NEU REV 5 analog 11_md)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Such-Algorithmus-Strategie-Familien analog 29 Cache-Strategie-Familien fuer ICacheEngine - 21 Patterns + 5 Plural-Familien + 4 Singular-Cluster + 5 NEUE Hybrid-Aufloesungen" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="komp" value="EBENE A KOMPOSITION-PATTERNS S1-S10&#10;━━━━━━━&#10;S1  IAllPagesUniformPattern (P11/P12/P14/P21)               atomar&#10;S2  ILayerMixPattern (P03/P10/P04/P22)                      HYBRID 4 Sub-Patterns&#10;S3  IInnerVsLeafPattern (P02/P10/P04/P19/P22)               HYBRID 5 Sub-Patterns&#10;S4  IHotVsColdPattern (P26/P28/P10)                          HYBRID 3 Sub-Patterns&#10;S5  IDynamicRebalancePattern (P05/P18/P19/P20)              HYBRID 4 Sub-Patterns (NEU §9.18+§9.19)&#10;S6  IHierarchicalFractalPattern (P22/P15/P06)                HYBRID 3 Sub-Patterns&#10;S7  IOrthogonalRuntimeParametrizedPattern (P23/P26/P14)     HYBRID 3 Sub-Patterns&#10;S8  IMultiStrategyOrchestrationPattern (P07/P26/P15)        HYBRID 3 Sub-Patterns&#10;S9  IHeterogeneousAdaptivePattern (P20)                     HYBRID (Aufl. §9 #17)&#10;S10 IBoundaryNodePartitionPattern (P20)                     atomar / Sub-Pattern" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="1100" height="320" as="geometry"/></mxCell>
        <mxCell id="adapt" value="EBENE A ADAPTIVITAETS-PATTERNS S11-S16 + AUFBAUVERFAHREN-PATTERNS S17-S21&#10;━━━━━━━&#10;S11 IOfflineSelfTuningPattern (P05 START)                  HYBRID (§9 #9)&#10;S12 IOnlineProbabilityRebalancePattern (P28/P26)            HYBRID (P28 §9 #7)&#10;S13 IOnEveryStructureModificationPattern (P19 Local Reloc) HYBRID (NEU §9.18)&#10;S14 IPeriodicGlobalRelocationPattern (P19 Composite P18)   HYBRID (NEU §9.19)&#10;S15 IBulkLoadLevelByLevelPattern (P11/P12/P14)              atomar&#10;S16 ICompoundFastBuildPattern (P02/P04)                     HYBRID (P02 §9 #5, P04 §9 #3)&#10;━━━━━━━&#10;S17 IBfsLevelByLevelPagePackingPattern (P18 Saikkonen)      atomar&#10;S18 IRecursiveDfsBlockPackingPattern (P17 vEB / P11 CSS)    HYBRID (P17 NEU §9.20)&#10;S19 IProbabilityGreedyPagePackingPattern (P16 / P28)        atomar&#10;S20 IPostOrderDpPattern (P04 / P05)                         HYBRID (§9 #3+#9)&#10;S21 IRecursiveCommonPrefixDecompositionPattern (P06 B^2)    HYBRID (§9 #12)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1100" height="320" as="geometry"/></mxCell>
        <mxCell id="plural" value="EBENE B PLURAL-STRATEGIEN S22-S26 (41 total)&#10;━━━━━━━&#10;S22 BPlus-Familie (12) - BPlusTreePerLayer P03, ClassicBPlus, CSS-Full P11, CSS-Level P11, CSBPlus-Basic/Segmented/FullPrealloc P12, WideNodeBPlus P21, FractalBPlus-DiskFirst/CacheFirst P22, LargeNodeBPlus P13, EmbeddedSecondaryIndex P06&#10;S23 Trie-Familie (8) - AdaptiveRadixTree P01, MultilevelAdaptiveRadix P05, KConstrainedHot P02, MacroNodeCollapsing P04, LoudsDenseSparse P10, JacobsonLouds P09, WormholeTriple P07, PathCompressedTrie P01/P02&#10;S24 Hybrid-Familie (8) - TripleHashThenBPlus P07, StaticPreSortedDirectory P11, EmbeddedDecisionSpanTree P06, JumpPointerArray-Ext/Int P21, DualJumpPointerArray P22, JumpPointerVersionChain P26, MicroIndexing P22&#10;S25 Layout-Theorie-Familie (14) - vEB P17 (4 Varianten), CacheSensitiveMultiLevel P18, LocalReloc P19 (2 Varianten), ProbabilityWeightedRootBlock P16, ProbabilityGreedy P16, RelaxedGreedy P16, CacheObliviousProbabilityLayout P16, BTreeOfCacheLines P15, VerticalPartitioning P15, HotPathLayout P28&#10;S26 Adaptive-Layout-Selectors (3) - AdaptiveLeafSelector P20, OfflineSelfTuning P05, ConfigurationLookup P14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="2240" height="280" as="geometry"/></mxCell>
        <mxCell id="singular" value="EBENE C SINGULAR-STRATEGIEN S27-S30 (74 total)&#10;━━━━━━━&#10;S27 Intra-Page Search-Strategien (22) - LinearScanWithinNode, BinarySearchWithinNode, LoopUnrolledBinarySearch, SimdParallelKeyComparison-SSE/AVX2, SimdParallelHeadComparison, Fingerprinting-PointLookup, DenseOffsetLookup-FDL, HintNarrowedBinarySearch, InterpolationSearch, PoorMansNormalizedKeySearch, RankSelectNavigation, TaggedHashSlotLookup, SpeculativeHashedAccess, IncrementalHashing, LoudsLookup, DfudsRankAccess, ExtensionSpanSearch-B^2, ByteRangeDecision-B^2, DiscriminativeBitsSelection, PrefixingLinearSearch&#10;S28 Intra-Page Insert/Update-Strategien (15) - PermutationFieldInsertion (P03), AdaptiveLayoutInsertion (P20), KConstrainedSubtreePartitioning (P02 4-Wege), LazyDeletion, LazySortInsertion-Fingerprinting, SequentialInsertHeuristic, SmartSplit, BulkLoadLevelByLevelInsertion, InsertionPathPrefetch, SiblingRedistributionPrefetch, RebuildOnSplit-B^2, BoundaryAwareSeparatorSelection-FDL, NodeReplacement-ROWEX, OverflowLeaf-Wormhole, ContentionSplit&#10;S29 Intra-Page Layout-/Encoding-Strategien (28) - PrefixTruncation, Heads-PoorMansNormalized, Hints, Fingerprinting-LeafLayout, SemiDenseLeafLayout-SDL, FullyDenseLeafLayout-FDL, IndirectionVector, InfixSpeicherung-B^2, SpanNodeLcpCompression-B^2, LinearizedCompoundNode-HOT, PointerElimination, NodeGroupContiguous, SegmentedNodeGroup, OrderPreservingCompression, KeyNormalization, NextNeighborDifferencing, PointerToExtentsCompression, IntegerSliceFormation, AdaptiveSuffixPlacement, PartialKeyEncoding, LcpAwareIntegerEncoding, EncodingSelection, AlphabetAwareEncoding, SuffixTruncation, PerNodeTypeFindChild, MultilevelNode, RewiredNode, MultilevelNode4&#10;S30 Concurrency-Strategien innerhalb Page (9 - 2 Hybride NEU §9.21+§9.22) - OptimisticLockCoupling-OLC (P03/P06/P08/P20), ROWEX (P02/P08), RCU (P29), HazardPointers (P30), EpochBasedReclamation, HandOverHandOptimistic, QuiescentStateBased, TripleClassConcurrency-Wormhole (NEU Aufl. §9.21), CopyOnWrite (P02 HOT/P19), DualHashTableCopyOnWrite (NEU Aufl. §9.22)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="2240" height="540" as="geometry"/></mxCell>
        <mxCell id="hybrid_neu" value="NEU REV 5 - 5 fehlende Hybrid-Aufloesungen (User-Kritik 2026-05-11)&#10;━━━━━━━&#10;§9.18 S13 P19 LocalReloc           OnModRelocation + LocalAlphaRelocation + WaitFreeRelocation                  -&gt; OnEveryStructureModificationCompositionCommand&#10;§9.19 S14 P18+P19 GlobalReloc      BfsGlobalRelocation + LocalReloc-Composite + PeriodicTrigger                  -&gt; PeriodicGlobalRelocationCompositionCommand&#10;§9.20 S18 P17 vEB Layout            VEBClassic + DynamicVEBPma + BufferNodesVEB + IndirectedVEB                   -&gt; VEBLayoutVariantCompositionCommand&#10;§9.21 S30 P07 TripleConcurrency     Class1Rcu + Class2RWLock + Class3MutEx                                        -&gt; WormholeTripleConcurrencyCompositionCommand&#10;§9.22 S30 P07 DualHashTable         T1MetaTrieHash + T2CowMetaTrieHash + BarrierSwap                              -&gt; WormholeDualHashTableCompositionCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1360" width="2240" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K07" name="K07 IPlatformProbe Auto-Discovery + 28 Concepts">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07 KONZEPT - IPlatformProbe Auto-Discovery (5 Schritte) + 28 NEUE Saeule-B-Concepts (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="KEINE plattform-spezifischen Klassen + 28 fehlende Saeule-B-Concepts aus 13_md §6+§7 ergaenzt" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ipp" value="IPlatformProbe (REV 3 vorhanden)&#10;━━━━━━━&#10;ALLGEMEIN OHNE CPU-Spezialisierung&#10;━━━━━━━&#10;+ discover_cache_topology() : ICacheTopology&#10;+ discover_core_layout() : ICoreLayout&#10;+ discover_isa_features() : IIsaFeatureSet&#10;+ discover_interconnect() : IBusTopology&#10;+ measure_cache_latencies()&#10;+ measure_bandwidths()&#10;+ measure_cache_coherence_cost()&#10;+ measure_pinning_effects()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="ippc" value="IPlatformPropertyClassifier (REV 3 vorhanden)&#10;━━━━━━━&#10;+ classify(probe_results) : PlatformPropertySet&#10;━━━━━━━&#10;PlatformPropertySet (REV 5 erweitert auf 12+ Properties):&#10;has_asymmetric_l3, has_hybrid_cores, has_hbm_tier, preferred_pinning,&#10;usable_simd_width, has_software_prefetch, coherence_cost_threshold,&#10;branch_predictor (NEU), has_bmi2_pext_pdep (NEU), primary_storage (NEU),&#10;page_cache_model (NEU), memory_channels (NEU), has_3d_v_cache (NEU),&#10;has_intel_thread_director (NEU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="780" height="280" as="geometry"/></mxCell>
        <mxCell id="iceop" value="ICacheEngineOptionPublisher (REV 3 vorhanden)&#10;━━━━━━━&#10;+ register_module(module : PermutationModule&amp;)&#10;+ unregister_module(module)&#10;+ publish_options_to_all() : void&#10;+ filter_options_for(module) : OptionSet&#10;+ properties() const : PlatformPropertySet const&amp;&#10;━━━━━━━&#10;Jede Permutation erhaelt nur die Optionen, die ihre Bausteine&#10;tatsaechlich konsumieren koennen (compile-time-gefiltert via Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="840" height="280" as="geometry"/></mxCell>
        <mxCell id="schritte" value="5-SCHRITT-PFLICHT (CacheEngineBuilder pro Permutations-Build):&#10;━━━━━━━&#10;1. DISCOVER (statisch)  - CPUID / sysfs / /proc/cpuinfo / hwloc&#10;2. MEASURE (dynamisch)  - Mikrobenchmark (clflush-cycle / All-Pairs-Pinning / Cache-Coherence-Calibration)&#10;3. CLASSIFY            - Properties zusammenstellen (12+ Properties REV 5)&#10;4. PUBLISH             - Properties allen Permutations-Modulen als Konfigurations-Optionen&#10;5. BIND                - Pro Permutation entscheidet ICacheStrategy-Visitor, welche Properties konsumiert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="2240" height="180" as="geometry"/></mxCell>
        <mxCell id="neu1" value="NEU REV 5 - 28 fehlende Saeule-B-Concepts (Teil 1: Hardware + Memory)&#10;━━━━━━━&#10;1.  IRankSelectPrimitive       - popcount / Jacobson 2-Level / Poppy (P09/P10/P04)&#10;2.  IModelAcquisitionStrategy  - wie wird ILivePlatformModel gewonnen? (P05)&#10;3.  IVirtualMemoryStrategy     - DirectMapping / RewiredSharedPages / HugePages (P05 Rewiring)&#10;4.  IBranchPredictorModel      - Mispredict-Cost als Plattform-Kennzahl (P01/P13)&#10;5.  IBitManipulationFeatureGate - BMI2 PEXT/PDEP, AVX2, popcount + Fallback (P02 HOT)&#10;6.  IStorageMedium             - DRAM/NVRAM/SSD/HDD-Hierarchy (P10 SuRF, P22)&#10;7.  IPageCacheModel            - OS Page Cache + App Block Cache 2-stufig (P10 SuRF)&#10;8.  IConcurrencyProtocol       - eigene Saeule C, orthogonal A/B (P02/P03/P08/P29/P30)&#10;9.  IRebuildScheduler          - VACUUM-aehnliche Trigger (P05 START Self-Tuning)&#10;10. IRebuildCostModel          - Bauzeit O(N h^2) bei P04 CoCo&#10;11. IWorkloadModel             - Read-Only/Read-Mostly/Write-Heavy/Mixed/Skewed/Range-Heavy&#10;12. ICellProbeModel vs IWordProbeModel - 2 alternative Plattform-Modelle (P09 Jacobson)&#10;13. IPositionalCorrespondencePrefetch - Prefetch via Layout-Invarianten (P10 SuRF)&#10;14. ICacheConflictModel        - FullAssociative vs SetAssociative (P18)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="1100" height="380" as="geometry"/></mxCell>
        <mxCell id="neu2" value="NEU REV 5 - 28 fehlende Saeule-B-Concepts (Teil 2: ISA + Memory-Decorator + Encoding)&#10;━━━━━━━&#10;15. ITemporalCacheStrategy     - Instruction-Cache, P15 §7 (REV 2 ICachePage ist Daten-orientiert)&#10;16. IIntelligentDMA            - Configurator/AGU/DataFetcher/Crawler (P31 iDMA)&#10;17. IComputeOffload            - PE/iDMA/App-Core/FPGA (P31)&#10;18. IHardwareExtension Sub-Hierarchie - WAH/PLWAH/COMPAX, Hash-Lookup, MergeSort, RiscBaseISA, SSE/AVX/SGX/THUMB/NEON (P31 TUD Goldstandard)&#10;19. IMemoryDecorator (NFP)     - latency/throughput/transience/reliability/wearout/random-accessibility/cache-coherence (P33 VAMPIR)&#10;20. IHeterogeneousAllocator (V-malloc) - heterogene Memory-Auswahl (P33)&#10;21. IMigrationPolicy           - transparente Daten-Migration zwischen Memory-Ebenen (P33 Compensation)&#10;22. ICompileTimeNegotiator     - Multi-Query Compile-Time-Negotiation (P33)&#10;23. IPipelineScheduler         - Operation-Pipelines mit Memory-Awareness (P33)&#10;24. IAccessPatternStrategy     - sequential/strided/simd (P32 To-Stride)&#10;25. IPaddingStrategy           - 576-Byte-Padding fuer Cache-Set-Disalignment (P32)&#10;26. IInformationTheoreticLowerBound - Optimality-Marker fuer Encoding (P09)&#10;27. IPositionalAddressing      - Implicit Addressing via Position-in-Bitstring (P09)&#10;28. ITopologyEncoding          - LOUDS/DFUDS/BP/Pointer/BitArray (orthogonal zu IFanout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="700" width="1100" height="380" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ipp" target="ippc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ippc" target="iceop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08" name="K08 Plattform-Modell verfeinert">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08 KONZEPT - Plattform-Modell verfeinert nach 33-Paper-Code (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="REV 3 Concepts + 11 NEUE Verfeinerungen aus 33-Paper-Code-Adapter + 5 Block-AO-OFFEN-Punkte" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="grp_cache" value="Cache-Hierarchie (REV 3 + REV 4 erweitert)&#10;━━━━━━━&#10;ICacheLevel - L1/L2/L3/HBM/V-Cache (size, latency, bandwidth, tier_kind enum)&#10;ICacheLine - Granularitaet (typ. 64 B, 256 B ARM A64FX)&#10;ICacheTopology - gesamte Hierarchie + asymmetric_l3 + per_ccd Map&#10;ICacheResidency - Cache whereabouts (Cached/HeaderCached/Uncached)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="700" height="180" as="geometry"/></mxCell>
        <mxCell id="grp_cpu" value="CPU-Kerne (generisch, KEINE CPU-Spezialisierung)&#10;━━━━━━━&#10;ICpuCore - core_class als generic enum&#10;ICoreLayout - Topologie ohne CPU-Namen&#10;ICoreToThreadMap - Thread-zu-Core, IPinningPolicy generisch&#10;IPinningPolicy - LARGEST_L3_CCD | HIGH_IPC_CORES | NUMA_LOCAL | ROUND_ROBIN&#10;NEU REV 5: Cross-Socket-cost + first-touch-policy + NUMA-node-binding (Cluster A/B/E)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="700" height="180" as="geometry"/></mxCell>
        <mxCell id="grp_isa" value="Hardware-Erweiterungen (ISA-Features) + Bus&#10;━━━━━━━&#10;IHardwareExtension (AVX-512, BMI2, NEON, SVE2, RISC-V V-Ext)&#10;IIsaFeatureSet (gesamte Verfuegbarkeit, Auto-discovered)&#10;IInterconnect - CCD-CCD, Core-Cache, NUMA, PCIe, NVLink&#10;IBusTopology + IMemoryBandwidthModel - Live-Bandbreiten + Bottleneck-Detection&#10;NEU REV 5: ITlbModel (dTLB / sTLB) als eigenes Concept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="700" height="180" as="geometry"/></mxCell>
        <mxCell id="grp_live" value="Echtzeit-Modelle&#10;━━━━━━━&#10;ILivePlatformModel - Echtzeit-Modell, periodisch aktualisiert (~100ms-Tick)&#10;ILiveCpuModel - Per-Core-Lasten + Hot-Path-Score&#10;Update-Source: perf-Counter / sysfs / cpuid&#10;NEU REV 5: Hardware-Counter-Feedback als STATISCHE Strategy fuer adaptives Resizing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="1100" height="160" as="geometry"/></mxCell>
        <mxCell id="grp_sync" value="Concurrency (NEU REV 5 detailliert)&#10;━━━━━━━&#10;IConcurrencyProtocol (eigene Saeule C):&#10;6-Flavor-RCU (qsbr/mb/membarrier/signal aus URCU Desnoyers 2012)&#10;Hazard Pointers (P30) + EpochBased + ROWEX + OLC&#10;NEU REV 5: IRangeAtomicityProtocol (P08 ROWEX-Range-Konflikt)&#10;NEU REV 5: ICompositionMode (OneNodePerPage / MultipleNodesPerPage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="380" width="1040" height="160" as="geometry"/></mxCell>
        <mxCell id="grp_storage" value="Storage + Memory-Ebenen (NEU REV 5 durchgaengig)&#10;━━━━━━━&#10;IStorageMedium (DRAM/NVRAM/SSD/HDD-Hierarchy)&#10;IPageCacheModel (OS Page Cache + App Block Cache 2-stufig)&#10;NVRAM/Persistent Memory durchgaengig (statt nur P25/P31)&#10;ITenancyModel (Multi-Tenancy/Cache-Pollution NEU statt 'dedicated')&#10;IEnergyModel (Cache-Coherence-Energiekosten quantitativ, P24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1100" height="160" as="geometry"/></mxCell>
        <mxCell id="grp_isa_more" value="Compiler-Automation + ISA-Compile-Gate (NEU REV 5)&#10;━━━━━━━&#10;IIsaCompileGate (P30/P31 OFFEN)&#10;Function Multiversioning / target_clones&#10;C++23 variadischer Runtime-Compiletime-hybrid-Resolver (Termin 4)&#10;ISimdAcceleratedLookupStrategy (F7) auf B+/Hybrid statt nur P03 PALM&#10;TLB explizit modelliert (statt nur P13/P28/P32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="580" width="1040" height="160" as="geometry"/></mxCell>
        <mxCell id="block_ao" value="BLOCK AO PRODUCTION-PLATTFORM (5 OFFEN-Punkte aus 13_md §10.5)&#10;━━━━━━━&#10;42. Cache-Coherence-Pressure-Quantifizierung 3D V-Cache (Ryzen 9 9950X3D - keines der 33 Paper modelliert 3D-stacked Cache)&#10;43. P/E-Core-Heterogenitaet i9-14900KS (keines der 33 Paper modelliert Hybrid-Architecture; IntelThreadDirector-Integration ist Eigenleistung)&#10;44. Bandwidth-Aware Layout fuer DDR5-5600 (Multi-Channel + Refresh-Cycle - P31 DDR2 / P32 DDR4/5 nur implizit)&#10;45. Live-Probing der Plattform-Konstanten via CPUID + __cpu_indicator_init (kein Paper liefert Code-Template)&#10;46. Cross-CCX-Coherence-Latenz Ryzen 9 9950X3D (nicht in 33 Papern modelliert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="2180" height="200" as="geometry"/></mxCell>
        <mxCell id="hint_pm" value="Verzeichnis Ebene 3 (REV 5 erweitert):&#10;cache_engine/&#10;platform_model/  (Concepts oben + 28 NEUE aus K07)&#10;scheduling/      (IScheduler + Konkretisierungen)&#10;heuristics/      (~80-85 IHeuristic-Konkretisierungen, 8 Cluster)&#10;decision_trees/  (F-EXTRA-6 PRO Baustein)&#10;observer_registry/ (F2 Push synchron)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="2180" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
