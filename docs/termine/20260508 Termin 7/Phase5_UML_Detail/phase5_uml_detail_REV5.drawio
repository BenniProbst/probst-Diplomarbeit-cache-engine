  <diagram id="U07" name="U07 ISearchEngine-Familien-Taxonomie als UML">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U07 UML - ISearchEngine-Familien-Taxonomie als UML-Klassen (NEU REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="S1-S30 als Concept-Hierarchie analog 11_md ICacheStrategy-Familien fuer Saeule A" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="patterns" value="«concept» ISearchPagesStrategyPattern Konkretisierungen (Ebene A: 21 Patterns)&#10;━━━━━━━ Komposition (S1-S10) ━━━━━━━&#10;S1 IAllPagesUniformPattern (P11/P12/P14/P21)&#10;S2 ILayerMixPattern (P03/P10/P04/P22)&#10;S3 IInnerVsLeafPattern (P02/P10/P04/P19/P22)&#10;S4 IHotVsColdPattern (P26/P28/P10)&#10;S5 IDynamicRebalancePattern (P05/P18/P19/P20)&#10;S6 IHierarchicalFractalPattern (P22/P15/P06)&#10;S7 IOrthogonalRuntimeParametrizedPattern (P23/P26/P14)&#10;S8 IMultiStrategyOrchestrationPattern (P07/P26/P15)&#10;S9 IHeterogeneousAdaptivePattern (P20)&#10;S10 IBoundaryNodePartitionPattern (P20)&#10;━━━━━━━ Adaptivitaet (S11-S16) ━━━━━━━&#10;S11 IOfflineSelfTuningPattern (P05)&#10;S12 IOnlineProbabilityRebalancePattern (P28/P26)&#10;S13 IOnEveryStructureModificationPattern (P19)&#10;S14 IPeriodicGlobalRelocationPattern (P19/P18)&#10;S15 IBulkLoadLevelByLevelPattern (P11/P12/P14)&#10;S16 ICompoundFastBuildPattern (P02/P04)&#10;━━━━━━━ Aufbauverfahren (S17-S21) ━━━━━━━&#10;S17 IBfsLevelByLevelPagePackingPattern (P18)&#10;S18 IRecursiveDfsBlockPackingPattern (P17/P11)&#10;S19 IProbabilityGreedyPagePackingPattern (P16/P28)&#10;S20 IPostOrderDpPattern (P04/P05)&#10;S21 IRecursiveCommonPrefixDecompositionPattern (P06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="600" as="geometry"/></mxCell>
        <mxCell id="plural" value="«concept» ISearchPagesStrategy Konkretisierungen (Ebene B: 41 Plural-Strategien in 5 Familien)&#10;━━━━━━━ S22 BPlus-Familie (12) ━━━━━━━&#10;BPlusTreePerLayerStrategy (P03)&#10;ClassicBPlusTreeStrategy&#10;CompactedSearchTreeStrategy-Full / -Level (P11)&#10;CSBPlusTreeStrategy-Basic / -Segmented / -FullPreallocated (P12)&#10;WideNodeBPlusStrategy pB+ (P21)&#10;FractalBPlusStrategy-DiskFirst / -CacheFirst (P22)&#10;LargeNodeBPlusStrategy 256-512B (P13)&#10;EmbeddedSecondaryIndexStrategy B^2 (P06)&#10;━━━━━━━ S23 Trie-Familie (8) ━━━━━━━&#10;AdaptiveRadixTreeStrategy (P01)&#10;MultilevelAdaptiveRadixStrategy (P05)&#10;KConstrainedHotStrategy (P02)&#10;MacroNodeCollapsingStrategy CoCo (P04)&#10;LoudsDenseSparseStrategy (P10)&#10;JacobsonLoudsStrategy (P09)&#10;WormholeTripleStrategy (P07)&#10;PathCompressedTrieStrategy (P01/P02)&#10;━━━━━━━ S24 Hybrid-Familie (8) + S25 Layout-Theorie (14) + S26 Adaptive-Selectors (3) ━━━━━━━&#10;TripleHashThenBPlus / EmbeddedDecisionSpanTree / JumpPointerArray-Ext/Int / DualJumpPointerArray /&#10;JumpPointerVersionChain / MicroIndexing | vEB-Varianten / CacheSensitiveMultiLevel / LocalReloc /&#10;ProbabilityWeighted / CacheOblivious / BTreeOfCacheLines / VerticalPartitioning / HotPathLayout |&#10;AdaptiveLeafSelector / OfflineSelfTuning / ConfigurationLookup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="1140" height="600" as="geometry"/></mxCell>
        <mxCell id="singular" value="«concept» ISearchPageStrategy Konkretisierungen (Ebene C: 74 Singular-Strategien)&#10;━━━━━━━ S27 Intra-Page Search (22) ━━━━━━━&#10;LinearScanWithinNode | BinarySearchWithinNode | LoopUnrolledBinarySearch | SimdParallelKeyComparison-SSE/AVX2 |&#10;SimdParallelHeadComparison | Fingerprinting-PointLookup | DenseOffsetLookup-FDL | HintNarrowedBinarySearch |&#10;InterpolationSearch | PoorMansNormalizedKeySearch | RankSelectNavigation | TaggedHashSlotLookup | SpeculativeHashedAccess |&#10;IncrementalHashing | LoudsLookup | DfudsRankAccess | ExtensionSpanSearch-B^2 | ByteRangeDecision-B^2 |&#10;DiscriminativeBitsSelection | PrefixingLinearSearch | TwoCandidatePrefetchBinarySearch&#10;━━━━━━━ S28 Intra-Page Insert/Update (15) ━━━━━━━&#10;PermutationFieldInsertion (P03) | AdaptiveLayoutInsertion (P20) | KConstrainedSubtreePartitioning (P02 4-Wege) |&#10;LazyDeletion | LazySortInsertion-Fingerprinting | SequentialInsertHeuristic | SmartSplit | BulkLoadLevelByLevel |&#10;InsertionPathPrefetch | SiblingRedistributionPrefetch | RebuildOnSplit-B^2 | BoundaryAwareSeparatorSelection-FDL |&#10;NodeReplacement-ROWEX | OverflowLeaf-Wormhole | ContentionSplit&#10;━━━━━━━ S29 Intra-Page Layout/Encoding (28) ━━━━━━━&#10;PrefixTruncation | Heads-PoorMansNormalized | Hints | Fingerprinting-LeafLayout | SDL | FDL | IndirectionVector |&#10;InfixSpeicherung-B^2 | SpanNodeLcpCompression-B^2 | LinearizedCompoundNode-HOT | PointerElimination |&#10;NodeGroupContiguous | SegmentedNodeGroup | OrderPreservingCompression | KeyNormalization | NextNeighborDifferencing |&#10;PointerToExtentsCompression | IntegerSliceFormation | AdaptiveSuffixPlacement | PartialKeyEncoding | LcpAwareIntegerEncoding |&#10;EncodingSelection | AlphabetAwareEncoding | SuffixTruncation | PerNodeTypeFindChild | MultilevelNode | RewiredNode | MultilevelNode4&#10;━━━━━━━ S30 Concurrency innerhalb Page (9, 2 Hybride NEU §9.21+§9.22) ━━━━━━━&#10;OptimisticLockCoupling-OLC | ROWEX | RCU | HazardPointers | EpochBasedReclamation | HandOverHandOptimistic |&#10;QuiescentStateBased | TripleClassConcurrency-Wormhole NEU | CopyOnWrite | DualHashTableCopyOnWrite NEU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="2320" height="640" as="geometry"/></mxCell>
        <mxCell id="hint" value="HINWEIS: Diese Konkretisierungen sind als Concept-Konkretisierungen modelliert (analog 11_md F1-F29). Jede konkrete Klasse erbt von einem Concept-Header (`i_*.hpp`).&#10;Hybrid-Aufloesungen via 17 + 5 NEU REV 5 + 12 NEU K10 HybridCompositionCommands (siehe U04). F15-Permutation Saeule A x Saeule B (siehe K12)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="2320" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U08" name="U08 PRT_ART vollstaendige Klasse">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U08 UML - comdare::prt_art vollstaendige Klasse (REV 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Vollstaendige Klassen-Definition: 7-Quellen-Hybrid + 6 Seitentypen + alle Iteratoren + alle Operationen + ValueHandle" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="prtart" value="template &lt;typename Key, typename Value, typename Allocator = std::allocator&lt;std::pair&lt;Key const, Value&gt;&gt;&gt;&#10;class comdare::prt_art : public ISearchEngine&#10;━━━━━━━ Typen (public) ━━━━━━━&#10;+ using key_type = Key&#10;+ using mapped_type = Value&#10;+ using value_type = std::pair&lt;Key const, Value&gt;&#10;+ using size_type = std::size_t&#10;+ using allocator_type = Allocator&#10;+ using value_handle = ValueHandle  // Inline | External | ChainRef&#10;━━━━━━━ Iterator-Typen (Pflicht REV 5) ━━━━━━━&#10;+ class iterator                  - mutable forward iterator (operator++ / operator* / operator-&gt;)&#10;+ class const_iterator&#10;+ class reverse_iterator&#10;+ class const_reverse_iterator&#10;+ class range_iterator            - lex-Modus, getrange-Semantik aus Masstree&#10;+ class key_iterator&#10;+ class value_iterator&#10;+ class prefix_iterator           - NEU REV 5 fuer Prefix-Lookup&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- root_page_ : IRootPage&amp; (CoCo Trie-Huelle)&#10;- page_pool_ : SeitentypPool {Redirect / DenseByte / Multilevel / SparsePatricia / DecisionSpan / CustomAligned}&#10;- value_storage_ : ValueStorage (Inline-Pool + External-Pool + ChainRef-Pool)&#10;- cache_engine_ref_ : optional&lt;CacheEngine&amp;&gt;&#10;- pages_strategy_pattern_ : ISearchPagesStrategyPattern&amp;&#10;- iterator_modes_ : IteratorMode (Default / LokalGeordnet / Lex)&#10;━━━━━━━ Pflicht-Operationen (Termin 1+2 Vergleichsmatrix) ━━━━━━━&#10;+ optional&lt;Value&gt; lookup(Key const&amp;) const                                       - exact lookup successful&#10;+ optional&lt;Value&gt; lookup_or_default(Key const&amp;, Value const&amp;) const               - exact lookup unsuccessful&#10;+ prefix_iterator prefix_lookup(Key const&amp; prefix) const                          - prefix lookup&#10;+ iterator prefix_enumeration(Key const&amp; prefix) const                            - prefix enumeration (forward)&#10;+ range_iterator range_scan(Key const&amp; begin, Key const&amp; end) const              - getrange Lex-Modus&#10;+ pair&lt;iterator, bool&gt; insert(value_type const&amp;)                                  - insert&#10;+ size_type erase(Key const&amp;)                                                     - delete&#10;+ template&lt;typename V&gt; void update(Key const&amp;, V&amp;&amp;)                              - update&#10;+ static prt_art bulk_build(span&lt;value_type const&gt; sorted_pairs)                  - bulk build&#10;+ void compact_rebuild()                                                          - konsolidierter Rebuild&#10;━━━━━━━ Standard-API (kompatibel zu std::map, Domaenenmodell §1A) ━━━━━━━&#10;+ size_type size() const noexcept | bool empty() const noexcept | void clear()&#10;+ iterator begin() / end() / cbegin() / cend() / rbegin() / rend() / crbegin() / crend()&#10;+ allocator_type get_allocator() const noexcept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2320" height="900" as="geometry"/></mxCell>
        <mxCell id="hint" value="HINWEIS REV 5: Iteratoren werden VOLLSTAENDIG implementiert (User-Direktive: 'in all unseren Arbeiten immer vollstaendig').&#10;ValueHandle::Inline / External / ChainRef ist H3-Hypothese (Termin 4) und MUSS aktiv ueber Kostenmodell gewaehlt werden.&#10;Compile-Time Seitenfamilie + Runtime Umschaltregeln (Termin 1) = HybridCompositionCommand-Pattern (siehe U04)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="2320" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K15" name="K15 ICacheEngine-Familien-Taxonomie C1-C12">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K15 KONZEPT - ICacheEngine-Familien-Taxonomie C1-C12 (NEU REV 5.1 - Pendant zu K06 ISearchEngine)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="WICHTIG: F1-F29 in K10 sind WAHL-OPTIONEN; C1-C12 sind die INTERNAL COMPONENTS der Cache-Engine. ~264 atomare Bausteine + ~30 Hybride." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="c1" value="C1 Cache-Layout-Engine (~26 Atoms)&#10;━━━━━━━&#10;Knoten-Format und Footprint&#10;Hostet F1/F3/F4/F8/F11/F12/F13/F14/F15/F16/F17/F19/F22&#10;━━━━━━━&#10;Atoms: Node4/16/48/256 (P01 ART), Single/MultiMask 8/16/32 PKEY (P02 HOT),&#10;MultilevelNode + RewiredVirtualPhysical (P05 START), Segmented/FullPrealloc/&#10;BasicSinglePointer (P12 CSB+), CacheLineSizedNode (P11), MultiCacheLineNode (P03/P21),&#10;EmbeddedSecondaryIndex (P06/P11), IndirectionVector (P03/P15), CacheObliviousVEB (P17),&#10;CacheSensitiveMultiLevel (P18), HotPathLinear (P28), ProbabilityWeightedRootBlock (P16),&#10;PoorMansNormalizedKey (P15/P20), PrefixTruncation (P20), OrderPreservingHuffman (P15),&#10;CodeSpecializedSearch (P11/P12/P14/P23), StridedPadded (P32)&#10;━━━━━━━&#10;Hybride: HOT-9-Layout-Pool, START-Multilevel+Rewired, CSB+ 3-Allocation, B-Tree-adaptive 4-Layout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c2" value="C2 Cache-Pinning-Engine (~10 Atoms)&#10;━━━━━━━&#10;NUMA / Core / Ebenen-Bindung&#10;Ergaenzt F18/F25&#10;━━━━━━━&#10;Atoms: FirstTouchPinning (P28), NumactlBind (P25/P32),&#10;PerCpuQuiescent (P29 RCU), PerThreadHazard (P30 HP),&#10;CrossSocketAvoidance (P03/P25), LargestL3CcdPinning (Auto, ehemals X3D),&#10;HotPathOnHighIpcCore (Auto, ehemals IntelHybrid),&#10;MicroServerCpuBinding (P15), CoreManagerPinning (P31),&#10;IntelThreadDirectorHint (Block AO i9-14900KS)&#10;━━━━━━━&#10;Hybride: Wormhole-3-Klassen-Scheduling (P07), Tomahawk-CoreManager (P31)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c3" value="C3 Cache-Prefetch-Engine (~25 Atoms)&#10;━━━━━━━&#10;Latenz-Hiding: T0/T1/T2/NTA/lfetch/KEEP/STREAM,&#10;WideNodePrefetch (P21), JumpPointerArray-Ext/Int (P21/P22/P26),&#10;DualJumpCachePlusDisk (P22), CoroutineFullNode/HalfNode (P25),&#10;BundlePrefetch d=90 (P27), StridedScalar (P32), PartitionStride 30-42 (P32),&#10;PathPrefetch + MonitorPrefetch + CachePrefetchInsideNode (P26),&#10;PostLocationCheck (P15), MultiRecordHint (P15), TwoNodesAheadRangeScan (P14),&#10;RuntimeAdaptiveDistance + AffineDistance + TemplateSpecializer (P23 Khan)&#10;━━━━━━━&#10;Hybride: ThreePrefetcherOrch (P26), KhanDynamicSpecializer (P23), CoroutineSelection (P25),&#10;ItaniumPrefetch (P14), GraefePrefetchSurvey (P15), ChenPrefetchedBPlus (P21)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c4" value="C4 Cache-Coherence-Engine (~12 Atoms)&#10;━━━━━━━&#10;Reader/Writer-Asymmetrie + Sync&#10;Hostet F18/F25&#10;━━━━━━━&#10;Atoms: OptimisticLockCoupling (P03/P06/P08), Rowex (P02/P08),&#10;RcuQsbr (P29/P07), RcuMembarrier, RcuSignal (URCU 6-Flavor),&#10;HazardPointer (P30), EpochBasedReclamation, HtmTransactional (P08),&#10;HandOverHandLocking (P03), Cow (P02), MfenceLfence (P05/P29),&#10;NoSharedWrite (P03/P08/P29/P30)&#10;━━━━━━━&#10;Hybride: Wormhole 3-Class-Sync (P07), ART-OLC + ROWEX (P08), HOT-COW + Obsolete-Marker (P02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c5" value="C5 Cache-Telemetry-Engine (~22 Atoms)&#10;━━━━━━━&#10;Mess- + Probe-Strategien (Hostet F23/F24)&#10;PerNodeCounter (P28 - mit Coherence-Falle!),&#10;LeafOnlyCounter + LeafOnlySampledCounter&lt;N&gt; + RetroactiveAggregation (P28-Mail NEU 2026-05-08),&#10;PathReadCounter + MonitorClustering (P26), JaccardSimilarity + BundleIdentification + CompressionBufferFifo (P27),&#10;HotPathExtraction (P28), FbFullCounter (P25),&#10;Clflush/Latency/Perfmon/Papi/VTune-Probe, CardenasFormula (P13),&#10;SlidingWindowDrift (P28-Future), ReuseDistance + OverpredictionGate (P24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c6" value="C6 Cache-Allocation-Engine (~17 Atoms)&#10;━━━━━━━&#10;Allocator + Ebenen-Auswahl (Hostet F1/F12/F21/F27)&#10;━━━━━━━&#10;Malloc, Jemalloc, Mimalloc, MmapAnonymous, MemfdCreate (P05),&#10;RewiredVirtualPhysicalAllocator (P05), HugePages, NumaLocalAllocator (P25/P32),&#10;HbmAllocation (P25/P33), LpddrAllocation (P25 Grace), NvramAllocation (P33),&#10;CxlAllocation (Future), PoolAllocator, SegmentedAllocator (P12),&#10;OverflowPageAllocator (P22), NfpDecorator (P33), VMalloc (P33)&#10;━━━━━━━&#10;Hybride: VAMPIR V-malloc + Compensation (P33), START Rewiring + memfd (P05), Multi-Ebenen-Allocator HBM+DRAM+NVRAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="840" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="c7" value="C7 Cache-Migration-Engine (~12 Atoms)&#10;━━━━━━━&#10;Ebenen-Migration + Compensation (F9/F19/F27)&#10;━━━━━━━&#10;HotColdSegregation (P02/P05/P10), LayerCutoff R=64 (P10 SuRF),&#10;MultiTierMigration Cache+Disk (P22), DramHbmMigration (P25/P33),&#10;CompensationMigration (P33), LocalRelocation alpha 1-6 (P19), GlobalRelocation BFS (P19),&#10;LayoutInvariantPreservation (P19), HotPathRefresh (P28+P28-Mail), BulkUpdateRebuild (P04),&#10;OnlineSelfTuningTrigger (P05), LayoutDegradationTrigger (P19)&#10;━━━━━━━&#10;Hybride: Saikkonen Local+Global (P19), Kuehn Hot-Path-Refresh (P28-Mail), VAMPIR Compensation (P33)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="c8" value="C8 Cache-Encoding-Engine (~28 Atoms)&#10;━━━━━━━&#10;Topologie + Bit-Packing (F2/F10/F16/F17/F19/F20)&#10;━━━━━━━&#10;LoudsEncoding + LoudsDense + LoudsSparse (P09/P10), DfudsEncoding, BalancedParentheses,&#10;PointerTopology, BitArrayTopology, EliasFano + PackedArray + Bitvector + Dense (P04 CoCo),&#10;PointerTag (P01/P02/P05/P07), OrderPreservingHuffman + KeyNormalization + PrefixSuffixTrunc + NextNeighborDiff (P15),&#10;RankSelectPrimitive + BlockOrientedRankSelect (P09/P10), JacobsonTwoLevelDirectory + PoppyRank,&#10;PartialKeyEncoding 8/16/32 (P02), SuRFBase/Hash/Real/Mixed (P10),&#10;WAH/PLWAH/COMPAX (P31)&#10;━━━━━━━&#10;Hybride: CoCo Encoding-Pool, SuRF Cutoff-Hybrid, SuRF Filter-Pool, Graefe Compression-Suite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1180" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="c9_12" value="C9 Cache-Heuristik-Engine (~73 Atoms ORTHOGONAL) + C10 Cache-Topologie-Engine (~17) + C11 Cache-Scheduler-Engine (~13) + C12 Cache-Filter-Engine (~9)&#10;━━━━━━━&#10;C9 Heuristik (orthogonal): Layout-Selection + Cost-Modell + AdaptivePrefetchDistance + Workload-Detection + Coherence-Pressure + Telemetry-getrieben + Search-Strategy-Selection + Workload-Mix + Hardware-Probing&#10;Hybride: Samuel ConfigurationTable (P14), Khan DynamicSpecializer (P23), Hankins-Patel Cost-Modell (P13), Block-AO Production-Dispatch&#10;━━━━━━━&#10;C10 Topologie (Saeule-B-Adapter): Cpuid + Sysfs + Hwloc + ProcCpuinfo + ClflushCycle + AllPairsPinning + CacheCoherenceCost + TlbCapacity + PrefetcherStream + AsymmetricL3 + HybridCore + HbmTier + IsaFeatureSet + InterconnectTopology + MemoryBandwidth + NumaTopology + PropertyPublisher&#10;Hybride: 5-Schritt Auto-Discovery (REV3), Block AO Auto-Discovery, Multi-Tool-Probe&#10;━━━━━━━&#10;C11 Scheduler: OfflineSelfTuning (P05) + PeriodicGlobalReloc (P19) + MicroServerScheduler (P15) + WorkerThreadAsync (P26) + CoreManagerScheduler (P31) + MultiQueryPipeline (P33) + OptimisticLocking (P03/P06/P08) + RcuGracePeriod (P29) + HazardPointer (P30) + Htm (P08) + BackgroundCheckpoint (P03) + RebalanceAmortization (P17) + RetroactiveAggregation (P28-Mail)&#10;Hybride: Wormhole 3-Class-Scheduler (P07), Tomahawk Core Manager (P31), Kuehn Hot-Path-Scheduler (P28-Mail)&#10;━━━━━━━&#10;C12 Filter (F29): BloomFilter, SuRFFilter (P10), CuckooFilter, AdaptiveRangeFilter, SuRF 4 Encoding-Varianten, FalsePositiveRateModel, FilterStorageMedium&#10;Hybride: SuRF Filter-Pool mit FPR-Tuning (P10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="2300" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U09" name="U09 ICacheEngine UML State+Visitor+Pipeline (REV 5.2)">
    <mxGraphModel dx="2400" dy="1900" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U09 UML - ICacheEngine als State-Pattern + Visitor-Pattern + Pipeline (REV 5.2 KOMPLETT NEU)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Klassisches UML: ICacheEngine ist Visitor (bedient Requester) + State-Pattern (monitort Plattform) + Pipeline-Mediator (orchestriert 12 Sub-Engines C1-C12). Quellen: extract_state_visitor_per_paper.md + extract_state_visitor_pattern.md + 33-Paper-Lektuere." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="layer_request" value="REQUEST-INTERFACE - aufrufende ISearchPageStrategy / ICacheStrategy" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="ctx" value="«struct» RequestContext (Read-only Snapshot vom Caller)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ caller_engine : IExecutingEngine const&amp;&#10;+ search_page : ISearchPage const&amp;&#10;+ search_page_structure : ISearchPageStructure const&amp;&#10;+ requested_inode : INode const&amp;&#10;+ operation_kind : enum {Lookup, Insert, Erase, RangeScan, PrefixScan, BulkBuild, Compact}&#10;+ key : KeyView&#10;+ value_size_hint : optional&lt;size_t&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1100" height="240" as="geometry"/></mxCell>
        <mxCell id="rec" value="«struct» CacheRecommendation (Rueckgabe an Caller, NICHT void!)&#10;━━━━━━━ Attribute (public) ━━━━━━━&#10;+ verdict : enum {DoNothing, Hint, Reshape, Migrate, Allocate, Abort}&#10;+ alloc_hint : optional&lt;MemoryAllocationHint&gt;     (NEU Speicher mit Ebenen-Wahl)&#10;+ layout_proposal : optional&lt;LayoutChangeProposal&gt; (Knoten-Geometrie aendern)&#10;+ prefetch_advice : optional&lt;PrefetchAdvisory&gt;     (Distance + Targets + Mode)&#10;+ migration_directive : optional&lt;MigrationDirective&gt; (Ebenen-Wechsel)&#10;+ pinning_directive : optional&lt;PinningDirective&gt;   (Core-Bindung)&#10;+ pressure_summary : PressureSummary               (fuer Telemetry)&#10;+ confidence : double  (0.0-1.0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="180" width="1180" height="240" as="geometry"/></mxCell>
        <mxCell id="layer_engine" value="ICACHE-ENGINE - Mediator + Pipeline + State-Holder" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="ice" value="«concept» ICacheEngine (Top-Level Entry-Point fuer Caller)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- pressure_state_ : PressureState                  (State-Pattern Aggregat - siehe unten)&#10;- sub_engines_ : array&lt;unique_ptr&lt;ISubEngine&gt;, 12&gt; (12 Pipeline-Stufen C1-C12)&#10;- snapshot_cache_ : optional&lt;PlatformSnapshot&gt;     (TTL-basiert, ~100 ms)&#10;- recommendation_history_ : RingBuffer&lt;CacheRecommendation&gt; (Telemetry/Audit)&#10;- mediator_dispatch_ : function&lt;void(SubEngineEvent)&gt; (Sub-Engine-Koordination)&#10;━━━━━━━ Methoden (public) - Externes Interface ━━━━━━━&#10;+ advise(ctx : RequestContext const&amp;) : CacheRecommendation&#10;+ snapshot() const : PlatformSnapshot&#10;+ register_sub_engine(slot : SubEngineSlot, engine : unique_ptr&lt;ISubEngine&gt;) : void&#10;+ on_pressure_transition(from : PressureState, to : PressureState) : void&#10;━━━━━━━ Methoden (private) - Mediator-Pattern Interna ━━━━━━━&#10;- run_pipeline(snap : PlatformSnapshot, ctx : RequestContext) : CacheRecommendation&#10;- merge(running : CacheRecommendation, delta : CacheRecommendation) : CacheRecommendation&#10;- notify(sender : ISubEngine*, event : SubEngineEvent) : void&#10;━━━━━━━ Pattern-Rolle ━━━━━━━&#10;Visitor-Wurzel (von aussen besucht durch ISearchPageStrategy)&#10;Mediator (koordiniert die 12 Sub-Engines)&#10;State-Holder (haelt PressureState als std::variant)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="2320" height="440" as="geometry"/></mxCell>
        <mxCell id="layer_state" value="STATE-PATTERN - Plattform-Zustand-Modellierung (5 Konkrete States)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="ps" value="using PressureState = std::variant&lt; Idle, Warmup, Saturated, CoherenceStorm, Recovery &gt;&#10;━━━━━━━ C++23 std::variant (statt klassischer GoF-Hierarchie - value-Semantik, Compile-Time-Exhaustiveness) ━━━━━━━&#10;«struct» Idle           - Cache-Druck &lt; 30 Prozent, last_check_ns&#10;«struct» Warmup         - mpki, pages_loaded - Khan 2010 Stil&#10;«struct» Saturated      - bandwidth_util, mshr_pressure - Mahling 2025 weak-reliability&#10;«struct» CoherenceStorm - inter_socket_msgs_per_us, affected_sockets - Stenstroem-Analyse&#10;«struct» Recovery       - remaining ms - Naderan-Tahan 2016 Negative-State&#10;━━━━━━━ State-Transitions (Trigger aus 33-Paper-Tieflektuere) ━━━━━━━&#10;Idle -&gt; Warmup           : erste Zugriffe, MPKI &gt; 0&#10;Warmup -&gt; Saturated      : Bandwidth-Util &gt; 80%, MSHR-Stalls (P25 Mahling, P21 Chen)&#10;Saturated -&gt; CoherenceStorm : Cross-Socket-Traffic &gt; Threshold (P28 Block AN, P03 Masstree)&#10;CoherenceStorm -&gt; Recovery : Stress-Reduktion, kuehlende Caches&#10;Recovery -&gt; Idle         : Steady-State erreicht&#10;━━━━━━━ Negative-State-Detection (P24 Naderan-Tahan) ━━━━━━━&#10;Wenn Hit-Rate von Prefetch &lt; 30%, dann verdict=DoNothing (Negative-Recommendation)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="2320" height="380" as="geometry"/></mxCell>
        <mxCell id="layer_visitor" value="VISITOR-PATTERN - Acyclic mit Rueckgabe (Praezedenz LLVM InstVisitor&lt;SubClass, RetTy&gt;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="ievis" value="«concept» ICacheEngineVisitor (Acyclic-Visitor-Wurzel - Robert C. Martin)&#10;━━━━━━━ Marker-Interface ━━━━━━━&#10;+ virtual ~ICacheEngineVisitor() = default&#10;━━━━━━━ Pro-State Visitor-Interface (Sub-Visitor) ━━━━━━━&#10;template&lt;class StateT&gt;&#10;«concept» VisitorFor&lt;StateT&gt; : public virtual ICacheEngineVisitor&#10;  + virtual visit(state : StateT const&amp;, ctx : RequestContext const&amp;) : CacheRecommendation = 0&#10;━━━━━━━ Konkretisierungen ━━━━━━━&#10;VisitorFor&lt;Idle&gt;             - liefert DoNothing&#10;VisitorFor&lt;Warmup&gt;           - liefert IncreasePrefetch (mpki)&#10;VisitorFor&lt;Saturated&gt;        - liefert ThrottlePrefetch (mshr_pressure)&#10;VisitorFor&lt;CoherenceStorm&gt;   - liefert PinHotPages (affected_sockets)&#10;VisitorFor&lt;Recovery&gt;         - liefert WaitAndMeasure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="iestate" value="«concept» ICacheEngineState (akzeptiert Visitor)&#10;━━━━━━━ Methoden ━━━━━━━&#10;+ virtual ~ICacheEngineState() = default&#10;+ virtual accept(visitor : ICacheEngineVisitor&amp;, ctx : RequestContext const&amp;) const : CacheRecommendation = 0&#10;━━━━━━━ Modern-C++23-Alternative (Overload-Pattern + std::visit) ━━━━━━━&#10;CacheRecommendation react(state : PressureState const&amp;, ctx : RequestContext const&amp;)&#10;{ return std::visit(Overload{&#10;    [](Idle const&amp;)            { return CacheRecommendation::DoNothing(); },&#10;    [](Warmup const&amp; w)        { return CacheRecommendation::IncreasePrefetch(w.mpki); },&#10;    [](Saturated const&amp; s)     { return CacheRecommendation::ThrottlePrefetch(s.mshr_pressure); },&#10;    [](CoherenceStorm const&amp; c){ return CacheRecommendation::PinHotPages(c.affected_sockets); },&#10;    [](Recovery const&amp;)        { return CacheRecommendation::WaitAndMeasure(); }&#10;}, state); }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="1420" width="1140" height="320" as="geometry"/></mxCell>
        <mxCell id="layer_pipeline" value="PIPELINE - 12 Sub-Engines in deterministischer Reihenfolge (Telemetry first, Behavior last)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="isub" value="«concept» ISubEngine (Pipeline-Stufe + Mediator-Teilnehmer)&#10;━━━━━━━ Methoden (public abstract) ━━━━━━━&#10;+ virtual name() const noexcept : string_view&#10;+ virtual family_kind() const noexcept : SubEngineSlot  (z.B. C03_Prefetch)&#10;+ virtual advise(snap : PlatformSnapshot, ctx : RequestContext, running : CacheRecommendation) : CacheRecommendation = 0&#10;+ virtual on_event(event : SubEngineEvent) : void   (Mediator-Callback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1800" width="1140" height="200" as="geometry"/></mxCell>
        <mxCell id="pipe_order" value="PIPELINE-REIHENFOLGE (deterministisch)&#10;━━━━━━━&#10;1.  C05 Telemetry      - PMU-Sampling, MPKI, FB_FULL (P25/P26/P27/P28)&#10;2.  C10 Topologie      - NUMA, Cache-Hierarchie (P05/P25/P28/P32/P33)&#10;3.  C09 Heuristik      - liest State + Topologie -&gt; Decision (alle 33 Paper)&#10;4.  C01 Layout         - Knoten-Geometrie (P01/P02/P05/P11/P12/P13/P15/P16/P17/P20)&#10;5.  C08 Encoding       - Bit-Packing, Path-Compression (P04/P09/P10/P15/P31)&#10;6.  C06 Allocation     - Ebenen-Auswahl, Pool (P05/P22/P25/P31/P33)&#10;7.  C02 Pinning        - Core-Bindung (P03/P25/P28/P29/P31/P32/P33)&#10;8.  C07 Migration      - Ebenen-Migration (P19/P22/P25/P28/P33)&#10;9.  C03 Prefetch       - Latenz-Hiding (P02/P14/P21/P22/P23/P25/P26/P27)&#10;10. C04 Coherence      - MOESI-Beobachtung (P03/P06/P07/P08/P28/P29/P30)&#10;11. C12 Filter         - Spaetfilter (P10 SuRF)&#10;12. C11 Scheduler      - Background-Defrag (P05/P15/P26/P28/P29/P31/P33)&#10;━━━━━━━&#10;Begruendung: Information first, Structure second, Allocation third, Behavior last" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="1800" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="impl" value="C++ Pipeline-Implementierung (von ICacheEngine.advise() aufgerufen)&#10;━━━━━━━&#10;CacheRecommendation ICacheEngine::advise(RequestContext const&amp; ctx) {&#10;  PlatformSnapshot snap = make_snapshot();                              // C10 Topologie + C05 Telemetry&#10;  pressure_state_ = classify_pressure(snap);                            // State-Update&#10;  CacheRecommendation acc = std::visit(state_overload, pressure_state_); // Visitor-Pattern Wurzel&#10;  for (auto&amp; sub : sub_engines_) {                                       // Pipeline ueber 12 Sub-Engines&#10;    CacheRecommendation delta = sub-&gt;advise(snap, ctx, acc);&#10;    acc = merge(acc, delta);&#10;    if (delta.verdict == Verdict::Abort) break;                          // Frueh-Ausstieg&#10;  }&#10;  recommendation_history_.push(acc);&#10;  return acc;                                                            // an Caller (ISearchPageStrategy)&#10;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2020" width="2320" height="200" as="geometry"/></mxCell>
        <mxCell id="hint" value="MUSTER-ZUSAMMENFASSUNG (REV 5.2):&#10;ICacheEngine ist gleichzeitig Visitor (von aussen) + Mediator (zwischen Sub-Engines) + State-Holder (Plattform-Zustand) + Pipeline-Orchestrator (deterministische 12-Sub-Engine-Reihenfolge).&#10;Caller ISearchPageStrategy ruft engine.advise(ctx) und erhaelt CacheRecommendation mit konsolidierter Empfehlung.&#10;Praezedenz: LLVM InstVisitor&lt;SubClass, RetTy&gt; (Visitor mit Rueckgabe), Java HotSpot CompilerVisitor (Pipeline), Mediator-Pattern Refactoring.guru, GoF State-Pattern modernisiert via std::variant + std::visit + P2637R3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2240" width="2320" height="140" as="geometry"/></mxCell>
        <mxCell id="r_ctx_ice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="ctx" target="ice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ctx_lbl" value="Caller passt RequestContext" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="r_ctx_ice"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ice_rec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=0;entryX=0.5;entryY=1;endArrow=open;startArrow=none;dashed=1;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="ice" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ice_lbl" value="Engine liefert CacheRecommendation" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="r_ice_rec"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ice_ps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#4A148C;strokeWidth=3;" edge="1" parent="1" source="ice" target="ps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ice_lbl2" value="haelt 1 PressureState" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#4A148C;" vertex="1" connectable="0" parent="r_ice_ps"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ievis_iestate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;dashed=1;strokeColor=#1B5E20;strokeWidth=3;" edge="1" parent="1" source="ievis" target="iestate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_visit_lbl" value="visit (Acyclic) / std::visit (Modern)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#1B5E20;" vertex="1" connectable="0" parent="r_ievis_iestate"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_isub_pipe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="isub" target="pipe_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_isub_lbl" value="12 Pipeline-Stufen" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_isub_pipe"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
      </root>
