    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K11 KONZEPT - Drei-Ebenen-Verbindungen + Phase 1-7 Pipeline (REV 5 mit Pfeil-Korrektur Phase 5 -&gt; 6 -&gt; 7)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Wer was wann macht - vom IExecutingEngine bis zur Permutations-Hardware-Bindung. KORREKTUR REV 5: Phase 5 -&gt; Phase 6 -&gt; Phase 7 (sequentiell)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="phase1" value="Phase 1 - DISCOVER&#10;━━━━━━━&#10;IPlatformProbe entdeckt:&#10;- ICacheTopology (L1/L2/L3/HBM)&#10;- ICoreLayout (P/E-Cores)&#10;- IIsaFeatureSet (AVX-512, NEON)&#10;- IBusTopology (NUMA, CCD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase2" value="Phase 2 - MEASURE&#10;━━━━━━━&#10;Mikrobenchmarks:&#10;- clflush-cycle&#10;- All-Pairs-Pinning&#10;- Cache-Coherence-Cost&#10;- DDR5-Latency-Calibration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase3" value="Phase 3 - CLASSIFY&#10;━━━━━━━&#10;IPlatformPropertyClassifier:&#10;PlatformPropertySet =&#10;{ has_asymmetric_l3,&#10;  has_hybrid_cores,&#10;  preferred_pinning,&#10;  usable_simd_width,&#10;  + 8 NEUE REV 5 }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase4" value="Phase 4 - PUBLISH&#10;━━━━━━━&#10;ICacheEngineOptionPublisher&#10;publish_options_to(modules)&#10;━━━━━━━&#10;Permutations erhalten nur die&#10;Optionen die sie konsumieren&#10;koennen (compile-time-Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase5" value="Phase 5 - BIND&#10;━━━━━━━&#10;ICacheStrategy-Visitor wird&#10;CacheEngineStrategy:&#10;Pattern -&gt; Plural-Strategy -&gt;&#10;Singular-Strategy -&gt; Heuristic&#10;━━━━━━━&#10;Saeule A und B physisch verbunden&#10;NEU REV 5: 4 Build-Varianten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1680" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase6" value="Phase 6 - EXECUTE (REV 5 KORRIGIERT - vorher uebersprungen!)&#10;━━━━━━━&#10;IExecutingEngine.execute() ->&#10;  ISearchEngine.search() ->&#10;    IFanout.distribute() ->&#10;      ISearchPagesStrategy ->&#10;        ISearchPageStrategy(N) ->&#10;          ICacheStrategy(N) ->&#10;            IHeuristic.score()&#10;━━━━━━━&#10;ISearchPageStructureInterpreter dekodiert (NEU REV 5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1180" height="240" as="geometry"/></mxCell>
        <mxCell id="phase7" value="Phase 7 - COMPARE (F15 - die Forschungsmission)&#10;━━━━━━━&#10;Permutations-Builds + Experiment-Loop:&#10;V1 BaseEngineStrategy (ohne CacheEngine, Baseline)&#10;V2 CacheEngineStrategy + HEURISTIC_STATIC&#10;V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#10;V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#10;Vergleich pro 4-Ebenen-Tupel x 4 Engine-Varianten:&#10;Throughput / Latency / Cache-Miss / Bandwidth /&#10;Cache-Coherence-Bus-Verkehr / Energieverbrauch&#10;═════ ECHTE Permutationsmaschine ═════" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="1100" height="240" as="geometry"/></mxCell>
        <mxCell id="vec_a" value="VERTIKALE EBENEN-AUFRUFE (Saeule A oben - Saeule B unten)&#10;━━━━━━━&#10;Ebene 1 (IExecutingEngine) waehlt zwischen Search-/Future-Engine&#10;Ebene 2 (Saeule A) sucht physisch in PRT-ART-Strukturen&#10;Ebene 3 (Saeule B) liefert die HW-Bindung jeder Saeule-A-Wahl&#10;━━━━━━━&#10;Visitor-Pattern: ICacheStrategy.visit(BaseEngineStrategy) vs visit(CacheEngineStrategy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="2320" height="220" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase1" target="phase2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase2" target="phase3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase3" target="phase4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase4" target="phase5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_neu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="phase5" target="phase6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5l" value="KORRIGIERT REV 5" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFE0B2;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="e5_neu"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e6_neu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="phase6" target="phase7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K12" name="K12 Forschungsmission F15 + Cache+Search Cross">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K12 KONZEPT - Forschungsmission F15 + Cache+Search Cross-Permutation (REV 5 erweitert)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A03700;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="User-Korrektur 2026-05-11: Bausteine der Cache-Engine permutieren GEGEN Permutationen der Search-Engine (Cross-Matrix)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="mission" value="FORSCHUNGSMISSION&#10;━━━━━━━&#10;Saeule B Cache-Engine erzeugt durch Plattform-Modell-Auswertung Permutations-Familien,&#10;die Saeule A vorher fest entscheidet - und beweist, dass diese dynamische Komposition&#10;messbar bessere Lookup-Zeiten als statisch vordefinierte Algorithmen liefert auf&#10;konkreter Plattform (z.B. Block AO Ryzen 9 9950X3D + i9-14900KS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="1840" height="180" as="geometry"/></mxCell>
        <mxCell id="search_dim" value="SUCH-DIMENSION (Saeule A) - K06 ISearchEngine-Familien&#10;━━━━━━━&#10;- 21 Patterns (S1-S21)&#10;- 41 Plural-Strategien (S22-S26)&#10;- 74 Singular-Strategien (S27-S30)&#10;- 12+ neue Hybrid-Auflosungen (§9.18-§9.22)&#10;━━━━━━━&#10;Total: 21 x 41 x 74 = ~63.714 Such-Tupel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="700" height="280" as="geometry"/></mxCell>
        <mxCell id="cross" value="x x x CROSS-PERMUTATION (NEU REV 5) x x x&#10;━━━━━━━&#10;Jede Such-Engine-Konfiguration (Saeule-A-Tupel)&#10;wird gegen alle Cache-Engine-Modi (Saeule-B-Tupel)&#10;gemessen, um die beste Cross-Kombination zu finden.&#10;━━━━━━━&#10;Beispiel-7-Tupel:&#10;Such-Tupel: {LayerMixPattern, Trie-Familie,&#10;             AdaptiveRadixTreeStrategy,&#10;             AdaptivePrefetchDistanceHeuristic}&#10;Cache-Tupel: {F1.AdaptiveFootprint,&#10;              F5.SoftwarePrefetch,&#10;              F24.TelemetryDriven}&#10;Engine-Choice: V3 INFORMED_KALIBRIERT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="380" width="800" height="380" as="geometry"/></mxCell>
        <mxCell id="cache_dim" value="CACHE-DIMENSION (Saeule B) - K10 Cache-Familien&#10;━━━━━━━&#10;- 29 Cache-Familien (F1-F29)&#10;- ~80-85 IHeuristic-Konkretisierungen&#10;- 28+ Plattform-Concepts&#10;- 12+ neue Hybrid-Auflosungen (§10.21-§10.32)&#10;━━━━━━━&#10;Total: 29 x 80 = ~2.320 Cache-Tupel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="380" width="700" height="280" as="geometry"/></mxCell>
        <mxCell id="engine_dim" value="ENGINE-CHOICE-DIMENSION (REV 5 NEU - K3 Erweiterung)&#10;━━━━━━━&#10;4 Build-Varianten pro Tupel:&#10;V1 BaseEngineStrategy (Baseline F15)&#10;V2 CacheEngineStrategy + HEURISTIC_STATIC&#10;V3 CacheEngineStrategy + INFORMED_KALIBRIERT&#10;V4 CacheEngineStrategy + AUTOMATIC_ADAPTIVE&#10;━━━━━━━&#10;= ~63.714 x ~2.320 x 4 = ~590 Mio. theoretische Tupel&#10;ConstraintFilter (compile-time-Concepts) reduziert auf&#10;~10.000-50.000 valide Permutationen pro Plattform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="2280" height="200" as="geometry"/></mxCell>
        <mxCell id="report" value="PFLICHT-REPORTING (Termin 6 T6-AA): 5 Rohlaeufe, keine Mittelung von Perzentilen, getrennte Ausweisung nach Plattform x Core-Typ x ISA x Cache-Engine-Modus&#10;━━━━━━━&#10;D1 Plattform: 9 Pflicht (VisionFive 2 / RPi 5 / Mac mini M1 / ODROID-H4 / i7-1270P / i9-14900KS / Ryzen 9 9950X3D / Barnard / Grace Hopper GH200)&#10;D2 ISA: 5 (scalar / x86_avx2 / x86_avx512 / arm_neon / arm_sve2)&#10;D3 Core-Typ: 2 (cpu_core P / cpu_atom E)&#10;D4 Cache-Engine-Modus: 3 (passiv / Warm-up / online-adaptiv)&#10;D14 Suchalgorithmus-Baseline: ART / HOT / Masstree / B^2-tree / CoCo-trie / START / Wormhole + PRT-ART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="2280" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K13" name="K13 Future-Proof-Prinzipien">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K13 KONZEPT - 7 Future-Proof-Prinzipien (REV 5 aus REV 4)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#311B92;strokeColor=#1A0E5C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Software-Engineering-Prinzipien fuer langlebige Architektur - Open/Closed, Modular, Encapsulation, SRP, SoC, API-First, DSM" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#311B92;fontColor=#311B92;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="p1" value="P1 Open/Closed-Prinzip&#10;━━━━━━━&#10;Concept-Klassen (ICacheStrategy, IPage, IHeuristic, ISearchPageStructure, ISearchPageStructureInterpreter)&#10;sind closed for modification - Methoden-Signaturen sind Contracts&#10;Konkretisierungen sind open for extension via C++23 Templates + requires-Klausel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p2" value="P2 Modular Architecture&#10;━━━━━━━&#10;Jede Achse einer Matrix (Layer-Matrix-Hybrid) ist unabhaengig austauschbar&#10;Konkretisierungen pro Cache-Familie pro ISA pro Plattform-Property pro Concurrency-Mechanik pro Telemetry-Strategie&#10;Verzeichnis-Granularitaet: pro Achse pro Familie pro Konkretisierung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1210" y="160" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p3" value="P3 Encapsulation through stable contracts&#10;━━━━━━━&#10;Concept-Header (i_*.hpp) sind die einzigen oeffentlichen API-Punkte&#10;Implementierungs-Header (*.hpp ohne i_-Praefix) sind privat zur Konkretisierungs-Achse&#10;Aenderungen innerhalb einer Achse beeinflussen keine anderen Achsen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p4" value="P4 Single Responsibility auf Architektur-Ebene&#10;━━━━━━━&#10;IPage = logische Seiten-Abstraktion&#10;ISearchPageStructure = Codierung (NEU REV 5)&#10;ISearchPageStructureInterpreter = Decodier-Logik (NEU REV 5)&#10;ICacheStrategy = Read/Write/Layout-Routing-Visitor&#10;IHeuristic = Wert-/Kostenberechnung&#10;IPlatformProbe = Auto-Discovery der Plattform" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1210" y="360" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p5" value="P5 Separation of Concerns&#10;━━━━━━━&#10;Saeulen A (Strategien) und B (Plattform-Modell) sind disjunkt&#10;Engine konsumiert nur abstrakte Schnittstellen - kennt keine konkreten Implementierungen&#10;DecisionLambdaTrees vermitteln Events zwischen den Saeulen ohne direkte Abhaengigkeit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p6" value="P6 API-First Design&#10;━━━━━━━&#10;Jede Erweiterung beginnt mit einer Concept-Erweiterung (oder neuem Concept-Header)&#10;Erst wenn die API stabil ist, folgen Konkretisierungen&#10;Aenderungen an Concepts erfordern formelle Architektur-Korrekturrunde (REV 1-2-3-4-5 Vorgehen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1210" y="560" width="1130" height="180" as="geometry"/></mxCell>
        <mxCell id="p7" value="P7 Dependency Structure Matrix (DSM)&#10;━━━━━━━&#10;DSM-Matrix mit allen Concepts als Zeilen + Spalten&#10;Zellen markieren vorhandene Abhaengigkeiten (uses, composes, inherits)&#10;Ziel: Block-Triangulare Struktur (saubere Layer-Trennung)&#10;Tooling: Lattix / Structure101 / eigenes Skript&#10;Phase-6+ Werkzeug fuer architektonisches Reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="2280" height="200" as="geometry"/></mxCell>
        <mxCell id="hint" value="Web-Recherche-Quellen (REV 4 §8, 11 URLs):&#10;codewave.com / moldstud.com / buildsimple.substack.com / superblocks.com / transcenda.com / ResearchGate / strapi.io /&#10;O'Reilly Layered Architecture Patterns / Wikipedia Multitier / DZone DSM / Bitloops Layered Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="2280" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K14" name="K14 Layer-Matrix-Hybrid + DSM">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K14 KONZEPT - Layer-Matrix-Hybrid + DSM (REV 5 aus REV 4 MX1)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#0D47A1;strokeColor=#062F6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Antwort auf Architekt-Frage: Reichen Layer? Oder Matrix? HYBRID = Layer fuer Architektur-Reasoning + Matrix fuer Konkretisierungs-Skalierung" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#0D47A1;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="layer" value="LAYER-DIMENSION (vertikal, klassisch)&#10;━━━━━━━&#10;Drei Ebenen aus K01: Engine | Strategien | CacheEngine&#10;Ein Concept gehoert genau einem Layer&#10;Klare Abhaengigkeits-Richtung (oben -&gt; unten)&#10;━━━━━━━&#10;Vorteil: Encapsulation, stabile Contracts, einfaches Reasoning,&#10;Open/Closed pro Layer (siehe K13 P1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="1100" height="240" as="geometry"/></mxCell>
        <mxCell id="matrix" value="MATRIX-DIMENSION (horizontal, fuer F15-Bausteine-Quer-Permutation)&#10;━━━━━━━&#10;Pro Layer existiert eine Matrix der Konkretisierungen entlang mehrerer orthogonaler Achsen.&#10;━━━━━━━&#10;Konkrete Achsen (REV 5 erweitert):&#10;- Cache-Familie F1-F29 (siehe K10)&#10;- Such-Familie S1-S30 (NEU REV 5 K06)&#10;- Strategie-Ebene A-D (Pattern / Plural / Singular / Heuristic)&#10;- Plattform-Property (12+ aus PlatformPropertySet)&#10;- ISA-Feature (AVX-512, BMI2, NEON, SVE2, RISC-V V-Ext)&#10;- Concurrency-Mechanik (OLC, ROWEX, RCU 6-Flavors, Hazard, EBR, QSBR)&#10;- Telemetry-Strategie (PerNode, LeafOnly, Sampled, Retroactive)&#10;- Cache-Engine-Modus (Static / Warmup / Adaptive - NEU REV 5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="1180" height="320" as="geometry"/></mxCell>
        <mxCell id="hybrid" value="HYBRID-EMPFEHLUNG: Layer + Matrix kombiniert&#10;━━━━━━━&#10;Beispiel-Verzeichnis (ICacheStrategy):&#10;search_engine/&#10;concepts/&#10;  i_cache_strategy.hpp                    (Concept-Header - Contract)&#10;  i_search_page_structure.hpp             (NEU REV 5)&#10;  i_search_page_structure_interpreter.hpp (NEU REV 5)&#10;cache_strategies/                          (Matrix-Layer)&#10;  visitor_variants/                        (Achse 1)&#10;    base_engine_strategy.hpp               (1A)&#10;    cache_engine_strategy.hpp              (1B)&#10;  families/                                (Achse 2)&#10;    f01_adaptive_footprint/                (F1)&#10;      art_node_footprint_strategy.hpp      (P01)&#10;      hot_layout_footprint_strategy.hpp    (P02)&#10;    f02_succinct_encoding/                 (F2)&#10;      louds_jacobson_encoding_strategy.hpp (P09)&#10;      ...&#10;search_page_structures/                    (NEU REV 5)&#10;  redirect_structure.hpp / redirect_interpreter.hpp&#10;  dense_byte_structure.hpp / dense_byte_interpreter.hpp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="1700" height="500" as="geometry"/></mxCell>
        <mxCell id="dsm" value="DSM (Phase 6+ Werkzeug)&#10;━━━━━━━&#10;Dependency Structure Matrix mit allen&#10;Concepts als Zeilen + Spalten&#10;Zellen markieren vorhandene&#10;Abhaengigkeiten (uses, composes, inherits)&#10;━━━━━━━&#10;Ziel: Block-Triangulare Struktur&#10;(saubere Layer-Trennung)&#10;━━━━━━━&#10;Tooling-Optionen:&#10;- Lattix (kommerziell)&#10;- Structure101 (kommerziell)&#10;- eigenes Skript ueber clang-AST&#10;━━━━━━━&#10;DSM erkennt Layer-Verletzungen,&#10;zyklische Abhaengigkeiten und&#10;potentielle Refactoring-Stellen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1800" y="500" width="560" height="500" as="geometry"/></mxCell>
        <mxCell id="beweis" value="Was MX1/K14 beweist (REV 5.1 erweitert):&#10;━━━━━━━&#10;Layer alleine reicht NICHT, weil F15-Permutationen orthogonal zu Layern verlaufen.&#10;Matrix alleine reicht NICHT, weil sie Abhaengigkeitsrichtung verliert.&#10;HYBRID = Layer fuer Architektur-Reasoning + Matrix fuer Konkretisierungs-Skalierung.&#10;━━━━━━━&#10;DISJUNKTE PERMUTATIONEN (NEU REV 5.1):&#10;ICacheEngine-Familien-Permutationen (C1-C12, K15) sind DISJUNKT zu ISearchEngine-Familien-Permutationen (S1-S30, K06).&#10;ALLE Cross-Rekombinationen muessen als Ergebnisse betrachtet werden.&#10;Eine andere ExecutionEngine (z.B. ICompactingEngine, ISortingEngine) wuerde dieselben C1-C12-Cache-Engine-Permutationen GEHALTEN durchgehen.&#10;-&gt; Cache-Engine ist wiederverwendbarer Optimierungs-Service ueber alle ExecutionEngines hinweg.&#10;━━━━━━━&#10;Verzeichnis-Konvention concepts/ + cache_strategies/[axis]/[family]/ ist die OPERATIVE Umsetzung." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="2300" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U01" name="U01 IExecutingEngine + ISearchEngine + IFutureEngine">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U01 UML - IExecutingEngine + ISearchEngine + IFutureEngine (vollstaendige Klassen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="UML 2.x Konvention: + public, # protected, - private, ~ package; «concept»-Stereotyp; const/noexcept/override sichtbar" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iee" value="«concept» IExecutingEngine&#10;━━━━━━━ Attribute (protected) ━━━━━━━&#10;# cache_engine_ : optional&lt;CacheEngine&amp;&gt;&#10;# observer_registry_ : ObserverRegistry&amp;&#10;# lifecycle_state_ : EngineLifecycleState&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ execute&lt;Op&gt;(operation : Op&amp;) : Result&lt;Op&gt;&#10;+ warm_up() : void&#10;+ reset() : void&#10;+ shutdown() : void&#10;+ telemetry_hooks() const : ObserverSlots&#10;+ bind_cache_engine(engine : CacheEngine&amp;) : void&#10;+ unbind_cache_engine() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="800" height="380" as="geometry"/></mxCell>
        <mxCell id="ise" value="«concept» ISearchEngine : IExecutingEngine&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- root_page_ : IRootPage&amp;&#10;- page_structure_ : ISearchPageStructure&amp;&#10;- page_structure_interpreter_ : ISearchPageStructureInterpreter&amp; (NEU REV 5)&#10;- cache_strategy_ : ICacheStrategy&amp;&#10;- prt_art_container_ : comdare::prt_art&lt;K, V&gt;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ lookup(key : K) const : optional&lt;V&gt;&#10;+ insert(key : K, value : V) : InsertResult&#10;+ erase(key : K) : EraseResult&#10;+ range_scan(begin : K, end : K) : RangeIterator&#10;+ prefix_lookup(prefix : K) : PrefixIterator (NEU REV 5)&#10;+ prefix_enumeration(prefix : K) : EnumerationIterator (NEU REV 5)&#10;+ begin() / end() / rbegin() / rend() / cbegin() / cend()&#10;+ size() const noexcept : size_t&#10;+ empty() const noexcept : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1100" height="500" as="geometry"/></mxCell>
        <mxCell id="ife" value="«concept» IFutureEngine : IExecutingEngine&#10;━━━━━━━&#10;Architektur-Slot, leer in PRT-ART&#10;━━━━━━━ Zukuenftige Konkretisierungen ━━━━━━━&#10;ICompactingEngine (Datenpacker)&#10;IDeduplicationEngine (Duplikat-Erkennung)&#10;ISortingEngine (Sortier-Operator)&#10;IRetentionEngine (TTL/Lifetime-Management)&#10;━━━━━━━&#10;ALLE nutzen die selbe CacheEngine-Schnittstelle&#10;ueber geerbte bind_cache_engine()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="700" width="1100" height="500" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;endArrow=block;endFill=0;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ise" target="iee"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;endArrow=block;endFill=0;dashed=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ife" target="iee"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U02" name="U02 Page-Familie 3-Schichten + IRootNode (REV 5.1)">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="U02 UML - Saeule A Page-Familie mit IRootNode + 3-Schichten-Trennung (REV 5.1 KORRIGIERT)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="REV 5.1 KORREKTUR: IRootPage (irrefuehrend, physisch) -&gt; IRootNode (KONZEPTIONELL, auf SearchPage). 3-Schichten-Audit aller Klassen." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="lbl_konzept" value="SCHICHT 1 KONZEPT (Bausteine - was)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E1F5FE;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="iroot" value="«concept» IRootNode&lt;R&gt; (NEU REV 5.1 - vorher faelschlich IRootPage)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- fanout_ : IFanout&amp;&#10;- placement_page_ : ISearchPage&amp; (Wurzel-Knoten residiert AUF einer SearchPage)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ root_fanout() const : IFanout&amp;&#10;+ set_root_fanout(fanout : IFanout&amp;) : void&#10;+ algorithm_signature() const : AlgorithmSignature&#10;+ supports_concurrent_root_swap() const noexcept : bool&#10;+ placement_page() const : ISearchPage&amp;&#10;━━━━━━━ Constraint REV 5.1 ━━━━━━━&#10;inv: IRootNode ist KONZEPTIONELLE Wurzel, NICHT physisch&#10;inv: liegt auf einer ISearchPage darunter (placement)&#10;inv: fanout_ ist genau 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="760" height="320" as="geometry"/></mxCell>
        <mxCell id="ifan" value="«concept» IFanout&lt;F&gt; (KONZEPT)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- pages_ : vector&lt;ISearchPage&amp;&gt; (KORRIGIERT REV 5.1)&#10;- pages_strategy_ : ISearchPagesStrategy&amp;&#10;- pages_strategy_pattern_ : ISearchPagesStrategyPattern&amp;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ visit_each_page(visitor : auto&amp;&amp;) const : void&#10;+ lookup_page(byte : uint8_t) const : ISearchPage*&#10;+ insert_page(page : ISearchPage&amp;) : InsertPageResult&#10;+ remove_page(page : ISearchPage&amp;) : RemovePageResult&#10;+ pages_count() const noexcept : size_t&#10;+ pages_strategy() const : ISearchPagesStrategy&amp;&#10;+ pages_strategy_pattern() const : ISearchPagesStrategyPattern&amp;&#10;━━━━━━━ KORREKTUR REV 5.1 ━━━━━━━&#10;FRUEHER: composes [N] INode (FALSCH!)&#10;JETZT: contains [N] ISearchPage; INodes sitzen AUF Pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="180" width="780" height="320" as="geometry"/></mxCell>
        <mxCell id="inode" value="«concept» INode&lt;N&gt; (KORRIGIERT REV 5.1) - Mikro-Verweis (Slot-Eintrag)&#10;━━━━━━━ Tagged Union mit Discriminator (Masstree keylenx_) ━━━━━━━&#10;~ enum NodeRefKind { ValueRef, ChildRef, LayerRef, SiblingRef, SuffixRef }&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- placement_page_ : ISearchPage&amp; (residiert AUF dieser Page)&#10;- slot_index_ : uint8_t (logischer Index ueber permutation_)&#10;- ikey_ : ikey_type (8-Byte slice in Masstree)&#10;- ref_kind_ : NodeRefKind&#10;- payload_ : Variant&lt;ValueHandle, ChildPtr, LayerPtr, SiblingPtr, SuffixPtr&gt;&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ kind() const noexcept : NodeRefKind&#10;+ as_value_handle() const : ValueHandle&#10;+ as_child_ptr() const : ISearchPage*&#10;+ as_layer_ptr() const : IRootNode*&#10;+ as_sibling_ptr() const : ISearchPage*&#10;+ as_suffix_ptr() const : SuffixPtr&#10;+ key_byte_at(slot : uint8_t) const : uint8_t&#10;━━━━━━━ KORREKTUR REV 5.1 (Masstree) ━━━━━━━&#10;HAT KEINE eigenstaendige Speicher-Adresse! Adressiert via permutation_index durch Interpreter (Facade).&#10;FRUEHER: Verzweigungs-/Daten-Einheit (zu grob)&#10;JETZT: Mikro-Verweis (Slot-Eintrag), Tagged Union mit 5 Discriminator-Werten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="180" width="740" height="500" as="geometry"/></mxCell>
        <mxCell id="lbl_strat" value="SCHICHT 2 STRATEGIE (Wie? = CacheEngine als Kleber)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="ispage" value="«concept» ISearchPage&lt;S&gt; (Knoten-Objekt = logische Such-Seite)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- nodes_ : array&lt;INode, W&gt; (W = Fanout-Width, z.B. 15 in Masstree)&#10;- node_count_ : uint8_t (nkeys_ in Masstree)&#10;- structure_ : ISearchPageStructure&amp; (Strategy + Facade)&#10;- mapped_cache_pages_ : vector&lt;ICachePage&amp;&gt; (typisch 1, fragmentiert moeglich)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ lookup(key : KeyView) const : LookupResult&#10;+ insert(key, value) : InsertResult&#10;+ structure() const : ISearchPageStructure&amp;&#10;+ accept(visitor : ICacheStrategy&amp;) : void&#10;+ contains_node(slot : uint8_t) const noexcept : bool&#10;━━━━━━━ Beispiele ━━━━━━━&#10;Masstree leaf: 256 B = 4 Cache-Lines, W=15&#10;ART Node16: ~144 B, W=16&#10;HOT Compound: 32-64 B = 1 Cache-Line, W=k-bit&#10;━━━━━━━ Constraint REV 5.1 ━━━━━━━&#10;inv: structure_ + interpreter (1 Singleton via Facade)&#10;inv: contains [W] INode (logisch)&#10;inv: mapped onto [1..K] ICachePage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="800" height="500" as="geometry"/></mxCell>
        <mxCell id="isps" value="«concept» ISearchPageStructure&lt;SST&gt; (Strategy + Facade-Singleton)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- encoding_ : Encoding (Enum: Redirect/DenseByte/Multilevel/SparsePatricia/DecisionSpan/CustomAligned)&#10;- layout_invariants_ : LayoutInvariantSet&#10;- raw_bytes_ : span&lt;byte&gt;&#10;- interpreter_ : ISearchPageStructureInterpreter const&amp; (FACADE Singleton)&#10;━━━━━━━ Methoden (public) - Facade-Pattern (GoF) ━━━━━━━&#10;+ encoding() const noexcept : Encoding&#10;+ raw_bytes() const noexcept : span&lt;byte const&gt;&#10;+ layout_invariants() const : LayoutInvariantSet const&amp;&#10;+ check_invariants() const : bool&#10;+ find(key) const : INode* (delegiert an interpreter_)&#10;+ scan(range) const : Iterator (delegiert an interpreter_)&#10;+ prefetch(hint) const : void (delegiert an interpreter_)&#10;+ interpreter() const : ISearchPageStructureInterpreter const&amp;&#10;━━━━━━━ 6 Konkretisierungen mit ihren Singleton-Interpretern ━━━━━━━&#10;RedirectStructure -&gt; RedirectInterpreter (memcmp byte-prefix)&#10;DenseByteStructure -&gt; DenseByteInterpreter (linear scan SIMD)&#10;MultilevelDenseStructure -&gt; MultilevelInterpreter (Cost-DP-Suche)&#10;SparsePatriciaStructure -&gt; PatriciaInterpreter (single/multi-mask AVX2/BMI2)&#10;DecisionSpanStructure -&gt; B2Interpreter (Decision-then-Span page-lokale Suche)&#10;CustomAlignedStructure -&gt; CustomInterpreter (B^2-aehnlich, eigene Optimierungen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="780" height="500" as="geometry"/></mxCell>
        <mxCell id="ispi" value="«concept» ISearchPageStructureInterpreter&lt;SSI&gt; (Singleton, Element der Structure)&#10;━━━━━━━ Pattern ━━━━━━━&#10;Singleton-pro-Layout-Variante (eine Instanz pro Encoding-Variante)&#10;Tree haelt EINEN Verweis pro Layout (nicht pro INode!)&#10;Spart 8 B vtable-Pointer pro INode (kritisch bei 16-B-INodes)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ static instance() : Interpreter const&amp;  (Singleton)&#10;+ interpret(structure : ISearchPageStructure const&amp;, key : KeyView) const : InterpretResult&#10;+ next_slot(structure, key : KeyView) const : SlotHandle&#10;+ value_handle_for(structure, slot : SlotHandle) const : ValueHandle&#10;+ child_handle_for(structure, slot : SlotHandle) const : ChildHandle&#10;+ make_iterator(structure, mode : IteratorMode) const : Iterator&#10;+ prefetch(structure, hint : Hint) const : void&#10;+ supports_simd() const noexcept : bool&#10;━━━━━━━ Praezedenz aus der Literatur ━━━━━━━&#10;LLVM TargetInfo (ein Singleton pro Target-Architektur)&#10;Java HotSpot CodeBlob, Protobuf MessageLite&#10;FAST 3-Level Embedding (Page-Block / Cache-Line-Block / SIMD-Block)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="700" width="700" height="380" as="geometry"/></mxCell>
        <mxCell id="lbl_phys" value="SCHICHT 3 PHYSISCH (Wo? = Hardware-Cache)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="2320" height="30" as="geometry"/></mxCell>
        <mxCell id="icpage" value="«concept» ICachePage&lt;C&gt; (physische Cache-Page-Einheit)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- size_bytes : size_t (z.B. 4 KiB Standard, 2 MiB Huge)&#10;- carried_inodes : vector&lt;INodeReference&gt;  (ganze ODER fragmentierte INodes!)&#10;- carried_search_pages : vector&lt;ISearchPage*&gt;  (typisch K=1 wenn aligned)&#10;- alignment : size_t (z.B. 64 bei x86, 256 bei A64FX)&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ carries_node(inode : INode const&amp;) const : InodeFragmentationKind&#10;+ carries_search_page(page : ISearchPage const&amp;) const : bool&#10;+ flush(target_tier : TierKind) : void&#10;+ residency() const : ResidencyKind&#10;━━━━━━━ Granularitaeten REV 5.1 ━━━━━━━&#10;Cache-Line (B0): 64 B (x86), 128 B (Apple Silicon), 256 B (A64FX)&#10;Cache-Page    : 4 KiB Standard, 2 MiB Huge&#10;Disk-Page     : 4-64 KiB (klassisch), 4 MiB+ NVMe&#10;━━━━━━━ Worst-Case ━━━━━━━&#10;INode an Cache-Line-Grenze gesplittet -&gt; 2 ICachePage-Loads fuer 1 INode-Lookup&#10;ICacheStrategy MUSS dies erkennen + ggf. mehrere ICachePages prefetchen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1140" height="440" as="geometry"/></mxCell>
        <mxCell id="icline" value="«concept» ICacheLine&lt;CL&gt; (Hardware-Atomic-Transfer-Einheit)&#10;━━━━━━━ Attribute (private) ━━━━━━━&#10;- size : size_t (PLATTFORM-SPEZIFISCH, NIE hardcoded!)&#10;- state : enum MESI / MOESI&#10;- residency : ICacheLevel const&amp; (L1/L2/L3/HBM/V-Cache)&#10;- tag : address_t&#10;━━━━━━━ Methoden (public) ━━━━━━━&#10;+ size_bytes() const noexcept : size_t&#10;+ residency() const noexcept : ICacheLevel const&amp;&#10;+ state() const noexcept : MESIState&#10;+ contains(addr : address_t) const noexcept : bool&#10;━━━━━━━ C++17 Plattform-Abstraktion ━━━━━━━&#10;static constexpr size_t destructive_size = std::hardware_destructive_interference_size;&#10;static constexpr size_t constructive_size = std::hardware_constructive_interference_size;&#10;━━━━━━━ Plattform-Werte (Stand 2026) ━━━━━━━&#10;x86-64 (Intel/AMD): 64 B&#10;ARM Cortex-A: 64 B&#10;Apple Silicon (M1-M4): 128 B (P-Cores)&#10;Fujitsu A64FX (Fugaku): 256 B&#10;IBM POWER9/POWER10: 128 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1140" width="1160" height="440" as="geometry"/></mxCell>
        <mxCell id="r_iroot_ifan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="iroot" target="ifan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ifan_ispage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ifan" target="ispage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ifan_lbl" value="contains [N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ifan_ispage"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_inode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ispage" target="inode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ispage_lbl" value="contains [W=15]" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" connectable="0" parent="r_ispage_inode"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_isps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="ispage" target="isps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_isps_ispi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="isps" target="ispi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_isps_lbl" value="has 1 (Singleton-Facade)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" connectable="0" parent="r_isps_ispi"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_ispage_icpage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#1B5E20;strokeWidth=3;" edge="1" parent="1" source="ispage" target="icpage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_ispage_lbl3" value="mapped via ICacheStrategy" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#FFFFFF;fontSize=11;fontStyle=1;fontColor=#1B5E20;" vertex="1" connectable="0" parent="r_ispage_icpage"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_icpage_icline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="icpage" target="icline"><mxGeometry relative="1" as="geometry"/></mxCell>
