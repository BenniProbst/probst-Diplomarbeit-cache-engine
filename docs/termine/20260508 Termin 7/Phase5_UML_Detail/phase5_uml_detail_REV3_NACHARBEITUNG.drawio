        <mxCell id="t" value="K04 KONZEPT - 4-Ebenen-Strategien + Multiplizitaeten" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A04000;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Pattern (1 pro IFanout) - Plural-Strategy (N pro Pattern) - Singular-Strategy (1 pro Page) - Heuristic (beliebig)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ea" value="EBENE A - ISearchPagesStrategyPattern (1 pro IFanout)&#10;━━━━━━━&#10;10 Patterns: AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold |&#10;DynamicRebalance | HierarchicalFractal | OrthogonalRuntimeParametrized |&#10;MultiStrategyOrchestration | HeterogeneousAdaptive | BoundaryNodePartition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="2200" height="160" as="geometry"/></mxCell>
        <mxCell id="eb" value="EBENE B - ISearchPagesStrategy PLURAL (N pro Pattern)&#10;━━━━━━━&#10;Konfigurations-Pakete (K3.3 - Cluster A+B sind Lektuere-Hilfen, NICHT Architektur-Trennlinien):&#10;BPlus-Familie | Trie-Familie | Hybrid-Familie&#10;Beispiele: BPlusTreePerLayerStrategy (P03) - CSBPlusTreeStrategy (P12) - WideNodeBPlusStrategy (P21) -&#10;FractalBPlusStrategy (P22) - EmbeddedSecondaryIndexStrategy (P06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="2200" height="180" as="geometry"/></mxCell>
        <mxCell id="ec" value="EBENE C - ISearchPageStrategy SINGULAR (1 pro ISearchPage)&#10;━━━━━━━&#10;Atomare Strategien:&#10;PermutationFieldInsertStrategy (P03) - AdaptiveLayoutSelectionStrategy (P20) -&#10;CompoundContainerStrategy (P02) - DecisionPageStrategy (P06) - SpanPageStrategy (P06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="580" width="2200" height="160" as="geometry"/></mxCell>
        <mxCell id="ed" value="EBENE D - IHeuristic (beliebig viele - parametrieren die Strategien)&#10;━━━━━━━&#10;~80 paper-abgeleitete Heuristiken:&#10;AdaptivePrefetchDistanceHeuristic (P23) | CacheCostDPHeuristic (P05) |&#10;CacheCoherenceCostHeuristic (P28 Block AN) | WidthCostModelHeuristic (P13) |&#10;ProbabilityLayoutHeuristic (P16) | LargestL3CcdPinningHeuristic (allgemein) |&#10;HotPathOnHighIpcCoreHeuristic (allgemein) | StrideVsSequentialHeuristic (P32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="780" width="2200" height="220" as="geometry"/></mxCell>
        <mxCell id="legend" value="MULTIPLIZITAETEN (K3.4):&#10;1 IFanout has-1 ISearchPagesStrategyPattern (eindeutig pro Fanout)&#10;1 ISearchPagesStrategyPattern has-N ISearchPageStrategy (eine pro ISearchPage)&#10;1 IHeuristic kann beliebig viele Strategien parametrieren&#10;Iteratoren orthogonal - siehe K05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="1040" width="2200" height="140" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

