        <mxCell id="t" value="K03 KONZEPT - ICacheStrategy als Visitor-Pattern (zwei Konkretisierungen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2120" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="ICacheStrategy ist Visitor-Pattern - BaseEngineStrategy (Baseline F15) | CacheEngineStrategy (CacheEngine-aktiv)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2120" height="40" as="geometry"/></mxCell>
        <mxCell id="ics" value="ICacheStrategy&lt;CS&gt;&#10;━━━━━━━&#10;Visitor-Pattern Wurzel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=14;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="bes" value="BaseEngineStrategy : ICacheStrategy&#10;━━━━━━━&#10;NICHT-OPTIMIERTE Read/Write-Variante&#10;StaticEngine-Pfad: Originalcode-Bauteil&#10;Baseline fuer F15-Vergleich&#10;━━━━━━━&#10;KEINE ILivePlatformModel-Konsultation&#10;KEINE Heuristik-Aufrufe&#10;KEINE Cache-Engine-Beeinflussung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="420" width="700" height="240" as="geometry"/></mxCell>
        <mxCell id="ces" value="CacheEngineStrategy : ICacheStrategy&#10;━━━━━━━&#10;CACHE-ENGINE-OPTIMIERTE Read/Write-Variante&#10;ruft CacheEngine fuer Speicher-optimierte Op&#10;━━━━━━━&#10;konsumiert ILivePlatformModel + ICacheResidency&#10;ruft IHeuristic (auf Live-Modell)&#10;kann Read/Write umrouten auf bessere Cache-Ebene&#10;kann Page-Layout vor Write rearrangieren" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1360" y="420" width="700" height="240" as="geometry"/></mxCell>
        <mxCell id="hint" value="ENGINE-CHOICE (Compile-Time): waehlt zwischen BaseEngineStrategy + CacheEngineStrategy&#10;F15-Vergleich: pro Permutation werden BEIDE Varianten gegen einander getestet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="800" width="1400" height="100" as="geometry"/></mxCell>
