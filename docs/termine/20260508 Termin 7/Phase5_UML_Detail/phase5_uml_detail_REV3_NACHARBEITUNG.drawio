        <mxCell id="t" value="K05 KONZEPT - Iteratoren-Familie (vom Architekt explizit verlangt)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1B5E20;strokeColor=#0D3F11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2120" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="3 Concept-Iteratoren + comdare::prt_art&lt;K, V&gt;::iterator-Familie" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1B5E20;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2120" height="40" as="geometry"/></mxCell>
        <mxCell id="ini" value="INodeIterator&lt;NI&gt;&#10;━━━━━━━&#10;visit_each_child / byte-by-byte / discriminative-bits&#10;━━━━━━━&#10;Konkretisierungen:&#10;- ART-byte-by-byte-iter (P01)&#10;- HOT-discriminative-bits-iter (P02)&#10;- LOUDS-rank-select-iter (P09/P10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="600" height="220" as="geometry"/></mxCell>
        <mxCell id="ispi" value="ISearchPageIterator&lt;SI&gt;&#10;━━━━━━━&#10;Range-Scan ueber ISearchPage&#10;━━━━━━━&#10;Konkretisierungen:&#10;- linear-sibling-list-iter (P03 Masstree)&#10;- LOUDS-lower-bound-iter (P10 SuRF)&#10;- SortedKeyArrayIterator (P11 CSS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="600" height="220" as="geometry"/></mxCell>
        <mxCell id="isps_iter" value="ISearchPageStrategyIterator&lt;SSI&gt;&#10;━━━━━━━&#10;Cross-Algorithm-Iteration ueber Permutationen&#10;━━━━━━━&#10;F15 Bausteine-Quer-Permutation:&#10;- permutiert ueber 4-Ebenen-Tupel&#10;- delegiert an Strategy-Konkretisierungen&#10;- liefert Vergleichs-Sequenz fuer Phase-7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="180" width="600" height="220" as="geometry"/></mxCell>
        <mxCell id="prtart_iter" value="class comdare::prt_art&lt;Key, Value&gt;&#10;━━━━━━━&#10;+ iterator           (mutable forward iterator)&#10;+ const_iterator&#10;+ range_iterator&#10;+ key_iterator&#10;+ value_iterator&#10;━━━━━━━&#10;Kompatibel zu std::map-API (Domaenenmodell §1A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=3;fontColor=#000000;fontSize=14;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="960" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K06" name="K06 Hybrid-Command-Pattern">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K06 KONZEPT - Hybrid-Command-Pattern + 17 Composition-Commands (K3.4)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#880E4F;strokeColor=#5C0934;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="17 Hybrid-Aufloesungen aus 12 §9 + 11 §10 - F15-Permutations-Raum 3x erweitert" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#880E4F;fontColor=#880E4F;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iscmd" value="IStrategyCommand&#10;━━━━━━━&#10;Wurzel jeder atomaren Strategie&#10;━━━━━━━&#10;+ execute(context : StrategyContext) : Result&#10;+ can_compose_with(other : IStrategyCommand) : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="800" height="140" as="geometry"/></mxCell>
        <mxCell id="hcc" value="HybridCompositionCommand : IStrategyCommand&#10;━━━━━━━&#10;Sammler von Atom-Commands&#10;━━━━━━━&#10;- parts : vector&lt;IStrategyCommand*&gt;&#10;- composition_rule : ICompositionRule&#10;+ execute(context) : Result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="380" width="600" height="160" as="geometry"/></mxCell>
        <mxCell id="icr" value="ICompositionRule&#10;━━━━━━━&#10;Varianten:&#10;- SequentialRule&#10;- ParallelRule&#10;- ConditionalRule (with ConditionPredicate)&#10;- RecursiveRule (with DepthLimit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="500" height="160" as="geometry"/></mxCell>
        <mxCell id="atoms" value="Atomare Strategy-Commands (Beispiele aus 17 Aufloesungen)&#10;━━━━━━━&#10;P03 Masstree: SliceLayerJump + BPlusPerLayer + PermutationFieldInsert&#10;P10 SuRF: LoudsDenseEncoding + LoudsSparseEncoding&#10;P02 HOT: CompoundContainer + BiNodeSubtree + SingleMaskPK + MultiMaskPK&#10;P07 Wormhole: HashAnchorLookup + BPlusHopLookup + LeafLinkedListScan&#10;P06 B2-Tree: OuterBPlusPage + DecisionPageStrategy + SpanPageStrategy&#10;P04 CoCo: MacroNodeCollapse + PatriciaInnerExpand + SuccinctEncodingPool&#10;P22 Fractal: DiskTierTraversal + CacheTierTraversal + DualJumpPointerArray&#10;P28 Kuehn: LeafOnlyCounter + RetroactiveAggregation + GreedyHotPathLayout&#10;P26 Zhang: CachePrefetcher (CP) + PathPrefetcher (PP) + MonitorPrefetcher (MP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="2200" height="280" as="geometry"/></mxCell>
        <mxCell id="comps" value="HybridCompositionCommand-Konkretisierungen (17 Stueck)&#10;━━━━━━━&#10;01 MasstreeSliceLayered                 10 ChenPrefetchedBPlus&#10;02 CutoffLevelLouds                     11 HankinsPatelCostModel&#10;03 HOTAdaptiveLayoutSelection           12 ZhangFGCSPointerResolution&#10;04 TripleLayerLookup                    13 STARTAdaptive&#10;05 B2TreeRecursiveCommonPrefix          14 KhanRuntimeAdaptive&#10;06 CoCoLevelLDecision                   15 SamuelConfigurationTable&#10;07 CoCoEncodingPool                     16 BTreesAreBackHeterogeneousAdaptive&#10;08 ThreePrefetcherOrchestration         17 SequentialInsertComposition&#10;09 KuehnHotPathOptimization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="920" width="2200" height="240" as="geometry"/></mxCell>
        <mxCell id="cmd_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="hcc" target="iscmd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cmd_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="hcc" target="icr"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K07" name="K07 IPlatformProbe Auto-Discovery">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K07 KONZEPT - IPlatformProbe Auto-Discovery (5 Schritte) - K3.2" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="KEINE plattform-spezifischen Klassen - generisches Auto-Discovery + Property-Klassifikation" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="ipp" value="IPlatformProbe&#10;━━━━━━━&#10;ALLGEMEIN - OHNE CPU-Spezialisierung&#10;━━━━━━━&#10;+ discover_cache_topology() : ICacheTopology&#10;+ discover_core_layout() : ICoreLayout&#10;+ discover_isa_features() : IIsaFeatureSet&#10;+ discover_interconnect() : IBusTopology&#10;━━━━━━━&#10;+ measure_cache_latencies()&#10;+ measure_bandwidths()&#10;+ measure_cache_coherence_cost()&#10;+ measure_pinning_effects()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="640" height="320" as="geometry"/></mxCell>
        <mxCell id="ippc" value="IPlatformPropertyClassifier&#10;━━━━━━━&#10;NEU REV 3 - Konsequenz aus Auto-Discovery&#10;━━━━━━━&#10;+ classify(probe_results) : PlatformPropertySet&#10;━━━━━━━&#10;PlatformPropertySet enthaelt z.B.:&#10;- has_asymmetric_l3 : bool   (entdeckt)&#10;- has_hybrid_cores  : bool   (entdeckt)&#10;- preferred_pinning : PinningPolicy  (gemessen)&#10;- has_hbm_tier      : bool   (entdeckt)&#10;- usable_simd_width : int    (gemessen)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="640" height="320" as="geometry"/></mxCell>
        <mxCell id="iceop" value="ICacheEngineOptionPublisher&#10;━━━━━━━&#10;NEU REV 3 - Bereitstellung an Permutationen&#10;━━━━━━━&#10;+ publish_options_to(modules : list) : void&#10;━━━━━━━&#10;Jede Permutation erhaelt nur die Optionen,&#10;die ihre Bausteine tatsaechlich konsumieren&#10;koennen (compile-time-gefiltert via Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="180" width="640" height="280" as="geometry"/></mxCell>
        <mxCell id="schritte" value="5-Schritt-Pflicht (CacheEngineBuilder pro Permutations-Build):&#10;━━━━━━━&#10;1. DISCOVER (statisch)  - CPUID / sysfs / /proc/cpuinfo / hwloc&#10;2. MEASURE (dynamisch)  - Mikrobenchmark (clflush-cycle / All-Pairs-Pinning / Cache-Coherence-Calibration)&#10;3. CLASSIFY            - Properties zusammenstellen (has_asymmetric_l3, preferred_pinning, ...)&#10;4. PUBLISH             - Properties allen Permutations-Modulen als Konfigurations-Optionen&#10;5. BIND                - Pro Permutation entscheidet ICacheStrategy-Visitor, welche Properties konsumiert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=13;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="2040" height="200" as="geometry"/></mxCell>
        <mxCell id="block_ao" value="Block AO als TESTFALL (nicht Implementierung):&#10;━━━━━━━&#10;Ryzen 9 9950X3D + i9-14900KS + DDR5-5600 CL36&#10;Auto-Discovery findet:&#10;- asymmetrisches L3 (96 + 32 MiB) =&gt; has_asymmetric_l3=true&#10;- Hybrid-Cores (8P + 16E) =&gt; has_hybrid_cores=true&#10;- DDR5-5600 mit 36 Zyklen Latenz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="1000" height="240" as="geometry"/></mxCell>
        <mxCell id="entscheidung" value="Heuristik-Wahl ist GENERISCH (KEINE CPU-Namen):&#10;━━━━━━━&#10;has_asymmetric_l3=true   =&gt; LargestL3CcdPinningHeuristic (allgemein)&#10;has_hybrid_cores=true    =&gt; HotPathOnHighIpcCoreHeuristic (allgemein)&#10;has_hbm_tier=true        =&gt; HbmAllocationStrategy (allgemein)&#10;━━━━━━━&#10;Wirkung: CacheEngine ist plattform-agnostisch im Code,&#10;plattform-konkret im Verhalten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="800" width="1000" height="240" as="geometry"/></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ipp" target="ippc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="ippc" target="iceop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K08" name="K08 Plattform-Modell">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K08 KONZEPT - Plattform-Modell (Cache-Hierarchie + CPU-Kerne + Bus + ISA + Live-Modell)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Saeule B Cache-Engine Plattform-Modell - alle Concept-Klassen mit Auto-Discovery-Bezug" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="grp_cache" value="Cache-Hierarchie&#10;━━━━━━━&#10;ICacheLevel - L1/L2/L3/HBM/V-Cache (size, latency, bandwidth)&#10;ICacheLine - Granularitaet (typ. 64 B, 256 B ARM A64FX)&#10;ICacheTopology - gesamte Hierarchie + asymmetric_l3 als Property&#10;ICacheResidency - Cache whereabouts (Cached/HeaderCached/Uncached)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="700" height="200" as="geometry"/></mxCell>
        <mxCell id="grp_cpu" value="CPU-Kerne (generisch, KEINE CPU-Spezialisierung)&#10;━━━━━━━&#10;ICpuCore - core_class als generic enum&#10;ICoreLayout - Topologie ohne CPU-Namen&#10;ICoreToThreadMap - Thread-zu-Core, IPinningPolicy generisch&#10;IPinningPolicy - LARGEST_L3_CCD | HIGH_IPC_CORES | NUMA_LOCAL | ROUND_ROBIN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="700" height="200" as="geometry"/></mxCell>
        <mxCell id="grp_isa" value="Hardware-Erweiterungen (ISA-Features)&#10;━━━━━━━&#10;IHardwareExtension - eine ISA-Feature-Bank&#10;  (AVX-512, BMI2, NEON, SVE2, RISC-V V-Ext)&#10;IIsaFeatureSet - gesamte Feature-Verfuegbarkeit&#10;  (Auto-discovered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="700" height="200" as="geometry"/></mxCell>
        <mxCell id="grp_bus" value="Kommunikations- + Bandbreitenverbindungen&#10;━━━━━━━&#10;IInterconnect - CCD-CCD, Core-Cache, Cache-Memory, NUMA, PCIe, NVLink&#10;IBusTopology - gesamte Bus-/Interconnect-Topologie&#10;IMemoryBandwidthModel - Live-Bandbreiten + Bottleneck-Detection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="1100" height="200" as="geometry"/></mxCell>
        <mxCell id="grp_live" value="Echtzeit-Modelle&#10;━━━━━━━&#10;ILivePlatformModel - Echtzeit-Modell, periodisch aktualisiert&#10;ILiveCpuModel - Per-Core-Lasten + Hot-Path-Score&#10;━━━━━━━&#10;Update-Source: perf-Counter / sysfs / cpuid&#10;Update-Period: ~100 ms-Tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="1040" height="200" as="geometry"/></mxCell>
        <mxCell id="grp_sched" value="Scheduling (Thread-zu-Core + Task-zu-Ebene)&#10;━━━━━━━&#10;IScheduler&#10;Konkretisierungen (allgemein, KEINE CPU-Namen):&#10;- PinningAwareScheduler&#10;- NumaLocalScheduler&#10;- RoundRobinScheduler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="1100" height="220" as="geometry"/></mxCell>
        <mxCell id="grp_heur" value="Heuristiken (~80 paper-abgeleitete Heuristiken - siehe K09)&#10;━━━━━━━&#10;IHeuristic - Wert-Berechnungen auf dem Live-Modell&#10;Konkretisierungen (Auswahl):&#10;- AdaptivePrefetchDistanceHeuristic (P23) | CacheCostDPHeuristic (P05)&#10;- CacheCoherenceCostHeuristic (P28 Block AN) | WidthCostModelHeuristic (P13)&#10;- ProbabilityLayoutHeuristic (P16) | StrideVsSequentialHeuristic (P32)&#10;- LargestL3CcdPinningHeuristic (allgemein) | HotPathOnHighIpcCoreHeuristic (allgemein)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1220" y="640" width="1040" height="240" as="geometry"/></mxCell>
        <mxCell id="hint_pm" value="Verzeichnis Ebene 3:&#10;cache_engine/&#10;platform_model/  (Concepts oben)&#10;scheduling/      (IScheduler + Konkretisierungen)&#10;heuristics/      (~80 IHeuristic-Konkretisierungen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="2180" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K09" name="K09 IHeuristic-Familie">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K09 KONZEPT - IHeuristic-Familie (~80 paper-derived Heuristiken aus Doku 13)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#4A148C;strokeColor=#310A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Heuristik-Klassen aus 33 Papers (P01-P33) - alle wertberechnend auf Live-Modell, KEIN festes Strategieobjekt" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#4A148C;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="iheur" value="IHeuristic&#10;━━━━━━━&#10;Wurzel - bewertet ICacheLevel/ICpuCore/IPattern&#10;━━━━━━━&#10;+ score(Context : LivePlatformModel) : double&#10;+ recommend() : ConfigurationOption" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=3;fontColor=#000000;fontSize=13;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="grp_pref" value="Prefetch-Heuristiken (~15)&#10;━━━━━━━&#10;AdaptivePrefetchDistanceHeuristic (P23 Khan)&#10;PrefetchPointerHeuristic (P21 Chen)&#10;ThreePrefetcherSwitchHeuristic (P26 Zhang FGCS)&#10;HierarchicalPrefetchHeuristic (P27 Zhang ASPLOS)&#10;FetchAheadHeuristic (P25 Mahling)&#10;StrideVsSequentialHeuristic (P32 Schmidt)&#10;LeafLinkPrefetchHeuristic (P22 Fractal)&#10;PageGroupPrefetchHeuristic (P25)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="grp_layout" value="Layout-Heuristiken (~12)&#10;━━━━━━━&#10;ProbabilityLayoutHeuristic (P16 BDF)&#10;StaticLayoutHeuristic (P16)&#10;HotPathLayoutHeuristic (P28 Kuehn)&#10;PageLeafCompactionHeuristic (P25)&#10;LeafTrimHeuristic (P11 CSS)&#10;BinaryTreeFanoutHeuristic (P11)&#10;CacheObliviousLayoutHeuristic (P17 BDF)&#10;ZOrderLayoutHeuristic (allgemein)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="380" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="grp_node" value="Node-Size-Heuristiken (~10)&#10;━━━━━━━&#10;CacheCostDPHeuristic (P05 START)&#10;NodeSizeOptimumHeuristic (P13 Hankins)&#10;CSSOptimumPageHeuristic (P11)&#10;OptimumLeafSizeHeuristic (P14 Samuel)&#10;OptimumInnerSizeHeuristic (P14)&#10;ParameterizedNodeSizeHeuristic (P15 Graefe)&#10;LeafLargerThanInnerHeuristic (P15)&#10;DecisionPageWidthHeuristic (P06 B2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="grp_sync" value="Concurrency-Heuristiken (~8)&#10;━━━━━━━&#10;CacheCoherenceCostHeuristic (P28 Block AN)&#10;OptimisticVsPessimisticHeuristic (P03)&#10;RcuVsHazardPointerHeuristic (P29/P30)&#10;PermutationStableInsertHeuristic (P03)&#10;PerCcdLockingHeuristic (allgemein)&#10;BackoffStrategyHeuristic (allgemein)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1740" y="380" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="grp_pinning" value="Pinning- + ISA-Heuristiken (~12)&#10;━━━━━━━&#10;LargestL3CcdPinningHeuristic (allgemein)&#10;HotPathOnHighIpcCoreHeuristic (allgemein)&#10;NumaLocalPinningHeuristic (allgemein)&#10;HBMAllocationHeuristic (allgemein)&#10;SimdWidthMatchHeuristic (P31 Ungethuem)&#10;WidthCostModelHeuristic (P13)&#10;BrokerStratHeuristic (P31)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="grp_visit" value="Visit-Order-Heuristiken (~10)&#10;━━━━━━━&#10;DiscriminativeBitsHeuristic (P02)&#10;ByteByByteHeuristic (P01)&#10;LoudsRankSelectHeuristic (P09/P10)&#10;BinarySearchVisitHeuristic (P11)&#10;LinearSiblingScanHeuristic (P03)&#10;PatriciaCutoffHeuristic (P04)&#10;HashAnchorVisitHeuristic (P07)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="740" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="grp_adapt" value="Adaptive- + Cost-Model-Heuristiken (~13)&#10;━━━━━━━&#10;RuntimeAdaptiveHeuristic (P23 Khan)&#10;HankinsPatelCostHeuristic (P13)&#10;SamuelConfigTableHeuristic (P14)&#10;STARTAdaptiveBranchHeuristic (P05)&#10;BTreesAreBackHybridHeuristic (P20)&#10;BIndirectionPenaltyHeuristic (P12)&#10;LookAheadBudgetHeuristic (P25)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="740" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="grp_telemetry" value="Telemetrie-Heuristiken (~10)&#10;━━━━━━━&#10;PIKABottleneckHeuristic (P33 VAMPIR)&#10;CacheMissRateThresholdHeuristic&#10;BandwidthSaturationHeuristic&#10;ProfileGuidedReplaceHeuristic&#10;HotnessBucketHeuristic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1740" y="740" width="540" height="280" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K10" name="K10 29 Cache-Strategie-Familien">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K10 KONZEPT - 29 Cache-Strategie-Familien F1-F29 (Doku 11)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#01579B;strokeColor=#003C71;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Disziplinen, mit denen Saeule B Cache-Engine den Cache-Zugriff oeffentlich macht - F15 ist der Vergleich" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#01579B;fontColor=#01579B;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="g_layout" value="LAYOUT-Familien (F1-F8)&#10;━━━━━━━&#10;F1  Cache-Aware Page-Layout (P01 ART, P02 HOT)&#10;F2  Cache-Oblivious vEB-Layout (P16, P17)&#10;F3  Implicit Tree Layout (P11 CSS)&#10;F4  Compressed/Succinct Layout (P09 LOUDS, P10 SuRF)&#10;F5  Adaptive Path Compression (P01, P03, P04, P07)&#10;F6  Hybrid Index Layout (P02, P03, P06, P20)&#10;F7  Sorted/Unsorted Mixed Layout (P11, P15)&#10;F8  Probability-aware Layout (P16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="720" height="320" as="geometry"/></mxCell>
        <mxCell id="g_pref" value="PREFETCH-Familien (F9-F14)&#10;━━━━━━━&#10;F9  Pointer-based Prefetching (P21 Chen)&#10;F10 Cache-line Prefetching (P22 Fractal)&#10;F11 Adaptive Prefetch Distance (P23 Khan)&#10;F12 Hierarchical Multi-Ebenen Prefetching (P27)&#10;F13 Multi-Strategy Prefetcher (P26 FGCS)&#10;F14 Look-Ahead Page Prefetch (P25 Mahling)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="720" height="320" as="geometry"/></mxCell>
        <mxCell id="g_compare" value="VERGLEICH-Familie (F15) - HERZSTUECK&#10;━━━━━━━&#10;F15 Comparable Cache-Strategy Composition&#10;━━━━━━━&#10;PRT-ART staedtet F15 als Forschungsstrategie:&#10;- vergleicht die anderen 28 Familien systematisch&#10;- BaseEngineStrategy = ohne CacheEngine&#10;- CacheEngineStrategy = mit Plattform-Heuristiken" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1540" y="160" width="720" height="320" as="geometry"/></mxCell>
        <mxCell id="g_node" value="NODE-Familien (F16-F19)&#10;━━━━━━━&#10;F16 Cache-aware Node-Sizing (P13 Hankins)&#10;F17 Cost-Model based Node-Sizing (P14 Samuel, P05 START)&#10;F18 Asymmetric Inner/Leaf-Sizing (P15 Graefe)&#10;F19 Adaptive Recursive Node-Splitting (P02, P04, P05)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="720" height="280" as="geometry"/></mxCell>
        <mxCell id="g_sync" value="CONCURRENCY-Familien (F20-F23)&#10;━━━━━━━&#10;F20 Optimistic Concurrency / OCC (P03 Masstree, P08)&#10;F21 RCU-style Concurrency (P29 McKenney)&#10;F22 Hazard-Pointer Concurrency (P30 Michael)&#10;F23 Cache-Coherence-aware Concurrency (P28 Block AN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="720" height="280" as="geometry"/></mxCell>
        <mxCell id="g_pin" value="PINNING- + ISA-Familien (F24-F26)&#10;━━━━━━━&#10;F24 NUMA/CCD-aware Pinning (allgemein)&#10;F25 Hybrid-Core (Hot/Cold) Aware Pinning (allgemein)&#10;F26 ISA-Width Adaptive Vectorization (P31, P32 Habich)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1540" y="500" width="720" height="280" as="geometry"/></mxCell>
        <mxCell id="g_telemetry" value="TELEMETRIE-Familien (F27-F29)&#10;━━━━━━━&#10;F27 Profile-Guided Cache Replacement (allgemein)&#10;F28 Bottleneck-Detection-driven Strategy Switching (P33 VAMPIR)&#10;F29 Hot Path Detection-driven Layout Adaption (P28 Kuehn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="2200" height="200" as="geometry"/></mxCell>
        <mxCell id="hint_F15" value="REGEL: F15 ist KEINE Disziplin - F15 ist die VERGLEICHS-FUNKTION ueber alle anderen Familien.&#10;Phase 7 (Permutations-Builds + Experiment-Loop) instanziiert F15 systematisch fuer alle 4-Tupel.&#10;Das macht PRT-ART zur PERMUTATIONSMASCHINE - die Diplomarbeit ist die Forschungsmission F15." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="2200" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K11" name="K11 Drei-Ebenen-Verbindungen">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K11 KONZEPT - Drei-Ebenen-Verbindungen + Phase 1-7 Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1A237E;strokeColor=#0D1A66;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Wer was wann macht - vom IExecutingEngine bis zur Permutations-Hardware-Bindung" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#1A237E;fontColor=#1A237E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="phase1" value="Phase 1 - DISCOVER&#10;━━━━━━━&#10;IPlatformProbe entdeckt:&#10;- ICacheTopology (L1/L2/L3/HBM)&#10;- ICoreLayout (P/E-Cores)&#10;- IIsaFeatureSet (AVX-512, NEON)&#10;- IBusTopology (NUMA, CCD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase2" value="Phase 2 - MEASURE&#10;━━━━━━━&#10;Mikrobenchmarks:&#10;- clflush-cycle&#10;- All-Pairs-Pinning&#10;- Cache-Coherence-Cost&#10;- DDR5-Latency-Calibration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase3" value="Phase 3 - CLASSIFY&#10;━━━━━━━&#10;IPlatformPropertyClassifier:&#10;PlatformPropertySet =&#10;{ has_asymmetric_l3,&#10;  has_hybrid_cores,&#10;  preferred_pinning,&#10;  usable_simd_width }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase4" value="Phase 4 - PUBLISH&#10;━━━━━━━&#10;ICacheEngineOptionPublisher&#10;publish_options_to(modules)&#10;━━━━━━━&#10;Permutations erhalten nur die&#10;Optionen die sie konsumieren&#10;koennen (compile-time-Concepts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1270" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase5" value="Phase 5 - BIND&#10;━━━━━━━&#10;ICacheStrategy-Visitor wird&#10;CacheEngineStrategy:&#10;Pattern -&gt; Plural-Strategy -&gt;&#10;Singular-Strategy -&gt; Heuristic&#10;━━━━━━━&#10;Saeule A und B physisch verbunden" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1680" y="160" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="phase6" value="Phase 6 - EXECUTE&#10;━━━━━━━&#10;IExecutingEngine.execute()&#10;-&gt; ISearchEngine.search()&#10;-&gt; IFanout.distribute()&#10;-&gt; ISearchPagesStrategy&#10;-&gt; ISearchPageStrategy(N)&#10;-&gt; ICacheStrategy(N)&#10;-&gt; IHeuristic.score()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="800" height="220" as="geometry"/></mxCell>
        <mxCell id="phase7" value="Phase 7 - COMPARE (F15 - die Forschungsmission)&#10;━━━━━━━&#10;Permutations-Builds + Experiment-Loop:&#10;- BaseEngineStrategy (ohne CacheEngine, Baseline)&#10;- CacheEngineStrategy (mit Plattform-Heuristiken)&#10;Vergleich pro 4-Ebenen-Tupel:&#10;Throughput / Latency / Cache-Miss / Bandwidth /&#10;Cache-Coherence-Bus-Verkehr / Energieverbrauch&#10;═════ ECHTE Permutationsmaschine ═════" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=3;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="500" width="1180" height="220" as="geometry"/></mxCell>
        <mxCell id="vec_a" value="VERTIKALE EBENEN-AUFRUFE (Saeule A oben - Saeule B unten)&#10;━━━━━━━&#10;Ebene 1 (IExecutingEngine) waehlt zwischen Search-/Future-Engine&#10;Ebene 2 (Saeule A) sucht physisch in PRT-ART-Strukturen&#10;Ebene 3 (Saeule B) liefert die HW-Bindung jeder Saeule-A-Wahl&#10;━━━━━━━&#10;BaseEngineStrategy: Saeule A nutzt KEINE Saeule-B-Bindung (Baseline F15-)&#10;CacheEngineStrategy: Saeule A bindet an Saeule B (CacheEngine-aktiv F15+)&#10;━━━━━━━&#10;Visitor-Pattern: ICacheStrategy.visit(BaseEngineStrategy) vs visit(CacheEngineStrategy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="2020" height="280" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase1" target="phase2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase2" target="phase3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase3" target="phase4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase4" target="phase5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase5" target="phase7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="phase6" target="phase7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K12" name="K12 Forschungs-Mission F15">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="K12 KONZEPT - Forschungsmission F15 + Diplomarbeits-Beweis" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#E65100;strokeColor=#A03700;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="Was die Diplomarbeit beweisen muss - was PRT-ART als Vergleichs-Werkzeug oeffentlich macht" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="mission" value="FORSCHUNGSMISSION&#10;━━━━━━━&#10;Saeule B Cache-Engine erzeugt durch Plattform-Modell-Auswertung&#10;Permutations-Familien, die Saeule A vorher fest entscheidet -&#10;und beweist, dass diese dynamische Komposition messbar bessere&#10;Lookup-Zeiten als statisch vordefinierte Algorithmen liefert&#10;auf konkreter Plattform (z.B. Block AO Ryzen 9 9950X3D + i9-14900KS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontSize=14;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="1840" height="200" as="geometry"/></mxCell>
        <mxCell id="b1" value="Beweis-Architektur (Phase 7 Experiment-Loop)&#10;━━━━━━━&#10;Schritt 1:  Auto-Discovery (Phase 1-3) erfasst die Plattform&#10;Schritt 2:  Permutations-Generator listet alle 4-Ebenen-Tupel auf&#10;            (Pattern x Plural x Singular x Heuristic)&#10;Schritt 3:  Pro Tupel zwei Builds:&#10;            - BaseEngineStrategy (ohne Saeule B)&#10;            - CacheEngineStrategy (mit Saeule B Heuristik-Bindung)&#10;Schritt 4:  Workload-Mix nach Pflicht-Korpus (siehe Phase 4.A)&#10;Schritt 5:  Messung pro Build:&#10;            Throughput, Latency, Cache-Miss-Rate,&#10;            Memory-Bandwidth-Auslastung, Coherence-Verkehr,&#10;            Energie (RAPL), L3-Hit-Ratio, Cycle-Counter&#10;Schritt 6:  MeasurementBuffer-Disk-Dump in LaTeX-Anhang" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="b2" value="Bausteine + Sprachmittel (warum F15 in PRT-ART funktioniert)&#10;━━━━━━━&#10;- Saeule A liefert die ALGORITHMUS-DIMENSION&#10;  (Pattern -&gt; Plural -&gt; Singular -&gt; Iteratoren)&#10;- Saeule B liefert die HARDWARE-DIMENSION&#10;  (Cache-Hierarchie, Pinning, ISA, Live-Modell, Heuristik)&#10;- Visitor (BaseEngineStrategy / CacheEngineStrategy) erlaubt&#10;  identische Code-Pfade mit / ohne Saeule-B-Bindung&#10;- Phase 7 vergleicht Tupel systematisch und reproduzierbar&#10;━━━━━━━&#10;PRT-ART ist die PERMUTATIONSMASCHINE -&#10;die Diplomarbeit ist die wissenschaftliche INSTANZIIERUNG von F15&#10;auf konkreter Plattform mit Pflicht-Korpus + 33-Paper-Strategie-Raum" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="abgr" value="Abgrenzung (NICHT Teil der Diplomarbeit, aber im Modell verankert):&#10;━━━━━━━&#10;- F15 funktioniert grundsaetzlich auf jeder Plattform - Block AO ist nur EINE Instanz&#10;- F15 funktioniert mit beliebigem Strategie-Raum - die 33 Paper sind nur EINE Quelle&#10;- F15 funktioniert mit beliebigem Workload - die Pflicht-Korpus-Datasets sind nur EINE Stichprobe&#10;- Die Diplomarbeit BEWEIST die Permutationsmaschine - sie reklamiert NICHT die optimale Konfiguration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;strokeWidth=2;fontColor=#000000;fontSize=12;verticalAlign=middle;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="2320" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
