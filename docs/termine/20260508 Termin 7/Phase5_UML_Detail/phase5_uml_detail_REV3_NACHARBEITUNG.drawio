  <diagram id="K03" name="K03 ICacheStrategy Visitor">
    <mxGraphModel dx="2200" dy="1300" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0" background="#FFFFFF">
