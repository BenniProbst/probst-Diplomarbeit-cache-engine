        <mxCell id="ipp" value="IPlatformProbe&#xa;Auto-Discovery (allgemein, KEINE CPU-Spezialisierung)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="640" height="80" as="geometry" /></mxCell>
        <mxCell id="ippc" value="IPlatformPropertyClassifier&#xa;PlatformPropertySet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="600" height="80" as="geometry" /></mxCell>
        <mxCell id="iceop" value="ICacheEngineOptionPublisher&#xa;publish_options_to(modules)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="640" height="80" as="geometry" /></mxCell>
        <mxCell id="schritte" value="5-Schritt-Pflicht (CacheEngineBuilder pro Permutations-Build)&#xa;1. DISCOVER (statisch) - CPUID / sysfs / proc / hwloc&#xa;2. MEASURE (dynamisch) - Mikrobenchmark (clflush-cycle / All-Pairs-Pinning / Coherence-Calibration)&#xa;3. CLASSIFY - Properties (has_asymmetric_l3, preferred_pinning, has_hbm_tier, ...)&#xa;4. PUBLISH - allen Permutations-Modulen als Konfigurations-Optionen&#xa;5. BIND - pro Permutation entscheidet ICacheStrategy-Visitor, was konsumiert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;verticalAlign=middle;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="280" width="2000" height="160" as="geometry" /></mxCell>
        <mxCell id="cache_concepts" value="Cache-Hierarchie&#xa;ICacheLevel / ICacheLine / ICacheTopology / ICacheResidency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="480" width="640" height="80" as="geometry" /></mxCell>
        <mxCell id="cpu_concepts" value="CPU-Modell (generisch)&#xa;ICpuCore / ICoreLayout / ICoreToThreadMap / IPinningPolicy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="480" width="600" height="80" as="geometry" /></mxCell>
        <mxCell id="bus_concepts" value="Bus / ISA-Features&#xa;IInterconnect / IBusTopology / IIsaFeatureSet / IMemoryBandwidthModel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="480" width="640" height="80" as="geometry" /></mxCell>
        <mxCell id="live" value="Echtzeit-Modelle&#xa;ILivePlatformModel - ILiveCpuModel (periodisch ~100ms-Tick)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C6BC0;strokeColor=#1A237E;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="620" width="2000" height="80" as="geometry" /></mxCell>
        <mxCell id="sched_heur" value="IScheduler (Thread-zu-Core, generisch) plus IHeuristic (~80 Konkretisierungen siehe 13)&#xa;LargestL3CcdPinning (allgemein) - HotPathOnHighIpcCore (allgemein)&#xa;CacheCostDP (P05) - WidthCostModel (P13) - CacheCoherenceCost (P28) - StrideVsSequential (P32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="760" width="2000" height="120" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="ipp" target="ippc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="ippc" target="iceop"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="K06" name="K06 Konzept Forschungs-Mission F15">
    <mxGraphModel dx="2400" dy="1300" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="K06 KONZEPT - Forschungs-Mission (Block AP) - heuristisch / informiert / adaptiv plus F15 Bausteine-Quer-Permutation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#F3E5F5;strokeColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="m1" value="HEURISTIC_STATIC&#xa;Klassische Faustregeln&#xa;ICacheStrategy = BaseEngineStrategy&#xa;Kein Auto-Discovery, kein Live-Modell" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="640" height="180" as="geometry" /></mxCell>
        <mxCell id="m2" value="INFORMED_KALIBRIERT&#xa;CacheEngine-Modell + plattform-Kalibrierung&#xa;ICacheStrategy = CacheEngineStrategy&#xa;Statische Heuristik-Wahl (Compile-Time)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="600" height="180" as="geometry" /></mxCell>
        <mxCell id="m3" value="AUTOMATIC_ADAPTIVE&#xa;DecisionLambdaTree-Steuerung waehrend Laufzeit&#xa;ICacheStrategy = CacheEngineStrategy&#xa;Dynamische Heuristik-Wahl via Live-Modell + Telemetry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D81B60;strokeColor=#880E4F;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="640" height="180" as="geometry" /></mxCell>
        <mxCell id="f15" value="F15 - Bausteine-Quer-Permutation (architektonisch erschlossen durch K3.3 + K3.4)&#xa;29 Cache-Familien x 4 Strategie-Ebenen x ~80 Heuristiken = ~10.000 moegliche Bausteine-Tupel&#xa;Mit Hybrid-Command-Pattern-Aufloesung x3 = ~30.000 Bausteine&#xa;ConstraintFilter (F4 K3.2) liefert ~500-1000 valide Permutationen pro Plattform&#xa;Cross-Familien-Permutationen (Trie-Page + BPlus-Layout + LOUDS-Encoding + Hot-Path-Heuristic): EXPLIZITES Forschungs-Ziel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="2000" height="220" as="geometry" /></mxCell>
        <mxCell id="opera" value="Operationalisierung (F15)&#xa;Pro Permutation wird die SELBE Workload-Sequenz auf den drei Modi (HEURISTIC/INFORMED/ADAPTIVE) ausgefuehrt.&#xa;Ergebnis: Direkter Vergleich der drei Modi ueber identische Workloads + Plattformen.&#xa;Diese These ist als zentrale Diplomarbeit-Einleitung verwendbar (siehe Glossar v7 BLOCK AP)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="200" y="660" width="2000" height="160" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U01" name="U01 UML IExecutingEngine Klassen">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U01 UML PROFESSIONELL - IExecutingEngine + Spezialisierungen (mit Variablen + Methoden)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="iexec" value="&lt;&lt;concept&gt;&gt; IExecutingEngine&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (protected):&#xa;# cache_engine_ : optional&lt;CacheEngine&amp;&gt;&#xa;# observer_registry_ : ObserverRegistry&amp;&#xa;# lifecycle_state_ : EngineLifecycleState&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ execute&lt;Op&gt;(operation : Op&amp;) : Result&lt;Op&gt;&#xa;+ warm_up() : void&#xa;+ reset() : void&#xa;+ shutdown() : void&#xa;+ telemetry_hooks() const : ObserverSlots&#xa;+ bind_cache_engine(engine : CacheEngine&amp;) : void&#xa;+ unbind_cache_engine() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="780" height="380" as="geometry" /></mxCell>
        <mxCell id="isearch" value="&lt;&lt;concept&gt;&gt; ISearchEngine : IExecutingEngine&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- root_page_ : IRootPage&amp;&#xa;- page_structure_ : ISearchPageStructure&amp;&#xa;- cache_strategy_ : ICacheStrategy&amp;&#xa;- prt_art_container_ : comdare::prt_art&lt;K, V&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ lookup(key : K) const : optional&lt;V&gt;&#xa;+ insert(key : K, value : V) : InsertResult&#xa;+ erase(key : K) : EraseResult&#xa;+ range_scan(begin : K, end : K) : RangeIterator&#xa;+ begin() / end() / rbegin() / rend()&#xa;+ size() const noexcept : size_t&#xa;+ empty() const noexcept : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="600" width="900" height="420" as="geometry" /></mxCell>
        <mxCell id="ifuture" value="&lt;&lt;concept&gt;&gt; IFutureEngine : IExecutingEngine&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Architektur-Slot (leer in PRT-ART)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Zukunftige Konkretisierungen, z.B.:&#xa;+ ICompactingEngine&#xa;+ IDeduplicationEngine&#xa;+ ISortingEngine&#xa;+ IRetentionEngine&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;ALLE nutzen die selbe CacheEngine-Schnittstelle&#xa;ueber die geerbte bind_cache_engine()-Methode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#1A237E;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="600" width="900" height="420" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;endArrow=block;endFill=0;" edge="1" parent="1" source="isearch" target="iexec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;endArrow=block;endFill=0;" edge="1" parent="1" source="ifuture" target="iexec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hint" value="UML-Konvention: + public, # protected, - private, ~ package&#xa;Concepts in C++23 nutzen requires-Klauseln; Konkrete Klassen erben/implementieren die Concept-Methoden compile-time-pruefbar." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#FFF9C4;" vertex="1" parent="1"><mxGeometry x="120" y="1080" width="2160" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U02" name="U02 UML Saeule A Page-Familie">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U02 UML PROFESSIONELL - Saeule A Page-Familie (IPage / IRootPage / IFanout / INode)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="ipage" value="&lt;&lt;concept&gt;&gt; IPage&lt;P&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Typen:&#xa;~ using PageHeader = typename P::PageHeader&#xa;~ using Value = typename P::Value&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (protected):&#xa;# header_ : PageHeader&#xa;# bytes_ : span&lt;byte&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ lookup(key : KeyView) const : LookupResult&lt;P&gt;&#xa;+ insert(key : KeyView, value : Value) : InsertResult&#xa;+ remove(key : KeyView) : RemoveResult&#xa;+ bytes() const noexcept : span&lt;byte const&gt;&#xa;+ value_type() const : type_info&#xa;+ accept(visitor : ICacheStrategy&amp;) : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="700" height="500" as="geometry" /></mxCell>
        <mxCell id="iroot" value="&lt;&lt;concept&gt;&gt; IRootPage&lt;R&gt; : IPage&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- fanout_ : IFanout&amp;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ root_fanout() const : IFanout&amp;&#xa;+ set_root_fanout(fanout : IFanout&amp;) : void&#xa;+ algorithm_signature() const : AlgorithmSignature&#xa;+ supports_concurrent_root_swap() const noexcept : bool&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Constraint:&#xa;inv: fanout_ ist genau 1 (eindeutig)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="700" height="380" as="geometry" /></mxCell>
        <mxCell id="ifan" value="&lt;&lt;concept&gt;&gt; IFanout&lt;F&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- nodes_ : array&lt;INode*, F::max_fanout&gt;&#xa;- node_count_ : uint16_t&#xa;- pages_strategy_pattern_ : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ visit_each_child(visitor : auto&amp;&amp;) const : void&#xa;+ lookup_child(byte : uint8_t) const : INode*&#xa;+ insert_child(byte, child : INode&amp;) : InsertChildResult&#xa;+ remove_child(byte : uint8_t) : RemoveChildResult&#xa;+ load_factor() const : double&#xa;+ pages_strategy_pattern() const : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Constraint K3.4:&#xa;inv: pages_strategy_pattern_ ist genau 1 pro IFanout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1680" y="120" width="700" height="500" as="geometry" /></mxCell>
        <mxCell id="inode" value="&lt;&lt;concept&gt;&gt; INode&lt;N&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Typen:&#xa;~ using ChildHandle = typename N::ChildHandle&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- placement_page_ : ISearchPage&amp;&#xa;- placement_offset_ : uint16_t&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ visit_each_child(visitor : auto&amp;&amp;) const : void&#xa;+ value_handle_for(byte : uint8_t) const : ValueHandle&#xa;+ child_handle_for(byte : uint8_t) const : ChildHandle&#xa;+ load_factor() const : double&#xa;+ search_page() const : ISearchPage&amp;&#xa;+ key_byte_at(slot : uint8_t) const : uint8_t" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="780" width="900" height="440" as="geometry" /></mxCell>
        <mxCell id="impl_hint" value="IMPLEMENTIERUNGS-PLAN je Concept (Open/Closed-Prinzip):&#xa;Pro Concept entsteht ein eigener Header (z.B. i_page.hpp, i_root_page.hpp, ...).&#xa;Konkretisierungen liegen in adapters/ext-Pfaden (Originalcode-Adapter) ODER prt_art/ (eigene Bausteine) ODER prt_art/legacy_reimpl/ (Re-Impl).&#xa;Concept-Klassen sind &apos;closed for modification&apos; - neue Konkretisierungen sind &apos;open for extension&apos; per template-Parameter + requires-Klausel." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="1100" y="780" width="1280" height="240" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;endArrow=block;endFill=0;" edge="1" parent="1" source="iroot" target="ipage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;" edge="1" parent="1" source="iroot" target="ifan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=1;endArrow=diamondThin;endFill=1;startArrow=none;" edge="1" parent="1" source="ifan" target="inode"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U03" name="U03 UML Saeule A Strategy-Familie">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U03 UML PROFESSIONELL - Saeule A Strategy-Familie + ICacheStrategy Visitor + Iteratoren" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="isps" value="&lt;&lt;concept&gt;&gt; ISearchPagesStrategy&lt;SPS&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (protected):&#xa;# structure_ : ISearchPageStructure&amp;&#xa;# pattern_ : ISearchPagesStrategyPattern&amp;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ on_insert_request(key : K, value : V) : OpResult&#xa;+ on_remove_request(key : K) : OpResult&#xa;+ on_consolidation_barrier(event : Event&amp;) : void&#xa;+ on_capacity_exceeded(page : ISearchPage&amp;) : void&#xa;+ get_target_page(key : K) const : ISearchPage&amp;&#xa;+ pattern() const : ISearchPagesStrategyPattern&amp;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="700" height="380" as="geometry" /></mxCell>
        <mxCell id="ispsp" value="&lt;&lt;concept&gt;&gt; ISearchPagesStrategyPattern&lt;SSP&gt;&#xa;K3.4 Multiplizitaet: 1 pro IFanout - has N ISearchPageStrategy&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- per_page_strategies_ : map&lt;PageId, ISearchPageStrategy&amp;&gt;&#xa;- pattern_kind_ : PatternKind  // 10 Varianten&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ assign_strategy(page : PageId, strat : ISearchPageStrategy&amp;)&#xa;+ strategy_for(page : PageId) const : ISearchPageStrategy&amp;&#xa;+ kind() const : PatternKind&#xa;+ visit_assignments(visitor : auto&amp;&amp;) const : void&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;PatternKind enum:&#xa;AllPagesUniform | LayerMix | InnerVsLeaf | HotVsCold |&#xa;DynamicRebalance | HierarchicalFractal | ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="780" height="500" as="geometry" /></mxCell>
        <mxCell id="isps_s" value="&lt;&lt;concept&gt;&gt; ISearchPageStrategy&lt;SP&gt;&#xa;K3.4 Multiplizitaet: 1 pro ISearchPage&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (protected):&#xa;# owning_page_ : ISearchPage&amp;&#xa;# layout_invariants_ : LayoutInvariantSet&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ insert_into(slot : Slot, key : K, value : V) : OpResult&#xa;+ remove_from(slot : Slot) : OpResult&#xa;+ should_split() const noexcept : bool&#xa;+ should_merge_with(other : ISearchPage&amp;) const : bool&#xa;+ check_invariants() const : bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1760" y="120" width="600" height="380" as="geometry" /></mxCell>
        <mxCell id="ics" value="&lt;&lt;concept, visitor&gt;&gt; ICacheStrategy&lt;CS&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ visit(read_op : PageReadOp&amp;) : void&#xa;+ visit(write_op : PageWriteOp&amp;) : void&#xa;+ visit(layout_op : PageLayoutOp&amp;) : void&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Konkretisierungen (Visitor):&#xa;A) BaseEngineStrategy - Baseline F15&#xa;B) CacheEngineStrategy - mit ILivePlatformModel + IHeuristic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="780" height="320" as="geometry" /></mxCell>
        <mxCell id="iter" value="Iteratoren-Familie&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;&lt;&lt;concept&gt;&gt; INodeIterator&lt;NI&gt; - byte_at() / next() / done() / current()&#xa;&lt;&lt;concept&gt;&gt; ISearchPageIterator&lt;SI&gt; - page_at() / next_page() / range_advance(steps)&#xa;&lt;&lt;concept&gt;&gt; ISearchPageStrategyIterator&lt;SSI&gt; - strategy_at() / next_strategy() / cross_algorithm_permutation()&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;class comdare::prt_art&lt;K, V&gt;:&#xa;+ iterator (mutable) - operator++ / operator* / operator->&#xa;+ const_iterator&#xa;+ range_iterator&#xa;+ key_iterator&#xa;+ value_iterator&#xa;+ begin() / end() / cbegin() / cend() / rbegin() / rend()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="700" width="1380" height="380" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="isps" target="ispsp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="ispsp" target="isps_s"><mxGeometry relative="1" as="geometry" /></mxCell>
