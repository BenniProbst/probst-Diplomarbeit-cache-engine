  <diagram id="U04" name="U04 UML Hybrid-Command Klassen">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U04 UML PROFESSIONELL - Hybrid-Command-Pattern Klassen mit Variablen + Methoden" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="iscmd" value="&lt;&lt;abstract&gt;&gt; IStrategyCommand&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public abstract):&#xa;+ virtual execute(context : StrategyContext&amp;) : Result = 0&#xa;+ virtual can_compose_with(other : IStrategyCommand&amp;) const : bool = 0&#xa;+ virtual command_kind() const noexcept : CommandKind = 0&#xa;+ virtual estimated_cost(context : StrategyContext&amp;) const : Cost = 0&#xa;+ virtual ~IStrategyCommand() = default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="980" height="240" as="geometry" /></mxCell>
        <mxCell id="hcc" value="&lt;&lt;composite&gt;&gt; HybridCompositionCommand : IStrategyCommand&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- parts_ : vector&lt;unique_ptr&lt;IStrategyCommand&gt;&gt;&#xa;- composition_rule_ : unique_ptr&lt;ICompositionRule&gt;&#xa;- composition_id_ : CompositionId&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ execute(context : StrategyContext&amp;) override : Result&#xa;+ add_part(part : unique_ptr&lt;IStrategyCommand&gt;) : void&#xa;+ remove_part(idx : size_t) : void&#xa;+ part_count() const noexcept : size_t&#xa;+ composition_rule() const : ICompositionRule&amp;&#xa;+ set_composition_rule(rule : unique_ptr&lt;ICompositionRule&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="900" height="440" as="geometry" /></mxCell>
        <mxCell id="icr" value="&lt;&lt;concept&gt;&gt; ICompositionRule&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ apply(parts : span&lt;IStrategyCommand*&gt;, ctx : StrategyContext&amp;) : ExecutionPlan&#xa;+ rule_kind() const noexcept : RuleKind&#xa;+ supports_parallel() const noexcept : bool&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Konkrete Subklassen:&#xa;+ SequentialRule&#xa;+ ParallelRule&#xa;+ ConditionalRule (with ConditionPredicate)&#xa;+ RecursiveRule (with DepthLimit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="700" height="380" as="geometry" /></mxCell>
        <mxCell id="atom_ex" value="Atom-Beispiel: HashAnchorLookupCommand : IStrategyCommand (P07 Wormhole)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- anchor_table_ : AnchorTable&amp;&#xa;- hash_function_ : HashFn&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ execute(context) override : Result&#xa;+ can_compose_with(other) const override : bool&#xa;+ command_kind() const noexcept override : CommandKind::HashAnchor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1840" y="460" width="540" height="380" as="geometry" /></mxCell>
        <mxCell id="hint" value="17 Composition-Konkretisierungen ableitbar von HybridCompositionCommand:&#xa;MasstreeSliceLayered / CutoffLevelLouds / HOTAdaptiveLayoutSelection / TripleLayerLookup / B2TreeRecursiveCommonPrefix / CoCoLevelLDecision /&#xa;CoCoEncodingPool / ThreePrefetcherOrchestration / KuehnHotPathOptimization / ChenPrefetchedBPlus / HankinsPatelCostModel /&#xa;ZhangFGCSPointerResolution / STARTAdaptive / KhanRuntimeAdaptive / SamuelConfigurationTable / BTreesAreBackHeterogeneousAdaptive / SequentialInsertComposition" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="120" y="940" width="2260" height="180" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="hcc" target="iscmd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=1;startArrow=none;" edge="1" parent="1" source="hcc" target="icr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="atom_ex" target="iscmd"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U05" name="U05 UML Saeule B Plattform-Probe">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U05 UML PROFESSIONELL - Saeule B Plattform-Probe + Auto-Discovery Klassen" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="ipp" value="&lt;&lt;concept&gt;&gt; IPlatformProbe (KEINE CPU-Spezialisierung)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public abstract):&#xa;+ discover_cache_topology() : ICacheTopology&#xa;+ discover_core_layout() : ICoreLayout&#xa;+ discover_isa_features() : IIsaFeatureSet&#xa;+ discover_interconnect() : IBusTopology&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;+ measure_cache_latencies() : map&lt;TierPair, Cycles&gt;&#xa;+ measure_bandwidths() : map&lt;InterconnectId, Gbps&gt;&#xa;+ measure_cache_coherence_cost() : CoherenceCostFunction&#xa;+ measure_pinning_effects() : map&lt;PinningPolicy, Speedup&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="900" height="400" as="geometry" /></mxCell>
        <mxCell id="ippc" value="&lt;&lt;concept&gt;&gt; IPlatformPropertyClassifier&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public abstract):&#xa;+ classify(probe_results : ProbeResults const&amp;) : PlatformPropertySet&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;PlatformPropertySet enthaelt:&#xa;- has_asymmetric_l3 : bool&#xa;- has_hybrid_cores : bool&#xa;- has_hbm_tier : bool&#xa;- preferred_pinning : PinningPolicy&#xa;- usable_simd_width : int&#xa;- has_software_prefetch : bool&#xa;- coherence_cost_threshold : Cycles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#1A237E;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="700" height="500" as="geometry" /></mxCell>
        <mxCell id="iceop" value="&lt;&lt;concept&gt;&gt; ICacheEngineOptionPublisher&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- properties_ : PlatformPropertySet&#xa;- registered_modules_ : vector&lt;PermutationModule*&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public abstract):&#xa;+ register_module(module : PermutationModule&amp;) : void&#xa;+ unregister_module(module : PermutationModule&amp;) : void&#xa;+ publish_options_to_all() : void&#xa;+ filter_options_for(module : PermutationModule&amp;) : OptionSet&#xa;+ properties() const : PlatformPropertySet const&amp;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1880" y="120" width="500" height="440" as="geometry" /></mxCell>
        <mxCell id="schritte" value="5-Schritt-Pflicht-Sequenz im CacheEngineBuilder (orchestriert IPlatformProbe + IPlatformPropertyClassifier + ICacheEngineOptionPublisher)&#xa;1. DISCOVER  - probe.discover_*() (statisch)&#xa;2. MEASURE   - probe.measure_*() (Mikrobenchmark)&#xa;3. CLASSIFY  - classifier.classify(probe_results)&#xa;4. PUBLISH   - publisher.register_module + publish_options_to_all&#xa;5. BIND      - pro Permutation entscheidet ICacheStrategy (Visitor) was konsumiert" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="2260" height="200" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="ipp" target="ippc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;" edge="1" parent="1" source="ippc" target="iceop"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="U06" name="U06 UML Saeule B Cache + Heuristic">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="U06 UML PROFESSIONELL - Saeule B Cache-Hierarchie + IHeuristic Familie" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="iclevel" value="&lt;&lt;concept&gt;&gt; ICacheLevel&lt;L&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (public):&#xa;+ size_bytes : size_t&#xa;+ line_size_bytes : size_t  // typ. 64 (256 ARM)&#xa;+ associativity : int&#xa;+ latency_cycles : double&#xa;+ bandwidth_gbps : double&#xa;+ tier_kind : enum L1 / L2 / L3 / HBM / V_CACHE&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ effective_capacity(...) const : size_t&#xa;+ measured_at(timestamp) const : MeasureSnapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="600" height="380" as="geometry" /></mxCell>
        <mxCell id="ictopo" value="&lt;&lt;concept&gt;&gt; ICacheTopology&lt;CT&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (private):&#xa;- levels_ : vector&lt;ICacheLevel&amp;&gt;&#xa;- per_ccd_ : map&lt;CcdId, ICacheLevel&amp;&gt;&#xa;- asymmetric_l3_ : bool   // Auto-discovered&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ levels() const : span&lt;ICacheLevel const&amp;&gt;&#xa;+ level_count() const : size_t&#xa;+ has_asymmetric_l3() const : bool&#xa;+ largest_l3_ccd() const : CcdId&#xa;+ tier_for(ptr : void const*) const : Optional&lt;TierKind&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="640" height="400" as="geometry" /></mxCell>
        <mxCell id="icres" value="&lt;&lt;concept&gt;&gt; ICacheResidency&lt;CR&gt;&#xa;Cache whereabouts (Cached / HeaderCached / Uncached)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public):&#xa;+ residency_of(page : ICachePage const&amp;) const : ResidencyKind&#xa;+ track_access(page : ICachePage const&amp;) : void&#xa;+ track_eviction(page : ICachePage const&amp;) : void&#xa;+ pinning_hint_for(page : ICachePage const&amp;) : Optional&lt;TierKind&gt;&#xa;+ snapshot() const : ResidencyMap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1520" y="120" width="860" height="380" as="geometry" /></mxCell>
        <mxCell id="iheur" value="&lt;&lt;concept&gt;&gt; IHeuristic&lt;H&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Attribute (protected):&#xa;# live_model_ : ILivePlatformModel&amp;&#xa;# property_set_ : PlatformPropertySet const&amp;&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Methoden (public abstract):&#xa;+ recommend(input : HeuristicInput const&amp;) : Recommendation&#xa;+ estimated_value(input : HeuristicInput const&amp;) const : double&#xa;+ confidence() const noexcept : double  // 0.0 - 1.0&#xa;+ heuristic_kind() const noexcept : HeuristicKind&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Konkretisierungen (~80, siehe 13 Paragraph 8):&#xa;LargestL3CcdPinning (allgemein, ersetzt X3DAware)&#xa;HotPathOnHighIpcCore (allgemein, ersetzt IntelHybridP)&#xa;CacheCostDPHeuristic (P05) - WidthCostModel (P13)&#xa;ProbabilityLayout (P16) - StrideVsSequential (P32)&#xa;CacheCoherenceCost (P28 Block AN) - usw." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#4A148C;fontSize=11;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="600" width="2260" height="500" as="geometry" /></mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=diamondThin;endFill=0;startArrow=none;" edge="1" parent="1" source="iclevel" target="ictopo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=open;startArrow=none;dashed=1;" edge="1" parent="1" source="ictopo" target="icres"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="MX1" name="MX1 Konzept Layer-vs-Matrix Strategie">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="MX1 KONZEPT - Layer + Matrix-Hybrid Implementierungs-Anordnung (Future-Proof Software-Architecture)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#E8F5E9;strokeColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2320" height="60" as="geometry" /></mxCell>
        <mxCell id="layer_box" value="LAYER-DIMENSION (vertikal, klassisch)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Drei Ebenen wie in K01: Engine | Strategien | CacheEngine&#xa;Ein Concept gehoert genau einem Layer - klare Abhaengigkeits-Richtung (oben → unten)&#xa;Vorteil: Encapsulation, stabile Contracts, einfaches Reasoning, Open/Closed pro Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0097A7;strokeColor=#006064;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="2160" height="120" as="geometry" /></mxCell>
        <mxCell id="matrix_box" value="MATRIX-DIMENSION (horizontal, fuer Bausteine-Quer-Permutation F15)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Pro Layer existiert eine Matrix der Konkretisierungen entlang mehrerer orthogonaler Achsen.&#xa;Achsen (Auswahl): Cache-Familie F1-F29 / Strategie-Ebene A-D / Plattform-Property / ISA-Feature / Concurrency-Mechanik / Telemetry-Strategie&#xa;Dependency Structure Matrix (DSM) als Visualisierungs-Tool fuer Cross-Achsen-Beziehungen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="2160" height="140" as="geometry" /></mxCell>
        <mxCell id="hybrid" value="HYBRID-EMPFEHLUNG (PRT-ART) - Layer fuer Architektur, Matrix fuer Konkretisierungen&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Concept-Hierarchie wird als 3 LAYER definiert (Ebene 1 / 2 / 3 wie K01).&#xa;Konkretisierungen pro Concept-Klasse werden als MATRIX angelegt.&#xa;Beispiel ICacheStrategy: Achse 1 = Visitor-Variante (Base/CacheEngine), Achse 2 = Cache-Familie F1-F29.&#xa;Beispiel IHeuristic: Achse 1 = Heuristik-Kategorie (Prefetch/Layout/Coherence/Plattform/ISA/Concurrency), Achse 2 = Paper-Quelle.&#xa;Beispiel ISearchPagesStrategyPattern: Achse 1 = PatternKind (10 Varianten), Achse 2 = Adaptivitaet (Statisch/Adaptive/Runtime).&#xa;Verzeichnis-Konsequenz: Pro Concept ein Header in concepts/, pro Achse ein Sub-Verzeichnis mit den Konkretisierungen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="2160" height="240" as="geometry" /></mxCell>
        <mxCell id="future" value="FUTURE-PROOF-PRINZIPIEN (aus Web-Recherche 2026-05-10)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;1. Open/Closed-Principle - Concept-Klassen sind closed for modification, Konkretisierungen sind open for extension via template + requires&#xa;2. Modular Architecture - jede Achse einer Matrix ist eine unabhaengig austauschbare Achse (eigenes Sub-Verzeichnis)&#xa;3. Encapsulation through stable contracts - Concept-Header sind die Contracts; Konkretisierungen koennen sich aendern, Concepts bleiben stabil&#xa;4. Single Responsibility auf Architektur-Ebene - jede Concept-Klasse hat einen klaren Zweck (z.B. ICacheStrategy = Read/Write-Routing)&#xa;5. Separation of Concerns - Saeulen A/B sind disjunkt; Engine konsumiert nur abstrakte Schnittstellen&#xa;6. API-First Design - jede Erweiterung beginnt mit Concept-Erweiterung, nie mit Implementierung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="760" width="2260" height="280" as="geometry" /></mxCell>
        <mxCell id="hint" value="DSM (Dependency Structure Matrix) als Visualisierungs-Tool fuer Architektur-Reviews:&#xa;Zeilen + Spalten = alle Concepts; Zellen = vorhandene Abhaengigkeit. Ziel = Block-Triangulare Struktur (saubere Layer-Trennung). DSM koennte separates Phase-6+-Werkzeug werden." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fillColor=#FFF9C4;strokeColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="120" y="1080" width="2260" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
