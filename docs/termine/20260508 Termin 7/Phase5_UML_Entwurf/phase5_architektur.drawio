        <mxCell id="arrow-d5-d1" value="waehlt Algo + Engine" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#B71C1C;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#B71C1C;" edge="1" parent="1" source="d5-engine" target="d1-search">
          <mxGeometry relative="1" as="geometry" />
