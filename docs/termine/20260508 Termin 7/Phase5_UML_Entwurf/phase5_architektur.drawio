        <mxCell id="arrow-d2-d4" value="nutzt LiveCpuModel" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#006064;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#006064;" edge="1" parent="1" source="d2-cache" target="d4-hwisa">
