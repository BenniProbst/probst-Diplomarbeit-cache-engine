        <mxCell id="arrow-d5-d2" value="aktiviert CacheEngine" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#B71C1C;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#B71C1C;" edge="1" parent="1" source="d5-engine" target="d2-cache">
