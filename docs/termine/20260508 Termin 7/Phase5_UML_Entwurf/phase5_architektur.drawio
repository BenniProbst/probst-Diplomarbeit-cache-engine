        <mxCell id="arrow-d2-d3" value="schreibt Mess-Records" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#1B5E20;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1B5E20;" edge="1" parent="1" source="d2-cache" target="d3-meas">
