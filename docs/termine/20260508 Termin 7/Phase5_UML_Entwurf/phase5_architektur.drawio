        <mxCell id="title-1" value="comdare-cache-engine — Architektur-Uebersicht (Domaenen 1-6)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-1" value="TU Dresden Diplomarbeit · PRT-ART · Phase 5 Entwurf · 2026-05-08 · REV 2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="55" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="d1-search" value="DOMAENE 1 — SEARCH ENGINE&#xa;━━━━━━━━━━━━━━━━━━━━━━━&#xa;fan_out_engine (Tries / B-/B+-/...)&#xa;Algorithm Strategies (P01-P33 + PRT-ART)&#xa;Page / Node / Traversal / ValueHandle&#xa;als C++23 Concepts mit requires&#xa;━━━━━━━━━━━━━━━━━━━━━━━&#xa;std::map-API (vollstaendig C++23)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d2-cache" value="DOMAENE 2 — CACHE ENGINE  «KERNBEITRAG»&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Schicht A: CacheEngineBuilder  (= main.cpp)&#xa;Schicht B: CacheEngine  «Heap-Singleton im Builder-Prozess»&#xa;ConcurrencyManager  «Sub-Singleton, 8+ Disziplinen»&#xa;DecisionLambdaTrees PRO BAUSTEIN  (F-EXTRA-6)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Live Modell der CPU — Observer + Visitor + Empfehlung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="440" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d3-meas" value="DOMAENE 3 — MEASUREMENT&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;In-Memory MeasurementBuffer  «KEINE DB!»&#xa;perf / PAPI / Intel Advisor Wrapper&#xa;HdrHistogram (Tail-Latenz)&#xa;Builder-Run + Single-Run + Mikrobenchmarks&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;Continuous (Builder) / Sampled (Production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d4-hwisa" value="DOMAENE 4 — HARDWARE / ISA&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;ISA-Dispatch  (target_clones)&#xa;scalar / x86_avx2 / x86_avx512 / arm_neon / arm_sve2&#xa;Hybrid-Core Pinning  (P/E-Cores)&#xa;Memory-Type-Detector  (DRAM / HBM / NV-RAM)&#xa;Hugepages  (2MB / 1GB)&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;Compile-Time XOR Runtime ISA-Detection  (F9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=#006064;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="350" width="440" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d5-engine" value="DOMAENE 5 — ENGINE-CHOICE&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;Compile-Time Template-Wahl:&#xa;StaticEngine&lt;Algo&gt;  vs  CacheEngine&lt;Algo&gt;&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;Static = Originalcode + Adapter, KEINE Optimierung&#xa;Cache = aktive Optimierung mit Builder + Singleton" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="580" width="320" height="160" as="geometry" />
        </mxCell>

        <mxCell id="d6-pub" value="DOMAENE 6 — PERSISTENCE &amp; PUBLICATION&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Disk-Serializer (Binary/CSV-Dump aus In-Memory-Buffer)&#xa;LaTeX-Renderer (tabular + pgfplots + booktabs + siunitx)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Output: Anhang fuer Diplomarbeit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AD1457;strokeColor=#880E4F;strokeWidth=3;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="580" width="440" height="160" as="geometry" />
        </mxCell>

        <mxCell id="d-direktive" value="HABICH-DIREKTIVE&#xa;━━━━━━━━━━━━━━━━&#xa;Originalcode (P01-P33) wird&#xa;EXAKT KOPIERT in ext/ ablegt.&#xa;Anbindung NUR ueber Adapter.&#xa;━━━━━━━━━━━━━━━━&#xa;Hauptcompiler IMMER C++23.&#xa;Bausteine mit Original-Compiler&#xa;kompiliert + statisch gelinkt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#283593;strokeColor=#1A237E;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=2;spacingTop=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="120" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d-f15" value="FORSCHUNGS-THESE F15&#xa;━━━━━━━━━━━━━━━━━━━&#xa;BAUSTEINE-QUER-PERMUTATION:&#xa;jeder Baustein gegen jeden anderen&#xa;Baustein aus jedem Algorithmus&#xa;austauschbar.&#xa;━━━━━━━━━━━━━━━━━━━&#xa;CacheEngine-Universalitaet im&#xa;allgemeinen Fall zeigen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9A825;strokeColor=#F57F17;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fontStyle=1;spacingTop=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="350" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d-direktive2" value="ARCHITEKT-DIREKTIVE 2026-05-08&#xa;━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Modularisierte Bruchstuecke +&#xa;C++23-Metaprogrammierung&#xa;= NEUES Werk (auch wenn&#xa;'inspiriert' von GPL-3.0).&#xa;━━━━━━━━━━━━━━━━━━━━━━━━&#xa;CacheEngine LEBT IM Builder&#xa;als Heap-Singleton (F12-K)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=2;spacingTop=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="580" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="arrow-d1-d2-observer" value="OBSERVER&#10;Push synchron + DecisionLambdaTree-Filter&#10;EXECUTE / DELAY / SKIP" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#0D47A1;strokeWidth=4;fontSize=11;fontStyle=1;fontColor=#0D47A1;" edge="1" parent="1" source="d1-search" target="d2-cache">
