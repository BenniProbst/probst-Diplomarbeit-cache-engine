        <mxCell id="axis-page" value="ACHSE 1&#xa;PAGE-TYPE&#xa;━━━━━━━━&#xa;DenseByte_ART256&#xa;Compound_HOT&#xa;BPlus_Masstree&#xa;Macro_CoCo [GPL]&#xa;Multibyte_START&#xa;Decision_B²tree&#xa;Span_B²tree&#xa;MetaTrieHT_Wormhole&#xa;LOUDS_Dense_SuRF&#xa;LOUDS_Sparse_SuRF&#xa;CSS_Node&#xa;CSB_NodeGroup&#xa;Wider_Hankins&#xa;Adaptive_BTreesAreBack&#xa;PRTART_DenseByte&#xa;PRTART_Redirect&#xa;..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="170" height="290" as="geometry" />
        </mxCell>

        <mxCell id="axis-node" value="ACHSE 2&#xa;NODE-TYPE&#xa;━━━━━━━&#xa;Node4 / 16 / 48 / 256&#xa;Compound_K32_HOT&#xa;BiNode_HOT&#xa;Internal_Masstree&#xa;Border_Masstree&#xa;Macronode_CoCo&#xa;Multibyte_START&#xa;Decision_B²tree&#xa;Span_B²tree&#xa;CSS_Node&#xa;CSB_NodeGroup&#xa;Wider_BPlus&#xa;PRTART_*Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="170" height="290" as="geometry" />
        </mxCell>

        <mxCell id="axis-trav" value="ACHSE 3&#xa;TRAVERSAL&#xa;━━━━━━━━&#xa;ByteByByte_ART&#xa;DiscBits_HOT&#xa;LayerSlice_Masstree&#xa;MacroNode_CoCo&#xa;MultibyteSpan_START&#xa;EmbDecTree_B²tree&#xa;HashAnchor_Wormhole&#xa;RankSelect_LOUDS&#xa;LowerBound_SuRF&#xa;PtrArith_CSS&#xa;Offset_CSB&#xa;PrefetchAhead_Chen&#xa;AdaptDist_Khan&#xa;PRTART_HotPath&#xa;PRTART_PrefetchAware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="170" height="290" as="geometry" />
        </mxCell>

        <mxCell id="axis-vh" value="ACHSE 4&#xa;VALUE-HANDLE&#xa;━━━━━━━━━━&#xa;Inline&#xa;Pointer&#xa;Redirect_To_Node&#xa;Redirect_To_Page&#xa;Dynamic&#xa;(switch_array&#xa; pro Algorithmus&#xa; begrenzt)&#xa;━━━━━━━━━━&#xa;Sache der NODE&#xa;(F8 std::variant +&#xa; Concept-Constraint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="630" y="100" width="170" height="290" as="geometry" />
        </mxCell>

        <mxCell id="axis-mem" value="ACHSE 5&#xa;MEMORY-LAYOUT&#xa;━━━━━━━━━━━&#xa;CachelineAligned&#xa;Hugepage_2MB&#xa;Hugepage_1GB&#xa;PointerFreeContig&#xa;SiblingCluster&#xa;InlineSlot&#xa;MetadataHeader&#xa;EmbeddedTree&#xa;ProbabilityLayout&#xa;CacheOblivious&#xa;LayoutInvariant&#xa;MultiLevelReloc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="170" height="290" as="geometry" />
        </mxCell>

        <mxCell id="axis-alloc" value="ACHSE 6&#xa;ALLOCATOR&#xa;━━━━━━━━&#xa;PoolPerPageType&#xa;ArenaPerSubtree&#xa;Slab&#xa;HBM&#xa;DefaultMalloc&#xa;TcmallocAdapter&#xa;MimallocAdapter&#xa;SnmallocAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="100" width="170" height="200" as="geometry" />
        </mxCell>

        <mxCell id="axis-pref" value="ACHSE 7&#xa;PREFETCH&#xa;━━━━━━━&#xa;None&#xa;SoftwareFixed_Chen&#xa;AdaptiveDist_Khan&#xa;HierBundle_Zhang&#xa;FillBufferAware_Mahling&#xa;HotPath_Zhang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="170" height="180" as="geometry" />
        </mxCell>

        <mxCell id="axis-conc" value="ACHSE 8&#xa;CONCURRENCY&#xa;━━━━━━━━━━&#xa;Disziplinen:&#xa;Page / Node / Array&#xa;DataStructure / Path&#xa;Memory R / W / RW&#xa;SimdThread / SimdFlow&#xa;━━━━━━━━━━&#xa;Mechaniken:&#xa;OLC&#xa;ROWEX&#xa;RCU (LGPL, dyn.)&#xa;SingleThreaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="320" width="170" height="220" as="geometry" />
        </mxCell>

        <mxCell id="axis-isa" value="ACHSE 9&#xa;ISA&#xa;━━━━━━&#xa;scalar (x86/arm/riscv)&#xa;x86_avx2&#xa;x86_avx512&#xa;x86_bmi1 / bmi2&#xa;arm_neon&#xa;arm_sve / sve2&#xa;riscv_v" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=9;fontColor=#FFFFFF;fontStyle=1;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="320" width="170" height="200" as="geometry" />
        </mxCell>

        <mxCell id="example-trad" value="TRADITIONELLE STUDIE  (vor PRT-ART)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Vergleich GANZER Algorithmen:&#xa;ART vs HOT vs Masstree vs B²-tree vs ...&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Pro Algorithmus EINE feste Kombination&#xa;auf alle 9 Achsen — nicht zerlegbar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacingTop=8;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="450" height="120" as="geometry" />
        </mxCell>

        <mxCell id="example-prt" value="PRT-ART F15 — BAUSTEINE-QUER-PERMUTATION&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Beispiel-Permutation A (Originalpaper-Reproduktion):&#xa;DenseByte_ART256 + Node256 + ByteByByte + Inline + CachelineAligned&#xa;+ PoolPerPageType + None + OLC + AVX2&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Beispiel-Permutation B (Quer-Mix):&#xa;Compound_HOT + Internal_Masstree + RankSelect_LOUDS + Dynamic&#xa;+ PointerFreeContig_CSS + ArenaPerSubtree&#xa;+ AdaptDist_Khan + RCU + AVX-512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacingTop=8;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="450" width="830" height="180" as="geometry" />
        </mxCell>

        <mxCell id="thesis" value="ZENTRALE FORSCHUNGS-AUSSAGE F15&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;'Wir muessen die Algorithmen IN BAUSTEINE NACH DEM DOMAENENMODELL zerlegen, sodass jeder Algorithmus-Baustein EINZELN testweise gegen einen anderen aus JEDEM&#xa;BELIEBIGEN anderen Algorithmus ausgetauscht werden kann. Es geht um die Untersuchung jedes einzelnen Prinzips gegen jedes Andere&#xa;unter Verwendung der aktiven Cache Engine.'  — Architekt-Direktive 2026-05-04&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Permutations-Identifier = Flag-System nach CPUID-Vorbild (F10-K, 9 uint64-Banken)&#xa;Permutationsraum (gefiltert) ≈ 500 Modul-Permutationen × 144 Test-Traces × 4 Plattformen = ≈ 20.000 Experimente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9A825;strokeColor=#F57F17;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;spacingTop=10;spacingLeft=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1310" height="220" as="geometry" />
        </mxCell>

        <mxCell id="cache-engine-role" value="ROLLE DER CACHE-ENGINE BEIM F15-BEWEIS&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Visitor + Observer ueber alle gewaehlten Bausteine.&#xa;DecisionLambdaTrees PRO BAUSTEIN (kein globaler Default) — Komposition pro Algorithmus.&#xa;Empfehlung aus CompileTimeKnowledge (Builder-Erfahrung pro Plattform).&#xa;Ergebnis: Cache-Engine wirkt UNIVERSELL auf jede Bausteine-Kombination —&#xa;das ist der Diplomarbeits-Beweis der Verallgemeinerbarkeit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacingTop=8;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1310" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4_Compiler_Layering_FExtra1" id="diag-compiler">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-4" value="Compiler-Layering (F-EXTRA-1) — Habich-Direktive: Originalcode mit Original-Compiler" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-4" value="Pro Modul-Permutation: C++23-Schale + Original-Compiler-Bausteine → statisches Linken → ABI-stabiles Modul" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="schale" value="SCHALE  «Modul-Wrapper»&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;Compiler:  C++23  (GCC 14+, Clang 17+, MSVC 19.39+)&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;Inhalt:&#xa;• Adapter (uebersetzt Original-API → Concepts)&#xa;• Concept-Bindungen (FanOutContainer, Page, Node,&#xa;   Traversal, ValueHandleStrategy, MemoryLayout)&#xa;• ABI-stabiles Modul-Interface (export module ...)&#xa;• Cache-Warmup-Logik (modul-spezifisch, F12-K)&#xa;• Mess-Hooks (constexpr Measure&amp;lt;C, D&amp;gt;, F1)&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;Sichtbarkeit:  EXTERN (Modul-API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="500" height="240" as="geometry" />
        </mxCell>

        <mxCell id="bausteine" value="BAUSTEINE  «Originalcode-Internals»&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Compiler:  je Algorithmus dessen Original-Compiler&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Beispiele:&#xa;• ART (P01) → GCC 4.7+&#xa;• HOT (P02) → GCC 5+ (BMI2 / AVX2)&#xa;• Masstree (P03) → GCC 4.6+&#xa;• CoCo-Trie (P04) → GCC 11+ (C++20)&#xa;• START (P05) → GCC 7+&#xa;• B²-tree (P06) → GCC 9+&#xa;• Wormhole (P07) → GCC 7+&#xa;• SuRF (P10) → GCC 5+&#xa;• LeanStore (P20) → GCC 13+&#xa;• Mahling Prefetch (P25) → GCC 11+&#xa;• userspace-rcu (P29) → GCC 4+ (LGPL — dynamisch!)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Inhalt:  EXAKTER Originalcode (Habich-Direktive)&#xa;Ausgabe:  .o (Object-File) oder .a (statische Library)&#xa;Sichtbarkeit:  INTERN (kein externes Symbol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#283593;strokeColor=#1A237E;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="500" height="320" as="geometry" />
        </mxCell>

        <mxCell id="static-link" value="STATIC LINKING  →  ABI-stabiles Modul&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Linker:  Hauptcompiler (C++23-Toolchain)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Eingabe:&#xa;• Schale-.o  (C++23, extern visible)&#xa;• Bausteine-.o / .a  (Original-Compiler, intern visible)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Ausgabe:&#xa;• .so  (Linux)&#xa;• .dll  (Windows)&#xa;• .dylib  (macOS)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Pfad: build/modules/&amp;lt;perm_id&amp;gt;/&amp;lt;perm_id&amp;gt;.module.so&#xa;Identifier:  Flag-System (CPUID-Stil, F10-K)&#xa;PAGE_DENSEBYTE_ART256.NODE_NODE256.TRAVERSAL_BYTEBYBYTE&#xa;.VALUEHANDLE_INLINE.MEMORY_CACHELINE_ALIGNED&#xa;.ALLOCATOR_POOL_PER_PAGETYPE.PREFETCH_NONE&#xa;.CONCURRENCY_OLC.ISA_X86_AVX2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;strokeWidth=4;align=left;verticalAlign=top;fontSize=12;fontColor=#FFFFFF;fontStyle=1;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="1100" height="300" as="geometry" />
        </mxCell>

        <mxCell id="arr-schale-link" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#0D47A1;strokeWidth=4;" edge="1" parent="1" source="schale" target="static-link">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr-baust-link" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#1A237E;strokeWidth=4;" edge="1" parent="1" source="bausteine" target="static-link">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cmake-pipeline" value="PIPELINE (F-EXTRA-5: Python-Codegen → CMake)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;1.  tools/permutation_codegen/codegen.py  liest Bausteine_Matrix + Flag_System&#xa;2.  Enumeriert gueltige Permutationen (ConstraintFilter via CMake compile-time, F4)&#xa;3.  Pro Permutation:  Schalen-.cpp/.ccm + external_objects.cmake generiert&#xa;4.  CMake parallelisiert die Hunderten add_library()-Targets&#xa;5.  Pre-Build verifiziert pro Algorithmus die Verfuegbarkeit des Original-Compilers&#xa;6.  Output:  build/modules/&amp;lt;perm_id&amp;gt;/  +  build/generated/permutations.cmake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#424242;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;spacingTop=10;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="820" width="1300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="hint-architekt" value="ARCHITEKT-DIREKTIVE 2026-05-08&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;'Wir verwenden ohnehin nur&#xa;modularisierte Bruchstuecke des&#xa;Original codes, was technisch&#xa;gesehen neuen Code erzeugt.&#xa;Unser Code wird C++23 und damit&#xa;ist durch die Metaprogrammierung&#xa;alles neu, auch wenn wir uns&#xa;inspirieren lassen.'&#xa;━━━━━━━━━━━━━━━━━━━━━&#xa;→ GPL-3.0 / LGPL kein&#xa;Hinderungsgrund&#xa;(P04, P07, P29)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;fontStyle=2;spacingTop=8;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1230" y="120" width="220" height="320" as="geometry" />
        </mxCell>

      </root>
