        <mxCell id="arrow-d2-d1-visitor" value="VISITOR&#10;Mid-Granularitaet&#10;visit(IPage*) / visit(INode*)" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#BF360C;strokeWidth=4;fontSize=11;fontStyle=1;fontColor=#BF360C;" edge="1" parent="1" source="d2-cache" target="d1-search">
