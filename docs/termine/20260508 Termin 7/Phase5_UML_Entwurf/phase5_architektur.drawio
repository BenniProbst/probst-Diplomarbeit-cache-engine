  </diagram>

  <diagram name="2_CacheEngine_Singleton_Hierarchie" id="diag-cache-engine">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-2" value="Domaene 2 — Cache Engine Detail (F12-K Heap-Singleton-Hierarchie im Builder-Prozess)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="proc-frame" value="CacheEngineBuilder = main.cpp Orchestrator (PROZESS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=4;align=center;verticalAlign=top;fontSize=15;fontColor=#BF360C;fontStyle=1;dashed=0;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1480" height="780" as="geometry" />
        </mxCell>

        <mxCell id="heap-frame" value="HEAP-Region des Builder-Prozesses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#F57C00;strokeWidth=3;align=center;verticalAlign=top;fontSize=12;fontColor=#E65100;fontStyle=2;dashed=8 4;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="1080" height="500" as="geometry" />
        </mxCell>

        <mxCell id="cls-builder" value="&lt;b&gt;CacheEngineBuilder&lt;/b&gt;  «Orchestrator»&lt;br&gt;&lt;i&gt;= main.cpp Entry Point&lt;/i&gt;&lt;hr&gt;- mode: { COMPILE_TIME | RUNTIME }&lt;br&gt;- platform_probe: PlatformProbe&lt;br&gt;- module_loader: ModuleLoader&lt;br&gt;- in_memory_buffer: InMemoryMeasurementBuffer&lt;hr&gt;+ run(BuilderConfig) -&gt; BuilderReport&lt;br&gt;+ scan_modules() -&gt; vector&amp;lt;PermutationFlags&amp;gt;&lt;br&gt;+ build_missing_modules(perm_ids)&lt;br&gt;+ run_experiment_loop()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="340" height="200" as="geometry" />
        </mxCell>

        <mxCell id="cls-runtime" value="&lt;b&gt;CacheEngine&lt;/b&gt;  «Heap-Singleton»&lt;br&gt;&lt;i&gt;F12-K: lebt IM Builder-Prozess als globale Variable&lt;/i&gt;&lt;hr&gt;static unique_ptr&amp;lt;CacheEngine&amp;gt; instance_&lt;br&gt;static once_flag once_&lt;hr&gt;- live_cpu_model: LiveCpuModel&lt;br&gt;- visitor: AlgorithmVisitor&lt;br&gt;- observers: ObserverRegistry&lt;br&gt;- compile_time_knowledge: CompileTimeKnowledge&lt;br&gt;- telemetry_spool: TelemetrySpool&lt;hr&gt;+ instance() -&gt; CacheEngine&amp;amp;&lt;br&gt;+ register_algorithm(IAlgorithmStrategy*)&lt;br&gt;+ on_observation(ObservationEvent)  &lt;i&gt;Push synchron&lt;/i&gt;&lt;br&gt;+ visit(IAlgorithmStrategy*)  &lt;i&gt;Mid-Visitor&lt;/i&gt;&lt;br&gt;+ recommend_strategy(Context)&lt;br&gt;+ reset()  &lt;i&gt;zwischen Experimenten — Instanz bleibt&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FB8C00;strokeColor=#E65100;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="420" height="280" as="geometry" />
        </mxCell>

        <mxCell id="cls-cm" value="&lt;b&gt;ConcurrencyManager&lt;/b&gt;  «Sub-Singleton»&lt;br&gt;&lt;i&gt;Heap-Singleton in CacheEngine&lt;/i&gt;&lt;hr&gt;Disziplin-Klassen (8+):&lt;br&gt;• PageConcurrency&lt;br&gt;• NodeConcurrency&lt;br&gt;• ArrayConcurrency&lt;br&gt;• DataStructureConcurrency&lt;br&gt;• PathConcurrency&lt;br&gt;• MemoryAccessConcurrency  (R/W/RW)&lt;br&gt;• SimdThreadConcurrency&lt;br&gt;• SimdFlowConcurrency&lt;hr&gt;Mechaniken (orthogonal):&lt;br&gt;• OLC  [P08]&lt;br&gt;• ROWEX  [P08]&lt;br&gt;• RCU  [P29 LGPL — dynamisch linken!]&lt;hr&gt;+ instance() -&gt; ConcurrencyManager&amp;amp;&lt;br&gt;+ acquire(DisciplineKind, Context)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFA726;strokeColor=#FB8C00;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="280" width="200" height="430" as="geometry" />
        </mxCell>

        <mxCell id="cls-perm" value="&lt;b&gt;PermutationEngine&lt;/b&gt;&lt;hr&gt;9 Bausteine-Banken (uint64_t):&lt;br&gt;page / node / traversal / value_handle&lt;br&gt;memory_layout / allocator / prefetch&lt;br&gt;concurrency / isa&lt;hr&gt;- constraint_filter&lt;br&gt;- target_isa: ISA-Maske (CMake compile-time, F4)&lt;hr&gt;+ enumerate() -&gt; range&amp;lt;PermutationFlags&amp;gt;&lt;br&gt;&lt;i&gt;CPUID-aehnliches Flag-System (F10-K)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="340" height="180" as="geometry" />
        </mxCell>

        <mxCell id="cls-loader" value="&lt;b&gt;ModuleLoader&lt;/b&gt;&lt;hr&gt;dlopen / LoadLibrary Wrapper&lt;hr&gt;+ load(path: filesystem::path) -&gt; Handle&lt;br&gt;+ extract_strategy(Handle) -&gt; IAlgorithmStrategy*&lt;br&gt;+ unload(Handle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="600" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls-buffer" value="&lt;b&gt;InMemoryMeasurementBuffer&lt;/b&gt;&lt;br&gt;&lt;i&gt;F5: KEINE externe DB!&lt;/i&gt;&lt;hr&gt;- arena: pmr::monotonic_buffer_resource&lt;br&gt;- records: vector&amp;lt;MeasurementRecord&amp;gt; (per-thread)&lt;hr&gt;+ append(record) noexcept  &lt;i&gt;append-only, lock-free&lt;/i&gt;&lt;br&gt;+ serialize_to_disk(path)  &lt;i&gt;am Lauf-Ende&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="600" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="cls-trees" value="&lt;b&gt;DecisionLambdaTree&amp;lt;EventT&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;F-EXTRA-6: PRO BAUSTEIN, kein globaler Default!&lt;/i&gt;&lt;hr&gt;Decision = { EXECUTE, DELAY, SKIP }&lt;br&gt;Trees pro Baustein:&lt;br&gt;• PageRelocationTree (ART_Node256-Baustein bringt mit)&lt;br&gt;• PageTypeChangeTree&lt;br&gt;• PrefetchAdjustmentTree (Khan-Baustein bringt mit)&lt;br&gt;• HotPathRecognitionTree (Kuehn-Baustein bringt mit)&lt;br&gt;• AllocatorRebalanceTree&lt;br&gt;• ConcurrencyDisciplineSwitchTree&lt;br&gt;• PageTypeSelectionTree&lt;br&gt;• LayoutInvariantMaintenanceTree&lt;hr&gt;+ evaluate(EventT&amp;amp;&amp;amp;, Context&amp;amp;) noexcept -&gt; Decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB300;strokeColor=#FF8F00;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#000000;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="120" width="320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="cls-meas-matrix" value="&lt;b&gt;Measure&amp;lt;Category, Detail&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;F1: Mess-Kategorie x Algorithmus-Detail Matrix&lt;/i&gt;&lt;br&gt;&lt;i&gt;constexpr Spezialisierungen — compile-time inlined&lt;/i&gt;&lt;hr&gt;Default-Hook + algo-spezifische Overrides (F-EXTRA-7)&lt;br&gt;requires HasMeasurement&amp;lt;Algo, C&amp;gt;&lt;hr&gt;Beispiele:&lt;br&gt;Measure&amp;lt;CLU, ART_Node256&amp;gt;::at_node_visit(...)&lt;br&gt;Measure&amp;lt;dTLB, HOT_CompoundNode&amp;gt;::at_node_visit(...)&lt;br&gt;Measure&amp;lt;BranchMiss, Masstree_BorderNode&amp;gt;::at_lookup_end(...)&lt;hr&gt;ZERO-OVERHEAD bei nicht-aktiver Messung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="380" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="cls-modules" value="&lt;b&gt;ABI-stabile Such-Algorithmus-Module&lt;/b&gt;&lt;br&gt;&lt;i&gt;C++23 Modules, dynamisch geladen&lt;/i&gt;&lt;hr&gt;Pro Permutation eine .so / .dll / .dylib&lt;br&gt;Build via Python-Codegen + CMake (F-EXTRA-5)&lt;br&gt;Compiler-Layering F-EXTRA-1:&lt;br&gt;Schale (C++23) + Bausteine (Original-Compiler) → static link&lt;hr&gt;binden CacheEngine::instance() als Ressource&lt;br&gt;rufen on_observation() im Hot-Path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;strokeWidth=3;align=left;verticalAlign=top;fontSize=10;fontColor=#FFFFFF;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="320" height="180" as="geometry" />
        </mxCell>

