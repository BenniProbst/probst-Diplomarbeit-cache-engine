        <mxCell id="legend" value="LEGENDE&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;━━━━━━━━ Synchroner Observer-Push (Domaene 1 → 2) mit DecisionLambdaTree-Filter (EXECUTE / DELAY / SKIP)&#xa;━━━━━━━━ Visitor-Besuch (Domaene 2 → 1, Mid-Granularitaet: Page + Node, respektiert Habich-Direktive)&#xa;┄┄┄┄┄┄┄┄ Nutzt-/Schreibt-Beziehung (Domaene 2 → 3/4, 3 → 6, 5 → 1/2)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Knallige Farb-Codierung: Blau Search · Orange Cache (Kern!) · Gruen Mess · Tuerkis HW · Rot Engine-Choice · Magenta Pub · Indigo Habich · Gelb F15 · Lila Architekt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#424242;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;spacingTop=8;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="1210" height="140" as="geometry" />
        </mxCell>

      </root>
